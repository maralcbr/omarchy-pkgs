# Maintainer: Omarchy <pkgs@omarchy.org>

# Test-lane candidate recipe. Metadata, dependencies and scriptlet follow
# omacom/omarchy-pkgs master pkgbuilds/omarchy-mac-boot (20260925-4 at
# 539f27b1d13d); the payload is packages/omarchy-mac/boot, staged by its own
# install. lab/build pins _runtime_commit, the omarchy dependency and backup=
# (every staged etc/ and usr/lib/omarchy/initcpio/ path). pkgver is the source
# commit's UTC date, so the set sorts above edge's 20260925-4.
pkgname=omarchy-mac-boot
pkgver=20260926
pkgrel=1
pkgdesc='Apple Silicon boot support for Omarchy: initramfs, in-place encryption, first boot and Limine activation'
arch=(aarch64)
url="https://omarchy.org"
license=('MIT')
depends=('omarchy' 'limine' 'limine-mkinitcpio-hook>=1.39.0-2' 'limine-snapper-sync' 'asahi-scripts' 'bash' 'binutils' 'btrfs-progs' 'coreutils' 'cpio' 'cryptsetup' 'diffutils' 'gawk' 'gnupg' 'grep' 'gum' 'gzip' 'kbd' 'mkinitcpio' 'sed' 'systemd' 'util-linux')
provides=('omarchy-apple-boot' 'omarchy-first-boot')
conflicts=('omarchy-apple-boot' 'omarchy-first-boot')
replaces=('omarchy-apple-boot' 'omarchy-first-boot')
install=omarchy-mac-boot.install
backup=()

_runtime_commit=unset
makedepends=('git')
source=("omarchy-mac-source::git+https://github.com/omacom/omarchy-mac.git#commit=$_runtime_commit")
sha256sums=('SKIP')

prepare() {
  [[ $(git -C "$srcdir/omarchy-mac-source" rev-parse HEAD) == "$_runtime_commit" ]]
  rm -rf "$srcdir/boot-support"
  cp -a "$srcdir/omarchy-mac-source/packages/omarchy-mac/boot" "$srcdir/boot-support"
}

# In the checkout: the legacy migration test reads the settings HOOKS baseline
# from the repository's etc/ (omacom/omarchy-mac#582).
check() {
  bash "$srcdir/omarchy-mac-source/packages/omarchy-mac/boot/test/all"
}

package() {
  "$srcdir/boot-support/install" "$pkgdir"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/omarchy-mac/boot-source-revision" <<<"$_runtime_commit"
}
