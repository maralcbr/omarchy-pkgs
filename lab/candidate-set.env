# One omacom/omarchy-mac commit for the packages built here: quattro-upstream
# b2ba91785 (2026-09-26, image 3: after #561 #563 #564 #567 #568 #569 #572-#577).
SOURCE_REPOSITORY=omacom/omarchy-mac
SOURCE_COMMIT=b2ba91785ed812f86a648a16b197e6f100b1bb57

# All four from the source commit: omarchy-mac (runtime) and omarchy-mac-boot
# must come from the same commit (speakersafetyd single owner, #567).
PACKAGES="omarchy omarchy-settings omarchy-mac omarchy-mac-boot"

# omarchy and omarchy-settings recipes, and the ARM first-run patch applied to
# them: the same pair the omarchy-pkgs-aarch64 quattro image-input lane uses.
DESKTOP_RECIPES_REPOSITORY=omacom/omarchy-pkgs
DESKTOP_RECIPES_COMMIT=4b60e4cd95972c16fbf3da634522a955cf7bf36c
ARM_PATCH_REPOSITORY=omarchy-mac/omarchy-pkgs-aarch64
ARM_PATCH_COMMIT=8f7bf309aa399d5de6c7b5c4228e9e8a0109b17b

# omarchy-mac recipe: omacom/omarchy-pkgs master (#626 merged).
ADDON_RECIPE_REPOSITORY=omacom/omarchy-pkgs
ADDON_RECIPE_COMMIT=8b4c4a4051a7687996be40b7360f1305abf3b584

# omarchy-mac-boot: lab/recipes/omarchy-mac-boot, following omacom/omarchy-pkgs master.
BOOT_RECIPE_ORIGIN=omacom/omarchy-pkgs@539f27b1d13d55749fb538a296aa609e0be40493

BUILD_IMAGE=menci/archlinuxarm:base-devel
