#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
repository=$tmp/repository
export GNUPGHOME=$tmp/gnupg
mkdir "$repository"
mkdir -m 0700 "$GNUPGHOME"

passphrase=phase-2-promotion-test
commit=2222222222222222222222222222222222222222
tag=asahi-packages-candidate-$commit

gpg --batch --pinentry-mode loopback --passphrase "$passphrase" \
  --quick-generate-key 'Promotion Fixture <promotion@example.invalid>' ed25519 cert 1d >/dev/null 2>&1
primary_fingerprint=$(gpg --batch --list-secret-keys --with-colons |
  awk -F: '$1 == "sec" { primary=1; next } primary && $1 == "fpr" { print $10; exit }')
gpg --batch --pinentry-mode loopback --passphrase "$passphrase" \
  --quick-add-key "$primary_fingerprint" ed25519 sign 1d >/dev/null 2>&1
signing_fingerprint=$(gpg --batch --list-secret-keys --with-colons |
  awk -F: '$1 == "ssb" { subkey=1; next } subkey && $1 == "fpr" { print $10; exit }')
gpg --batch --export "$primary_fingerprint" >"$tmp/candidate.gpg"

sign() {
  gpg --batch --yes --pinentry-mode loopback --passphrase "$passphrase" \
    --local-user "$signing_fingerprint!" --detach-sign "$1"
}

index=0
while IFS= read -r package; do
  ((index += 1))
  architecture=aarch64
  (( index % 2 == 0 )) && architecture=any
  printf 'pkgname = %s\npkgver = 2.0.%s-1\narch = %s\n' \
    "$package" "$index" "$architecture" >"$tmp/.PKGINFO"
  archive=$repository/$package-2.0.$index-1-$architecture.pkg.tar.zst
  bsdtar -cf "$archive" -C "$tmp" .PKGINFO
  sign "$archive"
done <"$ROOT/pkgbuilds/asahi-repository-packages"

for asset in omarchy.db omarchy.files transaction-clean.log transaction-upgrade.log transaction-repositories.sha256; do
  printf '%s fixture\n' "$asset" >"$repository/$asset"
done
sign "$repository/omarchy.db"
sign "$repository/omarchy.files"

"$ROOT/bin/asahi-package-candidate-descriptor" "$repository" "$tag" "$commit" \
  "$signing_fingerprint" 42 >"$repository/CANDIDATE"
sign "$repository/CANDIDATE"
(
  cd "$repository"
  sha256sum -- * >SHA256SUMS
)
printf 'format=1\nruntime fixture\n' >"$repository/asahi-quattro-bundle.manifest"
sign "$repository/asahi-quattro-bundle.manifest"
(
  cd "$repository"
  sha256sum asahi-quattro-bundle.manifest asahi-quattro-bundle.manifest.sig >RUNTIME-SHA256SUMS
)
descriptor_sha256=$(sha256sum "$repository/CANDIDATE" | cut -d' ' -f1)

cat >"$tmp/acceptance" <<EOF
format=1
candidate_tag=$tag
candidate_sha256=$descriptor_sha256
signing_fingerprint=$signing_fingerprint
status=accepted
EOF
acceptance_sha256=$(sha256sum "$tmp/acceptance" | cut -d' ' -f1)

output=$(ASAHI_CANDIDATE_SOURCE_DIR="$repository" "$ROOT/bin/promote-asahi-package-candidate" \
  maralcbr/omarchy-pkgs "$tag" "$descriptor_sha256" "$signing_fingerprint" \
  "$tmp/candidate.gpg" "$tmp/acceptance" "$acceptance_sha256")
grep -Fq "Would promote $tag to asahi-packages-stable-$commit" <<<"$output"
echo 'ok - promotion dry run verifies a byte-identical candidate'

if ASAHI_CANDIDATE_SOURCE_DIR="$repository" "$ROOT/bin/promote-asahi-package-candidate" \
  maralcbr/omarchy-pkgs "$tag" "$descriptor_sha256" "$signing_fingerprint" \
  "$tmp/candidate.gpg" "$tmp/acceptance" "$(printf '0%.0s' {1..64})" >/dev/null 2>&1; then
  echo 'not ok - promotion accepted the wrong acceptance digest'
  exit 1
fi
echo 'ok - promotion pins acceptance evidence'

if ASAHI_CANDIDATE_SOURCE_DIR="$repository" "$ROOT/bin/promote-asahi-package-candidate" --publish \
  maralcbr/omarchy-pkgs "$tag" "$descriptor_sha256" "$signing_fingerprint" \
  "$tmp/candidate.gpg" "$tmp/acceptance" "$acceptance_sha256" >/dev/null 2>&1; then
  echo 'not ok - fixture source was allowed to publish'
  exit 1
fi
echo 'ok - fixture promotion cannot publish'

# An incremental candidate carries the promoted candidate's archives and
# signatures byte for byte and rebuilds only the runtime pair. Promotion has no
# full-rebuild requirement and must accept it as it is.
incremental_commit=3333333333333333333333333333333333333333
incremental_tag=asahi-packages-candidate-$incremental_commit
runtime_packages=(omarchy-settings-dev omarchy-dev omarchy-keyring omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic)
predecessor=$tmp/predecessor
release=$tmp/incremental
mkdir "$predecessor" "$tmp/rebuilt-repository" "$tmp/rebuilt-runtime" "$release" "$release-runtime"
cp -a "$repository"/*.pkg.tar.* "$predecessor/"
make_package() {
  printf 'pkgname = %s\npkgver = %s\narch = any\n' "$2" "$3" >"$tmp/.PKGINFO"
  bsdtar -cf "$1/$2-$3-any.pkg.tar.zst" -C "$tmp" .PKGINFO
}
for package in "${runtime_packages[@]}"; do
  make_package "$predecessor" "$package" 1-1
  sign "$predecessor/$package-1-1-any.pkg.tar.zst"
done
make_package "$tmp/rebuilt-runtime" omarchy-settings-dev 2-1
make_package "$tmp/rebuilt-runtime" omarchy-dev 2-1
jq -n --arg commit "$incremental_commit" --rawfile repository "$ROOT/pkgbuilds/asahi-repository-packages" \
  '{format:1,architecture:"aarch64",requested_mode:"incremental",effective_mode:"incremental",fallback_reason:"",current_package_commit:$commit,
    build_sources:[],runtime_groups:["source-pair"],rebuilt_packages:["omarchy-dev","omarchy-settings-dev"],
    reused_packages:(($repository|split("\n")|map(select(length>0))) + ["omarchy-keyring","omarchy-nvim","quickshell-git","ttf-jetbrains-mono-nerd-basic"]),
    invalidation_reasons:{"omarchy-dev":"runtime source commit changed","omarchy-settings-dev":"runtime source commit changed"}}' >"$tmp/PLAN.json"
"$ROOT/bin/asahi-candidate-assemble" "$tmp/PLAN.json" "$predecessor" "$tmp/rebuilt-repository" "$tmp/rebuilt-runtime" "$tmp/assembled" >/dev/null

# As the incremental workflow publishes: sign only rebuilt archives, then split
# the repository from the runtime bundle.
for archive in "$tmp/assembled"/*.pkg.tar.*; do
  [[ $archive == *.sig || -s $archive.sig ]] || sign "$archive"
  [[ $archive == *.sig ]] && continue
  package=$(bsdtar -xOqf "$archive" .PKGINFO | sed -n 's/^pkgname = //p')
  if grep -Fxq "$package" "$ROOT/pkgbuilds/asahi-repository-packages"; then destination=$release; else destination=$release-runtime; fi
  cp -a "$archive" "$archive.sig" "$destination/"
done
for asset in omarchy.db omarchy.files transaction-clean.log transaction-upgrade.log transaction-repositories.sha256; do
  printf '%s incremental fixture\n' "$asset" >"$release/$asset"
done
sign "$release/omarchy.db"
sign "$release/omarchy.files"
cp "$tmp/PLAN.json" "$release/PLAN.json"
mkdir "$tmp/signed"
cp -a "$release"/*.pkg.tar.* "$release-runtime"/*.pkg.tar.* "$tmp/signed/"
"$ROOT/bin/asahi-candidate-provenance" "$tmp/PLAN.json" "$tmp/signed" "$tag" "$descriptor_sha256" "$signing_fingerprint" >/dev/null
cp "$tmp/signed/PROVENANCE.json" "$release/"
"$ROOT/bin/asahi-package-candidate-descriptor" "$release" "$incremental_tag" "$incremental_commit" \
  "$signing_fingerprint" 43 >"$release/CANDIDATE"
sign "$release/CANDIDATE"
(cd "$release" && sha256sum -- * >SHA256SUMS)
printf 'format=1\nruntime fixture\n' >"$release-runtime/asahi-quattro-bundle.manifest"
sign "$release-runtime/asahi-quattro-bundle.manifest"
cp "$tmp/candidate.gpg" "$release-runtime/asahi-repository-signing.asc"
(cd "$release-runtime" && sha256sum -- * >RUNTIME-SHA256SUMS)
cp -a "$release-runtime"/. "$release/"

[[ $(jq -r .effective_mode "$release/PLAN.json") == "incremental" ]]
(( $(jq '[.packages[]|select(.disposition=="reused")]|length' "$release/PROVENANCE.json") == 67 ))
(( $(jq '[.packages[]|select(.disposition=="rebuilt")]|length' "$release/PROVENANCE.json") == 2 ))
for archive in "$repository"/*.pkg.tar.*; do
  cmp "$archive" "$release/${archive##*/}"
done
incremental_sha256=$(sha256sum "$release/CANDIDATE" | cut -d' ' -f1)
cat >"$tmp/incremental-acceptance" <<ACCEPTANCE
format=1
candidate_tag=$incremental_tag
candidate_sha256=$incremental_sha256
signing_fingerprint=$signing_fingerprint
status=accepted
ACCEPTANCE
output=$(ASAHI_CANDIDATE_SOURCE_DIR="$release" "$ROOT/bin/promote-asahi-package-candidate" \
  maralcbr/omarchy-pkgs "$incremental_tag" "$incremental_sha256" "$signing_fingerprint" \
  "$tmp/candidate.gpg" "$tmp/incremental-acceptance" "$(sha256sum "$tmp/incremental-acceptance" | cut -d' ' -f1)")
grep -Fq "Would promote $incremental_tag to asahi-packages-stable-$incremental_commit" <<<"$output"
echo 'ok - promotion accepts an incremental candidate of reused, byte-identical packages'
