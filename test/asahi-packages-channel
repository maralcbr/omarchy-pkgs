# Signed channel 2 for m4 whose content is wrong in one way.
many_hashes() { seq 1 "$1" | awk '{ printf "%040x\n", $1 }' | paste -sd,; }
for variant in not-ancestor descendant unsorted duplicate self uppercase crlf extra-key reordered no-newline \
  sequence descriptor too-many oversize prerelease-target wrong-subkey; do
  description="packages channel with $variant"
  new_case "channel-$variant"
  pointer_fixture
  add_stable "${m[9]}"
  good=$(join_sorted "${m[1]}" "${m[2]}")
  channel_body 2 "${m[4]}" "$good" >"$case_dir/channel"
  case $variant in
    not-ancestor) channel_body 2 "${m[4]}" "$(join_sorted "${m[1]}" "$side")"; message="which is not an ancestor of ${m[4]}" ;;
    descendant) channel_body 2 "${m[4]}" "$(join_sorted "${m[1]}" "${m[9]}")"; message="which is not an ancestor of ${m[4]}" ;;
    unsorted) channel_body 2 "${m[4]}" "$(join_sorted "${m[1]}" "${m[2]}" | tr ',' '\n' | LC_ALL=C sort -r | paste -sd,)"; message='is not sorted and unique' ;;
    duplicate) channel_body 2 "${m[4]}" "${m[1]},${m[1]}"; message='is not sorted and unique' ;;
    self) channel_body 2 "${m[4]}" "$(join_sorted "${m[1]}" "${m[4]}")"; message='lists its own stable commit' ;;
    uppercase) channel_body 2 "${m[4]}" "${m[1]^^}"; message='is not a list of full commit hashes' ;;
    crlf) sed 's/$/\r/' "$case_dir/channel"; message='does not carry sequence=2' ;;
    extra-key) cat "$case_dir/channel"; echo 'note=x'; message='is not the canonical six-line format' ;;
    reordered) awk 'NR == 4 { held=$0; next } NR == 5 { print; print held; next } { print }' "$case_dir/channel"; message='has an invalid stable_tag or descriptor_sha256' ;;
    no-newline) head -c -1 "$case_dir/channel"; message='is not the canonical six-line format' ;;
    sequence) channel_body 3 "${m[4]}" "$good"; message='does not carry sequence=2' ;;
    descriptor) channel_body 2 "${m[4]}" "$good" | sed "s/^descriptor_sha256=.*/descriptor_sha256=$(descriptor_of "${m[2]}")/"; message='names descriptor' ;;
    too-many) channel_body 2 "${m[4]}" "$(many_hashes 2049)"; message='lists 2049 commits, over the limit of 2048' ;;
    oversize) channel_body 2 "${m[4]}" "$(many_hashes 3200)"; message='over the 131072-byte limit' ;;
    prerelease-target) update_release "asahi-packages-stable-${m[4]}" '.prerelease = true'; cat "$case_dir/channel"; message="release asahi-packages-stable-${m[4]} must be published" ;;
    wrong-subkey) sign "$other_subkey" "$(asset "asahi-packages-stable-${m[4]}" CANDIDATE)"; cat "$case_dir/channel"; message="is not signed by $signing_subkey" ;;
  esac >"$case_dir/variant"
  add_signed_channel 2 "$case_dir/variant"
  expect_refusal "$message" point 2
  [[ $(puts) == 0 ]] || fail "$description: pointer written"
  echo "ok - $description is refused by the pointer"
done

description='packages pointer after superseded releases are deleted or reclassified'
new_case pointer-history
pointer_fixture
add_channel 2 "${m[4]}" "$(join_sorted "${m[1]}" "${m[2]}")"
remove_release "asahi-packages-stable-${m[1]}"
update_release "asahi-packages-stable-${m[2]}" '.prerelease = true'
expect_success point 2
expect_pointer 2
echo "ok - $description still verifies"

description='shallow trusted checkout'
new_case shallow
pointer_fixture
git clone -q --depth 1 "file://$checkout" "$case_dir/shallow"
trusted=$case_dir/shallow
expect_refusal 'is not a full-history git checkout' point 1
[[ $(puts) == 0 ]] || fail "$description: pointer written"
echo "ok - $description is refused"

# ── wiring ─────────────────────────────────────────────────────────────────
workflow=$ROOT/.github/workflows/publish-asahi-packages-channel.yml
pointer_workflow=$ROOT/.github/workflows/publish-asahi-channel-pointer.yml

sed -n '/^    inputs:/,/^permissions:/p' "$workflow" >"$tmp/inputs"
sed -n '/^      stable_tag:/,/^      [a-z_]*:$/p' "$tmp/inputs" | grep -Fq 'required: true' &&
  sed -n '/^      stable_tag:/,/^      [a-z_]*:$/p' "$tmp/inputs" | grep -Fq 'type: string' ||
  fail 'package channel workflow requires a stable_tag'
sed -n '/^      replace_malformed_pointer:/,$p' "$tmp/inputs" | grep -Fq 'type: boolean' &&
  sed -n '/^      replace_malformed_pointer:/,$p' "$tmp/inputs" | grep -Fq 'default: false' ||
  fail 'package channel workflow offers replace_malformed_pointer, off by default'
grep -Fxq 'on:' "$workflow" && grep -Fxq '  workflow_dispatch:' "$workflow" && [[ $(sed -n '/^on:/,/^permissions:/p' "$workflow" | grep -c '^  [a-z_]*:') == 1 ]] ||
  fail 'package channel workflow is only dispatched manually'
[[ $(sed -n '/^permissions:/,/^[a-z]/p' "$workflow" | grep -c '^  ') == 1 ]] && grep -Fxq '  contents: write' "$workflow" &&
  [[ $(grep -c 'permissions:' "$workflow") == 1 ]] ||
  fail 'package channel workflow only has contents: write'
grep -Fxq '  group: asahi-quattro-release' "$workflow" && grep -Fxq '  cancel-in-progress: false' "$workflow" ||
  fail 'package channel workflow shares the publication concurrency group'
grep -Fxq '    environment: asahi-quattro-release' "$workflow" || fail 'package channel workflow uses the release environment'
grep -Fq '[[ $GITHUB_REF == "refs/heads/asahi-quattro" ]]' "$workflow" || fail 'package channel workflow only runs from asahi-quattro'
grep -Fxq '          ref: ${{ github.sha }}' "$workflow" && grep -Fxq '          fetch-depth: 0' "$workflow" &&
  grep -Fq '[[ $(git rev-parse --is-shallow-repository) == "false" ]]' "$workflow" ||
  fail 'package channel workflow checks out the dispatched commit with full history'
grep -Fxq '          test/asahi-packages-channel' "$workflow" && grep -Fxq '          test/asahi-channel-pointer' "$workflow" ||
  fail 'package channel workflow runs the publisher tests first'
grep -Fq 'merge-base --is-ancestor "$SOURCE_COMMIT" origin/main' "$workflow" ||
  fail 'package channel workflow reads the release key from public omarchy-mx-mac main'
grep -Fq 'RELEASE_KEY_FINGERPRINT: 5983B1CA32CB778F4D74D24ECFF35022CA5B5959' "$workflow" &&
  grep -Fq '[[ ${primary_fingerprints[0]} == "$RELEASE_KEY_FINGERPRINT" ]]' "$workflow" &&
  grep -Fq '[[ ${secret_fingerprints[0]} == "$RELEASE_KEY_FINGERPRINT" ]]' "$workflow" ||
  fail 'package channel workflow pins the public and imported release key fingerprints'
grep -Fq 'RELEASE_PRIVATE_KEY: ${{ secrets.OMARCHY_RELEASE_PRIVATE_KEY }}' "$workflow" &&
  grep -Fq 'GPG_PASSPHRASE: ${{ secrets.OMARCHY_RELEASE_KEY_PASSPHRASE }}' "$workflow" ||
  fail 'package channel workflow imports the release key and its passphrase'
[[ $(grep -E '^      - (name|uses):' "$workflow" | tail -1) == '      - name: Publish package channel' ]] ||
  fail 'package channel publication is the last step'
publish_step=$(sed -n '/- name: Publish package channel/,$p' "$workflow")
for expected in \
  'GH_TOKEN: ${{ github.token }}' \
  'AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}' \
  'AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}' \
  'AWS_DEFAULT_REGION: auto' \
  'R2_ACCOUNT_ID: ${{ vars.R2_ACCOUNT_ID }}' \
  'R2_BUCKET: ${{ vars.R2_BUCKET }}' \
  'R2_ENDPOINT: ${{ vars.R2_ENDPOINT }}' \
  'R2_PUBLIC_BASE_URL: ${{ vars.R2_PUBLIC_BASE_URL }}' \
  'REPLACE_MALFORMED_POINTER: ${{ inputs.replace_malformed_pointer }}' \
  '[[ $REPLACE_MALFORMED_POINTER == "true" ]]' \
  'options+=(--replace-malformed-pointer)' \
  '--keyring /tmp/omarchy-quattro/default/omarchy-release.gpg' \
  '--signing-key keys/asahi-repository-signing.asc'; do
  grep -Fq -- "$expected" <<<"$publish_step" || fail "package channel step has $expected"
done
installer_line=$(grep -n '\.github/scripts/install-aws-cli\.sh' <<<"$publish_step" | cut -d: -f1)
publisher_line=$(grep -n 'bin/publish-asahi-packages-channel "$STABLE_TAG"' <<<"$publish_step" | cut -d: -f1)
[[ -n $installer_line && -n $publisher_line ]] && ((installer_line < publisher_line)) ||
  fail 'package channel step installs the pinned AWS CLI before publishing'
if grep -E '^[[:space:]]*(- )?uses:' "$workflow" | grep -Ev '@[0-9a-f]{40}( |$)' | grep -q .; then
  fail 'package channel workflow pins actions by commit'
fi
if grep -REn -- '--(release-fingerprint|signing-subkey|trusted-checkout)' "$ROOT/.github/workflows"; then
  fail 'no workflow overrides the pinned keys or the trusted checkout'
fi

sed -n '/^      kind:/,/^      [a-z_]*:$/p' "$pointer_workflow" >"$tmp/kind"
grep -Fq 'type: choice' "$tmp/kind" && grep -Fq 'default: runtime' "$tmp/kind" && grep -Fq -- '- packages' "$tmp/kind" ||
  fail 'pointer repair workflow offers kind, runtime by default'
grep -Fq 'POINTER_KIND: ${{ inputs.kind }}' "$pointer_workflow" && grep -Fq 'options=(--kind "$POINTER_KIND"' "$pointer_workflow" &&
  grep -Fq '[[ $POINTER_KIND == "runtime" || $POINTER_KIND == "packages" ]]' "$pointer_workflow" ||
  fail 'pointer repair workflow forwards the validated kind'
grep -Fxq '          fetch-depth: 0' "$pointer_workflow" && grep -Fxq '          test/asahi-packages-channel' "$pointer_workflow" ||
  fail 'pointer repair workflow has full history and runs the package channel tests'
for workflow in release-asahi-quattro.yml promote-asahi-quattro-runtime.yml; do
  ! grep -Fq -- '--kind' "$ROOT/.github/workflows/$workflow" || fail "$workflow keeps the runtime default"
done
echo 'ok - the package channel workflow and the pointer repair workflow are wired to the pinned trust roots'
