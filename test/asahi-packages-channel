#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
publisher=$ROOT/bin/publish-asahi-packages-channel
pointer=$ROOT/bin/publish-asahi-channel-pointer
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export GNUPGHOME=$tmp/gnupg
mkdir -m 0700 "$GNUPGHOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
stubs=$tmp/bin
mkdir -p "$stubs"

fail() {
  echo "not ok - $1" >&2
  [[ -z ${case_dir:-} || ! -f $case_dir/output ]] || cat "$case_dir/output" >&2
  exit 1
}

repository=maralcbr/omarchy-pkgs
endpoint=https://account.r2.cloudflarestorage.com
bucket=omarchy-releases
public_base=https://downloads.example.invalid
cache_control='no-cache, max-age=0, must-revalidate'

# ── fakes ──────────────────────────────────────────────────────────────────
# gh keeps releases (drafts included), assets and git tags in GH_STATE and appends
# every performed mutation to GH_STATE/mutations. GH_STATE/interrupt=N makes the
# Nth mutation fail after it has taken effect, like a dropped connection.
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$stubs/gh"
set -euo pipefail
echo "gh $*" >>"$STUB_LOG"
state=$GH_STATE
repo=maralcbr/omarchy-pkgs
releases=$state/releases.json

not_found() {
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
}

update() {
  jq "$@" "$releases" >"$releases.next"
  mv "$releases.next" "$releases"
}

mutated() {
  echo "$*" >>"$state/mutations"
  if [[ -f $state/interrupt && $(cat "$state/interrupt") == "$(wc -l <"$state/mutations" | tr -d ' ')" ]]; then
    echo "gh: connection reset after the request was sent" >&2
    exit 1
  fi
}

# Like gh: the published release of a tag, else its first draft.
release_id() {
  jq -r --arg tag "$1" \
    '(map(select(.tag_name == $tag and .draft == false)) + map(select(.tag_name == $tag and .draft)))[0].id // empty' "$releases"
}

command=$1
shift
case $command in
  api)
    method=GET paginate=0 jq_filter="" path=""
    while (($#)); do
      case $1 in
        --method|-X) method=$2; shift 2 ;;
        --paginate) paginate=1; shift ;;
        --jq|-q) jq_filter=$2; shift 2 ;;
        -*) echo "unexpected gh api option $1" >&2; exit 2 ;;
        *) [[ -z $path ]] || { echo "unexpected gh api argument $1" >&2; exit 2; }; path=$1; shift ;;
      esac
    done
    [[ $path == "repos/$repo/"* ]] || { echo "unexpected gh api path $path" >&2; exit 2; }
    path=${path#"repos/$repo/"}
    case "$method $path" in
      "GET releases?per_page=100")
        ((paginate)) && [[ -n $jq_filter ]] || { echo "listing must be paginated and filtered" >&2; exit 2; }
        jq -r "$jq_filter" "$releases" ;;
      "GET releases?per_page=100&page="*)
        ((paginate == 0)) && [[ -z $jq_filter ]] || { echo "unexpected paged listing options" >&2; exit 2; }
        page=${path##*=}
        [[ $page =~ ^[1-9][0-9]*$ ]] || { echo "bad page $page" >&2; exit 2; }
        jq --argjson page "$page" '.[(($page - 1) * 100):($page * 100)]' "$releases" ;;
      "GET releases/tags/"*)
        json=$(jq --arg tag "${path#releases/tags/}" 'map(select(.tag_name == $tag and .draft == false))[0]' "$releases")
        [[ $json != null ]] || not_found
        printf '%s\n' "$json" ;;
      "GET releases/"*)
        id=${path#releases/}
        if [[ -f $state/reread/$id.json ]]; then
          cat "$state/reread/$id.json"
          exit 0
        fi
        json=$(jq --argjson id "$id" 'map(select(.id == $id))[0]' "$releases")
        [[ $json != null ]] || not_found
        printf '%s\n' "$json" ;;
      "DELETE releases/"*)
        id=${path#releases/}
        [[ $(jq --argjson id "$id" 'any(.[]; .id == $id)' "$releases") == true ]] || not_found
        update --argjson id "$id" 'map(select(.id != $id))'
        rm -rf "${state:?}/assets/$id"
        mutated "delete $id" ;;
      "GET git/matching-refs/tags/"*)
        jq -R -s --arg prefix "${path#git/matching-refs/tags/}" \
          'split("\n") | map(select(length > 0 and startswith($prefix)) | {ref: ("refs/tags/" + .)})' "$state/refs" ;;
      *) echo "unexpected gh api call: $method $path" >&2; exit 2 ;;
    esac ;;
  release)
    subcommand=$1 tag=$2
    shift 2
    files=() patterns=() dir="" draft="" latest="" target=""
    while (($#)); do
      case $1 in
        --repo) [[ $2 == "$repo" ]] || { echo "wrong repository $2" >&2; exit 2; }; shift 2 ;;
        --dir) dir=$2; shift 2 ;;
        --pattern) patterns+=("$2"); shift 2 ;;
        --draft) draft=true; shift ;;
        --draft=false) draft=false; shift ;;
        --latest=false) latest=false; shift ;;
        --target) target=$2; shift 2 ;;
        --title|--notes) shift 2 ;;
        -*) echo "unexpected gh release option $1" >&2; exit 2 ;;
        *) files+=("$1"); shift ;;
      esac
    done
    case $subcommand in
      create)
        [[ $draft == true && $latest == false && -n $target && ${#files[@]} == 0 ]] ||
          { echo "create must make an empty draft that is not latest" >&2; exit 2; }
        id=$(cat "$state/next-id")
        echo $((id + 1)) >"$state/next-id"
        update --argjson id "$id" --arg tag "$tag" --arg target "$target" \
          '[{id:$id,tag_name:$tag,draft:true,prerelease:false,immutable:false,target_commitish:$target}] + .'
        mkdir -p "$state/assets/$id"
        mutated "create $tag" ;;
      upload)
        id=$(release_id "$tag")
        [[ -n $id ]] || not_found
        [[ $(jq --argjson id "$id" 'map(select(.id == $id))[0].immutable' "$releases") == false ]] ||
          { echo "HTTP 422: Cannot upload assets to an immutable release." >&2; exit 1; }
        for file in "${files[@]}"; do
          [[ ! -e $state/assets/$id/${file##*/} ]] || { echo "asset ${file##*/} already exists" >&2; exit 1; }
        done
        cp "${files[@]}" "$state/assets/$id/"
        mutated "upload $tag ${files[*]##*/}" ;;
      edit)
        [[ $draft == false && $latest == false ]] || { echo "edit must publish without marking latest" >&2; exit 2; }
        id=$(release_id "$tag")
        [[ -n $id ]] || not_found
        immutable=true
        [[ ! -f $state/mutable ]] || immutable=false
        update --argjson id "$id" --argjson immutable "$immutable" \
          'map(if .id == $id then .draft = false | .immutable = $immutable else . end)'
        grep -Fxq "$tag" "$state/refs" || echo "$tag" >>"$state/refs"
        mutated "publish $tag" ;;
      download)
        id=$(jq -r --arg tag "$tag" 'map(select(.tag_name == $tag and .draft == false))[0].id // empty' "$releases")
        [[ -n $id && -n $dir ]] || { echo "release not found" >&2; exit 1; }
        mkdir -p "$dir"
        matched=0
        for asset in "$state/assets/$id"/*; do
          [[ -f $asset ]] || continue
          wanted=$(( ${#patterns[@]} == 0 ))
          for pattern in "${patterns[@]}"; do
            if [[ ${asset##*/} == $pattern ]]; then wanted=1; fi
          done
          if ((wanted)); then
            cp "$asset" "$dir/"
            matched=1
          fi
        done
        ((matched)) || { echo "no assets match the file pattern" >&2; exit 1; } ;;
      *) echo "unexpected gh release $subcommand" >&2; exit 2 ;;
    esac ;;
  *) echo "unexpected gh call: $command $*" >&2; exit 2 ;;
esac
STUB

{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$stubs/aws"
set -euo pipefail
echo "aws $*" >>"$STUB_LOG"
if [[ ${1:-} == --version ]]; then echo "aws-cli/2.36.40 fake"; exit 0; fi
endpoint=""
while [[ ${1:-} == --* ]]; do
  case $1 in
    --endpoint-url) endpoint=$2; shift 2 ;;
    *) shift ;;
  esac
done
[[ ${1:-} == s3api ]] || { echo "unexpected aws call" >&2; exit 2; }
operation=$2
shift 2
if [[ $operation == put-object && ${1:-} == --generate-cli-skeleton ]]; then
  echo '{"Bucket":"","Key":"","ContentType":"","IfMatch":"","IfNoneMatch":""}'
  exit 0
fi
[[ $endpoint == "$EXPECTED_ENDPOINT" ]] || { echo "wrong endpoint: $endpoint" >&2; exit 2; }
bucket="" key="" body="" content_type="" cache_control="" if_match="" if_none_match="" outfile="" conditions=0
while (($#)); do
  case $1 in
    --bucket) bucket=$2; shift 2 ;;
    --key) key=$2; shift 2 ;;
    --body) body=$2; shift 2 ;;
    --content-type) content_type=$2; shift 2 ;;
    --cache-control) cache_control=$2; shift 2 ;;
    --if-match) if_match=$2; conditions=$((conditions + 1)); shift 2 ;;
    --if-none-match) if_none_match=$2; conditions=$((conditions + 1)); shift 2 ;;
    --*) echo "unexpected option $1" >&2; exit 2 ;;
    *) outfile=$1; shift ;;
  esac
done
[[ $bucket == "$EXPECTED_BUCKET" && $key == "$EXPECTED_KEY" ]] || { echo "wrong object $bucket/$key" >&2; exit 2; }
state=$AWS_STATE
metadata() {
  jq -n --arg etag "$(cat "$state/etag")" --slurpfile meta "$state/meta.json" \
    --argjson size "$(wc -c <"$state/object" | tr -d ' ')" \
    '{ETag:$etag,ContentLength:$size,ContentType:$meta[0].ContentType,CacheControl:$meta[0].CacheControl}'
}
case $operation in
  get-object)
    [[ -f $state/object ]] || {
      echo "An error occurred (NoSuchKey) when calling the GetObject operation: The specified key does not exist." >&2
      exit 254
    }
    cp "$state/object" "$outfile"
    metadata ;;
  head-object)
    [[ -f $state/object ]] || { echo "An error occurred (404) when calling the HeadObject operation: Not Found" >&2; exit 254; }
    metadata ;;
  put-object)
    ((conditions == 1)) || { echo "unconditional or doubly conditional put" >&2; exit 2; }
    echo "put if-match=$if_match if-none-match=$if_none_match" >>"$state/puts"
    if [[ -n $if_none_match ]]; then
      [[ $if_none_match == '*' && ! -f $state/object ]] || { echo "An error occurred (PreconditionFailed)" >&2; exit 254; }
    else
      [[ -f $state/object && $if_match == "$(cat "$state/etag")" ]] || { echo "An error occurred (PreconditionFailed)" >&2; exit 254; }
    fi
    cp "$body" "$state/object"
    jq -n --arg type "$content_type" --arg cache "$cache_control" '{ContentType:$type,CacheControl:$cache}' >"$state/meta.json"
    printf '"etag-put-%s"\n' "$(wc -l <"$state/puts" | tr -d ' ')" >"$state/etag"
    echo '{}' ;;
  *) echo "unexpected s3api operation $operation" >&2; exit 2 ;;
esac
STUB

{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$stubs/curl"
set -euo pipefail
echo "curl $*" >>"$STUB_LOG"
output="" url=""
while (($#)); do
  case $1 in
    --output) output=$2; shift 2 ;;
    --proto|--max-time) shift 2 ;;
    --*) shift ;;
    *) url=$1; shift ;;
  esac
done
[[ $url == "$EXPECTED_PUBLIC_URL" && -n $output ]] || { echo "unexpected curl call $url" >&2; exit 2; }
if [[ -f $AWS_STATE/public-override ]]; then
  cp "$AWS_STATE/public-override" "$output"
elif [[ -f $AWS_STATE/object ]]; then
  cp "$AWS_STATE/object" "$output"
else
  exit 22
fi
STUB

{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$stubs/sleep"
echo "sleep $*" >>"$STUB_LOG"
STUB
chmod +x "$stubs"/*

# ── keys ───────────────────────────────────────────────────────────────────
generate_key() {
  gpg --batch --pinentry-mode loopback --passphrase '' --quick-generate-key "$1" ed25519 "$2" 1d >/dev/null 2>&1
  gpg --batch --with-colons --list-keys "$1" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }'
}
release_key=$(generate_key 'Release Fixture <release@example.invalid>' sign)
rogue_key=$(generate_key 'Rogue Fixture <rogue@example.invalid>' sign)
repository_primary=$(generate_key 'Repository Fixture <repository@example.invalid>' cert)
for _ in 1 2; do
  gpg --batch --pinentry-mode loopback --passphrase '' --quick-add-key "$repository_primary" ed25519 sign 1d >/dev/null 2>&1
done
mapfile -t repository_subkeys < <(
  gpg --batch --with-colons --list-keys "$repository_primary" |
    awk -F: '$1 == "sub" { inside=1; next } inside && $1 == "fpr" { print $10; inside=0 }'
)
((${#repository_subkeys[@]} == 2)) || fail 'fixture repository key has two signing subkeys'
signing_subkey=${repository_subkeys[0]}
other_subkey=${repository_subkeys[1]}
gpg --batch --export "$release_key" >"$tmp/release.gpg"
gpg --batch --armor --export "$repository_primary" >"$tmp/repository.asc"

sign() {
  gpg --batch --yes --pinentry-mode loopback --passphrase '' --local-user "$1!" --output "$2.sig" --detach-sign "$2"
}

# ── trusted history: m1..m14 on main (HEAD m14), side branches off m2 ───────
checkout=$tmp/checkout
git init -q -b main "$checkout"
new_commit() {
  git -C "$checkout" -c user.name=Fixture -c user.email=fixture@example.invalid commit -q --allow-empty -m "$1"
  git -C "$checkout" rev-parse HEAD
}
m=(root)
for i in {1..14}; do
  m[i]=$(new_commit "main $i")
done
git -C "$checkout" checkout -q -b side "${m[2]}"
side=$(new_commit side)
git -C "$checkout" checkout -q main

# ── release fixtures ───────────────────────────────────────────────────────
files=$tmp/files
base=$tmp/base
mkdir -p "$files" "$base/assets"
: >"$base/refs"
: >"$base/mutations"
echo 1000 >"$base/next-id"
echo '[]' >"$base/releases.json"
state=$base
channel_counter=0

add_release() {
  local tag=$1 draft=$2 prerelease=$3 immutable=$4 id
  shift 4
  id=$(cat "$state/next-id")
  echo $((id + 1)) >"$state/next-id"
  jq --argjson id "$id" --arg tag "$tag" --argjson draft "$draft" --argjson prerelease "$prerelease" \
    --argjson immutable "$immutable" '[{id:$id,tag_name:$tag,draft:$draft,prerelease:$prerelease,immutable:$immutable}] + .' \
    "$state/releases.json" >"$state/releases.next"
  mv "$state/releases.next" "$state/releases.json"
  mkdir -p "$state/assets/$id"
  if (($#)); then
    cp "$@" "$state/assets/$id/"
  fi
  if [[ $draft == false ]]; then
    echo "$tag" >>"$state/refs"
  fi
  last_id=$id
}

update_release() {
  jq --arg tag "$1" "map(if .tag_name == \$tag and .draft == false then $2 else . end)" "$state/releases.json" \
    >"$state/releases.next"
  mv "$state/releases.next" "$state/releases.json"
}

remove_release() {
  local id
  id=$(jq -r --arg tag "$1" 'map(select(.tag_name == $tag))[0].id' "$state/releases.json")
  jq --arg tag "$1" 'map(select(.tag_name != $tag))' "$state/releases.json" >"$state/releases.next"
  mv "$state/releases.next" "$state/releases.json"
  rm -rf "${state:?}/assets/$id"
}

asset() {
  echo "$state/assets/$(jq -r --arg tag "$1" 'map(select(.tag_name == $tag and .draft == false))[0].id' "$state/releases.json")/$2"
}

candidate_dir() {
  local dir=$files/candidate-$1
  if [[ ! -f $dir/CANDIDATE.sig ]]; then
    mkdir -p "$dir"
    printf 'format=1\nchannel=candidate\nrelease_tag=asahi-packages-candidate-%s\nsource_commit=%s\nworkflow_run=%s\nrunner_arch=aarch64\nsigning_fingerprint=%s\npackage_count=0\n' \
      "$1" "$1" "$((RANDOM + 1))" "$signing_subkey" >"$dir/CANDIDATE"
    sign "$signing_subkey" "$dir/CANDIDATE"
  fi
  echo "$dir"
}

# COMMIT [STABLE_DRAFT STABLE_PRERELEASE STABLE_IMMUTABLE]
add_stable() {
  local dir
  dir=$(candidate_dir "$1")
  add_release "asahi-packages-candidate-$1" false true true "$dir/CANDIDATE" "$dir/CANDIDATE.sig"
  add_release "asahi-packages-stable-$1" "${2:-false}" "${3:-false}" "${4:-true}" "$dir/CANDIDATE" "$dir/CANDIDATE.sig"
}

descriptor_of() {
  sha256sum "$(candidate_dir "$1")/CANDIDATE" | cut -d' ' -f1
}

join_sorted() {
  (($#)) || return 0
  printf '%s\n' "$@" | LC_ALL=C sort | paste -sd,
}

channel_body() {
  printf 'format=1\nchannel=asahi-packages\nsequence=%s\nstable_tag=asahi-packages-stable-%s\ndescriptor_sha256=%s\nsupersedes=%s\n' \
    "$1" "$2" "$(descriptor_of "$2")" "$3"
}

# SEQUENCE BODY_FILE [SIGNER]
add_signed_channel() {
  local dir=$files/channel-$((++channel_counter))
  mkdir -p "$dir"
  cp "$2" "$dir/asahi-packages-channel"
  sign "${3:-$release_key}" "$dir/asahi-packages-channel"
  add_release "asahi-packages-channel-$1" false false true "$dir/asahi-packages-channel" "$dir/asahi-packages-channel.sig"
}

# SEQUENCE COMMIT SUPERSEDES
add_channel() {
  channel_body "$1" "$2" "$3" >"$tmp/body"
  add_signed_channel "$1" "$tmp/body"
}

add_release asahi-quattro-channel-33 false false true
add_release "asahi-packages-candidate-$(printf 'e%.0s' {1..40})" false true true

# ── case harness ───────────────────────────────────────────────────────────
case_dir=""
trusted=$checkout
new_case() {
  case_dir=$tmp/case-$1
  mkdir -p "$case_dir/aws"
  cp -R "$base" "$case_dir/gh"
  state=$case_dir/gh
  trusted=$checkout
  : >"$case_dir/log"
  : >"$case_dir/aws/puts"
}

run() {
  env PATH="$stubs:$PATH" STUB_LOG="$case_dir/log" GH_STATE="$state" AWS_STATE="$case_dir/aws" \
    EXPECTED_ENDPOINT="$endpoint" EXPECTED_BUCKET="$bucket" EXPECTED_KEY=pointers/asahi-packages-channel \
    EXPECTED_PUBLIC_URL="$public_base/pointers/asahi-packages-channel" \
    R2_BUCKET="$bucket" R2_ENDPOINT="$endpoint" R2_PUBLIC_BASE_URL="$public_base" \
    AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test GH_TOKEN=test \
    "$BASH" "$@" >"$case_dir/output" 2>&1
}

key_args() {
  printf '%s\n' --keyring "$tmp/release.gpg" --signing-key "$tmp/repository.asc" --trusted-checkout "$trusted" \
    --release-fingerprint "$release_key" --signing-subkey "$signing_subkey"
}

publish() {
  local options
  mapfile -t options < <(key_args)
  run "$publisher" "asahi-packages-stable-$1" "${@:2}" "${options[@]}"
}

point() {
  local options
  mapfile -t options < <(key_args)
  run "$pointer" "$@" --kind packages "${options[@]}"
}

expect_success() {
  "$@" || fail "$description: $1 failed"
}

expect_refusal() {
  local message=$1
  shift
  if "$@"; then fail "$description: $1 succeeded"; fi
  grep -Fq -- "$message" "$case_dir/output" || fail "$description: expected '$message'"
}

mutations() { wc -l <"$state/mutations" | tr -d ' '; }
puts() { wc -l <"$case_dir/aws/puts" | tr -d ' '; }

expect_untouched() {
  [[ $(mutations) == 0 ]] || fail "$description: releases were changed"
  ! grep -Eq '^gh (release (create|upload|edit|delete)|api --method)' "$case_dir/log" ||
    fail "$description: a mutating gh call was made"
  [[ $(puts) == 0 ]] || fail "$description: the pointer was written"
}

pointer_body() {
  printf 'format=1\nsequence=%s\ntag=asahi-packages-channel-%s\n' "$1" "$1"
}

seed_pointer() {
  cp "$1" "$case_dir/aws/object"
  jq -n --arg cache "$cache_control" '{ContentType:"text/plain",CacheControl:$cache}' >"$case_dir/aws/meta.json"
  echo '"etag-seed"' >"$case_dir/aws/etag"
}

expect_pointer() {
  pointer_body "$1" | cmp -s - "$case_dir/aws/object" || fail "$description: the pointer does not name channel $1"
  grep -Fq "verified $public_base/pointers/asahi-packages-channel names asahi-packages-channel-$1" "$case_dir/output" ||
    fail "$description: the pointer was not verified"
}

# SEQUENCE COMMIT SUPERSEDES
expect_channel() {
  local tag=asahi-packages-channel-$1 id
  [[ $(jq --arg tag "$tag" 'map(select(.tag_name == $tag)) | length' "$state/releases.json") == 1 ]] ||
    fail "$description: $tag is not exactly one release"
  id=$(jq -r --arg tag "$tag" 'map(select(.tag_name == $tag and .draft == false and .prerelease == false and .immutable))[0].id // empty' \
    "$state/releases.json")
  [[ -n $id ]] || fail "$description: $tag is not published and immutable"
  [[ $(ls "$state/assets/$id" | paste -sd' ') == 'asahi-packages-channel asahi-packages-channel.sig' ]] ||
    fail "$description: $tag does not carry exactly the channel and its signature"
  channel_body "$1" "$2" "$3" | cmp -s - "$state/assets/$id/asahi-packages-channel" ||
    fail "$description: $tag does not hold the expected channel file"
  gpg --batch --status-fd 1 --verify "$state/assets/$id/asahi-packages-channel.sig" "$state/assets/$id/asahi-packages-channel" 2>/dev/null |
    awk -v key="$release_key" '$2 == "VALIDSIG" && $3 == key { valid=1 } END { exit !valid }' ||
    fail "$description: $tag is not signed by the release key"
  jq -e --arg tag "$tag" --arg commit "$2" 'map(select(.tag_name == $tag))[0] | (.target_commitish // $commit) == $commit' \
    "$state/releases.json" >/dev/null || fail "$description: $tag does not target its stable commit"
}

# ── first publication and supersedes ───────────────────────────────────────
description='first channel with no older stable sets'
new_case first
add_stable "${m[1]}"
expect_success publish "${m[1]}"
expect_channel 1 "${m[1]}" ""
expect_pointer 1
[[ $(paste -sd'|' "$state/mutations") == 'create asahi-packages-channel-1|upload asahi-packages-channel-1 asahi-packages-channel|upload asahi-packages-channel-1 asahi-packages-channel.sig|publish asahi-packages-channel-1' ]] ||
  fail "$description: publication was not draft, upload, upload, publish"
grep -Fxq 'put if-match= if-none-match=*' "$case_dir/aws/puts" || fail "$description: pointer was not created conditionally"
echo "ok - $description becomes channel 1 with an empty supersedes list, then gets its pointer"

description='supersedes'
new_case supersedes
for commit in "${m[1]}" "${m[2]}" "${m[4]}" "${m[5]}" "$side" "${m[9]}"; do
  add_stable "$commit"
done
add_stable "${m[3]}" false true true
add_stable "${m[6]}" true false false
add_stable "${m[7]}" false false false
add_stable "${m[8]}"
expect_success publish "${m[8]}"
expect_channel 1 "${m[8]}" "$(join_sorted "${m[1]}" "${m[2]}" "${m[4]}" "${m[5]}")"
echo "ok - $description lists exactly the published immutable non-prerelease strict ancestors, sorted"

description='legacy package releases'
new_case legacy
add_release "asahi-packages-${m[1]}" false false true
add_release "asahi-packages-${m[2]}" false true true
add_release "asahi-packages-${m[3]}" true false false
add_release "asahi-packages-${m[4]}" false false false
add_release "asahi-packages-$side" false false true
add_release "asahi-packages-${m[5]}" false false true
add_stable "${m[5]}"
add_release "asahi-packages-candidate-${m[6]}" false false true
add_release "asahi-packages-channel-${m[7]}" false false true
add_release "asahi-packages-stable-${m[8]:0:39}" false false true
add_release "asahi-packages-${m[9]:0:39}" false false true
