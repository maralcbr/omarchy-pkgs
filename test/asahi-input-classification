#!/bin/bash

set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")

# An unclassified file forces the next candidate into a full rebuild, so it
# must fail here, on the pull request that adds it.
mapfile -t tracked < <(git -C "$ROOT" ls-files)
(( ${#tracked[@]} > 0 ))
classes=$(printf '%s\n' "${tracked[@]}" | "$ROOT/bin/asahi-incremental-plan" --classify)
unclassified=$(awk -F'|' '$2 == "unclassified" { print "  " $1 }' <<<"$classes")
if [[ -n $unclassified ]]; then
  echo "not ok - classify these files in pkgbuilds/asahi-planner-classes (none) or bin/asahi-incremental-plan:" >&2
  echo "$unclassified" >&2
  exit 1
fi
(( $(wc -l <<<"$classes") == ${#tracked[@]} ))
echo 'ok - every tracked file has exactly one input class'

expect() {
  local path=$1 expected=$2 actual
  actual=$("$ROOT/bin/asahi-incremental-plan" --classify <<<"$path" | cut -d'|' -f2,3)
  [[ $actual == "$expected" ]] || { echo "not ok - $path is $actual, expected $expected" >&2; exit 1; }
}
expect bin/build 'rebuild-all|'
expect build/Dockerfile 'rebuild-all|'
expect build/pacstrap-docker 'rebuild-all|'
expect helpers/package-metadata.sh 'rebuild-all|'
expect keys/asahi-repository-signing.asc 'rebuild-all|'
expect pkgbuilds/asahi-repository-sources 'rebuild-all|'
expect bin/asahi-incremental-plan 'contract|'
expect bin/asahi-verify-candidate 'contract|'
expect bin/asahi-package-candidate-descriptor 'contract|'
expect .github/workflows/release-asahi-package-incremental.yml 'contract|'
expect .github/scripts/verify-asahi-repository-lifecycle.sh 'contract|'
expect pkgbuilds/aether/PKGBUILD 'package|aether'
expect pkgbuilds/libretro-vice-git/PKGBUILD 'package|libretro-vice-git'
expect pkgbuilds/omarchy-source.conf 'runtime|source-pair'
expect pkgbuilds/omarchy-dev/PKGBUILD 'runtime|source-pair'
expect pkgbuilds/omarchy-nvim/PKGBUILD 'runtime|omarchy-nvim'
expect pkgbuilds/cursor-bin/PKGBUILD 'none|'
expect pkgbuilds/linux-aurora/PKGBUILD 'none|'
expect bin/install-asahi-quattro 'none|'
expect bin/promote-asahi-package-candidate 'none|'
expect bin/asahi-release 'none|'
expect bin/asahi-candidate-lineage 'none|'
expect bin/asahi-package-payload 'none|'
expect docs/asahi-planner-replay.md 'none|'
expect pkgbuilds/asahi-planner-classes 'none|'
expect bin/asahi-new-tool 'unclassified|'
expect pkgbuilds/new-definition 'unclassified|'
echo 'ok - builder, contract, package and no-rebuild inputs keep their classes'

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/pkgbuilds"
cp "$ROOT/pkgbuilds/asahi-repository-sources" "$ROOT/pkgbuilds/asahi-repository-packages" "$ROOT/pkgbuilds/asahi-source-outputs" "$ROOT/pkgbuilds/asahi-planner-classes" "$tmp/pkgbuilds/"
echo 'bin/asahi-listed-tool|operator tool' >>"$tmp/pkgbuilds/asahi-planner-classes"
actual=$(ASAHI_PACKAGE_ROOT="$tmp" "$ROOT/bin/asahi-incremental-plan" --classify <<<"bin/asahi-listed-tool" | cut -d'|' -f2,3)
[[ $actual == 'none|' ]] || { echo "not ok - bin/asahi-listed-tool is $actual, expected none|" >&2; exit 1; }
echo 'ok - a path listed only in the none-class table is none'

{
  echo 'pkgbuilds/aether/*|operator tool'
  echo 'pkgbuilds/omarchy-source.conf|operator tool'
  echo 'pkgbuilds/omarchy-dev/*|operator tool'
  echo 'bin/build|operator tool'
  echo 'keys/*|operator tool'
  echo '.github/workflows/*|operator tool'
} >>"$tmp/pkgbuilds/asahi-planner-classes"
classify_tmp() {
  ASAHI_PACKAGE_ROOT="$tmp" "$ROOT/bin/asahi-incremental-plan" --classify <<<"$1" | cut -d'|' -f2,3
}
actual=$(classify_tmp pkgbuilds/aether/PKGBUILD)
[[ $actual == 'package|aether' ]] || { echo "not ok - pkgbuilds/aether/PKGBUILD is $actual, expected package|aether" >&2; exit 1; }
actual=$(classify_tmp pkgbuilds/omarchy-source.conf)
[[ $actual == 'runtime|source-pair' ]] || { echo "not ok - pkgbuilds/omarchy-source.conf is $actual, expected runtime|source-pair" >&2; exit 1; }
actual=$(classify_tmp pkgbuilds/omarchy-dev/PKGBUILD)
[[ $actual == 'runtime|source-pair' ]] || { echo "not ok - pkgbuilds/omarchy-dev/PKGBUILD is $actual, expected runtime|source-pair" >&2; exit 1; }
actual=$(classify_tmp bin/build)
[[ $actual == 'rebuild-all|' ]] || { echo "not ok - bin/build is $actual, expected rebuild-all|" >&2; exit 1; }
actual=$(classify_tmp keys/asahi-repository-signing.asc)
[[ $actual == 'rebuild-all|' ]] || { echo "not ok - keys/asahi-repository-signing.asc is $actual, expected rebuild-all|" >&2; exit 1; }
actual=$(classify_tmp .github/workflows/release-asahi-package-incremental.yml)
[[ $actual == 'contract|' ]] || { echo "not ok - incremental workflow is $actual, expected contract|" >&2; exit 1; }
echo 'ok - the none-class table cannot shadow package, runtime, rebuild-all or contract inputs'

echo 'bin/asahi-overlap*|first reason' >>"$tmp/pkgbuilds/asahi-planner-classes"
echo 'bin/asahi-overlap-tool|second reason' >>"$tmp/pkgbuilds/asahi-planner-classes"
line=$(ASAHI_PACKAGE_ROOT="$tmp" "$ROOT/bin/asahi-incremental-plan" --classify <<<"bin/asahi-overlap-tool")
[[ $line == 'bin/asahi-overlap-tool|none||first reason' ]] || { echo "not ok - overlapping patterns gave $line" >&2; exit 1; }
echo 'ok - overlapping none-class patterns keep the first match'

echo 'not a class entry' >>"$tmp/pkgbuilds/asahi-planner-classes"
status=0
ASAHI_PACKAGE_ROOT="$tmp" "$ROOT/bin/asahi-incremental-plan" --classify <<<"README.md" >/dev/null 2>"$tmp/malformed.err" || status=$?
(( status != 0 ))
grep -Fq 'Malformed none-class table line: not a class entry' "$tmp/malformed.err"
echo 'ok - a malformed none-class table line fails closed'

workflow=$ROOT/.github/workflows/test-asahi-release-inputs.yml
grep -Fxq '  pull_request:' "$workflow"
grep -Fxq '          test/asahi-input-classification' "$workflow"
for suite in asahi-package-payload asahi-packages-channel aurora-kernel-input-digest aurora-edge-release aurora-package-descriptor; do
  grep -Fxq "          test/$suite" "$workflow" || { echo "not ok - pull requests do not run test/$suite" >&2; exit 1; }
done
if grep -q 'secrets\.' "$workflow"; then echo 'not ok - the pull request workflow reads secrets' >&2; exit 1; fi
echo 'ok - pull requests run the classification check, the channel publisher and the Aurora digest suites without secrets'
