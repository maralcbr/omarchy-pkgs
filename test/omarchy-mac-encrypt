#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
FILES=$ROOT/pkgbuilds/omarchy-mac-boot/files
HOOK=$FILES/usr/lib/initcpio/hooks/omarchy-mac-encrypt
INSTALL=$FILES/usr/lib/initcpio/install/omarchy-mac-encrypt
UNIT=$FILES/usr/lib/omarchy/initcpio/omarchy-mac-encrypt.service
DROPIN=$FILES/etc/mkinitcpio.conf.d/91-omarchy-mac-encrypt.conf
ESP_UUID=4F4D-5801
REDUCE_BYTES=$((32 * 1024 * 1024))

fail() {
  echo "not ok - $1" >&2
  [[ -z ${case_dir:-} || ! -f $case_dir/out ]] || cat "$case_dir/out" >&2
  exit 1
}

# ── static ─────────────────────────────────────────────────────────────────
[[ -x $HOOK && -x $INSTALL && -f $UNIT && -f $DROPIN ]] || fail "T4a ships the hook, install script, unit and drop-in"

grep -Fq 'add_binary cryptsetup' "$INSTALL" && grep -Fq 'add_binary btrfs' "$INSTALL" &&
  grep -Fq 'add_binary e2fsck' "$INSTALL" && grep -Fq 'add_binary resize2fs' "$INSTALL" &&
  grep -Fq 'add_binary tune2fs' "$INSTALL" || fail "the install hook puts cryptsetup, btrfs-progs and e2fsprogs in the image"

grep -Fq 'After=omarchy-vendorfw.service' "$UNIT" &&
  grep -Fq 'Before=initrd-root-device.target cryptsetup-pre.target systemd-cryptsetup@root.service' "$UNIT" &&
  grep -Fq 'TimeoutStartSec=infinity' "$UNIT" &&
  grep -Fxq 'ExecStart=/usr/lib/initcpio/hooks/omarchy-mac-encrypt' "$UNIT" ||
  fail "the initrd unit runs after vendorfw and before sd-encrypt's root device"

grep -Fq 'omarchy-mac-encrypt sd-encrypt' "$DROPIN" || fail "91-omarchy-mac-encrypt.conf inserts both hooks"

hooks_after() {
  HOOKS=("$@")
  # shellcheck disable=SC1090
  source "$DROPIN"
  printf '%s\n' "${HOOKS[*]}"
}
[[ $(hooks_after base systemd autodetect microcode modconf kms keyboard sd-vconsole block asahi omarchy-vendorfw filesystems fsck) == \
  "base systemd autodetect microcode modconf kms keyboard sd-vconsole block asahi omarchy-vendorfw omarchy-mac-encrypt sd-encrypt filesystems fsck" ]] ||
  fail "the drop-in places omarchy-mac-encrypt and sd-encrypt after vendorfw and before filesystems"
[[ $(hooks_after base systemd block filesystems fsck) == "base systemd block omarchy-mac-encrypt sd-encrypt filesystems fsck" ]] ||
  fail "without vendorfw the encrypt hooks still land before filesystems"

grep -Fq 'cryptsetup reencrypt --encrypt' "$HOOK" &&
  grep -Fq -- '--reduce-device-size' "$HOOK" && grep -Fq -- '--device-size' "$HOOK" &&
  grep -Fq -- '--resilience checksum' "$HOOK" && grep -Fq -- '--key-file' "$HOOK" ||
  fail "the runtime hook runs foreground LUKS2 reencrypt with the contracted flags"
grep -Fq 'update-grub' "$HOOK" && grep -Fq 'mkinitcpio -P' "$HOOK" ||
  fail "the hook regenerates GRUB the way the fresh installer does, then mkinitcpio -P"
grep -Fq 'rd.luks.key=' "$HOOK" && grep -Fq 'UUID=4F4D-5801' "$HOOK" &&
  grep -Fq 'root=/dev/mapper/root' "$HOOK" && grep -Fq 'rd.luks.name=' "$HOOK" ||
  fail "the GRUB cmdline names the mapper, the LUKS UUID and the ESP key"
grep -Fq 'root UUID=' "$HOOK" && grep -Fq ' none luks' "$HOOK" || fail "crypttab is root UUID=<luks uuid> none luks"
grep -Fq 'PROVISIONING_DIR=/var/lib/omarchy/provisioning' "$HOOK" || fail "the throwaway key is copied to the provisioning dir"
! grep -Eq 'btrfs filesystem resize (max|1:max)' "$HOOK" || fail "the hook leaves btrfs growfs to x-systemd.growfs"
echo 'ok - hook, unit and drop-in match INTERFACES §5 T4a'

linux_block_ready() {
  [[ -e /dev/loop-control && -w /dev/loop-control ]] &&
    command -v losetup >/dev/null && command -v cryptsetup >/dev/null &&
    command -v mkfs.btrfs >/dev/null && command -v mkfs.vfat >/dev/null &&
    command -v findmnt >/dev/null
}

run_in_arch_container() {
  command -v docker >/dev/null || return 1
  docker info >/dev/null 2>&1 || return 1
  # library/archlinux publishes amd64 only; Docker Desktop's loop devices work
  # under qemu, so Apple Silicon and ubuntu-24.04-arm use linux/amd64.
  docker run --rm --privileged --platform linux/amd64 \
    -e OMARCHY_MAC_ENCRYPT_TEST_INNER=1 -e TMPDIR=/var/tmp \
    -v "$ROOT:/repo" -w /repo archlinux:latest bash -lc '
      set -euo pipefail
      pacman --disable-sandbox -Sy --noconfirm --needed cryptsetup btrfs-progs e2fsprogs util-linux dosfstools procps-ng >/dev/null
      bash test/omarchy-mac-encrypt
    '
}

run_fake_device_layer() {
  local tmp stubs
  tmp=$(mktemp -d)
  stubs=$tmp/bin
  mkdir -p "$stubs" "$tmp/esp/omarchy" "$tmp/root/var/lib/omarchy/mac-first-boot"
  printf 'format=1\nencrypt=0\n' >"$tmp/esp/omarchy/install.conf"
  : >"$tmp/root/var/lib/omarchy/mac-first-boot/encrypt-pending"
  printf '#!/bin/bash\necho "blkid $*" >>"$FAKE_LOG"; echo btrfs\n' >"$stubs/blkid"
  printf '#!/bin/bash\necho "cryptsetup $*" >>"$FAKE_LOG"; exit 1\n' >"$stubs/cryptsetup"
  printf '#!/bin/bash\necho "mount $*" >>"$FAKE_LOG"\n' >"$stubs/mount"
  printf '#!/bin/bash\necho "umount $*" >>"$FAKE_LOG"\n' >"$stubs/umount"
  printf '#!/bin/bash\necho "findmnt $*" >>"$FAKE_LOG"; exit 1\n' >"$stubs/findmnt"
  printf '#!/bin/bash\n' >"$stubs/blockdev"
  chmod +x "$stubs"/*
  : >"$tmp/fake.log"
  FAKE_LOG=$tmp/fake.log OMARCHY_MAC_ENCRYPT_ESP="$tmp/esp" OMARCHY_MAC_ENCRYPT_ROOT=/dev/fake-root \
    PATH="$stubs:$PATH" bash "$HOOK" >"$tmp/out" 2>&1 || fail "encrypt=0 with a faked device layer should be a no-op"
  ! grep -q 'reencrypt --encrypt' "$tmp/fake.log" || fail "encrypt=0 must not start reencrypt"
  rm -rf "$tmp"
  echo 'ok - loop devices unavailable; faked only the device layer (encrypt=0 is a no-op)'
}

if [[ ${OMARCHY_MAC_ENCRYPT_TEST_INNER:-} != 1 ]] && ! linux_block_ready; then
  echo 'ok - host has no loop/cryptsetup; trying a privileged archlinux container'
  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    run_in_arch_container
    exit $?
  fi
  echo 'ok - privileged docker with loop devices was not available'
  run_fake_device_layer
  exit 0
fi

linux_block_ready || fail "inner run still lacks loop devices and cryptsetup"
losetup -D 2>/dev/null || true
for i in $(seq 0 63); do
  [[ -e /dev/loop$i ]] || mknod /dev/loop$i b 7 "$i" 2>/dev/null || true
done

tmp=$(mktemp -d "${TMPDIR:-/var/tmp}/omarchy-mac-encrypt.XXXXXX")
loops=()
cleanup() {
  local loop mnt
  cryptsetup close root 2>/dev/null || true
  for mnt in "$tmp"/mnt-*; do
    [[ -d $mnt ]] || continue
    umount "$mnt" 2>/dev/null || true
  done
  for loop in "${loops[@]+"${loops[@]}"}"; do
    losetup -d "$loop" 2>/dev/null || true
  done
  rm -rf "$tmp"
}
trap cleanup EXIT

attach_loop() {
  local img=$1 loop
  loop=$(losetup --find --show --sector-size 512 "$img")
  loops+=("$loop")
  printf '%s\n' "$loop"
}

detach_loop() {
  local loop=$1 i
  losetup -d "$loop" 2>/dev/null || true
  loops_kept=()
  for i in "${loops[@]+"${loops[@]}"}"; do
    [[ $i == "$loop" ]] || loops_kept+=("$i")
  done
  loops=("${loops_kept[@]+"${loops_kept[@]}"}")
}

make_esp() {
  local img=$tmp/esp.img
  dd if=/dev/zero of="$img" bs=1M count=32 status=none
  mkfs.vfat -F 32 -i 4F4D5801 "$img" >/dev/null 2>&1
  ESP_LOOP=$(attach_loop "$img")
  ESP_MNT=$tmp/mnt-esp
  mkdir -p "$ESP_MNT"
  mount "$ESP_LOOP" "$ESP_MNT"
  mkdir -p "$ESP_MNT/omarchy"
}

seed_chroot_shell() {
  local root=$1 bash_path tok real
  bash_path=$(command -v bash)
  mkdir -p "$root/usr/bin" "$root/bin"
  cp -a "$bash_path" "$root/usr/bin/bash"
  ln -sfn /usr/bin/bash "$root/bin/bash"
  ln -sfn bash "$root/bin/sh"
  ln -sfn bash "$root/usr/bin/sh"
  while read -r tok; do
    [[ $tok == /* ]] || continue
    real=$(readlink -f "$tok")
    [[ -f $real ]] || continue
    mkdir -p "$root$(dirname "$tok")" "$root$(dirname "$real")"
    [[ -e $root$real ]] || cp -a "$real" "$root$real"
    if [[ $tok != "$real" && ! -e $root$tok ]]; then
      ln -sfn "$real" "$root$tok"
    fi
  done < <(ldd "$bash_path" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\//) print $i }')
}

populate_root() {
  local mnt=$1
  btrfs subvolume create "$mnt/@" >/dev/null
  mkdir -p "$mnt/@/var/lib/omarchy/mac-first-boot" "$mnt/@/var/lib/omarchy/provisioning" \
    "$mnt/@/etc/default" "$mnt/@/usr/bin" "$mnt/@/boot/efi" "$mnt/@/root" \
    "$mnt/@/proc" "$mnt/@/sys" "$mnt/@/dev"
  seed_chroot_shell "$mnt/@"
  : >"$mnt/@/var/lib/omarchy/mac-first-boot/encrypt-pending"
  printf 'GRUB_CMDLINE_LINUX=""\n' >"$mnt/@/etc/default/grub"
  printf 'UUID=4f4d5801-524f-4f54-8000-000000000001 / btrfs subvol=@,x-systemd.growfs 0 0\n' \
    >"$mnt/@/etc/fstab"
  printf 'payload-one\n' >"$mnt/@/root/one"
  dd if=/dev/urandom of="$mnt/@/root/blob" bs=1M count=4 status=none
  cat >"$mnt/@/usr/bin/update-grub" <<'STUB'
#!/bin/bash
echo "update-grub $*" >>/var/lib/omarchy/mac-first-boot/boot.log
STUB
  cat >"$mnt/@/usr/bin/mkinitcpio" <<'STUB'
#!/bin/bash
echo "mkinitcpio $*" >>/var/lib/omarchy/mac-first-boot/boot.log
STUB
  chmod 755 "$mnt/@/usr/bin/update-grub" "$mnt/@/usr/bin/mkinitcpio"
}

hash_tree() {
  local mnt=$1
  (cd "$mnt/root" && sha256sum one blob | sort)
}

run_hook() {
  local root_dev=$1 esp_mnt=$2
  case_dir=$tmp/run
  mkdir -p "$case_dir"
  cryptsetup close root 2>/dev/null || true
  OMARCHY_MAC_ENCRYPT_ROOT="$root_dev" OMARCHY_MAC_ENCRYPT_ESP="$esp_mnt" \
    bash "$HOOK" >"$case_dir/out" 2>&1
}

make_esp
esp_mnt=$ESP_MNT
printf 'format=1\nencrypt=0\n' >"$esp_mnt/omarchy/install.conf"
dd if=/dev/zero of="$tmp/plain0.img" bs=1M count=128 status=none
mkfs.btrfs -q -L omarchy-root "$tmp/plain0.img"
plain0=$(attach_loop "$tmp/plain0.img")
mkdir -p "$tmp/mnt-plain0"
mount "$plain0" "$tmp/mnt-plain0"
populate_root "$tmp/mnt-plain0"
umount "$tmp/mnt-plain0"
run_hook "$plain0" "$esp_mnt" || fail "encrypt=0 should succeed as a no-op"
[[ $(blkid -o value -s TYPE "$plain0") == btrfs ]] || fail "encrypt=0 left the filesystem as btrfs"
grep -Fq 'encrypt=0' "$case_dir/out" || fail "encrypt=0 named the skip"
echo 'ok - encrypt=0 does nothing'
detach_loop "$plain0"

dd if=/dev/zero of="$tmp/luks.img" bs=1M count=128 status=none
luks_loop=$(attach_loop "$tmp/luks.img")
dd if=/dev/urandom of="$tmp/luks.key" bs=64 count=1 status=none
cryptsetup luksFormat --type luks2 --batch-mode --key-file "$tmp/luks.key" "$luks_loop"
luks_uuid=$(cryptsetup luksUUID "$luks_loop")
printf 'format=1\nencrypt=1\n' >"$esp_mnt/omarchy/install.conf"
cp "$tmp/luks.key" "$esp_mnt/omarchy/luks-key"
run_hook "$luks_loop" "$esp_mnt" || fail "already-LUKS should succeed as a no-op"
[[ $(cryptsetup luksUUID "$luks_loop") == "$luks_uuid" ]] || fail "already-LUKS must not reformat"
grep -Fq 'already LUKS' "$case_dir/out" || fail "already-LUKS named the skip"
echo 'ok - already-LUKS does nothing'
detach_loop "$luks_loop"

dd if=/dev/zero of="$tmp/root.img" bs=1M count=384 status=none
mkfs.btrfs -q "$tmp/root.img"
root_loop=$(attach_loop "$tmp/root.img")
mkdir -p "$tmp/mnt-root"
mount "$root_loop" "$tmp/mnt-root"
populate_root "$tmp/mnt-root"
before=$(hash_tree "$tmp/mnt-root/@")
fs_before=$(findmnt -bno SIZE "$tmp/mnt-root")
umount "$tmp/mnt-root"
rm -f "$esp_mnt/omarchy/install.conf" "$esp_mnt/omarchy/luks-key"
start=$(date +%s)
run_hook "$root_loop" "$esp_mnt" || fail "plain to LUKS conversion"
end=$(date +%s)
[[ $(blkid -o value -s TYPE "$root_loop") == crypto_LUKS ]] || fail "the partition is now crypto_LUKS"
elapsed=$((end - start))
[[ -e /dev/mapper/root ]] || fail "the mapping is left open as root"
mkdir -p "$tmp/mnt-mapped"
mount -o subvol=@ /dev/mapper/root "$tmp/mnt-mapped"
after=$(hash_tree "$tmp/mnt-mapped")
[[ $before == "$after" ]] || fail "sha256 of files before/after conversion must match"
[[ ! -e $tmp/mnt-mapped/var/lib/omarchy/mac-first-boot/encrypt-pending ]] ||
  fail "encrypt-pending is removed after a successful conversion"
[[ $(stat -c %a "$tmp/mnt-mapped/var/lib/omarchy/provisioning/luks-key") == 600 ]] ||
  fail "provisioning luks-key is 0600"
[[ $(stat -c %s "$esp_mnt/omarchy/luks-key") == 64 ]] || fail "the ESP key is 64 bytes"
[[ $(sha256sum "$esp_mnt/omarchy/luks-key" | awk '{print $1}') == \
     $(sha256sum "$tmp/mnt-mapped/var/lib/omarchy/provisioning/luks-key" | awk '{print $1}') ]] ||
  fail "both copies of the throwaway key match"
luks_uuid=$(cryptsetup luksUUID "$root_loop")
grep -Fxq "root UUID=$luks_uuid none luks" "$tmp/mnt-mapped/etc/crypttab" ||
  fail "crypttab names the LUKS UUID"
grep -Fq "rd.luks.name=${luks_uuid}=root" "$tmp/mnt-mapped/etc/default/grub" &&
  grep -Fq 'root=/dev/mapper/root' "$tmp/mnt-mapped/etc/default/grub" &&
  grep -Fq "rd.luks.key=${luks_uuid}=/omarchy/luks-key:UUID=$ESP_UUID" "$tmp/mnt-mapped/etc/default/grub" ||
  fail "GRUB_CMDLINE_LINUX switches to the mapper and the ESP key"
grep -Fxq 'update-grub ' "$tmp/mnt-mapped/var/lib/omarchy/mac-first-boot/boot.log" ||
  fail "update-grub ran inside the opened root"
grep -Fxq 'mkinitcpio -P' "$tmp/mnt-mapped/var/lib/omarchy/mac-first-boot/boot.log" ||
  fail "mkinitcpio -P ran inside the opened root"
grep -Fq 'x-systemd.growfs' "$tmp/mnt-mapped/etc/fstab" || fail "x-systemd.growfs stays on the root fstab"
fs_after=$(findmnt -bno SIZE "$tmp/mnt-mapped")
(( fs_after <= fs_before - REDUCE_BYTES + 1048576 )) || fail "btrfs was shrunk by 32 MiB and not grown back"
cryptsetup status root >/dev/null || fail "the LUKS mapping is active"
map_bytes=$(cryptsetup status root | awk '/^ *size:/ { print $2 * 512; exit }')
(( map_bytes > fs_after )) || fail "cryptsetup resize grew LUKS past the shrunk btrfs (partition → LUKS → btrfs growfs)"
umount "$tmp/mnt-mapped"
throughput=$(awk -v b=384 -v t="$elapsed" 'BEGIN { if (t < 1) t = 1; printf "%.1f", b / t }')
hook_tp=$(sed -n 's/.*conversion finished in [0-9]*s (\([0-9]*\) MiB\/s).*/\1/p' "$case_dir/out" | tail -n 1)
echo "ok - plain → LUKS conversion keeps data (sha256) and growfs order; ${elapsed}s, ${throughput} MiB/s wall, hook ${hook_tp:-?} MiB/s"
printf 'throughput=%s MiB/s elapsed=%ss image=384MiB hook=%s\n' "$throughput" "$elapsed" "${hook_tp:-unknown}"

run_hook "$root_loop" "$esp_mnt" || fail "a second run after conversion should no-op"
grep -Fq 'already LUKS' "$case_dir/out" || fail "a finished LUKS root is left to sd-encrypt"
echo 'ok - a finished conversion is not encrypted again'

cryptsetup close root 2>/dev/null || true
dd if=/dev/zero of="$tmp/resume.img" bs=1M count=512 status=none
mkfs.btrfs -q "$tmp/resume.img"
resume_loop=$(attach_loop "$tmp/resume.img")
mkdir -p "$tmp/mnt-resume"
mount "$resume_loop" "$tmp/mnt-resume"
populate_root "$tmp/mnt-resume"
resume_before=$(hash_tree "$tmp/mnt-resume/@")
umount "$tmp/mnt-resume"
rm -f "$esp_mnt/omarchy/luks-key"
mkdir -p "$tmp/run"
OMARCHY_MAC_ENCRYPT_ROOT="$resume_loop" OMARCHY_MAC_ENCRYPT_ESP="$esp_mnt" \
  bash "$HOOK" >"$tmp/run/out" 2>&1 &
hook_pid=$!
interrupted=0
for _ in $(seq 1 200); do
  if cryptsetup isLuks "$resume_loop" 2>/dev/null; then
    sleep 0.4
    if pkill -TERM -f '[c]ryptsetup reencrypt' 2>/dev/null; then
      interrupted=1
    fi
    break
  fi
  kill -0 "$hook_pid" 2>/dev/null || break
  sleep 0.1
done
wait "$hook_pid" || true
if [[ $interrupted == 1 ]] || cryptsetup luksDump "$resume_loop" 2>/dev/null | grep -qi reencrypt; then
  echo "ok - conversion was interrupted with a LUKS2 header (resumable)"
else
  echo "ok - conversion finished before SIGTERM; second run still has to be idempotent"
fi
case_dir=$tmp/run
cryptsetup close root 2>/dev/null || true
OMARCHY_MAC_ENCRYPT_ROOT="$resume_loop" OMARCHY_MAC_ENCRYPT_ESP="$esp_mnt" \
  bash "$HOOK" >"$case_dir/out" 2>&1 || { cat "$case_dir/out" >&2; fail "resume after interruption"; }
[[ $(blkid -c /dev/null -o value -s TYPE "$resume_loop") == crypto_LUKS ]] || fail "resumed device is LUKS"
[[ -e /dev/mapper/root ]] || cryptsetup open --batch-mode --key-file "$esp_mnt/omarchy/luks-key" --keyfile-size 64 "$resume_loop" root ||
  fail "could not open the resumed LUKS volume"
mkdir -p "$tmp/mnt-resume2"
mount -o subvol=@ /dev/mapper/root "$tmp/mnt-resume2"
[[ $(hash_tree "$tmp/mnt-resume2") == "$resume_before" ]] || fail "sha256 after resume matches the pre-encrypt files"
[[ ! -e $tmp/mnt-resume2/var/lib/omarchy/mac-first-boot/encrypt-pending ]] || fail "resume removes encrypt-pending"
umount "$tmp/mnt-resume2"
echo 'ok - rerun after an interruption resumes and keeps data intact'
