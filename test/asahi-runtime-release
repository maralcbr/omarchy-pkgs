#!/bin/bash
# bin/asahi-runtime-release keeps its command line as the fast lane of
# bin/asahi-release; test/asahi-release covers the lane itself.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cp "$ROOT/bin/asahi-runtime-release" "$work/asahi-runtime-release"
cat >"$work/asahi-release" <<'STUB'
#!/bin/bash
printf '%s\n' "$*"
STUB
chmod +x "$work/asahi-release"
commit=$(printf 'a%.0s' {1..40})

[[ $(bash "$work/asahi-runtime-release" --dry-run "$commit") == "--runtime-only --dry-run $commit" ]] ||
  { echo "not ok - the runtime lane does not hand its arguments to asahi-release" >&2; exit 1; }
[[ $(bash "$work/asahi-runtime-release" "$commit") == "--runtime-only $commit" ]] ||
  { echo "not ok - the runtime lane does not run asahi-release in runtime-only mode" >&2; exit 1; }
echo "ok - the runtime lane runs asahi-release in runtime-only mode with its own arguments"

if bash "$work/asahi-runtime-release" --help 2>"$work/help"; then echo "not ok - --help exits 0" >&2; exit 1; fi
grep -Fq 'asahi-runtime-release [--dry-run] OMARCHY_MX_MAC_COMMIT' "$work/help" ||
  { echo "not ok - --help does not print the usage" >&2; exit 1; }
echo "ok - the runtime lane still prints its usage"

grep -Fq 'not a runtime-only change' "$ROOT/bin/asahi-release" ||
  { echo "not ok - runtime-only mode does not refuse repository rebuilds" >&2; exit 1; }
grep -Fq 'mode=incremental' "$ROOT/bin/asahi-release" && grep -Fq 'promote-asahi-quattro-runtime.yml' "$ROOT/bin/asahi-release" ||
  { echo "not ok - the release command does not chain candidate and channel" >&2; exit 1; }
echo "ok - the lane refuses repository rebuilds and chains candidate to channel"
