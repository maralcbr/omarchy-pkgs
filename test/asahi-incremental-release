#!/bin/bash

set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
repo=$tmp/repo
mkdir -p "$repo/bin" "$repo/pkgbuilds"
cp "$ROOT/bin/asahi-incremental-plan" "$repo/bin/"
cp "$ROOT/pkgbuilds/asahi-repository-sources" "$ROOT/pkgbuilds/asahi-repository-packages" "$ROOT/pkgbuilds/asahi-source-outputs" "$ROOT/pkgbuilds/asahi-planner-classes" "$repo/pkgbuilds/"
while read -r source; do mkdir -p "$repo/pkgbuilds/$source"; echo fixture >"$repo/pkgbuilds/$source/PKGBUILD"; done <"$repo/pkgbuilds/asahi-repository-sources"
mkdir -p "$repo/pkgbuilds"/{omarchy-dev,omarchy-settings-dev,omarchy-keyring,omarchy-nvim,quickshell-git,ttf-jetbrains-mono-nerd-basic}
echo source >"$repo/pkgbuilds/omarchy-source.conf"
git init -q "$repo"
git -C "$repo" config user.name Test
git -C "$repo" config user.email test@example.com
git -C "$repo" add .
git -C "$repo" commit -qm baseline
before=$(git -C "$repo" rev-parse HEAD)
echo changed >>"$repo/pkgbuilds/libretro-vice-git/PKGBUILD"
git -C "$repo" add .
git -C "$repo" commit -qm change
after=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$before" --current-package-commit "$after" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/plan.json"
[[ $(jq -r .effective_mode "$tmp/plan.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/plan.json") == 10 ))
jq -e '.rebuilt_packages|index("libretro-vice-x64-git")' "$tmp/plan.json" >/dev/null

# The Aurora kernel lane lives beside the repository, not in it: a change there
# must not push the next runtime release into a full rebuild.
mkdir -p "$repo/pkgbuilds/linux-aurora"
echo kernel >"$repo/pkgbuilds/linux-aurora/PKGBUILD"
echo toolchain >"$repo/pkgbuilds/linux-aurora/rust-toolchain.toml"
printf 'linux-aurora\n' >"$repo/pkgbuilds/aurora-repository-packages"
printf 'linux-aurora|linux-aurora\n' >"$repo/pkgbuilds/aurora-source-outputs"
echo descriptor >"$repo/bin/aurora-package-descriptor"
git -C "$repo" add .
git -C "$repo" commit -qm aurora
aurora=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$after" --current-package-commit "$aurora" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/aurora.json"
[[ $(jq -r .effective_mode "$tmp/aurora.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/aurora.json") == 0 ))
after=$aurora
echo 'ok - the Aurora lane does not invalidate the repository'

mkdir -p "$repo/pkgbuilds/linux-aurora-edge/.omarchy"
echo kernel >"$repo/pkgbuilds/linux-aurora-edge/PKGBUILD"
echo patch >"$repo/pkgbuilds/linux-aurora-edge/0003-drm-apple-release-stale-dptx-link.patch"
echo list >"$repo/pkgbuilds/linux-aurora-edge/patches"
echo '{}' >"$repo/pkgbuilds/linux-aurora-edge/.omarchy/package.json"
echo pin >"$repo/bin/aurora-edge-pin-recipe"
echo verify >"$repo/bin/aurora-verify-edge-release"
echo source >"$repo/bin/aurora-edge-source"
echo digest >"$repo/bin/aurora-kernel-input-digest"
git -C "$repo" add .
git -C "$repo" commit -qm aurora-edge
aurora_edge=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$after" --current-package-commit "$aurora_edge" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/aurora-edge.json"
[[ $(jq -r .effective_mode "$tmp/aurora-edge.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/aurora-edge.json") == 0 ))
after=$aurora_edge
echo 'ok - the Aurora edge lane does not invalidate the repository'

# Tools that promote and publish a candidate never run inside a package build.
for tool in asahi-release asahi-runtime-release promote-asahi-package-candidate publish-asahi-packages-channel publish-asahi-channel-pointer asahi-verify-packages-channel; do
  echo "$tool" >"$repo/bin/$tool"
done
git -C "$repo" add .
git -C "$repo" commit -qm operator-tools
operator=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$after" --current-package-commit "$operator" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/operator.json"
[[ $(jq -r .effective_mode "$tmp/operator.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/operator.json") == 0 ))
echo 'ok - promotion and publishing tools do not invalidate the repository'

# The bootstrap image lane installs published packages and builds none.
mkdir -p "$repo/apple-bootstrap"
for tool in build-apple-bootstrap apple-bootstrap-inputs apple-bootstrap-check; do
  echo "$tool" >"$repo/bin/$tool"
done
echo icon >"$repo/apple-bootstrap/omarchy-volume.icns"
git -C "$repo" add .
git -C "$repo" commit -qm bootstrap
bootstrap=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$operator" --current-package-commit "$bootstrap" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/bootstrap.json"
[[ $(jq -r .effective_mode "$tmp/bootstrap.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/bootstrap.json") == 0 ))
echo 'ok - the bootstrap image lane does not invalidate the repository'
operator=$bootstrap

echo tool >"$repo/bin/asahi-new-tool"
git -C "$repo" add .
git -C "$repo" commit -qm unclassified
unclassified=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$operator" --current-package-commit "$unclassified" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/unclassified.json"
[[ $(jq -r .effective_mode "$tmp/unclassified.json") == "full" ]]
[[ $(jq -r .fallback_reason "$tmp/unclassified.json") == "unclassified package repository change: bin/asahi-new-tool" ]]
echo 'ok - any other bin change still takes a full rebuild'

# A new operator script listed only in the none-class table, with no planner
# code change, does not rebuild. Appending that line is itself none.
echo 'bin/asahi-listed-tool|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
echo tool >"$repo/bin/asahi-listed-tool"
git -C "$repo" add .
git -C "$repo" commit -qm listed-tool
listed=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$unclassified" --current-package-commit "$listed" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/listed.json"
[[ $(jq -r .effective_mode "$tmp/listed.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/listed.json") == 0 ))
echo 'ok - a new operator script listed only in the none-class table does not rebuild'

echo 'bin/asahi-future-tool|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-append
appended=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$listed" --current-package-commit "$appended" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/appended.json"
[[ $(jq -r .effective_mode "$tmp/appended.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/appended.json") == 0 ))
echo 'ok - appending to the none-class table does not rebuild'

echo 'pkgbuilds/aether/*|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
echo 'bin/build|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
echo 'keys/*|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
echo '.github/workflows/*|operator tool' >>"$repo/pkgbuilds/asahi-planner-classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-shadow
shadowed=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$appended" --current-package-commit "$shadowed" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/shadowed.json"
[[ $(jq -r .effective_mode "$tmp/shadowed.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/shadowed.json") == 0 ))
echo changed >>"$repo/pkgbuilds/aether/PKGBUILD"
git -C "$repo" add .
git -C "$repo" commit -qm aether-after-shadow
aether_shadow=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$shadowed" --current-package-commit "$aether_shadow" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/aether-shadow.json"
[[ $(jq -r .effective_mode "$tmp/aether-shadow.json") == "incremental" ]]
[[ $(jq -c .rebuilt_packages "$tmp/aether-shadow.json") == '["aether"]' ]]
classify_repo() {
  ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --classify <<<"$1" | cut -d'|' -f2,3
}
actual=$(classify_repo bin/build)
[[ $actual == 'rebuild-all|' ]] || { echo "not ok - bin/build is $actual after a source-matching table row" >&2; exit 1; }
actual=$(classify_repo keys/asahi-repository-signing.asc)
[[ $actual == 'rebuild-all|' ]] || { echo "not ok - keys/* is $actual after a source-matching table row" >&2; exit 1; }
actual=$(classify_repo .github/workflows/release-asahi-package-incremental.yml)
[[ $actual == 'contract|' ]] || { echo "not ok - incremental workflow is $actual after a source-matching table row" >&2; exit 1; }
echo 'ok - a none-class row matching a repository source does not skip that rebuild or shadow contract inputs'
appended=$aether_shadow

classes=$repo/pkgbuilds/asahi-planner-classes
{
  IFS= read -r first
  echo "${first%%|*}|edited reason"
  cat
} <"$classes" >"$tmp/classes.edited"
mv "$tmp/classes.edited" "$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-edit
edited=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$appended" --current-package-commit "$edited" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/edited.json"
[[ $(jq -r .effective_mode "$tmp/edited.json") == "full" ]]
[[ $(jq -r .fallback_reason "$tmp/edited.json") == "incremental release contract changed: pkgbuilds/asahi-planner-classes" ]]
echo 'ok - editing the none-class table takes a full rebuild'

grep -Fxv 'bin/asahi-future-tool|operator tool' "$classes" >"$tmp/classes.removed"
mv "$tmp/classes.removed" "$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-remove
removed=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$edited" --current-package-commit "$removed" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/removed.json"
[[ $(jq -r .effective_mode "$tmp/removed.json") == "full" ]]
[[ $(jq -r .fallback_reason "$tmp/removed.json") == "incremental release contract changed: pkgbuilds/asahi-planner-classes" ]]
echo 'ok - removing a none-class table line takes a full rebuild'

echo 'not a class entry' >>"$classes"
status=0
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$removed" --current-package-commit "$removed" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/malformed.json" >/dev/null 2>"$tmp/malformed.err" || status=$?
(( status != 0 ))
grep -Fq 'Malformed none-class table line: not a class entry' "$tmp/malformed.err"
git -C "$repo" checkout -q -- pkgbuilds/asahi-planner-classes
echo 'ok - a malformed none-class table line fails closed'

truncate -s -1 "$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-unterminated
unterminated=$(git -C "$repo" rev-parse HEAD)
printf ' tool\n' >>"$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-extend-last-line
extended=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$unterminated" --current-package-commit "$extended" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/unterminated.json"
[[ $(jq -r .effective_mode "$tmp/unterminated.json") == "full" ]]
[[ $(jq -r .fallback_reason "$tmp/unterminated.json") == "incremental release contract changed: pkgbuilds/asahi-planner-classes" ]]
echo 'ok - extending an unterminated none-class table line takes a full rebuild'

# A last reason ending in the letter n must not pass for a newline.
printf 'bin/n-tool|written by n' >>"$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-ends-in-n
ends_in_n=$(git -C "$repo" rev-parse HEAD)
printf ' edited\n' >>"$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-extend-n-line
extended_n=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$ends_in_n" --current-package-commit "$extended_n" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/ends-in-n.json"
[[ $(jq -r .effective_mode "$tmp/ends-in-n.json") == "full" ]]
echo 'ok - extending a none-class line whose reason ends in n takes a full rebuild'

tac "$classes" >"$tmp/classes.reordered"
mv "$tmp/classes.reordered" "$classes"
git -C "$repo" add .
git -C "$repo" commit -qm classes-reorder
reordered=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$extended" --current-package-commit "$reordered" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/reordered.json"
[[ $(jq -r .effective_mode "$tmp/reordered.json") == "full" ]]
[[ $(jq -r .fallback_reason "$tmp/reordered.json") == "incremental release contract changed: pkgbuilds/asahi-planner-classes" ]]
echo 'ok - reordering the none-class table takes a full rebuild'

git -C "$repo" rm -q pkgbuilds/asahi-planner-classes
git -C "$repo" commit -qm classes-absent
absent=$(git -C "$repo" rev-parse HEAD)
cp "$ROOT/pkgbuilds/asahi-planner-classes" "$repo/pkgbuilds/"
git -C "$repo" add pkgbuilds/asahi-planner-classes
git -C "$repo" commit -qm classes-first
first=$(git -C "$repo" rev-parse HEAD)
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$absent" --current-package-commit "$first" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/first.json"
[[ $(jq -r .effective_mode "$tmp/first.json") == "incremental" ]]
(( $(jq '.rebuilt_packages|length' "$tmp/first.json") == 0 ))
echo 'ok - adding the none-class table for the first time does not rebuild'

runtime=1111111111111111111111111111111111111111
# Commits a change to one path and plans it against the commit before.
plan_change() {
  local path=$1 previous
  previous=$(git -C "$repo" rev-parse HEAD)
  mkdir -p "$(dirname "$repo/$path")"
  echo change >>"$repo/$path"
  git -C "$repo" add -A
  git -C "$repo" commit -qm "change $path"
  ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$previous" --current-package-commit "$(git -C "$repo" rev-parse HEAD)" --previous-runtime-commit "$runtime" --current-runtime-commit "$runtime" --output "$tmp/change.json"
}

# Paths that forced published candidates into full rebuilds although no
# candidate build reads them (docs/asahi-planner-replay.md).
for path in pkgbuilds/cursor-bin/PKGBUILD pkgbuilds/claude-code/.omarchy/package.json pkgbuilds/1password-beta/PKGBUILD \
  bin/install-asahi-quattro bin/apple-image-parity-capture bin/asahi-package-retention-plan bin/verify-asahi-runtime-version \
  bin/asahi-release-controller bin/asahi-cache bin/stage-arm64-iso-r2 bin/reuse-asahi-package controller/native-build-iso; do
  plan_change "$path"
  [[ $(jq -r .effective_mode "$tmp/change.json") == "incremental" ]] || { echo "not ok - $path forced a full rebuild" >&2; exit 1; }
  (( $(jq '.rebuilt_packages|length' "$tmp/change.json") == 0 ))
done
echo 'ok - replayed fallbacks from inputs no candidate build reads plan no rebuild'

plan_change pkgbuilds/omarchy-source.conf
[[ $(jq -c .rebuilt_packages "$tmp/change.json") == '["omarchy-dev","omarchy-settings-dev"]' ]]
echo 'ok - the runtime source pin rebuilds only the source pair'

# Planning, assembly and verification changes stay fail-closed even when they
# leave package bytes alone, as do builder, toolchain and signing trust inputs.
for path in bin/asahi-incremental-plan bin/asahi-verify-candidate bin/asahi-candidate-assemble bin/asahi-candidate-provenance \
  bin/asahi-package-candidate-descriptor bin/asahi-bundle-manifest .github/workflows/release-asahi-package-incremental.yml \
  .github/scripts/verify-asahi-repository-lifecycle.sh bin/build build/build.sh build/pacstrap-docker helpers/package-metadata.sh \
  keys/asahi-repository-signing.asc build/gpg-keys.txt Makefile pkgbuilds/new-definition; do
  plan_change "$path"
  [[ $(jq -r .effective_mode "$tmp/change.json") == "full" ]] || { echo "not ok - $path did not force a full rebuild" >&2; exit 1; }
  [[ $(jq -r .fallback_reason "$tmp/change.json") == *": $path" ]]
  (( $(jq '.reused_packages|length' "$tmp/change.json") == 0 ))
done
echo 'ok - contract, builder, signing trust and unknown inputs still take a full rebuild'

# A directory joins the candidate only through the repository definition.
echo cursor-bin >>"$repo/pkgbuilds/asahi-repository-sources"
echo cursor-bin >>"$repo/pkgbuilds/asahi-repository-packages"
echo 'cursor-bin|cursor-bin' >>"$repo/pkgbuilds/asahi-source-outputs"
plan_change pkgbuilds/cursor-bin/PKGBUILD
[[ $(jq -r .effective_mode "$tmp/change.json") == "full" ]]
jq -e '.rebuilt_packages|index("cursor-bin")' "$tmp/change.json" >/dev/null
echo 'ok - a directory that joins the repository sources rebuilds everything'
after=$(git -C "$repo" rev-parse HEAD)

echo shared >"$repo/pkgbuilds/asahi-repository-packages"
git -C "$repo" add .
git -C "$repo" commit -qm shared
latest=$(git -C "$repo" rev-parse HEAD)
status=0
ASAHI_PACKAGE_ROOT="$repo" "$ROOT/bin/asahi-incremental-plan" --mode incremental --previous-package-commit "$after" --current-package-commit "$latest" --previous-runtime-commit 1111111111111111111111111111111111111111 --current-runtime-commit 1111111111111111111111111111111111111111 --output "$tmp/fallback.json" >/dev/null 2>&1 || status=$?
(( status != 0 ))
echo 'ok - planner maps split outputs and fails closed on invalid repository definitions'

cache=$tmp/cache
printf cache-object >"$tmp/object"
key=$(sha256sum "$tmp/object" | cut -d' ' -f1)
"$ROOT/bin/asahi-cache" put "$cache" "$key" "$tmp/object"
"$ROOT/bin/asahi-cache" get "$cache" "$key" "$tmp/restored"
cmp "$tmp/object" "$tmp/restored"
chmod u+w "$cache/objects/$key"
printf corrupt >>"$cache/objects/$key"
status=0; "$ROOT/bin/asahi-cache" get "$cache" "$key" "$tmp/bad" >/dev/null 2>&1 || status=$?
(( status == 1 ))
echo 'ok - content-addressed cache verifies objects on read'
