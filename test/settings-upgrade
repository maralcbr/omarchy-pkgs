#!/bin/bash

set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
config_dir="$tmp/etc/sddm.conf.d"
config="$config_dir/10-wayland.conf"
mkdir -p "$config_dir"

source "$ROOT/pkgbuilds/omarchy-settings-dev/omarchy-settings-dev.install"

write_old_config() {
  cat >"$config" <<'EOF'
[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.conf
EOF
}

write_old_config
cp "$config" "$config.pacnew"
OMARCHY_SETTINGS_ROOT="$tmp" _sddm_config_upgrade
grep -Fxq 'CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua' "$config"
[[ ! -e $config.pacnew ]]
echo "ok - upgrades the known obsolete SDDM config"

write_old_config
printf '%s\n' '# Local customization' >>"$config"
cp "$config" "$tmp/customized"
cp "$config" "$config.pacnew"
OMARCHY_SETTINGS_ROOT="$tmp" _sddm_config_upgrade
cmp "$config" "$tmp/customized"
[[ -e $config.pacnew ]]
echo "ok - preserves customized SDDM config"

fastfetch_dir="$tmp/etc/fastfetch"
fastfetch_config="$fastfetch_dir/config.jsonc"
mkdir -p "$fastfetch_dir"

printf '%s\n' '"text": "version=$(omarchy-version) && echo \"Omarchy $version\""' >"$fastfetch_config"
printf '%s\n' '"text": "version=$(omarchy-version) && echo \"Omarchy Mx Mac $version\""' >"$fastfetch_config.pacnew"
OMARCHY_SETTINGS_ROOT="$tmp" _fastfetch_branding_upgrade
cmp "$fastfetch_config" <(printf '%s\n' '"text": "version=$(omarchy-version) && echo \"Omarchy Mx Mac $version\""')
[[ ! -e $fastfetch_config.pacnew ]]
echo "ok - upgrades system About branding"

printf '%s\n' '"text": "echo \"My custom system\""' >"$fastfetch_config"
cp "$fastfetch_config" "$tmp/custom-fastfetch"
printf '%s\n' '"text": "version=$(omarchy-version) && echo \"Omarchy Mx Mac $version\""' >"$fastfetch_config.pacnew"
OMARCHY_SETTINGS_ROOT="$tmp" _fastfetch_branding_upgrade
cmp "$fastfetch_config" "$tmp/custom-fastfetch"
[[ -e $fastfetch_config.pacnew ]]
echo "ok - preserves customized system About branding"

# Apple Silicon keeps Arch Linux ARM's system configuration but not its bash
# skeleton: accounts created from /etc/skel get the Omarchy ~/.bashrc.
skel_root="$tmp/skel-root"
mkdir -p "$skel_root/usr/share/omarchy/etc-overrides"
printf '%s\n' '# Omarchy bashrc' >"$skel_root/usr/share/omarchy/etc-overrides/dot.bashrc"
(
  # Pretend to be an Apple Silicon Mac and record, rather than make, the
  # os-release change the Apple branch makes to the live system.
  uname() { echo aarch64; }
  grep() { [[ ${*: -1} == /proc/device-tree/compatible ]] && return 0; command grep "$@"; }
  rm() { echo "rm $*" >>"$tmp/apple-calls"; }
  ln() { echo "ln $*" >>"$tmp/apple-calls"; }
  cp() { echo "cp $*" >>"$tmp/apple-calls"; }
  OMARCHY_SETTINGS_ROOT="$skel_root" _etc_overrides_apply >/dev/null
)
cmp "$skel_root/etc/skel/.bashrc" "$skel_root/usr/share/omarchy/etc-overrides/dot.bashrc"
[[ $(stat -c %a "$skel_root/etc/skel/.bashrc" 2>/dev/null || stat -f %Lp "$skel_root/etc/skel/.bashrc") == 644 ]]
! command grep -q '^cp ' "$tmp/apple-calls" 2>/dev/null
echo "ok - Apple Silicon gets the Omarchy bash skeleton and keeps the rest of ALARM's configuration"

printf '%s\n' '# Omarchy bashrc, updated' >"$skel_root/usr/share/omarchy/etc-overrides/dot.bashrc"
OMARCHY_SETTINGS_ROOT="$skel_root" _skel_bashrc_apply
cmp "$skel_root/etc/skel/.bashrc" "$skel_root/usr/share/omarchy/etc-overrides/dot.bashrc"
rm -f "$skel_root/usr/share/omarchy/etc-overrides/dot.bashrc"
OMARCHY_SETTINGS_ROOT="$skel_root" _skel_bashrc_apply
command grep -Fxq '# Omarchy bashrc, updated' "$skel_root/etc/skel/.bashrc"
echo "ok - the bash skeleton follows the package on upgrade and waits for its source"
