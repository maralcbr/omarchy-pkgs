#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

commit=1111111111111111111111111111111111111111
fingerprint=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
tag=aurora-packages-$commit

make_package() {
  local package=$1
  local architecture=$2
  printf 'pkgname = %s\npkgver = 1.2.3-1\narch = %s\n' "$package" "$architecture" >"$tmp/.PKGINFO"
  bsdtar -cf "$tmp/repository/$package-1.2.3-1-$architecture.pkg.tar.zst" -C "$tmp" .PKGINFO
  printf 'signature-%s\n' "$package" >"$tmp/repository/$package-1.2.3-1-$architecture.pkg.tar.zst.sig"
}

mkdir "$tmp/repository"
printf 'linux-aurora\nlinux-aurora-headers\n' >"$tmp/packages"
make_package linux-aurora aarch64
make_package linux-aurora-headers aarch64
for asset in omarchy-aurora.db omarchy-aurora.db.sig omarchy-aurora.files omarchy-aurora.files.sig; do
  printf '%s\n' "$asset" >"$tmp/repository/$asset"
done

descriptor=$($ROOT/bin/aurora-package-descriptor \
  "$tmp/repository" "$tag" "$commit" "$fingerprint" 42 "$tmp/packages")

grep -Fxq 'format=1' <<<"$descriptor"
grep -Fxq 'channel=aurora' <<<"$descriptor"
grep -Fxq "release_tag=$tag" <<<"$descriptor"
grep -Fxq "source_commit=$commit" <<<"$descriptor"
grep -Fxq "signing_fingerprint=$fingerprint" <<<"$descriptor"
grep -Fxq 'package_count=2' <<<"$descriptor"
[[ $(grep -c '^package=' <<<"$descriptor") == 2 ]]
[[ $(grep -c '^asset=' <<<"$descriptor") == 4 ]]

# A candidate tag from the Asahi lane must not pass as an Aurora release.
if $ROOT/bin/aurora-package-descriptor \
  "$tmp/repository" "asahi-packages-candidate-$commit" "$commit" "$fingerprint" 42 \
  "$tmp/packages" >/dev/null 2>&1; then
  echo 'not ok - descriptor accepted an Asahi candidate tag'
  exit 1
fi

rm "$tmp/repository/linux-aurora-headers-1.2.3-1-aarch64.pkg.tar.zst.sig"
if $ROOT/bin/aurora-package-descriptor \
  "$tmp/repository" "$tag" "$commit" "$fingerprint" 42 "$tmp/packages" >/dev/null 2>&1; then
  echo 'not ok - descriptor accepted a missing signature'
  exit 1
fi

echo 'ok - aurora descriptor binds the complete signed kernel release'
