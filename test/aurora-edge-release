  packages_commit=$(printf 'e%.0s' {1..40})
  echo "ok - $description is refused"
done

# ── gate edge ──────────────────────────────────────────────────────────────
gate_field() { sed -n "s/^$1=//p" "$case_dir/output"; }

expect_gate() {
  [[ $(gate_field build) == "$1" ]] && gate_field reason | grep -Fq -- "$2" ||
    fail "$description: expected build=$1 because '$2'"
}

digest_a=$(sha "$fixtures/staged/INPUTS")
make_edge "$tmp/other-builder" 5 7.1.12.aurora2.5-1 "$builder_b"
digest_b=$(sha "$tmp/other-builder/INPUTS")
[[ $digest_a != "$digest_b" ]] || fail 'fixture builds in two builders have two digests'

description='edge gate'
new_case gate-same
publish_edge 4 7.1.12.aurora2.4-1 false "$builder_a"
expect_success verify gate edge "$digest_a"
expect_gate false 'nothing new: aurora-edge-4 was built from the same inputs'
[[ $(gate_field previous_release) == aurora-edge-4 && $(gate_field previous_input_digest) == "$digest_a" ]] ||
  fail "$description: names the release it matched"
grep -Eq "gh release download aurora-edge-4 .*--pattern AURORA --pattern AURORA.sig$" "$case_dir/log" ||
  fail "$description: reads only the descriptor"
expect_success verify gate edge "$digest_b"
expect_gate true 'the inputs changed since aurora-edge-4'
echo "ok - $description has nothing new only when the latest edge release records the same input digest"

new_case gate-force
publish_edge 4 7.1.12.aurora2.4-1 false "$builder_a"
expect_success verify gate edge "$digest_a" --force
expect_gate true 'forced: builds a new edge sequence'
[[ ! -s $case_dir/log ]] || fail "$description: a forced gate looked at releases"
echo "ok - $description with force always builds, as a new sequence"

new_case gate-numeric
publish_edge 9 7.1.12.aurora2.9-1 false "$builder_b"
publish_edge 10 7.1.12.aurora2.10-1 false "$builder_a"
add_release aurora-edge-11 true
expect_success verify gate edge "$digest_a"
expect_gate false 'aurora-edge-10 was built from the same inputs'
echo "ok - $description compares with the highest published sequence, not a draft or the last in text order"

for variant in none legacy unverified prerelease mutable listing; do
  new_case "gate-$variant"
  case $variant in
    none) jq 'map(select(.tag_name != "aurora-edge-3"))' "$state/releases.json" >"$state/releases.next"
      mv "$state/releases.next" "$state/releases.json"; message='no edge release is published yet' ;;
    legacy) message='aurora-edge-3 records no input digest' ;;
    unverified) publish_edge 4 7.1.12.aurora2.4-1 false "$builder_a"; resign "$(edge_dir 4)" "$rogue_key"
      message='aurora-edge-4 does not verify (signature verification failed for AURORA in aurora-edge-4)' ;;
    prerelease) publish_edge 4 7.1.12.aurora2.4-1 true "$builder_a"; message='aurora-edge-4 does not verify' ;;
    mutable) publish_edge 4 7.1.12.aurora2.4-1 false "$builder_a"; update_release aurora-edge-4 '.immutable = false'
      message='aurora-edge-4 does not verify' ;;
    listing) echo 'not json' >"$state/releases.json"; message='could not be listed' ;;
  esac
  expect_success verify gate edge "$digest_a"
  expect_gate true "$message"
done
echo "ok - $description builds when there is no edge release, it records no digest, or it cannot be listed or verified"

# ── gate rc ────────────────────────────────────────────────────────────────
new_commit=$(printf '9%.0s' {1..40})
rc_digest_a=$(
  "$ROOT/bin/aurora-kernel-input-digest" rc "$tmp/rc-inputs" --builder-image "$builder_a" --dependencies "$tmp/dependencies" |
    sed -n 's/^input_digest=//p'
)

description='rc gate on a published commit'
new_case gate-rc-published
for arguments in "$rc_commit" "$rc_commit $rc_digest_a" "$rc_commit $rc_digest_a --force"; do
  : >"$case_dir/log"
  # shellcheck disable=SC2086
  expect_success verify gate rc $arguments
  expect_gate false "$rc_tag is already published and verifies; it is never rebuilt"
  [[ $(gate_field published) == true && $(gate_field release_tag) == "$rc_tag" ]] || fail "$description: names the release"
  grep -Fq "gh release download $rc_tag --repo maralcbr/omarchy-pkgs --dir" "$case_dir/log" &&
    ! grep -Eq "gh release download $rc_tag .*--pattern" "$case_dir/log" || fail "$description: verifies every asset"
done
echo "ok - $description only verifies it, with or without a digest or force"

for variant in package-bytes draft git-tag; do
  description="rc gate on a published commit with $variant"
  new_case "gate-rc-published-$variant"
  commit=$rc_commit
  case $variant in
    package-bytes) printf 'x' >>"$state/assets/$rc_tag/$m1n1_file"; sums "$state/assets/$rc_tag"; message="$m1n1_file in $rc_tag does not match AURORA" ;;
    draft) commit=$new_commit; add_release "aurora-packages-$new_commit" true; message="release aurora-packages-$new_commit is not published" ;;
    git-tag) commit=$new_commit; echo "aurora-packages-$new_commit" >>"$state/refs"; message="release aurora-packages-$new_commit is not published" ;;
  esac
  expect_refusal "$message" verify gate rc "$commit" "$rc_digest_a" --force
  ! grep -q '^build=' "$case_dir/output" || fail "$description: decided anyway"
  echo "ok - $description fails instead of building"
done

description='rc gate on a new commit'
new_case gate-rc-new
expect_success verify gate rc "$new_commit"
expect_gate true "aurora-packages-$new_commit is not published yet"
[[ $(gate_field published) == false ]] || fail "$description: not published"
expect_success verify gate rc "$new_commit" "$rc_digest_a"
expect_gate true 'no published aurora-packages release was built from these inputs'
packages_commit=$(printf 'e%.0s' {1..40})
publish_packages "$packages_commit" "$builder_a"
