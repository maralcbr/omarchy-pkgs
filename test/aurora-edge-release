#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "not ok - $1" >&2
  [[ -z ${case_dir:-} || ! -f $case_dir/output ]] || cat "$case_dir/output" >&2
  exit 1
}

sha() { sha256sum "$1" | cut -d' ' -f1; }

# ── recipe ─────────────────────────────────────────────────────────────────
recipe=$ROOT/pkgbuilds/linux-aurora-edge

description='edge recipe'
(cd "$recipe" && sha256sum --check --strict --quiet patches) || fail "$description: listed patches match their checksums"
listed=$(awk '{ print $2 }' "$recipe/patches" | sort)
present=$(cd "$recipe" && ls -- *.patch | sort)
[[ $listed == "$present" ]] || fail "$description: every patch in the recipe is listed, and only those"
cmp -s "$recipe/.omarchy/package.json" "$ROOT/pkgbuilds/linux-aurora/.omarchy/package.json" ||
  fail "$description: stays out of ordinary package publication like linux-aurora"
[[ $(jq -r '.skip_build' "$recipe/.omarchy/package.json") == true ]] || fail "$description: skip_build is set"
mapfile -t values < <(cd "$recipe" && bash -c '
  source PKGBUILD >/dev/null 2>&1
  printf "%s\n" "$pkgbase" "${pkgname[*]}" "$pkgrel" "${epoch:-none}" "${#source[@]}" "${#sha256sums[@]}" "${source[3]}"
')
[[ ${values[0]} == linux-aurora && ${values[1]} == 'linux-aurora linux-aurora-headers' && ${values[2]} == 1 &&
  ${values[3]} == none ]] || fail "$description: builds linux-aurora and linux-aurora-headers at pkgrel 1 without an epoch"
[[ ${values[4]} == $((3 + $(wc -l <"$recipe/patches"))) && ${values[4]} == "${values[5]}" &&
  ${values[6]} == "$(awk 'NR == 1 { print $2 }' "$recipe/patches")" ]] ||
  fail "$description: sources the listed patches with their checksums"
echo "ok - $description applies only its listed, checksummed patches and is never published as a package"

# ── pin ────────────────────────────────────────────────────────────────────
pin=$ROOT/bin/aurora-edge-pin-recipe
commit=abcdef0123456789abcdef0123456789abcdef01
archive_sha=$(printf 'e%.0s' {1..64})

description='pinning the recipe copy'
cp -R "$recipe" "$tmp/recipe"
"$pin" "$tmp/recipe" "$commit" "$archive_sha" 42 >"$tmp/pin.out" || fail "$description: pin failed"
diff "$recipe/PKGBUILD" "$tmp/recipe/PKGBUILD" | grep '^>' >"$tmp/changed" || true
printf '> _commit=%s\n> _edge_sequence=42\n> sha256sums=(%s\n' "$commit" "'$archive_sha'" | cmp -s - "$tmp/changed" ||
  { cat "$tmp/changed" >&2; fail "$description: changes only _commit, _edge_sequence and the archive checksum"; }
(cd "$tmp/recipe" && bash -c 'source PKGBUILD >/dev/null 2>&1; echo "${source[0]}"') |
  grep -Fxq "https://github.com/aurora-silicon/linux/archive/$commit.tar.gz" || fail "$description: source follows the commit"
"$pin" "$tmp/recipe" "$commit" "$archive_sha" 43 >/dev/null || fail "$description: a pinned copy can be pinned again"
grep -Fxq '_edge_sequence=43' "$tmp/recipe/PKGBUILD" || fail "$description: repinning moves the sequence"
echo "ok - $description changes exactly the commit, its archive checksum and the sequence"

description='invalid pins'
for arguments in "$commit $archive_sha 0" "$commit $archive_sha 042" "$commit $archive_sha 1234567890" \
  "${commit^^} $archive_sha 1" "${commit:1} $archive_sha 1" "$commit ${archive_sha:1} 1" "$commit $archive_sha"; do
  cp "$recipe/PKGBUILD" "$tmp/recipe/PKGBUILD"
  # shellcheck disable=SC2086
  if "$pin" "$tmp/recipe" $arguments >/dev/null 2>&1; then fail "$description: '$arguments' was accepted"; fi
  cmp -s "$recipe/PKGBUILD" "$tmp/recipe/PKGBUILD" || fail "$description: '$arguments' changed the recipe"
done
sed 's/^_commit=.*/&\n&/' "$recipe/PKGBUILD" >"$tmp/recipe/PKGBUILD"
if "$pin" "$tmp/recipe" "$commit" "$archive_sha" 1 >"$tmp/pin.out" 2>&1; then fail "$description: a doubled _commit was accepted"; fi
grep -Fq 'does not have exactly one line matching' "$tmp/pin.out" || fail "$description: doubled _commit reported"
sed "s/^sha256sums=('\([0-9a-f]*\)'$/sha256sums=(\n  '\1'/" "$recipe/PKGBUILD" >"$tmp/recipe/PKGBUILD"
if "$pin" "$tmp/recipe" "$commit" "$archive_sha" 1 >/dev/null 2>&1; then fail "$description: a moved archive checksum was accepted"; fi
echo "ok - $description and recipes it cannot pin exactly are refused unchanged"
