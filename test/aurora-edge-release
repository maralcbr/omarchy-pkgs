done
identity_job=$(sed -n '/^  identity:/,/^  signing-check:/p' "$rc_workflow")
grep -Fq 'bin/aurora-verify-edge-release gate rc "$GITHUB_SHA" | tee -a "$GITHUB_OUTPUT"' <<<"$identity_job" &&
  grep -Fq 'build: ${{ steps.identity.outputs.build }}' <<<"$identity_job" ||
  fail "$description: verifies, and never rebuilds, a release its commit already published"
signing_job=$(sed -n '/^  signing-check:/,/^  build:/p' "$rc_workflow")
grep -Fxq '    needs: build' <<<"$signing_job" &&
  grep -Fxq "    if: inputs.publish && needs.build.outputs.build == 'true'" <<<"$signing_job" ||
  fail "$description: asks for the release environment only when the build has something new"
rc_build_job=$(sed -n '/^  build:/,/^  publish:/p' "$rc_workflow")
for expected in '    needs: identity' "    if: needs.identity.outputs.build == 'true'" \
  'bin/aurora-kernel-input-digest dependencies "$image" pkgbuilds/linux-aurora pkgbuilds/m1n1-aurora >/tmp/dependencies' \
  'bin/aurora-kernel-input-digest rc /tmp/inputs/INPUTS --builder-image "$image" --dependencies /tmp/dependencies' \
  'bin/aurora-verify-edge-release gate rc "$GITHUB_SHA" "$(sed -n '"'s/^input_digest=//p'"' /tmp/digest)" "${force[@]}"' \
  'cp /tmp/inputs/INPUTS output/' 'build: ${{ steps.gate.outputs.build }}' \
  'cache-to: type=gha,mode=max,scope=asahi-builder-aarch64-edge-v2'; do
  grep -Fq -- "$expected" <<<"$rc_build_job" || fail "$description: build job has $expected"
done
conditional_after_gate "$rc_build_job" || fail "$description: builds nothing when the gate finds nothing new"
rc_publish_job=$(sed -n '/^  publish:/,$p' "$rc_workflow")
for expected in "needs.build.outputs.build == 'true' }}" '--input-digest "$INPUT_DIGEST" >/tmp/release/AURORA' \
  'AURORA AURORA.sig asahi-repository-signing.asc INPUTS >SHA256SUMS' 'bin/aurora-verify-edge-release packages "$GITHUB_SHA" --complete'; do
  grep -Fq -- "$expected" <<<"$rc_publish_job" || fail "$description: publish job has $expected"
done
echo "ok - $description verifies a published commit, stops when nothing is new, and records the inputs it publishes"

description='pointer repair workflow'
sed -n '/^      kind:/,/^      [a-z_]*:$/p' "$pointer_workflow" | grep -Fxq '          - aurora-edge' &&
  grep -Fxq '          test/aurora-edge-release' "$pointer_workflow" || fail "$description: offers aurora-edge and runs its tests"
echo "ok - $description can republish the edge pointer"
