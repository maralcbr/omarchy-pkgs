#!/bin/bash

set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
workflow=$ROOT/.github/workflows/release-asahi-package-incremental.yml
grep -Fq -- '- signing-check' "$workflow"
grep -Fq -- '- verify' "$workflow"
grep -Fq -- '- incremental' "$workflow"
grep -Fq -- '- full' "$workflow"
grep -Fq 'bin/asahi-verify-candidate' "$workflow"
grep -Fq 'bin/asahi-incremental-plan' "$workflow"
grep -Fq 'bin/asahi-candidate-assemble' "$workflow"
grep -Fq '[[ ! -s $archive.sig ]]' "$workflow"
grep -Fq 'cmp /tmp/release/PROVENANCE.json /tmp/existing/PROVENANCE.json' "$workflow"
grep -Fq 'diff -u /tmp/expected-assets /tmp/actual-assets' "$workflow"
grep -Fq 'cache-from: type=gha,scope=asahi-builder-aarch64-edge-v2' "$workflow"
# Publishing must not inherit the skip that a non-incremental build's
# predecessor job propagates down the needs chain.
grep -Fq "needs.assemble-and-verify.result == 'success'" "$workflow"
grep -Fq "needs.signing-check.result == 'success'" "$workflow"

grep -Fq 'runtime_only=' "$workflow"
grep -Fq 'if [[ $runtime_only != "true" ]]; then' "$workflow"
grep -Fq 'verify-asahi-repository-lifecycle.sh upgrade' "$workflow"
grep -Fq '/tmp/pacman-cache:/var/cache/pacman' "$workflow"
grep -Fq 'actions/cache@' "$workflow"
echo 'ok - a runtime-only candidate is gated by the upgrade lifecycle alone, with a kept package cache'
echo 'ok - workflow exposes four modes, verifies reuse, preserves signatures, gates transactions, and publishes idempotently'
