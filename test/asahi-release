# omarchy-mx-mac main is P (pinned) -> S (a runtime change) -> K (repins the
# Aurora kernel). omarchy-pkgs is C0, with a published candidate on P, its
# stable set, runtime channel 27 and package channel 5; a full world adds C1,
# a hyprland recipe change.
new_world() {
  local mx pkgs
  FAKE=$tmp/$1
  export FAKE
  mx=$FAKE/mx-work
  pkgs=$FAKE/pkgs-work
  mkdir -p "$FAKE"/{releases,pointers,runs,hosts,controller}
  git init -q -b main "$mx"
  mkdir -p "$mx/default" "$mx/install" "$mx/test/vm/asahi-fresh"
  cp "$tmp/release.gpg" "$mx/default/omarchy-release.gpg"
  printf 'tag=aurora-packages-%s\ndescriptor_sha256=%s\n' "$(printf 'a%.0s' {1..40})" "$(printf '1%.0s' {1..64})" >"$mx/default/aurora-qualified-release"
  printf '%s\n' install.a install.b install.c >"$mx/install/optional-packages-aarch64-required"
  cp "$tools/fake-harness" "$mx/test/vm/asahi-fresh/run"
  echo 4.0.4 >"$mx/version"
  P=$(commit_all "$mx" "Pinned runtime")
  echo change >"$mx/change"
  S=$(commit_all "$mx" "Change the runtime")
  printf 'tag=aurora-packages-%s\ndescriptor_sha256=%s\n' "$(printf 'b%.0s' {1..40})" "$(printf '2%.0s' {1..64})" >"$mx/default/aurora-qualified-release"
  K=$(commit_all "$mx" "Repin the Aurora kernel")
  git clone -q --bare "$mx" "$FAKE/mx.git"

  git init -q -b asahi-quattro "$pkgs"
  mkdir -p "$pkgs/pkgbuilds/hyprland" "$pkgs/bin" "$pkgs/keys"
  cp "$ROOT/pkgbuilds/asahi-repository-packages" "$ROOT/pkgbuilds/asahi-repository-sources" "$ROOT/pkgbuilds/asahi-source-outputs" "$pkgs/pkgbuilds/"
  cp "$ROOT/bin/asahi-incremental-plan" "$pkgs/bin/"
  cp "$tools/fake-promote" "$pkgs/bin/promote-asahi-package-candidate"
  cp "$tmp/repository.asc" "$pkgs/keys/asahi-repository-signing.asc"
  echo "OMARCHY_SOURCE_COMMIT=$P" >"$pkgs/pkgbuilds/omarchy-source.conf"
  echo 'pkgname=hyprland' >"$pkgs/pkgbuilds/hyprland/PKGBUILD"
  C0=$(commit_all "$pkgs" "Initial")
  if [[ ${2:-} == full ]]; then
    echo 'pkgrel=2' >>"$pkgs/pkgbuilds/hyprland/PKGBUILD"
    commit_all "$pkgs" "Rebuild hyprland" >/dev/null
    echo "hyprland hyprpm omarchy-dev omarchy-settings-dev" >"$FAKE/rebuilt"
  fi
  git clone -q --bare "$pkgs" "$FAKE/pkgs.git"

  (
    . "$tools/fake-lib"
    rebuilt_now=$(cat "$FAKE/rebuilt" 2>/dev/null || true)
    rm -f "$FAKE/rebuilt"
    make_candidate "$C0" 100 none "$(printf '0%.0s' {1..64})" "$C0" "$P"
    [[ -z $rebuilt_now ]] || echo "$rebuilt_now" >"$FAKE/rebuilt"
    make_stable "$C0"
    make_runtime_channel 27 "$P" "asahi-packages-candidate-$C0"
    make_package_channel 5 "asahi-packages-stable-$C0" "$(sha "$FAKE/releases/asahi-packages-candidate-$C0/assets/CANDIDATE")"
    set_pointer asahi-quattro-channel 27
    set_pointer asahi-packages-channel 5
  )
}

controller_env() {
  controller_vars=(FAKE="$FAKE" TOOLS="$tools" PATH="$tools:$PATH" XDG_STATE_HOME="$FAKE/controller/state"
    ASAHI_RELEASE_PKGS_GIT="file://$FAKE/pkgs.git" ASAHI_RELEASE_MX_GIT="file://$FAKE/mx.git"
    ASAHI_RELEASE_REPOSITORY_KEY="$tmp/repository.asc" ASAHI_RELEASE_EVIDENCE_ROOT="$FAKE/controller/vm-evidence"
    ASAHI_RELEASE_POLL_SECONDS=0 ASAHI_RELEASE_LOCK_WAIT_SECONDS=3 FAKE_TOKEN="$token"
    OMARCHY_VM_ALARM_MIRROR='https://mirror.invalid/$arch/$repo')
}

release_env() {
  controller_env
  env "${controller_vars[@]}" "$@"
}

# The release command runs as its own process (env execs bash, so $! is the
# command itself), whose PID the crash points kill.
run_release() {
  local pid status=0
  controller_env
  env "${controller_vars[@]}" bash "$script" "$@" >"$FAKE/out" 2>&1 &
  pid=$!
  echo "$pid" >"$FAKE/controller.pid"
  wait "$pid" || status=$?
  return "$status"
}

