# ── worlds ────────────────────────────────────────────────────────────────
commit_all() {
  git -C "$1" add -A
  git -C "$1" -c user.name=Fixture -c user.email=fixture@example.invalid commit -qm "$2"
  git -C "$1" rev-parse HEAD
