#!/bin/bash
# bin/asahi-release against a fake GitHub and fake Macs, with real git remotes
# and a throwaway signing key. The stubs keep their state under one directory
# per scenario ("world"); a stub can kill the release command at a named point
# to test that the next run resumes without doing anything twice.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
script=$ROOT/bin/asahi-release
tmp=$(mktemp -d)
blocker=""
cleanup() {
  [[ -z $blocker ]] || kill "$blocker" 2>/dev/null || true
  gpgconf --kill gpg-agent >/dev/null 2>&1 || true
  rm -rf "$tmp"
}
trap cleanup EXIT

fail() {
  echo "not ok - $1${FAKE:+ (scenario ${FAKE##*/})}" >&2
  if [[ -n ${2:-} && -f ${2:-} ]]; then sed 's/^/  | /' "$2" >&2; fi
  exit 1
}

tools=$tmp/tools
mkdir -p "$tools/remote"
export GNUPGHOME=$tmp/gnupg TOOLS=$tools
mkdir -m 0700 "$GNUPGHOME"
gpg --batch --pinentry-mode loopback --passphrase '' \
  --quick-generate-key 'Release Fixture <release@example.invalid>' ed25519 cert 1d >/dev/null 2>&1
primary=$(gpg --batch --list-secret-keys --with-colons | awk -F: '$1 == "sec" { p = 1; next } p && $1 == "fpr" { print $10; exit }')
gpg --batch --pinentry-mode loopback --passphrase '' --quick-add-key "$primary" ed25519 sign 1d >/dev/null 2>&1
SUBKEY=$(gpg --batch --list-secret-keys --with-colons | awk -F: '$1 == "ssb" { s = 1; next } s && $1 == "fpr" { print $10; exit }')
gpg --batch --armor --export "$primary" >"$tmp/repository.asc"
gpg --batch --export "$primary" >"$tmp/release.gpg"
export SUBKEY REPOSITORY_KEY=$tmp/repository.asc
token=gho_fixtureToken0123456789abcdef

# ── what the stubs share ──────────────────────────────────────────────────
cat >"$tools/fake-lib" <<'LIB'
# shellcheck shell=bash
repo=maralcbr/omarchy-pkgs

sha() { sha256sum "$1" | cut -d' ' -f1; }
sign() { gpg --batch --yes --pinentry-mode loopback --passphrase '' --local-user "$SUBKEY!" --detach-sign "$1" 2>/dev/null; }
publish_meta() {
  printf '{"draft":false,"prerelease":%s,"immutable":true,"created_at":"2026-09-19T00:00:00Z"}\n' "$2" >"$FAKE/releases/$1/meta.json"
}
pinned_source() {
  git --git-dir="$FAKE/pkgs.git" show "$1:pkgbuilds/omarchy-source.conf" | sed -n 's/^OMARCHY_SOURCE_COMMIT=//p'
}
set_pointer() { printf 'format=1\nsequence=%s\ntag=%s-%s\n' "$2" "$1" "$2" >"$FAKE/pointers/$1"; }

plan_json() {
  local rebuilt
  rebuilt=$(cat "$FAKE/rebuilt" 2>/dev/null || echo "omarchy-dev omarchy-settings-dev")
  jq -n --arg head "$1" --arg previous "$2" --arg previous_runtime "$3" --arg runtime "$(pinned_source "$1")" --arg rebuilt "$rebuilt" \
    '{format:1, architecture:"aarch64", requested_mode:"incremental", effective_mode:"incremental", fallback_reason:"",
      previous_package_commit:$previous, current_package_commit:$head, previous_runtime_commit:$previous_runtime,
      current_runtime_commit:$runtime, rebuilt_packages:($rebuilt | split(" ")), reused_packages:[]}'
}

# A signed candidate release: three repository packages, the six runtime
# packages, the descriptor, manifest, plan, provenance and both inventories.
make_candidate() {
  local head=$1 run=$2 tag=asahi-packages-candidate-$1 dir source name file version i=0
  local lines=() runtime=() repository_files=() runtime_files=()
  dir=$FAKE/releases/$tag/assets
  source=$(pinned_source "$head")
  mkdir -p "$dir"
  for name in hyprland hyprpm omarchy-apple-boot; do
    i=$((i + 1))
    # A scenario bumps a version with a name=version line in $FAKE/versions.
    version=$(sed -n "s/^$name=//p" "$FAKE/versions" 2>/dev/null || true)
    version=${version:-1.$i-1}
    file=$name-$version-aarch64.pkg.tar.xz
    printf '%s %s\n' "$name" "$head" >"$dir/$file"
    sign "$dir/$file"
    lines+=("package=$i|$name|$version|aarch64|$file|$(sha "$dir/$file")|$file.sig|$(sha "$dir/$file.sig")")
    repository_files+=("$file" "$file.sig")
  done
  printf '%s\n' format=1 channel=candidate "release_tag=$tag" "source_commit=$head" "workflow_run=$run" runner_arch=aarch64 \
    "signing_fingerprint=$SUBKEY" "package_count=${#lines[@]}" "${lines[@]}" >"$dir/CANDIDATE"
  sign "$dir/CANDIDATE"
  i=0
  for name in omarchy-keyring omarchy-settings-dev omarchy-dev omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic; do
    i=$((i + 1))
    file=$name-$i.${source:0:7}-1-aarch64.pkg.tar.xz
    printf '%s %s\n' "$name" "$source" >"$dir/$file"
    sign "$dir/$file"
    runtime+=("package=$i|$name|$i.${source:0:7}-1|aarch64|$file|$(sha "$dir/$file")")
    runtime_files+=("$file" "$file.sig")
  done
  printf '%s\n' format=2 bundle=asahi-quattro "source_commit=$source" package_count=6 "${runtime[@]}" >"$dir/asahi-quattro-bundle.manifest"
  sign "$dir/asahi-quattro-bundle.manifest"
  cp "$REPOSITORY_KEY" "$dir/asahi-repository-signing.asc"
  plan_json "$head" "$5" "$6" >"$dir/PLAN.json"
  jq -n --arg tag "$3" --arg sha "$4" '{format:1, predecessor:{tag:$tag, candidate_sha256:$sha}, packages:[]}' >"$dir/PROVENANCE.json"
  (cd "$dir" && sha256sum "${repository_files[@]}" CANDIDATE CANDIDATE.sig PLAN.json PROVENANCE.json >SHA256SUMS)
  (cd "$dir" && sha256sum "${runtime_files[@]}" asahi-quattro-bundle.manifest asahi-quattro-bundle.manifest.sig \
    asahi-repository-signing.asc >RUNTIME-SHA256SUMS)
  publish_meta "$tag" true
}

make_stable() {
  local stable=asahi-packages-stable-$1
  mkdir -p "$FAKE/releases/$stable"
  cp -R "$FAKE/releases/asahi-packages-candidate-$1/assets" "$FAKE/releases/$stable/"
  publish_meta "$stable" false
}

make_runtime_channel() {
  local sequence=$1 source=$2 candidate=$3 release=asahi-quattro-${2:0:8} rdir cdir manifest_sha
  rdir=$FAKE/releases/$release/assets
  cdir=$FAKE/releases/asahi-quattro-channel-$sequence/assets
  manifest_sha=$(sha "$FAKE/releases/$candidate/assets/asahi-quattro-bundle.manifest")
  mkdir -p "$rdir" "$cdir"
  cp "$FAKE/releases/$candidate/assets/asahi-quattro-bundle.manifest"* "$rdir/"
  printf '%s\n' format=1 bundle=asahi-quattro "sequence=$sequence" "release_tag=$release" "source_commit=$source" \
    "package_source_commit=${candidate#asahi-packages-candidate-}" "manifest_sha256=$manifest_sha" >"$rdir/asahi-quattro-release"
  sign "$rdir/asahi-quattro-release"
  printf '%s\n' format=1 channel=asahi-quattro "sequence=$sequence" "release_tag=$release" "source_commit=$source" \
    manifest=asahi-quattro-bundle.manifest "manifest_sha256=$manifest_sha" "release_sha256=$(sha "$rdir/asahi-quattro-release")" \
    >"$cdir/asahi-quattro-channel"
  sign "$cdir/asahi-quattro-channel"
  publish_meta "$release" false
  publish_meta "asahi-quattro-channel-$sequence" false
}

make_package_channel() {
  local cdir=$FAKE/releases/asahi-packages-channel-$1/assets
  mkdir -p "$cdir"
  printf '%s\n' format=1 channel=asahi-packages "sequence=$1" "stable_tag=$2" "descriptor_sha256=$3" supersedes= \
    >"$cdir/asahi-packages-channel"
  sign "$cdir/asahi-packages-channel"
  publish_meta "asahi-packages-channel-$1" false
}

max_channel() {
  local tag best=0 n
  for tag in "$FAKE"/releases/"$1"-*; do
    n=${tag##*-}
    if [[ -d $tag && $n =~ ^[0-9]+$ ]] && (( n > best )); then best=$n; fi
  done
  echo "$best"
}

# Kill the release command this test started (its PID only) here, once, if
# the scenario asked for it.
kill_controller_at() {
  local list=$FAKE/crash-points
  if [[ ! -s $list ]] || ! grep -Fxq "$1" "$list"; then return 1; fi
  grep -Fxv "$1" "$list" >"$list.new" || true
  mv "$list.new" "$list"
  echo "$1" >>"$FAKE/crashes.log"
  kill -KILL "$(cat "$FAKE/controller.pid")" 2>/dev/null || true
}

# The same, and the stub stops there too.
crash_point() {
  if kill_controller_at "$1"; then exit 0; fi
}
LIB

# ── gh ────────────────────────────────────────────────────────────────────
cat >"$tools/gh" <<'STUB'
#!/bin/bash
set -euo pipefail
. "$TOOLS/fake-lib"
printf '%s\n' "$*" >>"$FAKE/gh.log"

release_json() {
  local tag=$1 dir=$FAKE/releases/$1 assets file
  [[ -f $dir/meta.json ]] || { echo "HTTP 404: Not Found" >&2; return 1; }
  assets=$(for file in "$dir"/assets/*; do
      [[ -f $file ]] || continue
      jq -nc --arg name "${file##*/}" --arg digest "sha256:$(sha "$file")" '{name:$name, digest:$digest}'
    done | jq -s .)
  jq --arg tag "$tag" --argjson assets "$assets" '. + {tag_name:$tag, assets:$assets}' "$dir/meta.json"
}

releases_json() {
  local dir
  for dir in "$FAKE"/releases/*/; do release_json "$(basename "$dir")"; done | jq -s .
}

next_id() {
  local n
  n=$(cat "$FAKE/next-run" 2>/dev/null || echo 1000)
  echo $((n + 1)) >"$FAKE/next-run"
  echo "$n"
}

environment_json() {
  jq -nc --arg name "$(cat "$FAKE/environment" 2>/dev/null || echo asahi-quattro-release)" \
    '[{environment:{id:77, name:$name}, wait_timer:0, current_user_can_approve:true}]'
}

job() {
  jq -nc --arg name "$1" --arg status "$2" --arg conclusion "${3:-}" \
    '{name:$name, status:$status, conclusion:(if $conclusion == "" then null else $conclusion end), steps:[]}'
}

# A full build has more matrix jobs than a page holds; the gated jobs come last.
set_jobs() {
  local fillers
  fillers=$(jq -nc '[range(0; 130) | {name:"build-repository (source \(.))", status:"completed", conclusion:"success", steps:[]}]')
  jq -n --argjson jobs "$2" --argjson fillers "$fillers" '($fillers + $jobs) as $all | {total_count:($all | length), jobs:$all}' \
    >"$FAKE/runs/$1/jobs.json"
}

# One page of jobs, or every page as GitHub serves them to --paginate.
jobs_pages() {
  local file=$1 paginate=$2 per_page=$3 total page
  total=$(jq '.jobs | length' "$file")
  for ((page = 0; page * per_page < total || page == 0; page++)); do
    jq -c --argjson from $((page * per_page)) --argjson size "$per_page" '{total_count, jobs:.jobs[$from:$from + $size]}' "$file"
    (( paginate )) || break
  done
}

set_run() {
  local run=$FAKE/runs/$1/run.json
  jq --arg status "$2" --arg conclusion "${3:-}" \
    '.status = $status | .conclusion = (if $conclusion == "" then null else $conclusion end)' "$run" >"$run.new"
  mv "$run.new" "$run"
}

finish_run() {
  echo '[]' >"$FAKE/runs/$1/pending.json"
  set_jobs "$1" "[$(job publish completed "$2")]"
  set_run "$1" completed "$2"
}

create_run() {
  local id=$1 file=$2 head=$3 inputs=$4 title dir=$FAKE/runs/$1 candidate artifact name
  mkdir -p "$dir/artifacts"
  printf '%s\n' "$inputs" >"$dir/inputs.json"
  echo publish >"$dir/stage"
  case $file in
    release-asahi-package-incremental.yml)
      title="Build resumable ARM64 package candidate"
      echo signing >"$dir/stage"
      set_jobs "$id" "[$(job signing-check waiting), $(job plan completed success)]"
      ;;
    promote-asahi-quattro-runtime.yml)
      title=$(jq -r '"Runtime \(.mode) \(.candidate_tag) sha256 \(.candidate_sha256) source \(.source_commit) sequence \(.sequence)"' <<<"$inputs")
      candidate=$(jq -r .candidate_tag <<<"$inputs")
      artifact=$dir/artifacts/exact-asahi-runtime-candidate
      mkdir -p "$artifact/metadata" "$artifact/packages"
      cp "$FAKE/releases/$candidate/assets/asahi-quattro-bundle.manifest"* "$artifact/metadata/"
      while IFS='|' read -r _ _ _ _ name _; do
        cp "$FAKE/releases/$candidate/assets/$name" "$FAKE/releases/$candidate/assets/$name.sig" "$artifact/packages/"
      done < <(sed -n 's/^package=//p' "$artifact/metadata/asahi-quattro-bundle.manifest")
      [[ ! -e $FAKE/tamper-runtime-artifact ]] || echo tampered >>"$artifact/metadata/asahi-quattro-bundle.manifest"
      set_jobs "$id" "[$(job verify completed success), $(job publish waiting)]"
      ;;
    publish-asahi-packages-channel.yml)
      title="Package channel $(jq -r .stable_tag <<<"$inputs")"
      set_jobs "$id" "[$(job publish waiting)]"
      ;;
    *) echo "unexpected workflow $file" >&2; exit 1 ;;
  esac
  jq -n --argjson id "$id" --arg path ".github/workflows/$file" --arg head "$head" --arg title "$title" \
    '{id:$id, path:$path, event:"workflow_dispatch", head_sha:$head, head_branch:"asahi-quattro", actor:{login:"maralcbr"},
      display_title:$title, status:"waiting", conclusion:null, created_at:"2026-09-19T00:00:00Z"}' >"$dir/run.json"
  environment_json >"$dir/pending.json"
}

approve() {
  local id=$1 body=$2 dir=$FAKE/runs/$1 file stage inputs head sequence stable
  [[ $(jq -c .environment_ids <<<"$body") == '[77]' && $(jq -r .state <<<"$body") == approved ]] ||
    { echo "unexpected approval: $body" >&2; exit 1; }
  file=$(jq -r .path "$dir/run.json")
  file=${file##*/}
  stage=$(cat "$dir/stage")
  [[ $(jq -r .status "$dir/run.json") == waiting ]] || { echo "run $id is not waiting" >&2; exit 1; }
  printf '%s %s %s\n' "$id" "$file" "$stage" >>"$FAKE/approvals.log"
  inputs=$(cat "$dir/inputs.json")
  head=$(jq -r .head_sha "$dir/run.json")
  case $file:$stage in
    release-asahi-package-incremental.yml:signing)
      echo publish >"$dir/stage"
      mkdir -p "$dir/artifacts/incremental-plan"
      plan_json "$head" "$(jq -r .previous_package_commit <<<"$inputs")" "$(jq -r .previous_runtime_commit <<<"$inputs")" \
        >"$dir/artifacts/incremental-plan/plan.json"
      set_jobs "$id" "[$(job signing-check completed success), $(job plan completed success), $(job assemble-and-verify completed success), $(job publish waiting)]"
      environment_json >"$dir/pending.json"
      ;;
    release-asahi-package-incremental.yml:publish)
      make_candidate "$head" "$id" "$(jq -r .predecessor_tag <<<"$inputs")" "$(jq -r .predecessor_candidate_sha256 <<<"$inputs")" \
        "$(jq -r .previous_package_commit <<<"$inputs")" "$(jq -r .previous_runtime_commit <<<"$inputs")"
      [[ ! -e $FAKE/promote-by-hand ]] || make_stable "$head"
      finish_run "$id" success
      ;;
    promote-asahi-quattro-runtime.yml:publish)
      sequence=$(jq -r .sequence <<<"$inputs")
      make_runtime_channel "$sequence" "$(jq -r .source_commit <<<"$inputs")" "$(jq -r .candidate_tag <<<"$inputs")"
      if [[ -e $FAKE/pointer-fails ]]; then
        set_jobs "$id" '[{"name":"verify","status":"completed","conclusion":"success","steps":[]},
          {"name":"publish","status":"completed","conclusion":"failure","steps":[
            {"name":"Verify immutable public channel","conclusion":"success"},
            {"name":"Publish release channel pointer","conclusion":"failure"}]}]'
        echo '[]' >"$dir/pending.json"
        set_run "$id" completed failure
      else
        set_pointer asahi-quattro-channel "$sequence"
        finish_run "$id" success
      fi
      ;;
    publish-asahi-packages-channel.yml:publish)
      stable=$(jq -r .stable_tag <<<"$inputs")
      sequence=$(( $(max_channel asahi-packages-channel) + 1 ))
      make_package_channel "$sequence" "$stable" "$(sha "$FAKE/releases/$stable/assets/CANDIDATE")"
      set_pointer asahi-packages-channel "$sequence"
      finish_run "$id" success
      ;;
  esac
  crash_point "approved:$file:$stage"
}

list_runs() {
  local file head run
  file=$(cut -d/ -f6 <<<"$1")
  head=$(sed -n 's/.*head_sha=\([0-9a-f]*\).*/\1/p' <<<"$1")
  for run in "$FAKE"/runs/*/run.json; do
    [[ ! -f $run ]] || cat "$run"
  done | jq -s --arg path ".github/workflows/$file" --arg head "$head" \
    '[.[] | select(.path == $path and .head_sha == $head)] | {total_count:length, workflow_runs:.}'
}

gh_api() {
  local method=GET input="" endpoint="" id paginate=0 per_page
  while (($#)); do
    case $1 in
      -X) method=$2; shift ;;
      --input) input=$2; shift ;;
      --paginate) paginate=1 ;;
      *) endpoint=$1 ;;
    esac
    shift
  done
  case $endpoint in
    user) echo '{"login":"maralcbr"}' ;;
    "repos/$repo/releases?per_page=100") releases_json ;;
    "repos/$repo/releases/tags/"*) release_json "${endpoint##*/}" ;;
    "repos/$repo/actions/workflows/"*) list_runs "$endpoint" ;;
    "repos/$repo/actions/runs/"*/pending_deployments)
      id=$(cut -d/ -f6 <<<"$endpoint")
      if [[ $method == POST ]]; then
        [[ $input == - ]] && input=/dev/stdin
        approve "$id" "$(cat "$input")"
      else
        cat "$FAKE/runs/$id/pending.json"
      fi
      ;;
    "repos/$repo/actions/runs/"*/jobs*)
      per_page=$(sed -n 's/.*per_page=\([0-9]*\).*/\1/p' <<<"$endpoint")
      jobs_pages "$FAKE/runs/$(cut -d/ -f6 <<<"$endpoint")/jobs.json" "$paginate" "${per_page:-30}"
      ;;
    "repos/$repo/actions/runs/"*) cat "$FAKE/runs/${endpoint##*/}/run.json" ;;
    *) echo "unexpected gh api $endpoint" >&2; exit 1 ;;
  esac
}

gh_release() {
  local tag=$2 dir="" patterns=() file name pattern
  [[ $1 == download ]] || { echo "unexpected gh release $1" >&2; exit 1; }
  shift 2
  while (($#)); do
    case $1 in
      --dir) dir=$2; shift ;;
      --pattern) patterns+=("$2"); shift ;;
      -R) shift ;;
    esac
    shift
  done
  [[ -d $FAKE/releases/$tag/assets ]] || { echo "release not found" >&2; exit 1; }
  mkdir -p "$dir"
  for file in "$FAKE/releases/$tag/assets"/*; do
    name=${file##*/}
    for pattern in "${patterns[@]}"; do
      if [[ $name == $pattern ]]; then cp "$file" "$dir/"; break; fi
    done
  done
}

gh_run() {
  local id=$2 name="" dir=""
  [[ $1 == download ]] || { echo "unexpected gh run $1" >&2; exit 1; }
  shift 2
  while (($#)); do
    case $1 in
      -n) name=$2; shift ;;
      -D) dir=$2; shift ;;
      -R) shift ;;
    esac
    shift
  done
  [[ -d $FAKE/runs/$id/artifacts/$name ]] || { echo "no artifact $name" >&2; exit 1; }
  mkdir -p "$dir"
  cp -R "$FAKE/runs/$id/artifacts/$name/." "$dir/"
}

gh_workflow() {
  local file=$2 inputs='{}' head id count=1 i
  [[ $1 == run ]] || { echo "unexpected gh workflow $1" >&2; exit 1; }
  shift 2
  while (($#)); do
    case $1 in
      -f) inputs=$(jq --arg key "${2%%=*}" --arg value "${2#*=}" '.[$key] = $value' <<<"$inputs"); shift ;;
      -R|--ref) shift ;;
    esac
    shift
  done
  crash_point "dispatch-lost:$file"
  head=$(git --git-dir="$FAKE/pkgs.git" rev-parse refs/heads/asahi-quattro)
  [[ ! -e $FAKE/duplicate-dispatch ]] || count=2
  echo "$file" >>"$FAKE/dispatches.log"
  for ((i = 0; i < count; i++)); do
    id=$(next_id)
    create_run "$id" "$file" "$head" "$inputs"
  done
  crash_point "dispatch:$file"
  echo "https://github.com/$repo/actions/runs/$id"
}

gh_pr() {
  local sub=$1 head="" state=all title="" number pr branch tree parent commit
  shift
  case $sub in
    list)
      while (($#)); do
        case $1 in
          --head) head=$2; shift ;;
          --state) state=$2; shift ;;
          -R|--base|--json) shift ;;
        esac
        shift
      done
      for pr in "$FAKE"/prs/*.json; do [[ ! -f $pr ]] || cat "$pr"; done |
        jq -s --arg head "$head" --arg state "$state" \
          '[.[] | select(.headRefName == $head) | select($state == "all" or (.state | ascii_downcase) == $state)]'
      ;;
    create)
      while (($#)); do
        case $1 in
          --head) head=$2; shift ;;
          --title) title=$2; shift ;;
          -R|--base|--body) shift ;;
        esac
        shift
      done
      git --git-dir="$FAKE/pkgs.git" rev-parse --verify -q "refs/heads/$head" >/dev/null || { echo "no branch $head" >&2; exit 1; }
      mkdir -p "$FAKE/prs"
      number=$(( $(find "$FAKE/prs" -name '*.json' | wc -l) + 200 ))
      jq -n --argjson number "$number" --arg head "$head" --arg title "$title" \
        '{number:$number, state:"OPEN", headRefName:$head, title:$title, mergeCommit:null}' >"$FAKE/prs/$number.json"
      echo "$number" >>"$FAKE/pr-creates.log"
      crash_point pr-create
      echo "https://github.com/$repo/pull/$number"
      ;;
    merge)
      number=$1
      pr=$FAKE/prs/$number.json
      [[ $(jq -r .state "$pr") == OPEN ]] || { echo "pull request $number is not open" >&2; exit 1; }
      branch=$(jq -r .headRefName "$pr")
      tree=$(git --git-dir="$FAKE/pkgs.git" rev-parse "refs/heads/$branch^{tree}")
      parent=$(git --git-dir="$FAKE/pkgs.git" rev-parse refs/heads/asahi-quattro)
      commit=$(GIT_AUTHOR_NAME=f GIT_AUTHOR_EMAIL=f@example.invalid GIT_COMMITTER_NAME=f GIT_COMMITTER_EMAIL=f@example.invalid \
        git --git-dir="$FAKE/pkgs.git" commit-tree "$tree" -p "$parent" -m "$(jq -r .title "$pr") (#$number)")
      git --git-dir="$FAKE/pkgs.git" update-ref refs/heads/asahi-quattro "$commit"
      git --git-dir="$FAKE/pkgs.git" update-ref -d "refs/heads/$branch"
      jq --arg commit "$commit" '.state = "MERGED" | .mergeCommit = {oid:$commit}' "$pr" >"$pr.new"
      mv "$pr.new" "$pr"
      ;;
    *) echo "unexpected gh pr $sub" >&2; exit 1 ;;
  esac
}

case $1 in
  auth) echo "$FAKE_TOKEN" ;;
  api) shift; gh_api "$@" ;;
  release) shift; gh_release "$@" ;;
  run) shift; gh_run "$@" ;;
  workflow) shift; gh_workflow "$@" ;;
  pr) shift; gh_pr "$@" ;;
  *) echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
STUB

# ── ssh: each host is a home directory on this machine ───────────────────
cat >"$tools/ssh" <<'STUB'
#!/bin/bash
printf '%s\n' "$*" >>"$FAKE/ssh.log"
while (($#)); do
  case $1 in
    -o) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
host=${1#*@}
shift
[[ ! -e $FAKE/offline-$host ]] || exit 255
export HOME=$FAKE/hosts/$host FAKE_HOST=$host PATH=$TOOLS/remote:$PATH
export OMARCHY_REBOOT_BLOCKED=$HOME/reboot-blocked OMARCHY_ASAHI_RELEASE_FILE=$HOME/asahi-quattro-release OMARCHY_PACMAN_CONF=$HOME/pacman.conf
mkdir -p "$HOME"
cd "$HOME" || exit 255
status=0
bash -c "$*" || status=$?
case "$*" in
