#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
script="$ROOT/.github/scripts/verify-asahi-repository-lifecycle.sh"
workflow="$ROOT/.github/workflows/release-asahi-package-candidate.yml"

[[ -x $script ]]
bash -n "$script"
grep -Fq 'verify-asahi-repository-lifecycle.sh clean' "$workflow"
grep -Fq 'verify-asahi-repository-lifecycle.sh upgrade' "$workflow"
grep -Fq 'SigLevel = Required DatabaseOptional' "$workflow"
grep -Fq 'CacheDir = /var/cache/pacman/candidate' "$workflow"
grep -Fq 'CacheDir = /var/cache/pacman/previous' "$workflow"
grep -Fq 'install -d -m 0755 /var/cache/pacman/candidate /var/cache/pacman/previous' "$script"
grep -Fq 'asahi-packages-784daa3efaecfa81b5b4da888b524e6ec4574d24' "$workflow"
grep -Fq 'for required_dependency in limine snapper' "$script"
grep -Fq 'Candidate transaction omitted ARM dependency $required_dependency' "$script"
grep -Fq 'for pc_package in amd-ucode intel-ucode' "$script"
grep -Fq 'previous_packages+=("$package")' "$script"
grep -Fq '"${previous_packages[@]}"' "$script"
grep -Fq 'Previous repository has no packages in the candidate inventory' "$script"
grep -Fq '798f4b283ad2819aee950d042f26566ae1a68f87c12247301ce449bea3b2d81e' "$script"
grep -Fq "'SigLevel = Required DatabaseOptional'" "$script"
grep -Fq -- '--config "$asahi_work/pacman.conf" asahi-alarm/asahi-scripts' "$script"
grep -Fq 'first_config=$previous_dir/pacman.conf' "$script"
grep -Fq 'pacman_with_retry -Syy --noconfirm --config "$asahi_work/pacman.conf"' "$script"
grep -Fq '== asahi-alarm/asahi-scripts ]]' "$script"
! grep -Fq '[asahi-alarm]' "$workflow" || exit 1

echo 'ok - repository lifecycle gates clean install and pinned-snapshot upgrade'
echo 'ok - a signed Asahi ALARM transaction that resolves to asahi-scripts only runs after a forced refresh of the first mirrors'
