# ── install ────────────────────────────────────────────────────────────────
pacman() {
  echo "pacman $*" >>"$case_dir/calls"
  local repository
  case " $* " in
    *" -Sy "*)
      mkdir -p "$target/var/lib/pacman/sync"
      for repository in omarchy-aurora omarchy asahi-alarm core extra alarm aur; do
        if [[ $repository == "${moved:-}" ]]; then
          echo "$repository moved" >"$target/var/lib/pacman/sync/$repository.db"
        else
          echo "$repository served" >"$target/var/lib/pacman/sync/$repository.db"
        fi
      done ;;
    *" -Qq "*) printf '%s\n' linux-aurora linux-aurora-headers m1n1-aurora omarchy-apple-boot omarchy-first-boot ;;
  esac
}
mount() { echo "mount $*" >>"$case_dir/calls"; }
umount() { echo "umount $*" >>"$case_dir/calls"; }
served_sha() { printf '%s served\n' "$1" | sha256sum | cut -d' ' -f1; }

new_install_case() {
  case_dir=$tmp/install-$1
  lane=rc work=$case_dir/work target=$case_dir/work/target logs=$case_dir/work/logs api_mounts=()
  mkdir -p "$logs" "$target" "$work/pkg-cache"
  : >"$case_dir/calls"
  record_of "$(hex 1)" "$(served_sha omarchy)" "$(hex 3)" "$(served_sha omarchy-aurora)" \
    "$(hex 5)" "$(served_sha omarchy-aurora)" "$(hex 5)" "$(served_sha omarchy-aurora)" \
    "$(served_sha asahi-alarm)" "$(served_sha core)" "$(served_sha extra)" "$(served_sha alarm)" \
    "$(served_sha aur)" "$(hex f)" 1 >"$case_dir/inputs"
  inputs=$("$BASH" "$inputs_script" check "$case_dir/inputs" --lane rc)
  write_build_config
}

line_of() { grep -n -- "$1" "$case_dir/calls" | head -1 | cut -d: -f1; }
in_builder() { (fail() { echo "build-mac-image: $*" >&2; exit 1; }; "$@"); }

description='installing the package set'
new_install_case served
in_builder install_packages >"$case_dir/output" 2>&1 || fail "$description: refused databases that match $(<"$case_dir/output")"
[[ $(grep -c ' -Sy$' "$case_dir/calls") == 1 && $(grep -c -- ' -S base ' "$case_dir/calls") == 1 ]] ||
  fail "$description: syncs once, then installs once"
(($(line_of ' -Sy$') < $(line_of '^mount ') && $(line_of '^mount ') < $(line_of ' -S base '))) ||
  fail "$description: syncs before it mounts anything, and installs after"
grep -Fq omarchy-apple-boot "$case_dir/calls" || fail "$description: falls back to omarchy-apple-boot"
grep -Fq 'omarchy-mac-boot is not in' "$case_dir/output" || fail "$description: warns when omarchy-mac-boot is missing"
for moved in asahi-alarm core omarchy-aurora; do
  new_install_case "moved-$moved"
  if in_builder install_packages >"$case_dir/output" 2>&1; then fail "$description: installed from a moved $moved"; fi
  grep -Fq "$moved.db is not the database this run resolved" "$case_dir/output" || fail "$description: names the moved $moved"
  [[ $(grep -c '' "$case_dir/calls") == 1 ]] && grep -q ' -Sy$' "$case_dir/calls" ||
    fail "$description: a moved $moved stops the build before any mount or install"
done
unset moved
echo "ok - $description syncs every database and checks it before any mount; a moved database installs nothing"
unset -f pacman mount umount

# ── interruption ───────────────────────────────────────────────────────────
interrupt_stubs=$tmp/interrupt-bin
mkdir -p "$interrupt_stubs"
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$interrupt_stubs/mount"
echo "mount $*" >>"$STATE/log"
[[ $1 == -o && $2 == loop* ]] || exit 32
echo "$4" >>"$STATE/mounts"
echo "/dev/loop7 $3" >>"$STATE/loops"
STUB
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$interrupt_stubs/umount"
echo "umount $*" >>"$STATE/log"
grep -Fxv -- "${@: -1}" "$STATE/mounts" >"$STATE/mounts.new" || true
mv "$STATE/mounts.new" "$STATE/mounts"
STUB
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$interrupt_stubs/findmnt"
case $* in
  "-rn -o TARGET") cat "$STATE/mounts" ;;
  "-n -o SOURCE "*) echo /dev/loop7 ;;
  *) exit 2 ;;
esac
STUB
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$interrupt_stubs/losetup"
echo "losetup $*" >>"$STATE/log"
case $* in
  "-n -O NAME,BACK-FILE --list") cat "$STATE/loops" ;;
  "-d "*) grep -v "^$2 " "$STATE/loops" >"$STATE/loops.new" || true; mv "$STATE/loops.new" "$STATE/loops" ;;
  *) exit 2 ;;
esac
STUB
chmod +x "$interrupt_stubs"/*

await() {
  local tries=200
  until [[ -e $1 ]]; do
    ((tries-- > 0)) || return 1
    sleep 0.1
  done
}

description='a container build stopped after it attached a loop device'
case_dir=$tmp/interrupt-container
state=$case_dir/state
mkdir -p "$state" "$case_dir/work/top"
: >"$state/mounts"
: >"$state/loops"
env PATH="$interrupt_stubs:$PATH" STATE="$state" WORK="$case_dir/work" "$BASH" -c '
  set -euo pipefail
  source "$1"
  work=$WORK
  slow_step() {
    mount_image "$work/root.img" "$work/top"
    echo "$attached" >"$STATE/attached"
    sleep 300
  }
  trap cleanup EXIT
  run_interruptible slow_step' _ "$ROOT/bin/build-mac-image" >"$case_dir/output" 2>&1 &
builder=$!
await "$state/attached" || fail "$description: never attached"
started=$SECONDS
kill -TERM "$builder"
status=0
wait "$builder" || status=$?
((status == 143 && SECONDS - started < 10)) || fail "$description: exits 143 at once, not $status after $((SECONDS - started))s"
[[ $(<"$state/attached") == /dev/loop7 ]] || fail "$description: mount_image names its loop device"
grep -Fxq "umount $case_dir/work/top" "$state/log" && [[ ! -s $state/mounts ]] || fail "$description: unmounts what it mounted"
grep -Fxq 'losetup -d /dev/loop7' "$state/log" && [[ ! -s $state/loops ]] || fail "$description: detaches its loop device"
! pgrep -f 'sleep 300' >/dev/null || fail "$description: the interrupted step is still running"
echo "ok - $description stops the step at once, unmounts and detaches"

description='a host build stopped while its container runs'
case_dir=$tmp/interrupt-host
state=$case_dir/state
mkdir -p "$state" "$case_dir/root/bin"
cat >"$case_dir/root/bin/mac-image-inputs" <<'STUB'
case $1 in
  check) ;;
  rootfs) echo rootfs >"$3" ;;
esac
STUB
{ printf '#!%s\n' "$BASH"; cat <<'STUB'; } >"$case_dir/docker"
echo "docker $*" >>"$STATE/log"
case $1 in
  import|stop|rm) ;;
  image) [[ $2 != inspect ]] || echo sha256:image ;;
  run)
    while (($#)); do [[ $1 != --cidfile ]] || { echo container42 >"$2"; break; }; shift; done
    touch "$STATE/running"
    exec sleep 300 ;;
esac
STUB
chmod +x "$case_dir/docker"
record_of >"$case_dir/inputs"
env PATH="$case_dir:$PATH" STATE="$state" GITHUB_SHA="$stable_commit" FAKE_ROOT="$case_dir/root" "$BASH" -c '
  source "$1"
  ROOT=$FAKE_ROOT
  host_main --inputs "$2" rc "$3"' _ "$ROOT/bin/build-mac-image" "$case_dir/inputs" "$case_dir/out" \
  >"$case_dir/output" 2>&1 &
builder=$!
await "$state/running" || fail "$description: never started the container"
kill -TERM "$builder"
status=0
wait "$builder" || status=$?
((status == 143)) || fail "$description: exits 143, not $status"
grep -Fxq 'docker stop --time 60 container42' "$state/log" && grep -Fxq 'docker rm -f container42' "$state/log" ||
  fail "$description: stops and removes the container it started"
grep -Eq '^docker image rm -f omarchy-mac-image-alarm:' "$state/log" || fail "$description: removes the imported image"
! pgrep -f 'sleep 300' >/dev/null || fail "$description: the container is still running"
echo "ok - $description stops and removes the container, then its image"

description='a dry-run'
case_dir=$tmp/dry-run
mkdir -p "$case_dir/out"
record_of >"$case_dir/inputs"
"$BASH" "$ROOT/bin/build-mac-image" --inputs "$case_dir/inputs" --dry-run rc "$case_dir/out" \
  >"$case_dir/output" 2>&1 || fail "$description: refused"
grep -Fq "Would build the rc Mac image" "$case_dir/output" || fail "$description: does not say what it would build"
[[ -z $(ls -A "$case_dir/out") ]] || fail "$description: wrote into OUT"
echo "ok - $description checks the inputs and writes nothing"

# ── payload ────────────────────────────────────────────────────────────────
make_payload() {
  local dir=$1
  mkdir -p "$dir/payload/esp/EFI/BOOT" "$dir/payload/esp/m1n1" "$dir/payload/esp/omarchy"
  python3 - "$dir/payload" "$ROOT_UUID" "$BOOT_UUID" <<'PY'
import struct, sys, uuid
out, root_uuid, boot_uuid = sys.argv[1], uuid.UUID(sys.argv[2]).bytes, uuid.UUID(sys.argv[3]).bytes
boot = bytearray(1 << 16)
boot[0x438:0x43A] = b"\x53\xef"
boot[0x468:0x478] = boot_uuid
boot[0x478:0x484] = b"OMARCHY_BOOT"
open(f"{out}/boot.img", "wb").write(boot)
root = bytearray(1 << 17)
root[0x10020:0x10030] = root_uuid
root[0x10040:0x10048] = b"_BHRfS_M"
root[0x1012B:0x1012B + 12] = b"OMARCHY_ROOT"
open(f"{out}/root.img", "wb").write(root)
efi = bytearray(0x200)
efi[:2] = b"MZ"
struct.pack_into("<I", efi, 0x3C, 0x80)
efi[0x80:0x84] = b"PE\0\0"
struct.pack_into("<H", efi, 0x84, 0xAA64)
efi += f"search.fs_uuid {sys.argv[3]} root hd0,gpt2\n".encode()
open(f"{out}/esp/EFI/BOOT/BOOTAA64.EFI", "wb").write(efi)
open(f"{out}/esp/m1n1/boot.bin", "wb").write(b"m1n1" * 1024)
PY
  cp "$ROOT/apple-bootstrap/omarchy-volume.icns" "$dir/payload/"
}

zip_payload() {
  local dir=$1 name=$2
  rm -f "$dir/$name"
  (cd "$dir/payload" && bsdtar --format zip -cf "$dir/$name" esp boot.img root.img omarchy-volume.icns)
}

check_payload() {
  python3 "$check_script" payload "$1" "$2" "$3" >"$case_dir/output" 2>&1
}

description='the builder payload'
case_dir=$tmp/payload
mkdir -p "$case_dir"
for flavour in edge rc stable; do
  lane=$flavour
  name=$(payload_name)
  [[ $name == "omarchy-2026.09.19-aarch64-apple-silicon-mac-$flavour-os-package.zip" ]] ||
    fail "$description: is named $name"
  mkdir -p "$case_dir/$flavour"
  make_payload "$case_dir/$flavour"
  zip_payload "$case_dir/$flavour" "$name"
  write_installer_data "$name" "$case_dir/$flavour/installer_data.json"
  check_payload "$flavour" "$case_dir/$flavour/$name" "$case_dir/$flavour/installer_data.json" ||
    fail "$description: the $flavour payload and its installer_data are refused $(<"$case_dir/output")"
done
echo "ok - $description is named for its lane and date, and its installer_data keeps today's declared sizes"

description='a payload'
base=$case_dir/rc
lane=rc
name=$(payload_name)
for variant in name install-conf wrong-uuid no-omarchy extra-member luks; do
  dir=$case_dir/$variant
  rm -rf "$dir"
  cp -R "$base" "$dir"
  zip=$dir/$name
  metadata=$dir/installer_data.json
  flavour=rc
  case $variant in
    name) mv "$zip" "$dir/omarchy-rc.zip"; zip=$dir/omarchy-rc.zip; message='is not a rc mac image payload name' ;;
    install-conf) echo encrypt=1 >"$dir/payload/esp/omarchy/install.conf"; zip_payload "$dir" "$name"
      message='the image carries install.conf' ;;
    wrong-uuid) printf '\x01' | dd of="$dir/payload/boot.img" bs=1 seek=$((0x468)) conv=notrunc 2>/dev/null
      zip_payload "$dir" "$name"; message='does not carry the Boot UUID' ;;
    no-omarchy) rm -rf "$dir/payload/esp/omarchy"; zip_payload "$dir" "$name"; message='missing members: esp/omarchy/' ;;
    extra-member) echo notes >"$dir/payload/NOTES"
      (cd "$dir/payload" && bsdtar --format zip -cf "$zip" esp boot.img root.img omarchy-volume.icns NOTES)
      message='unexpected member NOTES' ;;
    luks) printf 'LUKS\xba\xbe' | dd of="$dir/payload/root.img" bs=1 seek=0 conv=notrunc 2>/dev/null
      zip_payload "$dir" "$name"; message='carries a LUKS header' ;;
  esac
  expect_refusal "$message" check_payload "$flavour" "$zip" "$metadata"
done
echo "ok - $description with another name, install.conf, UUID, missing esp/omarchy or a LUKS root is refused"

description='a PROVENANCE and IMAGE'
dir=$case_dir/descriptor
rm -rf "$dir"
mkdir -p "$dir"
cp "$base/$name" "$base/installer_data.json" "$dir/"
{
  printf 'format=1\nkind=mac-image\nlane=rc\nkernel=linux-aurora\npkgs_commit=%s\ninputs_sha256=%s\n' \
    "$stable_commit" "$(hex e)"
  printf 'package_count=1\npackage=1|base|3-3|base-3-3-any.pkg.tar.zst|%s\n' "$(hex f)"
  printf 'installer_data_sha256=%s\n' "$(sha "$dir/installer_data.json")"
  printf 'payload=%s|%s|%s\n' "$name" "$(wc -c <"$dir/$name" | tr -d ' ')" "$(sha "$dir/$name")"
} >"$dir/PROVENANCE"
python3 "$check_script" provenance rc "$dir" >"$case_dir/output" 2>&1 ||
  fail "$description of the built bytes is refused $(<"$case_dir/output")"
python3 - "$dir" "$name" "$runtime_tag" "$aurora_commit" "$(sha "$tmp/builder-inputs")" <<'PY'
import hashlib, sys, zipfile
from pathlib import Path
directory, name, runtime, aurora, digest = sys.argv[1:]
members = {}
with zipfile.ZipFile(Path(directory) / name) as archive:
    for info in archive.infolist():
        if info.is_dir():
            continue
        members[info.filename] = hashlib.sha256(archive.read(info)).hexdigest()
lines = [
    "format=1",
    "lane=rc",
    "package_channel=asahi-packages-channel-6",
    f"runtime_release={runtime}",
    f"aurora_release=aurora-packages-{aurora}",
]
for member, sha in sorted(members.items()):
    lines.append(f"image_sha256={member}|{sha}")
lines.append(f"input_digest={digest}")
Path(directory, "IMAGE").write_text("\n".join(lines) + "\n")
PY
python3 "$check_script" descriptor rc "$dir" >"$case_dir/output" 2>&1 ||
  fail "$description IMAGE is refused $(<"$case_dir/output")"
python3 "$check_script" "$dir/$name" >"$case_dir/output" 2>&1 ||
  fail "$description zip-only check is refused"
echo "ok - $description is signed only when IMAGE names exactly the payload members"

# ── workflow ───────────────────────────────────────────────────────────────
workflow=$ROOT/.github/workflows/release-mac-image.yml
description='the Mac image workflow'
job() { awk -v job="  $1:" '$0 == job { inside = 1; next } inside && /^  [a-z-]+:$/ { exit } inside' "$workflow"; }
has() { grep -Fq -- "$2" <<<"$1" || fail "$description: $3 lacks '$2'"; }
[[ $(awk '/^  [a-z-]+:$/ { sub(/:$/, ""); sub(/^  /, ""); print }' "$workflow" | paste -sd' ' -) == \
  'signing-check inputs build sign publish' ]] ||
  fail "$description: has the signing check, inputs, build, sign and publish jobs, in that order"
grep -Fxq '  workflow_dispatch:' "$workflow" || fail "$description: runs only when dispatched"

check_job=$(job signing-check)
for line in 'environment: asahi-quattro-release' "run: '[[ \$GITHUB_REF == refs/heads/asahi-quattro ]]'" \
  'secrets.OMARCHY_ARM_REPOSITORY_SIGNING_SUBKEY' 'bin/asahi-signing-subkey-validate'; do
  has "$check_job" "$line" 'the signing check'
done
inputs_job=$(job inputs)
for line in 'needs: signing-check' 'test/mac-image' 'name: mac-image-inputs' \
  'bin/mac-image-inputs run /tmp/mac-image-inputs "${arguments[@]}" | tee -a "$GITHUB_OUTPUT"'; do
  has "$inputs_job" "$line" 'the inputs job'
done
build_job=$(job build)
for line in 'needs: inputs' 'runs-on: ubuntu-24.04-arm' 'lane: [edge, rc, stable]' 'name: mac-image-${{ matrix.lane }}' \
  'bin/build-mac-image --inputs /tmp/mac-image-inputs/inputs "$LANE" "/tmp/mac-image-$LANE"'; do
  has "$build_job" "$line" 'the build job'
done
! grep -Eq 'secrets\.|environment:|GPG_PASSPHRASE|--local-package' <<<"$build_job" ||
  fail "$description: the privileged build sees no secret, gate or local package"
sign_job=$(job sign)
for line in 'needs: [signing-check, build]' 'environment: asahi-quattro-release' 'runs-on: ubuntu-latest' \
  'bin/mac-image-check descriptor "$LANE" /tmp/mac-image' \
  'secrets.OMARCHY_ARM_REPOSITORY_SIGNING_SUBKEY' 'secrets.OMARCHY_ARM_REPOSITORY_SIGNING_PASSPHRASE' \
  '--local-user "$fingerprint!"' '--detach-sign /tmp/mac-image/IMAGE' \
  'gpg --batch --homedir "$home" --import keys/asahi-repository-signing.asc' \
  '/tmp/mac-image/IMAGE.sig'; do
  has "$sign_job" "$line" 'the sign job'
done
(($(grep -n 'mac-image-check descriptor' <<<"$sign_job" | cut -d: -f1) < $(grep -n -- '--detach-sign' <<<"$sign_job" | cut -d: -f1) &&
  $(grep -n -- '--detach-sign' <<<"$sign_job" | cut -d: -f1) < $(grep -n 'VALIDSIG' <<<"$sign_job" | cut -d: -f1))) ||
  fail "$description: checks IMAGE against the bytes, then signs, then verifies"
publish_job=$(job publish)
for line in 'needs: [sign]' 'mac-image-$sequence-$LANE' 'gh release create' 'IMAGE.sig' '--latest=false'; do
  has "$publish_job" "$line" 'the publish job'
done
echo "ok - $description is gated, resolves once, builds all three lanes on arm64 without secrets, signs IMAGE, and publishes mac-image-<S>-<lane>"

planner=$ROOT/pkgbuilds/asahi-planner-classes
grep -Fxq 'bin/build-mac-image|mac image lane' "$planner" || fail "planner lacks bin/build-mac-image"
grep -Fxq 'bin/mac-image-check|mac image lane' "$planner" || fail "planner lacks bin/mac-image-check"
grep -Fxq 'bin/mac-image-inputs|mac image lane' "$planner" || fail "planner lacks bin/mac-image-inputs"
grep -Fxq 'test/mac-image|mac image lane' "$planner" || fail "planner lacks test/mac-image"
grep -Fxq '.github/workflows/release-mac-image.yml|mac image lane' "$planner" || fail "planner lacks the workflow"
echo "ok - the planner classifies the Mac image lane"
