  ln -s /etc/systemd/system/omarchy-vendor-firmware.service "$tree/etc/systemd/system/multi-user.target.wants/"
  ln -s /usr/lib/systemd/system/NetworkManager.service "$tree/etc/systemd/system/multi-user.target.wants/"
  ln -s /usr/lib/systemd/system/systemd-resolved.service "$tree/etc/systemd/system/sysinit.target.wants/"
  ln -s /usr/lib/systemd/system/systemd-timesyncd.service "$tree/etc/systemd/system/sysinit.target.wants/"
  printf 'linux-aurora\n' >"$tree/usr/share/omarchy/apple-silicon-kernel"
  for name in "${PACKAGES[@]}" linux-aurora linux-aurora-headers m1n1-aurora omarchy-apple-boot omarchy-first-boot; do
    mkdir -p "$tree/var/lib/pacman/local/$name-1-1"
    printf '%%NAME%%\n%s\n\n%%VERSION%%\n1-1\n' "$name" >"$tree/var/lib/pacman/local/$name-1-1/desc"
  done
  : >"$tree/etc/machine-id"
  printf 'omarchy\n' >"$tree/etc/hostname"
  ln -s ../run/systemd/resolve/stub-resolv.conf "$tree/etc/resolv.conf"
  printf '[device]\nwifi.backend=iwd\n' >"$tree/etc/NetworkManager/conf.d/wifi_backend.conf"
  printf 'root:*:14871::::::\n' >"$tree/etc/shadow"
  printf 'root:x:0:0::/root:/bin/bash\n' >"$tree/etc/passwd"
  tarball=$tree/var/lib/omarchy/provisioning/packages/node-v26.8.1-linux-arm64.tar.gz
  printf 'node fixture\n' >"$tarball"
  chmod 0444 "$tarball"
  node_sha=$(sha "$tarball")
  node_size=$(wc -c <"$tarball" | tr -d ' ')
  printf 'version=26.8.1\nurl=https://nodejs.org/dist/v26.8.1/node-v26.8.1-linux-arm64.tar.gz\nsize=%s\nsha256=%s\n' \
    "$node_size" "$node_sha" >"$tree/usr/lib/omarchy/first-boot/node.pin"
  printf '#!/bin/bash\nexit 0\n' >"$tree/usr/bin/mac-image-finalize"
  chmod 0755 "$tree/usr/bin/mac-image-finalize"
}

