[[ $(readlink "$target/etc/systemd/system/multi-user.target.wants/omarchy-provision-owner.service") == \
  /etc/systemd/system/omarchy-provision-owner.service ]] || fail "$description: does not enable owner provisioning"
echo "ok - $description downloads the pinned tarball and arms provisioning/pending"

description='the chroot installer environment'
