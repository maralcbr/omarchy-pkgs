  printf 'format=1\nworkflow_run=35337257961\n' >"$work/CANDIDATE"
  write_fstab
  write_installed_config
  write_lane_and_pending
  echo kernel >"$tree/boot/vmlinuz-linux-aurora"
  echo initramfs >"$tree/boot/initramfs-linux-aurora.img"
  cat >"$tree/boot/grub/grub.cfg" <<EOF
menuentry 'Omarchy' {
	search --no-floppy --fs-uuid --set=root $BOOT_UUID
	linux	/vmlinuz-linux-aurora root=UUID=$ROOT_UUID rw rootflags=subvol=@  zswap.enabled=0 rootfstype=btrfs quiet loglevel=3 splash
	initrd	/initramfs-linux-aurora.img
}
EOF
  echo efi >"$tree/boot/efi/EFI/BOOT/BOOTAA64.EFI"
