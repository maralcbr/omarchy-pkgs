description='an image tree'
for variant in not-armed not-provisioning-armed no-node bad-node no-lane no-preset fstab install-conf mac-install-conf \
  user first-boot both-kernels builder-marker root-password machine-id omarchy-not-empty journal encrypt-state \
  factory-mismatch no-boot-omarchy boot-omarchy-not-empty no-finalize unsigned-omarchy factory-pending; do
  tree=$case_dir/$variant
  make_tree "$tree" rc
  factory=$case_dir/$variant-factory
  make_factory "$factory"
  case $variant in
    not-armed) rm "$tree/var/lib/omarchy/mac-first-boot/pending"; message='first boot is not armed' ;;
    not-provisioning-armed) rm "$tree/var/lib/omarchy/provisioning/pending"; message='owner provisioning is not armed' ;;
    no-node) rm "$tree/var/lib/omarchy/provisioning/packages/node-v26.8.1-linux-arm64.tar.gz"; message='Node.js is not staged' ;;
    no-lane) rm "$tree/var/lib/omarchy/apple-silicon-aurora-lane"; message='the lane file is missing' ;;
    no-preset) rm "$tree/etc/systemd/system/sysinit.target.wants/systemd-timesyncd.service"
      message="systemd-timesyncd.service is not the preset's enable link" ;;
    fstab) sed -i.bak "s/$BOOT_UUID/$ROOT_UUID/" "$tree/etc/fstab"; message='fstab does not mount the fixed UUIDs' ;;
    install-conf) echo encrypt=1 >"$tree/boot/efi/omarchy/install.conf"; message='the image carries install.conf' ;;
    mac-install-conf) echo encrypt=1 >"$tree/var/lib/omarchy/mac-first-boot/install.conf"
      message='the image carries install.conf' ;;
    user) printf 'alice:x:1000:1000::/home/alice:/bin/bash\n' >>"$tree/etc/passwd"; message='the image has a user' ;;
    first-boot) ln -s /usr/lib/systemd/system/omarchy-first-boot.service \
      "$tree/etc/systemd/system/multi-user.target.wants/omarchy-first-boot.service"
      message='omarchy-first-boot.service is enabled on a finished image' ;;
    both-kernels) mkdir -p "$tree/var/lib/pacman/local/linux-asahi-1-1"
      printf '%%NAME%%\nlinux-asahi\n' >"$tree/var/lib/pacman/local/linux-asahi-1-1/desc"; message='also installs linux-asahi' ;;
    builder-marker) : >"$tree/boot/efi/.builder"; message='keeps the builder marker' ;;
    root-password) printf 'root::14871::::::\n' >"$tree/etc/shadow"; message='root can log in without a password' ;;
    machine-id) echo 0123 >"$tree/etc/machine-id"; message='/etc/machine-id is not empty' ;;
    omarchy-not-empty) echo x >"$tree/boot/efi/omarchy/notes"; message='/boot/efi/omarchy is not empty' ;;
    journal) mkdir -p "$tree/var/log/journal/abc"; echo log >"$tree/var/log/journal/abc/system.journal"
      message='the image has a journal' ;;
    encrypt-state) echo 'format=1' >"$tree/boot/omarchy/encrypt.state"; message='the image carries encrypt.state' ;;
    factory-mismatch) sed -i.bak 's/package_stable_tag=.*/package_stable_tag=asahi-packages-stable-deadbeef/' \
      "$factory/var/lib/omarchy/factory-sealed"; message='@factory marker mismatch' ;;
    no-boot-omarchy) rmdir "$tree/boot/omarchy"; message='/boot/omarchy does not exist' ;;
    boot-omarchy-not-empty) echo x >"$tree/boot/omarchy/notes"; message='/boot/omarchy is not empty' ;;
    no-finalize) rm "$tree/usr/bin/mac-image-finalize"; message='the image has no mac-image-finalize or apple-image-finalize' ;;
    unsigned-omarchy) sed -i.bak 's/SigLevel = Required DatabaseOptional/SigLevel = Optional/' "$tree/etc/pacman.conf"
      message='[omarchy] is not the SigLevel and stable Server' ;;
    factory-pending) mkdir -p "$factory/var/lib/omarchy/provisioning"; : >"$factory/var/lib/omarchy/provisioning/pending"
      message='@factory carries a provisioning marker' ;;
    bad-node) chmod u+w "$tree/var/lib/omarchy/provisioning/packages/node-v26.8.1-linux-arm64.tar.gz"
      echo tampered >>"$tree/var/lib/omarchy/provisioning/packages/node-v26.8.1-linux-arm64.tar.gz"
      message='the staged Node.js does not match its pin' ;;
  esac
  expect_refusal "$message" check_tree rc "$tree" "$factory"
done
echo "ok - $description that is not armed, lacks Node, carries install.conf, a journal, encrypt.state, or another fstab is refused"

