[[ $(python3 -c "import os, stat; print(format(stat.S_IMODE(os.stat('$target/var/lib/omarchy/provisioning/packages/node-v26.8.1-linux-arm64.tar.gz').st_mode), 'o'))") == 444 ]] ||
