#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
script=$ROOT/bin/publish-asahi-channel-pointer
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export GNUPGHOME=$tmp/gnupg
mkdir -m 0700 "$GNUPGHOME"
stubs=$tmp/bin
mkdir -p "$stubs"

fail() {
  echo "not ok - $1" >&2
  [[ -z ${case_dir:-} || ! -f $case_dir/output ]] || cat "$case_dir/output" >&2
  exit 1
}

endpoint=https://account.r2.cloudflarestorage.com
bucket=omarchy-releases
public_base=https://downloads.example.invalid
cache_control='no-cache, max-age=0, must-revalidate'

# ── fakes ──────────────────────────────────────────────────────────────────
cat >"$stubs/gh" <<'STUB'
#!/bin/bash
set -euo pipefail
echo "gh $*" >>"$STUB_LOG"
jq_filter="" paginate=0 args=()
while (($#)); do
