description='release_sha256 mismatch'
new_case release-sha
printf 'format=1\nchannel=asahi-quattro\nsequence=33\nrelease_tag=%s\nsource_commit=%s\nmanifest=asahi-quattro-bundle.manifest\nmanifest_sha256=%s\nrelease_sha256=%s\n' \
  "$release_tag" "$source_commit" "$(sha "$(release_dir)/asahi-quattro-bundle.manifest")" "$(printf '0%.0s' {1..64})" \
