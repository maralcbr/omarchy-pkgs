sed 's/^sequence=33$/sequence=32/' "$(channel_dir)/asahi-quattro-channel" >"$case_dir/channel"
mv "$case_dir/channel" "$(channel_dir)/asahi-quattro-channel"
sign "$release_key" "$(channel_dir)/asahi-quattro-channel"
