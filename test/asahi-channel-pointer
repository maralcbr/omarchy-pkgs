chmod +x "$stubs"/*

# ── signed fixtures ────────────────────────────────────────────────────────
generate_key() {
  gpg --batch --pinentry-mode loopback --passphrase '' --quick-generate-key "$1" ed25519 sign 1d >/dev/null 2>&1
  gpg --batch --with-colons --list-keys "$1" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }'
}
release_key=$(generate_key 'Release Fixture <release@example.invalid>')
repository_key=$(generate_key 'Repository Fixture <repository@example.invalid>')
rogue_key=$(generate_key 'Rogue Fixture <rogue@example.invalid>')
gpg --batch --export "$release_key" >"$tmp/release.gpg"
gpg --batch --armor --export "$repository_key" >"$tmp/repository.asc"

sign() {
  gpg --batch --yes --pinentry-mode loopback --passphrase '' --local-user "$1!" --output "$2.sig" --detach-sign "$2"
}

sha() { sha256sum "$1" | cut -d' ' -f1; }

source_commit=0123456789abcdef0123456789abcdef01234567
release_tag=asahi-quattro-01234567
fixtures=$tmp/fixtures

release_json() {
  jq -n --arg tag "$1" --argjson draft "${2:-false}" --argjson prerelease "${3:-false}" --argjson immutable "${4:-true}" \
    '{tag_name:$tag,draft:$draft,prerelease:$prerelease,immutable:$immutable}'
}

build_fixtures() {
  local sequence=$1 rel chan index=0 name arch file
  rel=$fixtures/releases/$release_tag
  chan=$fixtures/releases/asahi-quattro-channel-$sequence
  mkdir -p "$rel" "$chan" "$fixtures/tags"
  {
    printf 'format=2\nbundle=asahi-quattro\nsource_commit=%s\npackage_count=6\n' "$source_commit"
    for entry in omarchy-keyring:any omarchy-settings-dev:aarch64 omarchy-dev:aarch64 omarchy-nvim:any \
      quickshell-git:aarch64 ttf-jetbrains-mono-nerd-basic:any; do
      index=$((index + 1))
      name=${entry%%:*} arch=${entry#*:}
      file=$name-1.0-1-$arch.pkg.tar.zst
      printf '%s archive\n' "$name" >"$rel/$file"
      sign "$repository_key" "$rel/$file"
      printf 'package=%s|%s|1.0-1|%s|%s|%s\n' "$index" "$name" "$arch" "$file" "$(sha "$rel/$file")"
    done
  } >"$rel/asahi-quattro-bundle.manifest"
  sign "$repository_key" "$rel/asahi-quattro-bundle.manifest"
  printf '#!/bin/bash\necho installer\n' >"$rel/install-asahi-quattro"
  sign "$release_key" "$rel/install-asahi-quattro"
  printf 'format=1\nbundle=asahi-quattro\nsequence=%s\nrelease_tag=%s\nsource_commit=%s\npackage_source_commit=%s\nmanifest_sha256=%s\n' \
    "$sequence" "$release_tag" "$source_commit" "$(printf 'c%.0s' {1..40})" "$(sha "$rel/asahi-quattro-bundle.manifest")" \
    >"$rel/asahi-quattro-release"
  sign "$release_key" "$rel/asahi-quattro-release"
  (cd "$rel" && sha256sum -- * >"$tmp/SHA256SUMS" && mv "$tmp/SHA256SUMS" SHA256SUMS)
  printf 'format=1\nchannel=asahi-quattro\nsequence=%s\nrelease_tag=%s\nsource_commit=%s\nmanifest=asahi-quattro-bundle.manifest\nmanifest_sha256=%s\nrelease_sha256=%s\n' \
    "$sequence" "$release_tag" "$source_commit" "$(sha "$rel/asahi-quattro-bundle.manifest")" "$(sha "$rel/asahi-quattro-release")" \
    >"$chan/asahi-quattro-channel"
  sign "$release_key" "$chan/asahi-quattro-channel"
  cp "$rel/install-asahi-quattro" "$rel/install-asahi-quattro.sig" "$chan/"
  release_json "$release_tag" >"$fixtures/tags/$release_tag.json"
  release_json "asahi-quattro-channel-$sequence" >"$fixtures/tags/asahi-quattro-channel-$sequence.json"
  jq -s '.' "$fixtures/tags/$release_tag.json" "$fixtures/tags/asahi-quattro-channel-$sequence.json" \
    <(release_json asahi-quattro-channel-32) <(release_json "asahi-packages-candidate-$(printf 'e%.0s' {1..40})" false true false) \
    >"$fixtures/releases.json"
}
build_fixtures 33

body() { printf 'format=1\nsequence=%s\ntag=asahi-quattro-channel-%s\n' "$1" "$1"; }

# ── case harness ───────────────────────────────────────────────────────────
case_dir=""
new_case() {
  case_dir=$tmp/case-$1
  mkdir -p "$case_dir/aws"
  cp -R "$fixtures" "$case_dir/gh"
  : >"$case_dir/log"
  : >"$case_dir/aws/puts"
}

seed_object() {
  cp "$1" "$case_dir/aws/object"
  jq -n --arg type "${2:-text/plain}" --arg cache "${3:-$cache_control}" '{ContentType:$type,CacheControl:$cache}' \
    >"$case_dir/aws/meta.json"
  echo '"etag-seed"' >"$case_dir/aws/etag"
}

add_release() {
  jq --argjson release "$(release_json "$@")" '. + [$release]' "$case_dir/gh/releases.json" >"$case_dir/gh/releases.next"
  mv "$case_dir/gh/releases.next" "$case_dir/gh/releases.json"
}

publish() {
  env PATH="$stubs:$PATH" STUB_LOG="$case_dir/log" GH_FIXTURES="$case_dir/gh" AWS_STATE="$case_dir/aws" \
    EXPECTED_ENDPOINT="$endpoint" EXPECTED_BUCKET="$bucket" \
    EXPECTED_PUBLIC_URL="$public_base/pointers/asahi-quattro-channel" \
    R2_BUCKET="$bucket" R2_ENDPOINT="$endpoint" R2_PUBLIC_BASE_URL="$public_base" \
    AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test \
    "$BASH" "$script" "$@" --keyring "$tmp/release.gpg" --signing-key "$tmp/repository.asc" \
    >"$case_dir/output" 2>&1
}

expect_success() {
  publish "$@" || fail "$description: publisher failed"
}

expect_refusal() {
  local message=$1
  shift
  if publish "$@"; then fail "$description: publisher succeeded"; fi
  grep -Fq -- "$message" "$case_dir/output" || fail "$description: expected '$message'"
}

puts() { wc -l <"$case_dir/aws/puts" | tr -d ' '; }

expect_no_write() {
  [[ $(puts) == 0 ]] || fail "$description: the pointer was written"
}

expect_object() {
  body "$1" | cmp -s - "$case_dir/aws/object" || fail "$description: stored pointer is not channel $1"
  jq -e --arg cache "$cache_control" '.ContentType == "text/plain" and .CacheControl == $cache' \
    "$case_dir/aws/meta.json" >/dev/null || fail "$description: stored metadata is wrong"
}

expect_verified() {
  grep -Fq 's3api head-object' "$case_dir/log" || fail "$description: metadata was not read back"
  [[ $(grep -c 's3api get-object' "$case_dir/log") == 2 ]] || fail "$description: bytes were not read back"
  grep -Fq "curl " "$case_dir/log" || fail "$description: public bytes were not read back"
  grep -Fq "verified $public_base/pointers/asahi-quattro-channel names asahi-quattro-channel-33" "$case_dir/output" ||
    fail "$description: no verification report"
}

# ── publisher cases ────────────────────────────────────────────────────────
description='absent pointer is created'
new_case absent
expect_success 33
[[ $(puts) == 1 ]] && grep -Fxq "put if-match= if-none-match=*" "$case_dir/aws/puts" ||
  fail "$description: create was not conditional on absence"
expect_object 33
expect_verified
echo "ok - $description with If-None-Match and verified"

description='older pointer moves forward'
new_case forward
body 32 >"$case_dir/current"
seed_object "$case_dir/current"
expect_success 33
grep -Fxq 'put if-match="etag-seed" if-none-match=' "$case_dir/aws/puts" || fail "$description: not conditional on the read ETag"
expect_object 33
expect_verified
echo "ok - $description with If-Match on the ETag it read"

description='identical pointer is not rewritten'
new_case same
body 33 >"$case_dir/current"
seed_object "$case_dir/current"
expect_success 33
expect_no_write
expect_verified
echo "ok - $description, yet fully verified"

description='identical bytes with wrong metadata'
new_case metadata
body 33 >"$case_dir/current"
seed_object "$case_dir/current" application/octet-stream 'max-age=3600'
expect_success 33
grep -Fxq 'put if-match="etag-seed" if-none-match=' "$case_dir/aws/puts" || fail "$description: no conditional rewrite"
expect_object 33
expect_verified
echo "ok - $description are rewritten conditionally and verified"

description='stale public readback'
new_case public-mismatch
body 33 >"$case_dir/current"
seed_object "$case_dir/current"
body 32 >"$case_dir/aws/public-override"
expect_refusal 'did not serve the pointer for asahi-quattro-channel-33 after 10 attempts' 33
expect_no_write
[[ $(grep -c '^curl ' "$case_dir/log") == 10 && $(grep -c '^sleep 6$' "$case_dir/log") == 9 ]] ||
  fail "$description: public readback was not retried 10 times 6 seconds apart"
echo "ok - $description fails even when the write was skipped"

description='newer pointer'
new_case backward
body 34 >"$case_dir/current"
seed_object "$case_dir/current"
expect_refusal 'already names channel 34, newer than 33' 33
expect_no_write
echo "ok - $description is never moved backwards"

description='same channel with different bytes'
new_case same-different
{ body 33; echo extra; } >"$case_dir/current"
seed_object "$case_dir/current"
expect_refusal 'is malformed; rerun with --replace-malformed' 33
expect_no_write
echo "ok - $description is refused"

description='malformed pointer'
for variant in extra-line wrong-order tag-mismatch leading-zero crlf no-newline; do
  new_case "malformed-$variant"
  case $variant in
    extra-line) { body 31; echo 'note=x'; } ;;
    wrong-order) printf 'sequence=31\nformat=1\ntag=asahi-quattro-channel-31\n' ;;
    tag-mismatch) printf 'format=1\nsequence=31\ntag=asahi-quattro-channel-30\n' ;;
    leading-zero) printf 'format=1\nsequence=031\ntag=asahi-quattro-channel-031\n' ;;
    crlf) printf 'format=1\r\nsequence=31\r\ntag=asahi-quattro-channel-31\r\n' ;;
    no-newline) printf 'format=1\nsequence=31\ntag=asahi-quattro-channel-31' ;;
  esac >"$case_dir/current"
  seed_object "$case_dir/current"
  expect_refusal 'is malformed; rerun with --replace-malformed' 33
  expect_no_write
done
echo "ok - $description variants are refused without --replace-malformed"

description='malformed pointer with --replace-malformed'
new_case replace-malformed
printf 'garbage\n' >"$case_dir/current"
seed_object "$case_dir/current"
expect_success 33 --replace-malformed
grep -Fxq 'put if-match="etag-seed" if-none-match=' "$case_dir/aws/puts" || fail "$description: replacement was not conditional"
expect_object 33
expect_verified
echo "ok - $description is replaced conditionally"

description='higher published channel'
new_case higher
add_release asahi-quattro-channel-34
expect_refusal 'channel 34 exists; publish that' 33
expect_no_write
! grep -Fq 's3api get-object' "$case_dir/log" || fail "$description: R2 was read before eligibility"
echo "ok - $description is refused"

description='higher prerelease and draft channels'
new_case prerelease
add_release asahi-quattro-channel-35 false true
add_release asahi-quattro-channel-36 true false
add_release asahi-quattro-channel-1000000000 true false
expect_success 33
expect_object 33
echo "ok - $description are ignored"

description='get-object error other than NoSuchKey'
new_case get-error
echo AccessDenied >"$case_dir/aws/get-error"
expect_refusal 'refusing to write without the current pointer' 33
expect_no_write
echo "ok - $description fails closed"

description='concurrent writer'
new_case race
body 32 >"$case_dir/current"
seed_object "$case_dir/current"
touch "$case_dir/aws/race"
expect_refusal 'another writer changed pointers/asahi-quattro-channel' 33
body 32 | cmp -s - "$case_dir/aws/object" || fail "$description: the other writer's object was overwritten"
echo "ok - $description makes the conditional put fail"

description='AWS CLI without conditional writes'
new_case old-aws
if AWS_STUB_NO_CONDITIONAL=1 publish 33; then fail "$description: publisher succeeded"; fi
grep -Fq 'cannot make conditional writes' "$case_dir/output" || fail "$description: no capability error"
! grep -Eq '^gh |s3api (get|put|head)-object --bucket' "$case_dir/log" || fail "$description: work started before the probe"
echo "ok - $description is refused before any read"

# ── channel validation cases ───────────────────────────────────────────────
channel_dir() { echo "$case_dir/gh/releases/asahi-quattro-channel-33"; }
release_dir() { echo "$case_dir/gh/releases/$release_tag"; }

description='tampered channel signature'
new_case bad-channel-signature
printf 'x' >>"$(channel_dir)/asahi-quattro-channel"
expect_refusal 'signature verification failed for asahi-quattro-channel in asahi-quattro-channel-33' 33
expect_no_write
echo "ok - $description is refused"

description='channel signed by another key'
new_case rogue-channel
sign "$rogue_key" "$(channel_dir)/asahi-quattro-channel"
expect_refusal 'signature verification failed for asahi-quattro-channel' 33
expect_no_write
echo "ok - $description is refused"

description='install-asahi-quattro signature failure'
new_case bad-installer
printf 'echo tampered\n' >>"$(channel_dir)/install-asahi-quattro"
expect_refusal 'signature verification failed for install-asahi-quattro in asahi-quattro-channel-33' 33
expect_no_write
echo "ok - $description is refused"

description='release descriptor signature failure'
