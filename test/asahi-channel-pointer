description='mutable channel release'
new_case mutable-channel
release_json asahi-quattro-channel-33 false false false >"$case_dir/gh/tags/asahi-quattro-channel-33.json"
expect_refusal 'release asahi-quattro-channel-33 must be published (not a draft or prerelease) and immutable' 33
expect_no_write
echo "ok - $description is refused"

description='mutable runtime release'
new_case mutable-release
release_json "$release_tag" false false false >"$case_dir/gh/tags/$release_tag.json"
expect_refusal "release $release_tag must be published (not a draft or prerelease) and immutable" 33
expect_no_write
echo "ok - $description is refused"

description='prerelease channel'
new_case prerelease-channel
release_json asahi-quattro-channel-33 false true true >"$case_dir/gh/tags/asahi-quattro-channel-33.json"
expect_refusal 'release asahi-quattro-channel-33 must be published' 33
expect_no_write
echo "ok - $description is refused"

description='SHA256SUMS failure'
new_case sha256sums
printf 'echo tampered\n' >>"$(release_dir)/install-asahi-quattro"
expect_refusal "SHA256SUMS in $release_tag does not verify" 33
expect_no_write
echo "ok - $description is refused"

description='manifest signed by the release key'
new_case manifest-signature
sign "$release_key" "$(release_dir)/asahi-quattro-bundle.manifest"
(cd "$(release_dir)" && sha256sum -- $(ls | grep -vx SHA256SUMS) >"$case_dir/SHA256SUMS" && mv "$case_dir/SHA256SUMS" SHA256SUMS)
expect_refusal "signature verification failed for asahi-quattro-bundle.manifest in $release_tag" 33
expect_no_write
echo "ok - $description instead of the repository key is refused"

description='package signature failure'
new_case package-signature
sign "$rogue_key" "$(release_dir)/omarchy-dev-1.0-1-aarch64.pkg.tar.zst"
(cd "$(release_dir)" && sha256sum -- $(ls | grep -vx SHA256SUMS) >"$case_dir/SHA256SUMS" && mv "$case_dir/SHA256SUMS" SHA256SUMS)
expect_refusal "signature verification failed for omarchy-dev-1.0-1-aarch64.pkg.tar.zst in $release_tag" 33
expect_no_write
echo "ok - $description is refused"

description='package missing from SHA256SUMS'
new_case unlisted-package
grep -v 'omarchy-nvim-1.0-1-any.pkg.tar.zst.sig$' "$(release_dir)/SHA256SUMS" >"$case_dir/SHA256SUMS"
mv "$case_dir/SHA256SUMS" "$(release_dir)/SHA256SUMS"
expect_refusal "SHA256SUMS in $release_tag does not list omarchy-nvim-1.0-1-any.pkg.tar.zst.sig" 33
expect_no_write
echo "ok - $description is refused"

description='package missing from the release'
new_case missing-package
rm "$(release_dir)/quickshell-git-1.0-1-aarch64.pkg.tar.zst"
grep -v ' quickshell-git-1.0-1-aarch64.pkg.tar.zst$' "$(release_dir)/SHA256SUMS" >"$case_dir/SHA256SUMS"
mv "$case_dir/SHA256SUMS" "$(release_dir)/SHA256SUMS"
expect_refusal "$release_tag is missing quickshell-git-1.0-1-aarch64.pkg.tar.zst" 33
expect_no_write
echo "ok - $description is refused"

# ── arguments and environment ──────────────────────────────────────────────
description='invalid arguments'
new_case arguments
for arguments in "" "0" "033" "1234567890" "33x" "33 34" "33 --unknown" "33 --keyring"; do
  # shellcheck disable=SC2086
  if env PATH="$stubs:$PATH" STUB_LOG="$case_dir/log" "$BASH" "$script" $arguments >/dev/null 2>&1; then
    fail "$description: '$arguments' was accepted"
  fi
done
[[ ! -s $case_dir/log ]] || fail "$description: work started for invalid arguments"
echo "ok - $description are refused before any work"

description='missing R2 configuration'
new_case environment
if env PATH="$stubs:$PATH" STUB_LOG="$case_dir/log" R2_BUCKET="$bucket" R2_ENDPOINT="$endpoint" \
  AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test "$BASH" "$script" 33 \
  --keyring "$tmp/release.gpg" --signing-key "$tmp/repository.asc" >"$case_dir/output" 2>&1; then
  fail "$description: publisher succeeded"
fi
grep -Fq 'R2_PUBLIC_BASE_URL must be an https origin' "$case_dir/output" || fail "$description: no configuration error"
if R2_ACCOUNT_ID=other publish 33; then fail "$description: endpoint of another account accepted"; fi
grep -Fq 'R2_ENDPOINT does not belong to R2_ACCOUNT_ID' "$case_dir/output" || fail "$description: no account error"
echo "ok - $description and a foreign endpoint are refused"

# ── wiring ─────────────────────────────────────────────────────────────────
release_workflow=$ROOT/.github/workflows/release-asahi-quattro.yml
promote_workflow=$ROOT/.github/workflows/promote-asahi-quattro-runtime.yml
pointer_workflow=$ROOT/.github/workflows/publish-asahi-channel-pointer.yml
installer=$ROOT/.github/scripts/install-aws-cli.sh

last_step() { grep -E '^      - (name|uses):' "$1" | tail -1 | sed 's/^      - name: //'; }
step_before_last() { grep -E '^      - (name|uses):' "$1" | tail -2 | head -1 | sed 's/^      - name: //'; }

[[ $(last_step "$release_workflow") == 'Publish release channel pointer' &&
  $(step_before_last "$release_workflow") == 'Verify fresh public release downloads' ]] ||
  fail 'release workflow publishes the pointer after verifying fresh public downloads'
[[ $(last_step "$promote_workflow") == 'Publish release channel pointer' &&
  $(step_before_last "$promote_workflow") == 'Verify immutable public channel' ]] ||
  fail 'promotion publishes the pointer after verifying the immutable public channel'
for workflow in "$release_workflow" "$promote_workflow" "$pointer_workflow"; do
  pointer_step=$(sed -n '/- name: Publish release channel pointer/,$p' "$workflow")
  for expected in \
    'AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}' \
    'AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}' \
    'AWS_DEFAULT_REGION: auto' \
    'R2_ACCOUNT_ID: ${{ vars.R2_ACCOUNT_ID }}' \
    'R2_BUCKET: ${{ vars.R2_BUCKET }}' \
    'R2_ENDPOINT: ${{ vars.R2_ENDPOINT }}' \
    'R2_PUBLIC_BASE_URL: ${{ vars.R2_PUBLIC_BASE_URL }}' \
    '.github/scripts/install-aws-cli.sh' \
    'bin/publish-asahi-channel-pointer "$RELEASE_SEQUENCE"' \
    '--keyring /tmp/omarchy-quattro/default/omarchy-release.gpg' \
    '--signing-key keys/asahi-repository-signing.asc'; do
    grep -Fq -- "$expected" <<<"$pointer_step" || fail "$(basename "$workflow") pointer step has $expected"
  done
  grep -Fq 'environment: asahi-quattro-release' "$workflow" || fail "$(basename "$workflow") uses the release environment"
done
for workflow in "$release_workflow" "$promote_workflow"; do
  grep -Fq "group: \${{ inputs.mode == 'publish' && 'asahi-quattro-release'" "$workflow" ||
    fail "$(basename "$workflow") still serialises publication on asahi-quattro-release"
done

grep -Fq 'workflow_dispatch:' "$pointer_workflow" || fail 'pointer repair workflow is dispatched manually'
sed -n '/^    inputs:/,/^permissions:/p' "$pointer_workflow" >"$tmp/inputs"
grep -Eq '^      sequence:$' "$tmp/inputs" && sed -n '/^      sequence:/,/^      [a-z_]*:$/p' "$tmp/inputs" | grep -Fq 'required: true' ||
  fail 'pointer repair workflow requires a sequence'
sed -n '/^      replace_malformed:/,$p' "$tmp/inputs" | grep -Fq 'type: boolean' &&
  sed -n '/^      replace_malformed:/,$p' "$tmp/inputs" | grep -Fq 'default: false' ||
  fail 'pointer repair workflow offers replace_malformed, off by default'
grep -Fxq '  group: asahi-quattro-release' "$pointer_workflow" && grep -Fxq '  cancel-in-progress: false' "$pointer_workflow" ||
  fail 'pointer repair workflow shares the publication concurrency group'
grep -Fq '[[ ${primary_fingerprints[0]} == "$RELEASE_KEY_FINGERPRINT" ]]' "$pointer_workflow" &&
  grep -Fq 'RELEASE_KEY_FINGERPRINT: 5983B1CA32CB778F4D74D24ECFF35022CA5B5959' "$pointer_workflow" ||
  fail 'pointer repair workflow pins the release key fingerprint'
grep -Fq 'merge-base --is-ancestor "$SOURCE_COMMIT" origin/main' "$pointer_workflow" ||
  fail 'pointer repair workflow reads the release key from public omarchy-mx-mac main'
grep -Fq '[[ $GITHUB_REF == "refs/heads/asahi-quattro" ]]' "$pointer_workflow" ||
  fail 'pointer repair workflow only runs from asahi-quattro'
grep -Fq '[[ $REPLACE_MALFORMED == "true" ]]' "$pointer_workflow" || fail 'pointer repair workflow forwards replace_malformed'
grep -Fxq '          test/asahi-channel-pointer' "$pointer_workflow" || fail 'pointer repair workflow runs the publisher tests first'
if grep -E '^[[:space:]]*(- )?uses:' "$pointer_workflow" | grep -Ev '@[0-9a-f]{40}( |$)' | grep -q .; then
  fail 'pointer repair workflow pins actions by commit'
fi

grep -Fxq 'AWS_CLI_VERSION=2.36.40' "$installer" || fail 'AWS CLI version is pinned'
grep -Fxq 'AWS_CLI_KEY_FINGERPRINT=FB5DB77FD5C118B80511ADA8A6310ACC4672475C' "$installer" || fail 'AWS CLI signer is pinned'
gpg --batch --show-keys --with-colons "$ROOT/.github/scripts/aws-cli-team.asc" |
  grep -Fxq 'fpr:::::::::FB5DB77FD5C118B80511ADA8A6310ACC4672475C:' || fail 'AWS CLI Team key has the pinned fingerprint'
echo 'ok - both runtime publication jobs and the repair workflow publish the pointer with a pinned conditional-write AWS CLI'
