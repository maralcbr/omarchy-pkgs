#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
workflow="$ROOT/.github/workflows/promote-asahi-quattro-runtime.yml"
publisher="$ROOT/bin/release-asahi-quattro"
installer="$ROOT/bin/install-asahi-quattro"
certificate="$ROOT/keys/asahi-repository-signing.asc"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

[[ -s $workflow ]] || fail 'candidate-only runtime promotion workflow exists'
[[ -s $certificate ]] || fail 'repository signing certificate is pinned'
gpg --batch --show-keys --with-colons "$certificate" |
  grep -Fxq 'fpr:::::::::CAB18E175BFB9ACCE185234474DE0C737AC186E4:' ||
  fail 'pinned certificate contains the expected repository signing subkey'
grep -Fq '[[ $(jq -r .immutable <<<"$release_json") == "true" ]]' "$workflow" ||
  fail 'promotion requires an immutable candidate release'
grep -Fq '[[ $(sha256sum CANDIDATE | cut -d' "$workflow" ||
  fail 'promotion pins the signed candidate descriptor digest'
grep -Fq 'sha256sum --check --strict RUNTIME-SHA256SUMS' "$workflow" ||
  fail 'promotion verifies the complete runtime checksum inventory'
grep -Fq 'exact-asahi-runtime-candidate' "$workflow" ||
  fail 'verified runtime bytes cross the workflow boundary as one artifact'
grep -Fq 'Promote exact runtime assets without rebuilding' "$workflow" ||
  fail 'publication has an explicit no-rebuild boundary'
grep -Fq 'name: Install promotion tools' "$workflow" ||
  fail 'publication installs the package metadata verifier on its own runner'
grep -Fq 'ASAHI_RUNTIME_CANDIDATE_MANIFEST=' "$workflow" ||
  fail 'publisher receives the exact candidate manifest'
grep -Fq 'key=$GITHUB_WORKSPACE/keys/asahi-repository-signing.asc' "$workflow" ||
  fail 'promotion verifies candidates with the pinned public repository certificate'
grep -Fq 'gpg --batch --dearmor --output /tmp/candidate-signing.gpg "$key"' "$workflow" ||
  fail 'promotion converts the armored certificate into a gpgv keyring'
grep -Fq 'ASAHI_PACKAGE_SOURCE_COMMIT=' "$workflow" ||
  fail 'release descriptor is bound to the candidate package commit'
grep -Fq 'cmp --silent "$candidate_manifest" "$manifest"' "$publisher" ||
  fail 'publisher proves the candidate manifest matches the promoted archives'
grep -Fq 'gpg --batch --dearmor --output "$candidate_keyring" "$candidate_key"' "$publisher" ||
  fail 'publisher converts the armored certificate into a gpgv keyring'
grep -Fq 'gpgv --keyring "$candidate_keyring" "$archive.sig" "$archive"' "$publisher" ||
  fail 'publisher re-verifies every candidate package signature'
grep -Fq 'gh release download "$release_tag" --repo "$REPOSITORY" --dir "$existing_release_dir"' "$publisher" ||
  fail 'publisher reads back an existing immutable release before retrying publication'
grep -Fq 'cmp --silent "$immutable_asset" "$existing_asset"' "$publisher" ||
  fail 'publisher requires an existing immutable release to match the promoted bytes'
grep -Fq 'sha256sum --check --strict SHA256SUMS' "$publisher" ||
  fail 'publisher verifies the existing immutable checksum inventory'
grep -Fq 'gpg --batch --verify "$existing_release_dir/$signature"' "$publisher" ||
  fail 'publisher verifies generated signatures from the immutable release'
grep -Fq 'cp "$existing_release_dir/$signature" "$output_dir/$signature"' "$publisher" ||
  fail 'publisher reuses valid immutable signature bytes on a retry'
grep -Fq 'channel_tag="$CHANNEL_TAG_PREFIX-$ASAHI_QUATTRO_SEQUENCE"' "$publisher" ||
  fail 'publisher gives each signed channel an immutable sequence tag'
grep -Fq 'gh release create "$channel_tag"' "$publisher" ||
  fail 'publisher creates a new immutable channel release instead of replacing assets'
if grep -Fq 'gh release upload "$CHANNEL_TAG"' "$publisher"; then
  fail 'publisher still attempts to replace the frozen legacy channel'
fi
grep -Fq 'ASAHI_QUATTRO_RELEASES_API_URL' "$installer" ||
  fail 'bootstrap installer dynamically discovers immutable channel releases'
grep -Fq "sort -u -t- -k4,4n | tail -1" "$installer" ||
  fail 'bootstrap installer selects the newest immutable channel sequence'
if grep -Eq '(^|[^a-z-])jq( |$)' "$installer"; then
  fail 'bootstrap installer must not require jq, which Asahi Arch Minimal lacks'
fi
grep -Fq 'PACKAGE_KEY_FINGERPRINT=C81AC3E2A99556F9B21D5FEA3DD49BC9F8360BDC' "$installer" ||
  fail 'bootstrap installer pins the repository package signing identity'
grep -Fq 'verify_release_signature "$channel" "$channel.sig"' "$installer" ||
  fail 'bootstrap installer verifies the channel with the release key'
grep -Fq 'verify_package_signature "$manifest" "$manifest.sig"' "$installer" ||
  fail 'bootstrap installer verifies the manifest with the package key'
grep -Fq 'verify_package_signature "$bundle_dir/$package_file"' "$installer" ||
  fail 'bootstrap installer verifies archives with the package key'
grep -Fq 'OMARCHY_ASAHI_PACKAGE_KEY_FILE="$package_key_file"' "$installer" ||
  fail 'bootstrap installer passes separate trust roots to the runtime updater'
grep -Fq 'name: Verify immutable public channel' "$workflow" ||
  fail 'promotion reads back the new immutable channel and bridge assets'
grep -Fq 'channel_json=$(gh api "repos/$GITHUB_REPOSITORY/releases/tags/$channel_tag")' "$workflow" ||
  fail 'promotion checks immutable channel metadata without requiring attestations'
grep -Fq '[[ $(jq -r .immutable <<<"$channel_json") == "true" ]]' "$workflow" ||
  fail 'promotion requires the public channel release to be immutable'
grep -Fq 'gpgv --keyring "$key" /tmp/public-channel/asahi-quattro-channel.sig' "$workflow" ||
  fail 'promotion verifies the public channel with the pinned release key'
grep -Fq 'cmp --silent "$filename" "/tmp/runtime/packages/$filename"' "$workflow" ||
  fail 'promotion proves public package bytes match the verified candidate artifact'
grep -Fq 'if (( RELEASE_SEQUENCE == current_sequence )); then' "$workflow" ||
  fail 'promotion can safely retry an already-published exact sequence'
grep -Fq 'grep -Fxq "package_source_commit=$candidate_commit"' "$workflow" ||
  fail 'same-sequence retries require the exact candidate package commit'
grep -Fq 'grep -Fxq "manifest_sha256=$manifest_sha256"' "$workflow" ||
  fail 'same-sequence retries require the exact candidate runtime manifest'
if sed -n '/name: Verify immutable public channel/,$p' "$workflow" | grep -Fq 'gh release verify'; then
  fail 'public channel readback incorrectly requires GitHub attestations'
fi

echo 'ok - Quattro promotion consumes one exact immutable runtime candidate'
