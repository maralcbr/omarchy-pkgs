#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
sources="$ROOT/pkgbuilds/asahi-repository-sources"
packages="$ROOT/pkgbuilds/asahi-repository-packages"
workflow="$ROOT/.github/workflows/release-asahi-packages.yml"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

[[ -s $sources && -s $packages ]] || fail "Asahi repository manifests exist"
[[ -z $(sort "$sources" | uniq -d) ]] || fail "Asahi repository sources are unique"
[[ -z $(sort "$packages" | uniq -d) ]] || fail "Asahi repository packages are unique"

while IFS= read -r source; do
  pkgbuild="$ROOT/pkgbuilds/$source/PKGBUILD"
  [[ -f $pkgbuild ]] || fail "Asahi repository source exists: $source"
  grep -Eq "^[[:space:]]*arch=.*('aarch64'|\"aarch64\"|[=( ]aarch64[ )]|'any'|\"any\"|[=( ]any[ )])" "$pkgbuild" ||
    fail "Asahi repository source declares ARM support: $source"
done <"$sources"

[[ $(wc -l <"$sources") == 12 ]] || fail "Asahi repository has the reviewed source count"
[[ $(wc -l <"$packages") == 21 ]] || fail "Asahi repository has the reviewed binary count"
grep -Fq 'ubuntu-24.04-arm' "$workflow" || fail "Asahi repository builds natively"
grep -Fq 'source: ${{ fromJSON(needs.plan.outputs.sources) }}' "$workflow" ||
  fail "Asahi repository builds sources as a matrix"
grep -Fq 'needs: assemble' "$workflow" || fail "publication waits for complete repository assembly"
grep -Fq 'environment: asahi-quattro-release' "$workflow" || fail "Asahi repository publishing is protected"
grep -Fq 'gpg --batch --verify' "$workflow" || fail "Asahi repository verifies package signatures"
grep -Fq 'OMARCHY_ARM_REPOSITORY_SIGNING_SUBKEY' "$workflow" ||
  fail "Asahi repository uses the dedicated ARM signing secret"
! grep -Fq 'secrets.OMARCHY_RELEASE_PRIVATE_KEY' "$workflow" ||
  fail "Asahi repository does not import the personal release key"
grep -Fq 'asahi-signing-subkey-validate "$ARM_REPOSITORY_SIGNING_FINGERPRINT" "$PERSONAL_RELEASE_MASTER_FINGERPRINT"' "$workflow" ||
  fail "Asahi signing key must be a subkey"
grep -Fq -- '--local-user "$RELEASE_KEY_FINGERPRINT!"' "$workflow" ||
  fail "Asahi signing forces the configured subkey"
# These are literal workflow and PKGBUILD assertions, not shell expansions.
# shellcheck disable=SC2016
grep -Fq 'git+$url.git#commit=$_commit' "$ROOT/pkgbuilds/retroarch-joypad-autoconfig-git/PKGBUILD" ||
  fail "Asahi repository Git sources are pinned"
# shellcheck disable=SC2016
grep -Fq 'GH_TOKEN="$REPOSITORY_ADMIN_TOKEN" gh api "repos/$GITHUB_REPOSITORY/immutable-releases"' "$workflow" ||
  fail "Asahi repository requires release immutability"
# shellcheck disable=SC2016
grep -Fq '[[ $release_tag == "asahi-packages-candidate-$GITHUB_SHA" ]]' "$workflow" ||
  fail "Asahi candidate tag uses the full commit"
grep -Fq -- '--prerelease --latest=false' "$workflow" ||
  fail "Asahi candidates are public prereleases"
# shellcheck disable=SC2016
grep -Fq '[[ $(gh api "repos/$GITHUB_REPOSITORY/releases/tags/$release_tag" --jq .immutable) == "true" ]]' "$workflow" ||
  fail "Asahi repository verifies release immutability"
# shellcheck disable=SC2016
grep -Fq 'gh release verify "$release_tag"' "$workflow" || fail "Asahi repository verifies GitHub release attestation"
# shellcheck disable=SC2016
grep -Fq 'sanitized=${archive//:/-}' "$workflow" || fail "Asahi repository filenames are artifact-safe"
(( $(grep -Fc 'libarchive-tools pacman-package-manager' "$workflow") == 3 )) ||
  fail "every repository producer installs repo-add runtime tools"
(( $(grep -Fc 'retention-days: 1' "$workflow") == 2 )) ||
  fail "every temporary package artifact expires after one day"

echo "ok - Asahi package repository publication is bounded and signed"
