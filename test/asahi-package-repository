#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
sources="$ROOT/pkgbuilds/asahi-repository-sources"
packages="$ROOT/pkgbuilds/asahi-repository-packages"
workflow="$ROOT/.github/workflows/release-asahi-packages.yml"

fail() {
  echo "not ok - $1" >&2
  exit 1
}

[[ -s $sources && -s $packages ]] || fail "Asahi repository manifests exist"
[[ -z $(sort "$sources" | uniq -d) ]] || fail "Asahi repository sources are unique"
[[ -z $(sort "$packages" | uniq -d) ]] || fail "Asahi repository packages are unique"

while IFS= read -r source; do
  pkgbuild="$ROOT/pkgbuilds/$source/PKGBUILD"
  [[ -f $pkgbuild ]] || fail "Asahi repository source exists: $source"
  grep -Eq "^[[:space:]]*arch=.*('aarch64'|\"aarch64\"|[=( ]aarch64[ )]|'any'|\"any\"|[=( ]any[ )])" "$pkgbuild" ||
    fail "Asahi repository source declares ARM support: $source"
done <"$sources"

[[ $(wc -l <"$sources") == 12 ]] || fail "Asahi repository has the reviewed source count"
[[ $(wc -l <"$packages") == 21 ]] || fail "Asahi repository has the reviewed binary count"
grep -Fq 'ubuntu-24.04-arm' "$workflow" || fail "Asahi repository builds natively"
grep -Fq 'environment: asahi-quattro-release' "$workflow" || fail "Asahi repository publishing is protected"
grep -Fq 'gpg --batch --verify' "$workflow" || fail "Asahi repository verifies package signatures"
# These are literal workflow and PKGBUILD assertions, not shell expansions.
# shellcheck disable=SC2016
grep -Fq 'git+$url.git#commit=$_commit' "$ROOT/pkgbuilds/retroarch-joypad-autoconfig-git/PKGBUILD" ||
  fail "Asahi repository Git sources are pinned"
# shellcheck disable=SC2016
grep -Fq 'gh api "repos/$GITHUB_REPOSITORY/immutable-releases"' "$workflow" ||
  fail "Asahi repository requires release immutability"
# shellcheck disable=SC2016
grep -Fq '[[ $release_tag == "asahi-packages-$GITHUB_SHA" ]]' "$workflow" ||
  fail "Asahi repository release tag uses the full commit"
# shellcheck disable=SC2016
grep -Fq '[[ $(gh api "repos/$GITHUB_REPOSITORY/releases/tags/$release_tag" --jq .immutable) == "true" ]]' "$workflow" ||
  fail "Asahi repository verifies release immutability"

echo "ok - Asahi package repository publication is bounded and signed"
