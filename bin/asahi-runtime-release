#!/usr/bin/env bash
#
# Release a runtime-only change to installed Apple Silicon Macs in one go.
#
#   asahi-runtime-release [--dry-run] OMARCHY_MX_MAC_COMMIT
#
# The fast lane of bin/asahi-release, kept for its command line: pin the
# runtime source to the commit, build an incremental candidate, and publish
# the next runtime channel. A candidate that rebuilds repository packages
# stops here; bin/asahi-release with the same commit resumes it on the full
# lane (VM acceptance, promotion, package channel). See
# docs/asahi-resumable-release.md.

set -euo pipefail

case ${1:-} in
  -h|--help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" >&2
    exit 64
    ;;
esac

exec "$(dirname -- "${BASH_SOURCE[0]}")/asahi-release" --runtime-only "$@"
