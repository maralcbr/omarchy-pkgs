#!/bin/bash

# Provenance record for an Aurora kernel release.
#
# The Aurora kernel ships in its own immutable release, separate from the
# [omarchy] repository the Asahi lane pins, so it cannot use
# asahi-package-candidate-descriptor: that tool refuses any tag outside the
# asahi-packages-candidate-<sha> family, and its asset list assumes the
# 55-package repository. The record below carries the same package= lines, so
# the builder verifies an Aurora release exactly the way it verifies the
# repository one.
#
# An aurora-packages-<sha> release is the rc channel (channel=aurora). An
# aurora-edge-N release is the edge channel (channel=aurora-edge) and also
# records its sequence, the aurora-silicon/linux commit and archive it was
# built from, and the sha256 of the pinned recipe it was built with (PKGBUILD)
# and of that recipe's generated metadata (SRCINFO), both release assets.

set -euo pipefail
# The descriptor is compared byte for byte wherever it is regenerated, so its sort order cannot follow the host locale.
export LC_ALL=C

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

usage() {
  echo "Usage: aurora-package-descriptor REPOSITORY TAG SOURCE_COMMIT SIGNING_FINGERPRINT WORKFLOW_RUN [PACKAGES_MANIFEST]" >&2
  echo "       [--sequence N --aurora-commit SHA --source-sha256 SHA256]   (aurora-edge-N tags only)" >&2
  exit 64
}

positionals=()
sequence=""
aurora_commit=""
source_sha256=""
while (($#)); do
  case $1 in
    --sequence|--aurora-commit|--source-sha256)
      (($# > 1)) || usage
      case $1 in
        --sequence) sequence=$2 ;;
        --aurora-commit) aurora_commit=$2 ;;
        --source-sha256) source_sha256=$2 ;;
      esac
      shift 2
      ;;
    -*) usage ;;
    *) positionals+=("$1"); shift ;;
  esac
done
set -- "${positionals[@]}"

(( $# == 5 || $# == 6 )) || usage

repository=$1
release_tag=$2
source_commit=$3
signing_fingerprint=${4^^}
workflow_run=$5
packages_manifest=${6:-$ROOT/pkgbuilds/aurora-repository-packages}

[[ -d $repository ]] || { echo "Repository directory does not exist: $repository" >&2; exit 1; }
[[ -s $packages_manifest ]] || { echo "Package manifest does not exist or is empty: $packages_manifest" >&2; exit 1; }
if [[ $release_tag =~ ^aurora-packages-[0-9a-f]{40}$ ]]; then
  channel=aurora
  [[ -z $sequence && -z $aurora_commit && -z $source_sha256 ]] ||
    { echo "Only an aurora-edge release carries a sequence, aurora commit or source sha256: $release_tag" >&2; exit 1; }
elif [[ $release_tag =~ ^aurora-edge-([1-9][0-9]{0,8})$ ]]; then
  channel=aurora-edge
  [[ $sequence == "${BASH_REMATCH[1]}" ]] ||
    { echo "Edge tag $release_tag needs --sequence ${BASH_REMATCH[1]}, not '${sequence}'" >&2; exit 1; }
  [[ $aurora_commit =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid aurora commit: $aurora_commit" >&2; exit 1; }
  [[ $source_sha256 =~ ^[0-9a-f]{64}$ ]] || { echo "Invalid source sha256: $source_sha256" >&2; exit 1; }
  for recipe_file in PKGBUILD SRCINFO; do
    [[ -s $repository/$recipe_file ]] || { echo "Missing edge recipe asset: $recipe_file" >&2; exit 1; }
  done
else
  echo "Invalid aurora tag: $release_tag" >&2
  exit 1
fi
[[ $source_commit =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid source commit: $source_commit" >&2; exit 1; }
[[ $signing_fingerprint =~ ^[A-F0-9]{40}$ ]] || { echo "Invalid signing fingerprint: $signing_fingerprint" >&2; exit 1; }
[[ $workflow_run =~ ^[0-9]+$ ]] || { echo "Invalid workflow run: $workflow_run" >&2; exit 1; }
[[ -z $(sort "$packages_manifest" | uniq -d) ]] || { echo "Package manifest contains duplicates" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

: >"$tmp/packages"
shopt -s nullglob
archives=("$repository"/*.pkg.tar.*)
shopt -u nullglob

for archive in "${archives[@]}"; do
  [[ $archive == *.sig ]] && continue
  filename=${archive##*/}
  [[ $filename =~ ^[A-Za-z0-9._+@-]+$ ]] || { echo "Unsafe package filename: $filename" >&2; exit 1; }
  [[ -s $archive.sig ]] || { echo "Missing package signature: $filename.sig" >&2; exit 1; }

  pkginfo=$(bsdtar -xOqf "$archive" .PKGINFO)
  package=$(sed -n 's/^pkgname = //p' <<<"$pkginfo")
  version=$(sed -n 's/^pkgver = //p' <<<"$pkginfo")
  architecture=$(sed -n 's/^arch = //p' <<<"$pkginfo")
  [[ -n $package && -n $version ]] || { echo "Incomplete package metadata: $filename" >&2; exit 1; }
  [[ $architecture == "aarch64" || $architecture == "any" ]] || {
    echo "Unsupported package architecture $architecture: $filename" >&2
    exit 1
  }
  grep -Fxq "$package" "$packages_manifest" || { echo "Unexpected package: $package" >&2; exit 1; }
  printf '%s\n' "$package" >>"$tmp/packages"
  printf '%s|%s|%s|%s|%s|%s|%s\n' \
    "$package" "$version" "$architecture" "$filename" \
    "$(sha256sum "$archive" | cut -d' ' -f1)" "$filename.sig" \
    "$(sha256sum "$archive.sig" | cut -d' ' -f1)" >>"$tmp/package-records"
done

sort "$tmp/packages" >"$tmp/actual-packages"
sort "$packages_manifest" >"$tmp/expected-packages"
diff -u "$tmp/expected-packages" "$tmp/actual-packages"

for asset in omarchy-aurora.db omarchy-aurora.db.sig omarchy-aurora.files omarchy-aurora.files.sig; do
  [[ -s $repository/$asset ]] || { echo "Missing repository asset: $asset" >&2; exit 1; }
done

package_count=$(wc -l <"$tmp/expected-packages")
printf 'format=1\n'
printf 'channel=%s\n' "$channel"
printf 'release_tag=%s\n' "$release_tag"
if [[ $channel == aurora-edge ]]; then
  printf 'sequence=%s\n' "$sequence"
fi
printf 'source_commit=%s\n' "$source_commit"
if [[ $channel == aurora-edge ]]; then
  printf 'aurora_commit=%s\n' "$aurora_commit"
  printf 'source_sha256=%s\n' "$source_sha256"
  printf 'recipe_sha256=%s\n' "$(sha256sum "$repository/PKGBUILD" | cut -d' ' -f1)"
  printf 'srcinfo_sha256=%s\n' "$(sha256sum "$repository/SRCINFO" | cut -d' ' -f1)"
fi
printf 'workflow_run=%s\n' "$workflow_run"
printf 'runner_arch=aarch64\n'
printf 'signing_fingerprint=%s\n' "$signing_fingerprint"
printf 'package_count=%s\n' "$package_count"
sort "$tmp/package-records" | awk '{ printf "package=%d|%s\n", NR, $0 }'
for asset in omarchy-aurora.db omarchy-aurora.db.sig omarchy-aurora.files omarchy-aurora.files.sig; do
  printf 'asset=%s|%s\n' "$asset" "$(sha256sum "$repository/$asset" | cut -d' ' -f1)"
done
