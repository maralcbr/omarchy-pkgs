#!/bin/bash

set -euo pipefail

ROOT=${ASAHI_PACKAGE_ROOT:-$(realpath "${BASH_SOURCE[0]%/*}/..")}
mode=incremental
previous_package_commit=""
current_package_commit=""
previous_runtime_commit=""
current_runtime_commit=""
output=/dev/stdout
classify_only=0

usage() {
  echo "Usage: asahi-incremental-plan --mode incremental|full --previous-package-commit SHA --current-package-commit SHA --previous-runtime-commit SHA --current-runtime-commit SHA [--output FILE]" >&2
  echo "       asahi-incremental-plan --classify <PATHS" >&2
  exit 64
}

while (($#)); do
  case "$1" in
    --mode) mode=${2:-}; shift ;;
    --previous-package-commit) previous_package_commit=${2:-}; shift ;;
    --current-package-commit) current_package_commit=${2:-}; shift ;;
    --previous-runtime-commit) previous_runtime_commit=${2:-}; shift ;;
    --current-runtime-commit) current_runtime_commit=${2:-}; shift ;;
    --output) output=${2:-}; shift ;;
    --classify) classify_only=1 ;;
    *) usage ;;
  esac
  shift
done

if (( ! classify_only )); then
  [[ $mode == "incremental" || $mode == "full" ]] || usage
  for commit in "$previous_package_commit" "$current_package_commit"; do
    [[ $commit =~ ^[0-9a-f]{40}$ ]] || usage
    git -C "$ROOT" rev-parse --verify "$commit^{commit}" >/dev/null
  done
  for commit in "$previous_runtime_commit" "$current_runtime_commit"; do
    [[ $commit =~ ^[0-9a-f]{40}$ ]] || usage
  done
fi
[[ -s $ROOT/pkgbuilds/asahi-source-outputs ]] || { echo "Missing source-output mapping" >&2; exit 1; }

mapfile -t sources <"$ROOT/pkgbuilds/asahi-repository-sources"
mapfile -t repository_packages <"$ROOT/pkgbuilds/asahi-repository-packages"
runtime_groups=(source-pair omarchy-keyring omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic)
runtime_packages=(omarchy-settings-dev omarchy-dev omarchy-keyring omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic)

declare -A rebuild_sources=() rebuild_runtime=() reasons=()
fallback_reason=""

mapped_sources=$(cut -d'|' -f1 "$ROOT/pkgbuilds/asahi-source-outputs" | sort)
expected_sources=$(sort "$ROOT/pkgbuilds/asahi-repository-sources")
[[ $mapped_sources == "$expected_sources" ]] || { echo "Source-output mapping does not exactly cover repository sources" >&2; exit 1; }
mapped_packages=$(cut -d'|' -f2- "$ROOT/pkgbuilds/asahi-source-outputs" | tr ' ' '\n' | sort)
expected_packages=$(sort "$ROOT/pkgbuilds/asahi-repository-packages")
[[ $mapped_packages == "$expected_packages" ]] || { echo "Source-output mapping does not exactly cover repository packages" >&2; exit 1; }

declare -A repository_sources=()
for source in "${sources[@]}"; do repository_sources[$source]=1; done

# Each path gets exactly one class, as CLASS|TARGET|REASON. package and runtime
# rebuild TARGET; rebuild-all, contract (planning, assembly, verification) and
# unclassified rebuild everything; none feeds no candidate package (tests the candidate workflow runs included).
# test/asahi-input-classification keeps every tracked file classified.
classify() {
  local path=$1 directory
  case "$path" in
    pkgbuilds/omarchy-source.conf)
      echo "runtime|source-pair|runtime source pin changed"
      ;;
    pkgbuilds/omarchy-dev/*|pkgbuilds/omarchy-settings-dev/*)
      echo "runtime|source-pair|source-coupled package recipe changed"
      ;;
    pkgbuilds/omarchy-keyring/*|pkgbuilds/omarchy-nvim/*|pkgbuilds/quickshell-git/*|pkgbuilds/ttf-jetbrains-mono-nerd-basic/*)
      directory=${path#pkgbuilds/}
      echo "runtime|${directory%%/*}|package recipe or source changed"
      ;;
    pkgbuilds/linux-aurora/*|pkgbuilds/linux-aurora-edge/*|pkgbuilds/m1n1-aurora/*|pkgbuilds/aurora-repository-packages|pkgbuilds/aurora-source-outputs|bin/aurora-package-descriptor|bin/aurora-edge-pin-recipe|bin/aurora-edge-source|bin/aurora-verify-edge-release)
      # The Aurora kernel lanes (rc and edge) build and publish on their own;
      # nothing in the [omarchy] repository depends on these inputs.
      echo "none||Aurora kernel lane"
      ;;
    pkgbuilds/*/*)
      # Each source builds alone from its own directory, so a directory that
      # is not a repository source feeds no candidate. Adding it to the
      # sources is a repository definition change.
      directory=${path#pkgbuilds/}; directory=${directory%%/*}
      if [[ -n ${repository_sources[$directory]:-} ]]; then
        echo "package|$directory|package recipe, source, patch, or dependency definition changed"
      else
        echo "none||not an aarch64 repository source"
      fi
      ;;
    keys/*|build/gpg-keys.txt)
      echo "rebuild-all||signing trust input changed"
      ;;
    bin/build|build/*|helpers/*|pkgbuilds/asahi-repository-sources|pkgbuilds/asahi-repository-packages|pkgbuilds/asahi-source-outputs)
      echo "rebuild-all||shared build, toolchain, base-image, dependency, or repository definition changed"
      ;;
    bin/asahi-incremental-plan|bin/asahi-candidate-assemble|bin/asahi-candidate-provenance|bin/asahi-verify-candidate|bin/asahi-bundle-manifest|bin/asahi-package-candidate-descriptor|bin/asahi-signing-subkey-validate)
      echo "contract||incremental release contract changed"
      ;;
    .github/workflows/release-asahi-package-candidate.yml|.github/workflows/release-asahi-package-incremental.yml|.github/scripts/verify-asahi-*)
      echo "contract||candidate workflow or validation contract changed"
      ;;
    README.md|LICENSE|.gitignore|docs/*|test/*|.github/*)
      echo "none||documentation, test, or another workflow"
      ;;
    bin/asahi-runtime-release|bin/promote-asahi-package-candidate|bin/publish-asahi-packages-channel|bin/publish-asahi-channel-pointer|bin/asahi-verify-packages-channel|bin/asahi-package-retention-plan|bin/asahi-release-controller|bin/asahi-cache)
      # Operator tools that act on a published candidate; no package build
      # runs them.
      echo "none||operator tool"
      ;;
    bin/release-asahi-quattro|bin/install-asahi-quattro|bin/reuse-asahi-package|bin/asahi-package-build-key|bin/verify-asahi-runtime-version)
      echo "none||runtime channel lane"
      ;;
    bin/stage-arm64-iso-r2|bin/apple-image-parity-capture|controller/*)
      echo "none||ARM64 image lane"
      ;;
    bin/build-apple-bootstrap|bin/apple-bootstrap-inputs|bin/apple-bootstrap-check|apple-bootstrap/*)
      # The bootstrap image lane installs published packages; no package
      # build runs it.
      echo "none||bootstrap image lane"
      ;;
    bin/add-package|bin/auto-release|bin/check-versions|bin/clean-docker|bin/clean-repo|bin/list-packages|bin/migrate-edge-to-stable|bin/package-worktree|bin/promote-build|bin/release|bin/remove-package|bin/repo|bin/sign|bin/sync-aur|bin/sync-repo|bin/update-repo|bin/upload-prebuilt|systemd/*)
      echo "none||x86_64 repository lane"
      ;;
    *)
      echo "unclassified||unclassified package repository change"
      ;;
  esac
}

if (( classify_only )); then
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    printf '%s|%s\n' "$path" "$(classify "$path")"
  done
  exit 0
fi

if [[ $mode == "full" ]]; then
  fallback_reason="operator selected full mode"
else
  mapfile -t changed_paths < <(git -C "$ROOT" diff --name-only "$previous_package_commit" "$current_package_commit")
  for path in "${changed_paths[@]}"; do
    IFS='|' read -r class target reason <<<"$(classify "$path")"
    case "$class" in
      package) rebuild_sources[$target]=1; reasons[$target]=$reason ;;
      runtime) rebuild_runtime[$target]=1; reasons[$target]=$reason ;;
      none) ;;
      *) fallback_reason="$reason: $path" ;;
    esac
  done

  if [[ $previous_runtime_commit != "$current_runtime_commit" ]]; then
    rebuild_runtime[source-pair]=1
    reasons[source-pair]="runtime source commit changed"
  fi
fi

effective_mode=$mode
if [[ $mode == "full" || -n $fallback_reason ]]; then
  effective_mode=full
  for source in "${sources[@]}"; do rebuild_sources[$source]=1; reasons[$source]="${fallback_reason:-full rebuild}"; done
  for group in "${runtime_groups[@]}"; do rebuild_runtime[$group]=1; reasons[$group]="${fallback_reason:-full rebuild}"; done
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
: >"$tmp/build-sources"
: >"$tmp/rebuild-packages"
: >"$tmp/reuse-packages"
: >"$tmp/runtime-groups"
: >"$tmp/reasons"

for source in "${sources[@]}"; do
  if [[ -n ${rebuild_sources[$source]:-} ]]; then
    echo "$source" >>"$tmp/build-sources"
    outputs=$(awk -F'|' -v source="$source" '$1 == source { print $2 }' "$ROOT/pkgbuilds/asahi-source-outputs")
    [[ -n $outputs ]] || { echo "No output mapping for $source" >&2; exit 1; }
    for package in $outputs; do
      echo "$package" >>"$tmp/rebuild-packages"
      printf '%s|%s\n' "$package" "${reasons[$source]}" >>"$tmp/reasons"
    done
  fi
done
for group in "${runtime_groups[@]}"; do
  [[ -n ${rebuild_runtime[$group]:-} ]] || continue
  echo "$group" >>"$tmp/runtime-groups"
  if [[ $group == "source-pair" ]]; then packages="omarchy-settings-dev omarchy-dev"; else packages=$group; fi
  for package in $packages; do
    echo "$package" >>"$tmp/rebuild-packages"
    printf '%s|%s\n' "$package" "${reasons[$group]}" >>"$tmp/reasons"
  done
done

for package in "${repository_packages[@]}" "${runtime_packages[@]}"; do
  grep -Fxq "$package" "$tmp/rebuild-packages" || echo "$package" >>"$tmp/reuse-packages"
done
sort -u -o "$tmp/rebuild-packages" "$tmp/rebuild-packages"
sort -u -o "$tmp/reuse-packages" "$tmp/reuse-packages"

jq -n \
  --arg requested_mode "$mode" \
  --arg effective_mode "$effective_mode" \
  --arg fallback_reason "$fallback_reason" \
  --arg previous_package_commit "$previous_package_commit" \
  --arg current_package_commit "$current_package_commit" \
  --arg previous_runtime_commit "$previous_runtime_commit" \
  --arg current_runtime_commit "$current_runtime_commit" \
  --argjson build_sources "$(jq -R -s -c 'split("\n")|map(select(length>0))' <"$tmp/build-sources")" \
  --argjson runtime_groups "$(jq -R -s -c 'split("\n")|map(select(length>0))' <"$tmp/runtime-groups")" \
  --argjson rebuilt "$(jq -R -s -c 'split("\n")|map(select(length>0))' <"$tmp/rebuild-packages")" \
  --argjson reused "$(jq -R -s -c 'split("\n")|map(select(length>0))' <"$tmp/reuse-packages")" \
  --argjson reasons "$(jq -Rn '[inputs|select(length>0)|split("|")|{key:.[0],value:.[1]}]|from_entries' <"$tmp/reasons")" \
  '{format:1,architecture:"aarch64",requested_mode:$requested_mode,effective_mode:$effective_mode,fallback_reason:$fallback_reason,previous_package_commit:$previous_package_commit,current_package_commit:$current_package_commit,previous_runtime_commit:$previous_runtime_commit,current_runtime_commit:$current_runtime_commit,build_sources:$build_sources,runtime_groups:$runtime_groups,rebuilt_packages:$rebuilt,reused_packages:$reused,invalidation_reasons:$reasons}' >"$output"
