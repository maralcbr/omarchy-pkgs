#!/bin/bash

# Builds an Apple Silicon bootstrap payload: a small Omarchy root that boots,
# gets online and installs the rest from the package channel on first boot
# (omarchy-first-boot). The layout is today's full payload's, so the installer
# engine and Mac app take it unchanged: EFI/Boot/Root, a btrfs root with @,
# @home, @log and @pkg, the fixed UUIDs and ESP volume id, the same zip members
# and the same declared installer_data sizes. Only root.img is smaller.
#
# On the host it verifies the Arch Linux ARM root filesystem the inputs record
# names, imports it and runs itself inside it as a privileged container, which
# builds from those pinned inputs only and writes to OUT the zip,
# installer_data.json and PROVENANCE.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# Today's payload contract (omarchy-iso builder/products/*.json; the engine's
# bundled installer_data.json).
ROOT_UUID=4f4d5801-524f-4f54-8000-000000000001
BOOT_UUID=4f4d5801-424f-4f54-8000-000000000001
ESP_VOLUME_ID=0x4f4d5801
ESP_UUID=4F4D-5801
ESP_SIZE=524288000
BOOT_SIZE=2147483648
ROOT_SIZE=34359738368
SUPPORTED_FW=(13.5 14.8.3)
ICON_SHA256=cf26ed5d2831db99c00d62ca046040e01a18e08e63363d629340d04ac6ec8c23

ARM_REPOSITORY_KEY=C81AC3E2A99556F9B21D5FEA3DD49BC9F8360BDC
# The keyring omarchy-iso's apple-platform-snapshot.json trusts.
ASAHI_KEYRING_FILE=asahi-alarm-keyring-20241216-1-any.pkg.tar.xz
ASAHI_KEYRING_SHA256=798f4b283ad2819aee950d042f26566ae1a68f87c12247301ce449bea3b2d81e
ASAHI_KEY=12CE6799A94A3F1B5DDFFE88F576553597FB8FEB
PACKAGES=(base mkinitcpio uboot-asahi grub asahi-scripts asahi-fwextract omarchy-apple-boot btrfs-progs
  archlinuxarm-keyring asahi-alarm-keyring networkmanager iwd curl gnupg jq gum sudo omarchy-first-boot)
TOOLCHAIN=(pacman arch-install-scripts btrfs-progs e2fsprogs dosfstools libarchive util-linux systemd jq python)

usage() {
  cat <<'USAGE'
Usage: bin/build-apple-bootstrap --inputs FILE [--cache DIR] <asahi|aurora> OUT

Builds the bootstrap payload for one product from the inputs record FILE
(bin/apple-bootstrap-inputs) into the empty or missing directory OUT, in a
privileged linux/arm64 Arch Linux ARM container. --cache holds the verified root
filesystem between runs (bin/apple-bootstrap-inputs resolve --cache).

Needs docker, curl, gpg and sha256sum on the host.
USAGE
}

fail() {
  echo "build-apple-bootstrap: $*" >&2
  exit 1
}

usage_error() {
  echo "build-apple-bootstrap: $*" >&2
  usage >&2
  exit 64
}

sha256_of() {
  sha256sum "$1" | cut -d' ' -f1
}

# ── host ───────────────────────────────────────────────────────────────────
host_work="" host_image=""

host_main() {
  local inputs="" cache="" product out commit clean=true started=$SECONDS
  while (($#)); do
    case $1 in
      --inputs|--cache)
        (($# > 1)) && [[ -n $2 ]] || usage_error "$1 requires a value"
        case $1 in
          --inputs) inputs=$2 ;;
          --cache) cache=$2 ;;
        esac
        shift 2
        ;;
      -h|--help) usage; exit 0 ;;
      -*) usage_error "unknown option: $1" ;;
      *) break ;;
    esac
  done
  (($# == 2)) || usage_error "expected a product and OUT"
  product=$1 out=$2
  [[ $product == asahi || $product == aurora ]] || usage_error "the product must be asahi or aurora"
  [[ -n $inputs ]] || usage_error "--inputs is required"
  for tool in docker curl gpg sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing command: $tool"
  done
  "$BASH" "$ROOT/bin/apple-bootstrap-inputs" check "$inputs" >/dev/null
  inputs=$(cd -- "$(dirname -- "$inputs")" && pwd)/$(basename -- "$inputs")
  mkdir -p "$out"
  [[ -z $(ls -A "$out") ]] || fail "$out is not empty"
  out=$(cd -- "$out" && pwd)

  commit=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null) || commit=${GITHUB_SHA:-}
  [[ $commit =~ ^[0-9a-f]{40}$ ]] || fail "cannot tell which omarchy-pkgs commit is building"
  [[ -z $(git -C "$ROOT" status --porcelain 2>/dev/null) ]] || clean=false

  host_work=$(mktemp -d)
  trap 'rm -rf "$host_work"; [[ -z $host_image ]] || docker image rm -f "$host_image" >/dev/null 2>&1 || true' EXIT
  local rootfs_args=("$inputs" "$host_work/rootfs.tar.gz")
  [[ -z $cache ]] || rootfs_args+=(--cache "$cache")
  "$BASH" "$ROOT/bin/apple-bootstrap-inputs" rootfs "${rootfs_args[@]}"
  host_image=omarchy-apple-bootstrap-alarm:$(sha256_of "$host_work/rootfs.tar.gz" | cut -c1-16)-$$
  docker import --platform linux/arm64 "$host_work/rootfs.tar.gz" "$host_image" >/dev/null ||
    fail "could not import the root filesystem"
  rm -f "$host_work/rootfs.tar.gz"

  # /work is an anonymous volume: loop devices need a real filesystem under
  # them, and --rm removes it with the container.
  docker run --rm --privileged --platform linux/arm64 \
    -v "$ROOT:/src:ro" -v "$inputs:/inputs:ro" -v "$out:/out" -v /work \
    -e OMARCHY_BOOTSTRAP_PKGS_COMMIT="$commit" \
    -e OMARCHY_BOOTSTRAP_PKGS_CLEAN="$clean" \
    -e OMARCHY_BOOTSTRAP_BUILDER_IMAGE="$(docker image inspect --format '{{.Id}}' "$host_image")" \
    -e OMARCHY_BOOTSTRAP_WORKFLOW_RUN="${GITHUB_RUN_ID:-local}" \
    "$host_image" /bin/bash /src/bin/build-apple-bootstrap --in-container "$product" ||
    fail "the $product build failed"
  echo "Built the $product bootstrap payload in $((SECONDS - started))s:"
  ls -l "$out"
}

# ── container ──────────────────────────────────────────────────────────────
work=/work
target=$work/target
logs=$work/logs
loops=()

field() {
  sed -n "s/^$1=//p" <<<"$inputs"
}

cleanup() {
  local process process_root index point
  set +e
  for process in /proc/[0-9]*; do
    process_root=$(readlink "$process/root" 2>/dev/null)
    [[ $process_root == "$work"/* ]] && kill -KILL "${process##*/}" 2>/dev/null
  done
  for point in "$work/final-root" "$work/final-boot" "$work/build-top" "$target"; do
    mountpoint -q "$point" && umount -R "$point"
  done
  # Loop devices belong to the kernel, not the container: never leave one behind.
  for ((index = ${#loops[@]} - 1; index >= 0; index--)); do
    losetup -d "${loops[index]}" 2>/dev/null
  done
  loops=()
  set -e
}

# Sets attached to the loop device now backing FILE.
attach() {
  attached=$(losetup --find --show "$1") || fail "could not attach $1"
  loops+=("$attached")
}

# losetup --find creates missing loop nodes on the kernel's devtmpfs, which a
# container's /dev never shows. Provide them up front.
make_loop_nodes() {
  local index
  for index in $(seq 0 31); do
    [[ -e /dev/loop$index ]] || mknod "/dev/loop$index" b 7 "$index"
  done
}

verify_database() {
  local file=$1 expected=$2
  [[ -f $file && $(sha256_of "$file") == "$expected" ]] ||
    fail "${file##*/} is not the database this run resolved; dispatch a new run"
}

prepare_toolchain() {
  local repository
  {
    printf '[options]\nArchitecture = aarch64\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n'
    printf 'ParallelDownloads = 5\nCacheDir = %s/pkg-cache/\nDisableSandboxFilesystem\nDisableSandboxSyscalls\n' "$work"
    for repository in core extra alarm aur; do
      printf '\n[%s]\nServer = %s\n' "$repository" "$(field alarm_server)"
    done
  } >/etc/pacman.conf
  mkdir -p "$work/pkg-cache"
  pacman-key --init >>"$logs/toolchain.log" 2>&1 && pacman-key --populate archlinuxarm >>"$logs/toolchain.log" 2>&1 ||
    fail "could not set up the build keyring (logs/toolchain.log)"
  pacman -Sy --noconfirm >>"$logs/toolchain.log" 2>&1 || fail "could not read the Arch Linux ARM snapshot"
  for repository in core extra alarm aur; do
    verify_database "/var/lib/pacman/sync/$repository.db" "$(field "alarm_${repository}_db_sha256")"
  done
  pacman -Su --noconfirm --needed arch-install-scripts btrfs-progs dosfstools e2fsprogs jq python \
    >>"$logs/toolchain.log" 2>&1 || fail "could not install the build tools (logs/toolchain.log)"

  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 \
    --output "$work/$ASAHI_KEYRING_FILE" "$(field asahi_alarm_server)/$ASAHI_KEYRING_FILE" ||
    fail "could not download $ASAHI_KEYRING_FILE"
  [[ $(sha256_of "$work/$ASAHI_KEYRING_FILE") == "$ASAHI_KEYRING_SHA256" ]] || fail "$ASAHI_KEYRING_FILE changed"
  pacman -U --noconfirm --config <(sed 's/^LocalFileSigLevel = .*/LocalFileSigLevel = Never/' /etc/pacman.conf) \
    "$work/$ASAHI_KEYRING_FILE" >>"$logs/toolchain.log" 2>&1 && pacman-key --populate asahi-alarm >>"$logs/toolchain.log" 2>&1 ||
    fail "could not trust the Asahi ALARM keyring (logs/toolchain.log)"
  pacman-key --finger "$ASAHI_KEY" >/dev/null 2>&1 || fail "the Asahi ALARM keyring does not hold $ASAHI_KEY"

  [[ $(gpg --batch --show-keys --with-colons /src/keys/asahi-repository-signing.asc |
    awk -F: '$1 == "fpr" { print $10; exit }') == "$ARM_REPOSITORY_KEY" ]] ||
    fail "keys/asahi-repository-signing.asc is not the Omarchy ARM repository key"
  pacman-key --add /src/keys/asahi-repository-signing.asc >>"$logs/toolchain.log" 2>&1 &&
    pacman-key --lsign-key "$ARM_REPOSITORY_KEY" >>"$logs/toolchain.log" 2>&1 ||
    fail "could not trust the Omarchy ARM repository key (logs/toolchain.log)"
}

# The pacman configuration the build installs from: the resolved servers only.
write_build_config() {
  local repository
  {
    printf '[options]\nArchitecture = aarch64\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n'
    printf 'ParallelDownloads = 5\nCacheDir = %s/pkg-cache/\nDisableSandboxFilesystem\nDisableSandboxSyscalls\n' "$work"
    [[ $product != aurora ]] ||
      printf '\n[omarchy-aurora]\nSigLevel = Required DatabaseOptional\nServer = %s\n' "$(field aurora_server)"
    printf '\n[omarchy]\nSigLevel = Required DatabaseOptional\nServer = %s\n' "$(field omarchy_server)"
    printf '\n[asahi-alarm]\nSigLevel = Required DatabaseOptional\nServer = %s\n' "$(field asahi_alarm_server)"
    for repository in core extra alarm aur; do
      printf '\n[%s]\nServer = %s\n' "$repository" "$(field alarm_server)"
    done
  } >"$work/build.conf"
}

# omarchy-iso's installed configuration, with [omarchy] exactly as
# omarchy-update-asahi-repository --bootstrap writes it and, on Aurora,
# [omarchy-aurora] directly ahead of it as omarchy-update-aurora-repository does.
write_installed_config() {
  local repository
  {
    printf '[options]\nHoldPkg = pacman glibc\nArchitecture = aarch64\nCheckSpace\nParallelDownloads = 5\n'
    printf 'DownloadUser = alpm\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n\n'
    if [[ $product == aurora ]]; then
      printf '# Aurora kernel and bootloader, kept on the qualified release by omarchy update\n'
      printf '[omarchy-aurora]\nSigLevel = Required DatabaseOptional\nServer = %s\n\n' "$(field aurora_server)"
    fi
    printf '[omarchy]\nSigLevel = Required DatabaseOptional\nServer = %s\n\n' "$(field omarchy_server)"
    printf '[asahi-alarm]\nSigLevel = Required DatabaseOptional\nServer = %s\n' "$(field asahi_alarm_server)"
    for repository in core extra alarm aur; do
      printf '\n[%s]\nServer = https://ca.us.mirror.archlinuxarm.org/$arch/$repo\n' "$repository"
      printf 'Server = https://fl.us.mirror.archlinuxarm.org/$arch/$repo\n'
    done
  } >"$target/etc/pacman.conf"
  chmod 0644 "$target/etc/pacman.conf"
  # The state that bootstrap leaves beside the pin.
  install -d -m 0755 "$target/var/lib/omarchy"
  printf 'format=1\ntag=%s\nsource_commit=%s\nworkflow_run=%s\ndescriptor_sha256=%s\nchannel_sequence=%s\n' \
    "$(field omarchy_tag)" "$(field omarchy_tag | sed 's/^asahi-packages-stable-//')" \
    "$(sed -n 's/^workflow_run=//p' "$work/CANDIDATE")" "$(field omarchy_descriptor_sha256)" \
    "$(field packages_channel | sed 's/^asahi-packages-channel-//')" >"$target/var/lib/omarchy/asahi-package-repository"
  chmod 0644 "$target/var/lib/omarchy/asahi-package-repository"
}

create_images() {
  local root_loop top=$work/build-top subvolume
  truncate -s 16G "$work/root-build.img"
  truncate -s "$BOOT_SIZE" "$work/boot-build.img"
  truncate -s "$ESP_SIZE" "$work/esp-build.img"
  make_root_fs "$work/root-build.img"
  make_boot_fs "$work/boot-build.img"
  mkfs.vfat -F 32 -n OMARCHYESP -i "${ESP_VOLUME_ID#0x}" "$work/esp-build.img" >/dev/null
  attach "$work/root-build.img"
  root_loop=$attached
  mkdir -p "$top" "$target"
  mount "$root_loop" "$top"
  for subvolume in @ @home @log @pkg; do
    btrfs subvolume create "$top/$subvolume" >/dev/null
  done
  mount -o subvol=@,compress=zstd "$root_loop" "$target"
  mkdir -p "$target/home" "$target/var/log" "$target/var/cache/pacman/pkg" "$target/boot"
  mount -o subvol=@home,compress=zstd "$root_loop" "$target/home"
  mount -o subvol=@log,compress=zstd "$root_loop" "$target/var/log"
  mount -o subvol=@pkg,compress=zstd "$root_loop" "$target/var/cache/pacman/pkg"
  attach "$work/boot-build.img"
  mount "$attached" "$target/boot"
  mkdir -p "$target/boot/efi"
  attach "$work/esp-build.img"
  mount "$attached" "$target/boot/efi"
  # asahi-scripts' builder marker keeps update-m1n1 on this ESP, which needs m1n1/.
  mkdir -p "$target/boot/efi/m1n1"
  : >"$target/boot/efi/.builder"
}

make_root_fs() {
  mkfs.btrfs -q -f -L OMARCHY_ROOT -U "$ROOT_UUID" "$1"
}

# omarchy-iso's base-images options: no lazy initialisation left for first boot.
make_boot_fs() {
  mkfs.ext4 -q -F -L OMARCHY_BOOT -U "$BOOT_UUID" \
    -E lazy_itable_init=0,lazy_journal_init=0,hash_seed="$BOOT_UUID" "$1"
}

install_packages() {
  local kernel=linux-$product repository expected installed packages=("${PACKAGES[@]}")
  if [[ $product == aurora ]]; then
    packages+=(linux-aurora linux-aurora-headers m1n1-aurora)
  else
    packages+=(linux-asahi linux-asahi-headers m1n1)
  fi
  pacstrap -C "$work/build.conf" -c -M "$target" "${packages[@]}" >"$logs/pacstrap.log" 2>&1 ||
    fail "pacstrap failed (logs/pacstrap.log)"
  for repository in omarchy asahi-alarm core extra alarm aur; do
    case $repository in
      omarchy) expected=$(field omarchy_db_sha256) ;;
      asahi-alarm) expected=$(field asahi_alarm_db_sha256) ;;
      *) expected=$(field "alarm_${repository}_db_sha256") ;;
    esac
    verify_database "$target/var/lib/pacman/sync/$repository.db" "$expected"
  done
  [[ $product != aurora ]] || verify_database "$target/var/lib/pacman/sync/omarchy-aurora.db" "$(field aurora_db_sha256)"
  # By name: pacman -Q linux-asahi also answers for linux-aurora, which provides it.
  installed=$(pacman --dbpath "$target/var/lib/pacman" -Qq)
  grep -Fxq "$kernel" <<<"$installed" && grep -Fxq "$kernel-headers" <<<"$installed" || fail "$kernel is not installed"
  [[ $product != aurora ]] || ! grep -Fxq linux-asahi <<<"$installed" || fail "linux-asahi is installed beside linux-aurora"
}

write_fstab() {
  cat >"$target/etc/fstab" <<EOF
# /etc/fstab — generated by the Omarchy Apple Silicon bootstrap builder
# <device>  <mount>  <fs>  <options>  <dump>  <pass>
UUID=$ROOT_UUID  /                      btrfs  noatime,compress=zstd,x-systemd.growfs,subvol=@       0 0
UUID=$ROOT_UUID  /home                  btrfs  noatime,compress=zstd,subvol=@home   0 0
UUID=$ROOT_UUID  /var/log               btrfs  noatime,compress=zstd,subvol=@log    0 0
UUID=$ROOT_UUID  /var/cache/pacman/pkg  btrfs  noatime,compress=zstd,subvol=@pkg    0 0
UUID=$BOOT_UUID  /boot                  ext4   defaults,noatime       0 2
UUID=$ESP_UUID  /boot/efi                   vfat   umask=0077              0 2
EOF
}

configure_image() {
  local kernel=linux-$product units
  write_fstab
  bash "$target/usr/lib/omarchy/apple-image-finalize" --root "$target" "$product" >/dev/null
  mapfile -t units < <(awk '$1 == "enable" { print $2 }' "$target/usr/lib/systemd/system-preset/80-omarchy-apple.preset")
  ((${#units[@]} > 0)) || fail "80-omarchy-apple.preset enables nothing"
  systemctl --root="$target" preset "${units[@]}" >/dev/null 2>&1 || fail "could not apply the image presets"
  bash "$target/usr/lib/omarchy/first-boot/omarchy-first-boot" arm "$target"
  write_installed_config

  arch-chroot "$target" mkinitcpio -P >"$logs/mkinitcpio.log" 2>&1 || fail "mkinitcpio failed (logs/mkinitcpio.log)"
  [[ -s $target/boot/vmlinuz-$kernel && -s $target/boot/initramfs-$kernel.img ]] ||
    fail "/boot has no $kernel kernel and initramfs"
  generate_grub
  arch-chroot "$target" update-m1n1 >"$logs/update-m1n1.log" 2>&1 || fail "update-m1n1 failed (logs/update-m1n1.log)"
  [[ -s $target/boot/efi/m1n1/boot.bin && -s $target/boot/efi/EFI/BOOT/BOOTAA64.EFI && -s $target/boot/grub/grub.cfg ]] ||
    fail "the boot chain is incomplete"

  # pacstrap gave the image the build keyring, which trusts the ARM repository key.
  [[ $(gpg --batch --homedir "$target/etc/pacman.d/gnupg" --with-colons --list-keys "$ARM_REPOSITORY_KEY" 2>/dev/null |
    awk -F: '$1 == "pub" { print $2; exit }') == [fu] ]] || fail "the image does not trust the Omarchy ARM repository key"

  # The installed system finds its own ESP; first boot syncs its own databases.
  rm -f "$target/boot/efi/.builder" "$target/boot/efi/m1n1/boot.bin.old" "$target/etc/pacman.d/gnupg/S."*
  rm -rf "$target/var/lib/pacman/sync"
  find "$target/var/cache/pacman/pkg" -mindepth 1 -delete
}

# omarchy-iso's update-grub run: grub-mkconfig names root=UUID= only when
# /dev/disk/by-uuid has it, so the root loop device gets that link meanwhile.
generate_grub() {
  local root_device
  root_device=$(findmnt -n -o SOURCE --target "$target" | sed 's/\[.*//')
  [[ $root_device =~ ^/dev/loop[0-9]+$ ]] || fail "unexpected root device $root_device"
  mkdir -p "$target/boot/grub" "$target/boot/efi/EFI/BOOT"
  arch-chroot "$target" /bin/bash -s -- "$root_device" "$ROOT_UUID" >"$logs/update-grub.log" 2>&1 <<'SCRIPT' ||
set -euo pipefail
link=/dev/disk/by-uuid/$2
mkdir -p /dev/disk/by-uuid
[[ ! -e $link ]] || [[ $(readlink -f "$link") == "$(readlink -f "$1")" ]] || { echo "$link names another device" >&2; exit 1; }
ln -sfn "$1" "$link"
trap 'rm -f "$link"' EXIT
BOOT_PART=/boot EFI_PART=/boot/efi TARGET=/boot/efi/EFI/BOOT/BOOTAA64.EFI /usr/bin/update-grub
SCRIPT
    fail "update-grub failed (logs/update-grub.log)"
}

record_packages() {
  local name version archive matches
  : >"$work/packages"
  while read -r name version; do
    matches=()
    for archive in "$work/pkg-cache/$name-$version-"*.pkg.tar.*; do
      [[ -f $archive && $archive != *.sig ]] && matches+=("$archive")
    done
    ((${#matches[@]} == 1)) || fail "cannot tell which archive installed $name $version"
    printf '%s|%s|%s|%s\n' "$name" "$version" "${matches[0]##*/}" "$(sha256_of "${matches[0]}")" >>"$work/packages"
  done < <(pacman --dbpath "$target/var/lib/pacman" -Q)
}

# The finished root is copied into a fresh image sized to its content, so
# nothing deleted during the build is left in its free space; growfs fills the
# partition on first boot.
seal_images() {
  local build_top=$work/build-top final=$work/final used=0 bytes subvolume size free
  cleanup_target
  for subvolume in @ @home @log @pkg; do
    bytes=$(du -s --apparent-size -B1 "$build_top/$subvolume" | cut -f1)
    used=$((used + bytes))
  done
  size=$(( (used + used / 4 + 768 * 1024 * 1024 + 1048575) / 1048576 * 1048576 ))
  ((size <= ROOT_SIZE)) || fail "the root needs $size bytes, more than the $ROOT_SIZE-byte partition"
  mkdir -p "$final" "$work/final-root" "$work/final-boot"
  truncate -s "$size" "$final/root.img"
  make_root_fs "$final/root.img"
  attach "$final/root.img"
  mount -o compress=zstd "$attached" "$work/final-root"
  for subvolume in @ @home @log @pkg; do
    btrfs subvolume create "$work/final-root/$subvolume" >/dev/null
    cp -a "$build_top/$subvolume/." "$work/final-root/$subvolume/"
  done
  btrfs filesystem sync "$work/final-root"
  free=$(btrfs filesystem usage -b "$work/final-root" 2>/dev/null | awk '/Free \(estimated\)/ { print $3; exit }')
  [[ $free =~ ^[0-9]+$ ]] && ((free >= 512 * 1024 * 1024)) || fail "the sealed root has too little free space ($free)"
  umount "$work/final-root"
  umount "$build_top"

  truncate -s "$BOOT_SIZE" "$final/boot.img"
  make_boot_fs "$final/boot.img"
  attach "$final/boot.img"
  mount "$attached" "$work/final-boot"
  cp -a "$work/boot-tree/." "$work/final-boot/"
  umount "$work/final-boot"
  e2fsck -fn "$final/boot.img" >/dev/null || fail "the sealed boot image does not check clean"
  btrfs check --readonly "$final/root.img" >/dev/null 2>&1 || fail "the sealed root image does not check clean"
  cleanup
}

# Keeps the boot and ESP trees, then unmounts the build root's subvolumes,
# leaving the top level mounted for the copy.
cleanup_target() {
  local process process_root
  for process in /proc/[0-9]*; do
    process_root=$(readlink "$process/root" 2>/dev/null) || continue
    [[ $process_root == "$target" ]] && kill -KILL "${process##*/}" 2>/dev/null || true
  done
  sync
  mkdir -p "$work/boot-tree" "$work/final/esp"
  cp -a "$target/boot/efi/." "$work/final/esp/"
  umount "$target/boot/efi"
  cp -a "$target/boot/." "$work/boot-tree/"
  umount -R "$target"
}

payload_name() {
  local date
  date=$(field resolved_at | cut -c1-10 | tr - .)
  printf 'omarchy-%s-aarch64-apple-silicon-%s-bootstrap-os-package.zip\n' "$date" "$product"
}

write_installer_data() {
  jq -S -n --arg package "$1" --argjson esp "$ESP_SIZE" --argjson boot "$BOOT_SIZE" --argjson root "$ROOT_SIZE" \
    --arg volume_id "$ESP_VOLUME_ID" --args '{os_list: [{
      name: "Omarchy MX Mac", default_os_name: "Omarchy", omarchy_target: "apple-silicon-full-os",
      boot_object: "m1n1.bin", next_object: "m1n1/boot.bin", package: $package, icon: "omarchy-volume.icns",
      supported_fw: $ARGS.positional,
      partitions: [
        {name: "EFI", type: "EFI", size: "\($esp)B", format: "fat", volume_id: $volume_id,
          copy_firmware: true, copy_installer_data: true, source: "esp"},
        {name: "Boot", type: "Linux", size: "\($boot)B", image: "boot.img"},
        {name: "Root", type: "Linux", size: "\($root)B", expand: true, image: "root.img"}]}]}' \
    "${SUPPORTED_FW[@]}" >"$2"
}

write_provenance() {
  local zip=$1 name repository server path
  {
    printf 'format=1\nkind=apple-bootstrap\nproduct=%s\nkernel=linux-%s\n' "$product" "$product"
    printf 'pkgs_commit=%s\npkgs_tree_clean=%s\nworkflow_run=%s\n' \
      "$OMARCHY_BOOTSTRAP_PKGS_COMMIT" "$OMARCHY_BOOTSTRAP_PKGS_CLEAN" "$OMARCHY_BOOTSTRAP_WORKFLOW_RUN"
    printf 'builder_image=%s\n' "$OMARCHY_BOOTSTRAP_BUILDER_IMAGE"
    printf 'inputs_sha256=%s\n' "$(sha256_of /inputs)"
    sed 's/^/input./' /inputs
    for name in "${TOOLCHAIN[@]}"; do
      printf 'toolchain=%s\n' "$(pacman -Q "$name" | tr ' ' '|')"
    done
    [[ $product != aurora ]] || printf 'repository=omarchy-aurora|%s|%s\n' "$(field aurora_server)" "$(field aurora_db_sha256)"
    printf 'repository=omarchy|%s|%s\n' "$(field omarchy_server)" "$(field omarchy_db_sha256)"
    printf 'repository=asahi-alarm|%s|%s\n' "$(field asahi_alarm_server)" "$(field asahi_alarm_db_sha256)"
    for repository in core extra alarm aur; do
      server=$(field alarm_server)
      server=${server//\$repo/$repository}
      printf 'repository=%s|%s|%s\n' "$repository" "${server//\$arch/aarch64}" "$(field "alarm_${repository}_db_sha256")"
    done
    [[ $product != aurora ]] || printf 'descriptor=AURORA|%s\n' "$(field aurora_descriptor_sha256)"
    printf 'descriptor=CANDIDATE|%s\n' "$(field omarchy_descriptor_sha256)"
    printf 'package_count=%s\n' "$(wc -l <"$work/packages")"
    awk '{ printf "package=%d|%s\n", NR, $0 }' "$work/packages"
    for name in boot.img root.img; do
      printf 'image=%s|%s|%s\n' "$name" "$(stat -c %s "$work/final/$name")" "$(sha256_of "$work/final/$name")"
    done
    (cd "$work/final" && find esp -type f | LC_ALL=C sort) | while read -r path; do
      printf 'member=%s|%s|%s\n' "$path" "$(stat -c %s "$work/final/$path")" "$(sha256_of "$work/final/$path")"
    done
    printf 'member=omarchy-volume.icns|%s|%s\n' "$(stat -c %s /src/apple-bootstrap/omarchy-volume.icns)" "$ICON_SHA256"
    printf 'installer_data_sha256=%s\n' "$(sha256_of /out/installer_data.json)"
    printf 'payload=%s|%s|%s\n' "${zip##*/}" "$(stat -c %s "$zip")" "$(sha256_of "$zip")"
  } >/out/PROVENANCE
}

container_main() {
  local zip started=$SECONDS
  (($# == 1)) && [[ $1 == asahi || $1 == aurora ]] || usage_error "--in-container takes asahi or aurora"
  product=$1
  inputs=$(bash /src/bin/apple-bootstrap-inputs check /inputs)
  [[ -d /out && -z $(ls -A /out) ]] || fail "/out is not an empty directory"
  [[ $(sha256_of /src/apple-bootstrap/omarchy-volume.icns) == "$ICON_SHA256" ]] || fail "the volume icon changed"
  mkdir -p "$logs"
  trap 'cleanup; cp -r "$logs" /out/' EXIT
  make_loop_nodes

  step() { printf '[%4ds] %s\n' "$((SECONDS - started))" "$1"; }
  step "preparing the toolchain from Arch Linux ARM $(field alarm_snapshot)"
  prepare_toolchain
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 \
    --output "$work/CANDIDATE" "$(field omarchy_server)/CANDIDATE" || fail "could not download CANDIDATE"
  [[ $(sha256_of "$work/CANDIDATE") == "$(field omarchy_descriptor_sha256)" ]] || fail "CANDIDATE is not the resolved descriptor"
  write_build_config
  step "creating the images"
  create_images
  step "installing the $product package set"
  install_packages
  record_packages
  step "finalizing the image"
  configure_image
  step "sealing root.img and boot.img"
  seal_images
  step "checking the images"
  python3 /src/bin/apple-bootstrap-check image "$product" "$work/final/root.img" "$work/final/boot.img" "$work/final/esp" ||
    fail "the images do not pass the layout check"
  step "packaging"
  zip=/out/$(payload_name)
  install -m 0444 /src/apple-bootstrap/omarchy-volume.icns "$work/final/omarchy-volume.icns"
  find "$work/final" -exec touch -h -d "$(field resolved_at)" {} +
  (cd "$work/final" && bsdtar --format zip -cf "$zip" esp boot.img root.img omarchy-volume.icns)
  write_installer_data "${zip##*/}" /out/installer_data.json
  python3 /src/bin/apple-bootstrap-check payload "$product" "$zip" /out/installer_data.json ||
    fail "the payload does not pass the layout check"
  write_provenance "$zip"
  step "done: ${zip##*/} is $(stat -c %s "$zip") bytes, root.img $(stat -c %s "$work/final/root.img") bytes"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  if [[ ${1:-} == --in-container ]]; then
    shift
    container_main "$@"
  else
    host_main "$@"
  fi
fi
