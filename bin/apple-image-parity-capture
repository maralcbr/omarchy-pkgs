#!/bin/bash

# Derives the parity fixtures from a reference payload's root, mounted read-only:
#   bsdtar -xOf <payload>.zip root.img | cp --sparse=always /dev/stdin root.img
#   mount -o ro,loop,subvolid=5 root.img /mnt/top
#   bin/apple-image-parity-capture manifest /mnt/top/@ >test/fixtures/apple-image-parity/<product>.manifest
#   bin/apple-image-parity-capture pristine /mnt/top/@
# pristine prints the md5 pacman recorded for each edited input, which the
# committed copy under inputs/ must match.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixtures=$ROOT/test/fixtures/apple-image-parity
mode=${1:-}
reference=${2:-}
[[ ($mode == manifest || $mode == pristine) && -d $reference ]] || {
  echo "Usage: apple-image-parity-capture manifest|pristine <reference root>" >&2
  exit 64
}

if [[ $mode == pristine ]]; then
  for entry in 'etc/default/grub grub' 'etc/locale.gen glibc'; do
    read -r file package <<<"$entry"
    database=$(find "$reference/var/lib/pacman/local" -maxdepth 1 -type d -name "$package-[0-9]*" | head -1)
    [[ -n $database ]] || { echo "$package is not installed in $reference" >&2; exit 1; }
    version=${database##*/}
    version=${version#"$package"-}
    md5=$(awk -v file="$file" '/^%BACKUP%$/ { inside = 1; next } /^%/ { inside = 0 } inside && $1 == file { print $2 }' "$database/files")
    printf '%s %s %s %s\n' "$file" "$package" "$version" "$md5"
  done
  exit 0
fi

while IFS= read -r path; do
  [[ -n $path && $path != \#* ]] || continue
  target=$reference/$path
  if [[ -L $target ]]; then
    printf 'link\t%s\t-\t%s\n' "$path" "$(readlink -- "$target")"
  elif [[ -f $target ]]; then
    printf 'file\t%s\t%s\t%s\n' "$path" "$(stat -c %a -- "$target")" "$(sha256sum -- "$target" | cut -d' ' -f1)"
  elif [[ -e $target ]]; then
    echo "$path is neither a file nor a symlink in $reference" >&2
    exit 1
  else
    printf 'absent\t%s\t-\t-\n' "$path"
  fi
done <"$fixtures/shared-paths"
