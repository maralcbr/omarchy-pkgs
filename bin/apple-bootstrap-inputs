#!/bin/bash

# Resolves, once per run, every moving input an Apple Silicon bootstrap image is
# built from: the promoted [omarchy] set the package channel names, the rc pin's
# [omarchy-aurora] release, the [asahi-alarm] database, the dated Arch Linux ARM
# snapshot's databases and the Arch Linux ARM root filesystem. The record pins
# each by sha256, so both products of a run, and every re-run of it, build from
# the same bytes or stop.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
REPOSITORY=${ASAHI_QUATTRO_REPOSITORY:-maralcbr/omarchy-pkgs}
ARTIFACT=apple-bootstrap-inputs
PACKAGES_POINTER_URL=https://downloads.aicodelabs.com.au/pointers/asahi-packages-channel
RELEASE_KEY_URL=https://raw.githubusercontent.com/maralcbr/omarchy-mx-mac/main/default/omarchy-release.gpg
ASAHI_ALARM_SERVER=https://github.com/asahi-alarm/asahi-alarm/releases/download/aarch64
ALARM_SNAPSHOT_BASE=https://downloads.aicodelabs.com.au/mirror/alarm
# The snapshot the rc and stable payloads were built against; see "The Arch Linux
# ARM snapshot" in omarchy-mx-mac docs/apple-silicon-distribution-channels.md.
ALARM_SNAPSHOT=20260910
ALARM_REPOSITORIES=(core extra alarm aur)
ALARM_ROOTFS_URL=https://ca.us.mirror.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz
ALARM_KEY_URL=https://raw.githubusercontent.com/archlinuxarm/archlinuxarm-keyring/91e6b11698f8df66042d56aaa56fbe9c9263847d/packager/builder.asc
ALARM_KEY_FINGERPRINT=68B3537F39A313B3E574D06777193F152BDBE6A6

usage() {
  cat <<'USAGE'
Usage: bin/apple-bootstrap-inputs resolve FILE [--alarm-snapshot YYYYMMDD] [--cache DIR]
       bin/apple-bootstrap-inputs run DIR [--alarm-snapshot YYYYMMDD]
       bin/apple-bootstrap-inputs check FILE
       bin/apple-bootstrap-inputs rootfs FILE DEST [--cache DIR]

  resolve  resolve every input now and write the record to FILE; --cache keeps
           the verified root filesystem for the build
  run      resolve once per workflow run: reuse the apple-bootstrap-inputs
           artifact of this run, or resolve on attempt 1. Writes DIR/inputs and
           prints upload= (true when it is new and must be uploaded) and sha256=
  check    FILE is a canonical record; prints its fields and the servers they name
  rootfs   put the record's Arch Linux ARM root filesystem at DEST after checking
           its signature and recorded sha256

Environment: an authenticated gh (GH_TOKEN) for resolve and run; run also reads
GITHUB_REPOSITORY, GITHUB_RUN_ID and GITHUB_RUN_ATTEMPT.
USAGE
}

fail() {
  echo "apple-bootstrap-inputs: $*" >&2
  exit 1
}

usage_error() {
  echo "apple-bootstrap-inputs: $*" >&2
  usage >&2
  exit 64
}

sha256_of() {
  sha256sum "$1" | cut -d' ' -f1
}

download() {
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --retry 3 --output "$2" "$1"
}

record_body() {
  printf 'format=1\nresolved_at=%s\npackages_channel=%s\nomarchy_tag=%s\nomarchy_descriptor_sha256=%s\nomarchy_db_sha256=%s\naurora_tag=%s\naurora_descriptor_sha256=%s\naurora_db_sha256=%s\nasahi_alarm_db_sha256=%s\nalarm_snapshot=%s\n' \
    "$resolved_at" "$packages_channel" "$omarchy_tag" "$omarchy_descriptor" "$omarchy_db" \
    "$aurora_tag" "$aurora_descriptor" "$aurora_db" "$asahi_alarm_db" "$alarm_snapshot"
  local repository
  for repository in "${ALARM_REPOSITORIES[@]}"; do
    printf 'alarm_%s_db_sha256=%s\n' "$repository" "${alarm_db[$repository]}"
  done
  printf 'alarm_rootfs_sha256=%s\n' "$alarm_rootfs"
}

declare -A alarm_db=()

# Parses FILE, which must be byte for byte the canonical rendering of its fields.
load_record() {
  local file=$1 body="" line key value hex='^[0-9a-f]{64}$'
  declare -A seen=()
  [[ -f $file && ! -L $file ]] || fail "$file is not a regular file"
  (($(wc -c <"$file") <= 4096)) || fail "$file is not an inputs record"
  while IFS= read -r line; do
    [[ $line == *=* ]] || fail "$file is not an inputs record"
    key=${line%%=*} value=${line#*=}
    [[ -z ${seen[$key]:-} ]] || fail "$file is not an inputs record"
    seen[$key]=1
    case $key in
      format) [[ $value == 1 ]] || fail "$file is not an inputs record" ;;
      resolved_at) resolved_at=$value ;;
      packages_channel) packages_channel=$value ;;
      omarchy_tag) omarchy_tag=$value ;;
      omarchy_descriptor_sha256) omarchy_descriptor=$value ;;
      omarchy_db_sha256) omarchy_db=$value ;;
      aurora_tag) aurora_tag=$value ;;
      aurora_descriptor_sha256) aurora_descriptor=$value ;;
      aurora_db_sha256) aurora_db=$value ;;
      asahi_alarm_db_sha256) asahi_alarm_db=$value ;;
      alarm_snapshot) alarm_snapshot=$value ;;
      alarm_rootfs_sha256) alarm_rootfs=$value ;;
      alarm_*_db_sha256)
        key=${key#alarm_} key=${key%_db_sha256}
        alarm_db[$key]=$value
        ;;
      *) fail "$file is not an inputs record" ;;
    esac
  done <"$file"
  [[ ${resolved_at:-} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ &&
    ${packages_channel:-} =~ ^asahi-packages-channel-[1-9][0-9]{0,8}$ &&
    ${omarchy_tag:-} =~ ^asahi-packages-stable-[0-9a-f]{40}$ &&
    ${aurora_tag:-} =~ ^aurora-packages-[0-9a-f]{40}$ &&
    ${alarm_snapshot:-} =~ ^20[0-9]{6}$ ]] || fail "$file is not an inputs record"
  for value in "${omarchy_descriptor:-}" "${omarchy_db:-}" "${aurora_descriptor:-}" "${aurora_db:-}" \
    "${asahi_alarm_db:-}" "${alarm_rootfs:-}"; do
    [[ $value =~ $hex ]] || fail "$file is not an inputs record"
  done
  for key in "${ALARM_REPOSITORIES[@]}"; do
    [[ ${alarm_db[$key]:-} =~ $hex ]] || fail "$file is not an inputs record"
  done
  ((${#alarm_db[@]} == ${#ALARM_REPOSITORIES[@]})) || fail "$file is not an inputs record"
  record_body | cmp -s - "$file" || fail "$file is not a canonical inputs record"
}

# The unsigned pointer only names a channel; asahi-verify-packages-channel decides.
read_pointer() {
  local file=$1 body="" canonical sequence pattern=$'^format=1\nsequence=([1-9][0-9]{0,8})\n'
  (($(wc -c <"$file") <= 256)) || return 1
  IFS= read -r -d '' body <"$file" || true
  [[ $body =~ $pattern ]] || return 1
  sequence=${BASH_REMATCH[1]}
  printf -v canonical 'format=1\nsequence=%s\ntag=asahi-packages-channel-%s\n' "$sequence" "$sequence"
  [[ $body == "$canonical" ]] || return 1
  printf '%s\n' "$sequence"
}

# Prints the value of a key that must appear exactly once.
field() {
  [[ $(grep -c "^$2=" "$1" || true) == 1 ]] || return 1
  sed -n "s/^$2=//p" "$1"
}

# The sha256 a signed descriptor (CANDIDATE or AURORA) records for one asset.
asset_sha256() {
  local value
  [[ $(grep -c "^asset=$2|" "$1" || true) == 1 ]] || return 1
  value=$(sed -n "s/^asset=$2|//p" "$1")
  [[ $value =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$value"
}

release_asset() {
  gh release download "$1" --repo "$REPOSITORY" --dir "$3" --pattern "$2" >/dev/null 2>&1 && [[ -s $3/$2 ]] ||
    fail "could not download $2 from $1"
}

# Downloads the rootfs and its signature into DIR and checks the signature
# against the pinned Arch Linux ARM build key.
fetch_rootfs() {
  local dir=$1 home fingerprint
  download "$ALARM_KEY_URL" "$dir/alarm-builder.asc" || fail "could not download the Arch Linux ARM build key"
  fingerprint=$(gpg --batch --show-keys --with-colons "$dir/alarm-builder.asc" 2>/dev/null |
    awk -F: '$1 == "fpr" { print $10; exit }')
  [[ $fingerprint == "$ALARM_KEY_FINGERPRINT" ]] || fail "the Arch Linux ARM build key has the wrong fingerprint"
  if [[ ! -f $dir/rootfs.tar.gz ]]; then
    download "$ALARM_ROOTFS_URL" "$dir/rootfs.tar.gz" && download "$ALARM_ROOTFS_URL.sig" "$dir/rootfs.tar.gz.sig" ||
      fail "could not download the Arch Linux ARM root filesystem"
  fi
  home=$dir/gnupg
  mkdir -p -m 0700 "$home"
  gpg --batch --homedir "$home" --import "$dir/alarm-builder.asc" >/dev/null 2>&1 ||
    fail "could not load the Arch Linux ARM build key"
  gpg --batch --homedir "$home" --status-fd 1 --verify "$dir/rootfs.tar.gz.sig" "$dir/rootfs.tar.gz" 2>/dev/null |
    awk -v key="$ALARM_KEY_FINGERPRINT" '$2 == "VALIDSIG" && ($3 == key || $NF == key) { valid = 1 } END { exit !valid }' ||
    fail "the Arch Linux ARM root filesystem is not signed by $ALARM_KEY_FINGERPRINT"
}

resolve() {
  local file=$1 sequence repository
  resolved_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 --max-time 20 --max-filesize 256 \
    --output "$work/pointer" "$PACKAGES_POINTER_URL" || fail "could not read the package channel pointer"
  sequence=$(read_pointer "$work/pointer") || fail "the package channel pointer is malformed"
  # asahi-verify-packages-channel checks its fingerprint.
  download "$RELEASE_KEY_URL" "$work/omarchy-release.gpg" || fail "could not download the Omarchy release key"
  "$BASH" "$ROOT/bin/asahi-verify-packages-channel" channel "$sequence" --complete \
    --keyring "$work/omarchy-release.gpg" --trusted-checkout "$ROOT" >"$work/channel" ||
    fail "asahi-packages-channel-$sequence does not verify"
  packages_channel=asahi-packages-channel-$sequence
  omarchy_tag=$(field "$work/channel" stable_tag) && [[ $omarchy_tag =~ ^asahi-packages-stable-[0-9a-f]{40}$ ]] ||
    fail "$packages_channel names no stable package set"
  omarchy_descriptor=$(field "$work/channel" descriptor_sha256) && [[ $omarchy_descriptor =~ ^[0-9a-f]{64}$ ]] ||
    fail "$packages_channel names no descriptor digest"
  release_asset "$omarchy_tag" CANDIDATE "$work/omarchy"
  [[ $(sha256_of "$work/omarchy/CANDIDATE") == "$omarchy_descriptor" ]] ||
    fail "CANDIDATE in $omarchy_tag is not the descriptor $packages_channel names"
  omarchy_db=$(asset_sha256 "$work/omarchy/CANDIDATE" omarchy.db) || fail "CANDIDATE in $omarchy_tag lists no omarchy.db"

  "$BASH" "$ROOT/bin/aurora-verify-edge-release" rc >"$work/rc" || fail "the qualified Aurora release does not verify"
  aurora_tag=$(field "$work/rc" release_tag) && [[ $aurora_tag =~ ^aurora-packages-[0-9a-f]{40}$ ]] ||
    fail "the qualified Aurora release names no aurora-packages release"
  aurora_descriptor=$(field "$work/rc" descriptor_sha256) && [[ $aurora_descriptor =~ ^[0-9a-f]{64}$ ]] ||
    fail "the qualified Aurora release names no descriptor digest"
  release_asset "$aurora_tag" AURORA "$work/aurora"
  [[ $(sha256_of "$work/aurora/AURORA") == "$aurora_descriptor" ]] || fail "AURORA in $aurora_tag is not the qualified one"
  aurora_db=$(asset_sha256 "$work/aurora/AURORA" omarchy-aurora.db) || fail "AURORA in $aurora_tag lists no omarchy-aurora.db"

  # [asahi-alarm] is a mutable release: its database, which carries every
  # package's sha256, is what pins it.
  download "$ASAHI_ALARM_SERVER/asahi-alarm.db" "$work/asahi-alarm.db" || fail "could not download asahi-alarm.db"
  asahi_alarm_db=$(sha256_of "$work/asahi-alarm.db")

  for repository in "${ALARM_REPOSITORIES[@]}"; do
    download "$ALARM_SNAPSHOT_BASE/$alarm_snapshot/$repository/os/aarch64/$repository.db" "$work/$repository.db" ||
      fail "could not download $repository.db from the Arch Linux ARM snapshot $alarm_snapshot"
    alarm_db[$repository]=$(sha256_of "$work/$repository.db")
  done

  mkdir "$work/rootfs"
  fetch_rootfs "$work/rootfs"
  alarm_rootfs=$(sha256_of "$work/rootfs/rootfs.tar.gz")
  if [[ -n $cache ]]; then
    mkdir -p "$cache"
    mv "$work/rootfs/rootfs.tar.gz" "$cache/alarm-rootfs-$alarm_rootfs.tar.gz"
    mv "$work/rootfs/rootfs.tar.gz.sig" "$cache/alarm-rootfs-$alarm_rootfs.tar.gz.sig"
  fi

  record_body >"$file.new"
  mv "$file.new" "$file"
}

mode=${1:-}
if (($#)); then
  shift
fi
case $mode in
  resolve|run|check|rootfs) ;;
  -h|--help) usage; exit 0 ;;
  *) usage_error "mode must be resolve, run, check or rootfs" ;;
esac

positionals=()
alarm_snapshot=$ALARM_SNAPSHOT
cache=""
while (($#)); do
  case $1 in
    --alarm-snapshot|--cache)
      (($# > 1)) && [[ -n $2 ]] || usage_error "$1 requires a value"
      case $1 in
        --alarm-snapshot) alarm_snapshot=$2 ;;
        --cache) cache=$2 ;;
      esac
      shift 2
      ;;
    -*) usage_error "unknown option: $1" ;;
    *) positionals+=("$1"); shift ;;
  esac
done
[[ $alarm_snapshot =~ ^20[0-9]{6}$ ]] || usage_error "invalid Arch Linux ARM snapshot: $alarm_snapshot"
case $mode in
  resolve|run|check) ((${#positionals[@]} == 1)) || usage_error "$mode takes one path" ;;
  rootfs) ((${#positionals[@]} == 2)) || usage_error "rootfs takes FILE and DEST" ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

case $mode in
  resolve)
    resolve "${positionals[0]}"
    load_record "${positionals[0]}"
    ;;
  check)
    load_record "${positionals[0]}"
    cat "${positionals[0]}"
    printf 'omarchy_server=https://github.com/%s/releases/download/%s\n' "$REPOSITORY" "$omarchy_tag"
    printf 'aurora_server=https://github.com/%s/releases/download/%s\n' "$REPOSITORY" "$aurora_tag"
    printf 'asahi_alarm_server=%s\n' "$ASAHI_ALARM_SERVER"
    printf 'alarm_server=%s/%s/$repo/os/$arch\n' "$ALARM_SNAPSHOT_BASE" "$alarm_snapshot"
    ;;
  rootfs)
    load_record "${positionals[0]}"
    dest=${positionals[1]}
    [[ ! -e $dest ]] || fail "$dest already exists"
    if [[ -n $cache && -f $cache/alarm-rootfs-$alarm_rootfs.tar.gz ]]; then
      cp "$cache/alarm-rootfs-$alarm_rootfs.tar.gz" "$work/rootfs.tar.gz"
      cp "$cache/alarm-rootfs-$alarm_rootfs.tar.gz.sig" "$work/rootfs.tar.gz.sig"
    fi
    fetch_rootfs "$work"
    [[ $(sha256_of "$work/rootfs.tar.gz") == "$alarm_rootfs" ]] ||
      fail "the Arch Linux ARM root filesystem changed since this run resolved it; dispatch a new run"
    mv "$work/rootfs.tar.gz" "$dest"
    ;;
  run)
    dir=${positionals[0]}
    [[ ${GITHUB_REPOSITORY:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "GITHUB_REPOSITORY is missing or invalid"
    [[ ${GITHUB_RUN_ID:-} =~ ^[0-9]+$ && ${GITHUB_RUN_ATTEMPT:-} =~ ^[1-9][0-9]*$ ]] ||
      fail "GITHUB_RUN_ID and GITHUB_RUN_ATTEMPT are missing or invalid"
    [[ -d $dir && -z $(ls -A "$dir") ]] || fail "$dir is not an empty directory"
    listing=$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/artifacts?name=$ARTIFACT" \
      --jq '.artifacts[] | select(.expired | not) | .id') || fail "could not list the artifacts of run $GITHUB_RUN_ID"
    ids=()
    while IFS= read -r id; do
      if [[ -n $id ]]; then
        [[ $id =~ ^[0-9]+$ ]] || fail "unexpected artifact id: $id"
        ids+=("$id")
      fi
    done <<<"$listing"
    ((${#ids[@]} <= 1)) || fail "run $GITHUB_RUN_ID has ${#ids[@]} $ARTIFACT artifacts"
    if ((${#ids[@]} == 1)); then
      gh api "repos/$GITHUB_REPOSITORY/actions/artifacts/${ids[0]}/zip" >"$work/inputs.zip" ||
        fail "could not download the $ARTIFACT artifact"
      mkdir "$work/unpacked"
      bsdtar -xf "$work/inputs.zip" -C "$work/unpacked" || fail "could not unpack the $ARTIFACT artifact"
      [[ $(ls -A "$work/unpacked") == inputs && -f $work/unpacked/inputs ]] ||
        fail "the $ARTIFACT artifact does not hold exactly one inputs record"
      cp "$work/unpacked/inputs" "$dir/inputs"
      upload=false
    else
      ((GITHUB_RUN_ATTEMPT == 1)) ||
        fail "attempt $GITHUB_RUN_ATTEMPT finds no inputs recorded by attempt 1; dispatch a new run"
      resolve "$dir/inputs"
      upload=true
    fi
    load_record "$dir/inputs"
    printf 'upload=%s\nsha256=%s\n' "$upload" "$(sha256_of "$dir/inputs")"
    ;;
esac
