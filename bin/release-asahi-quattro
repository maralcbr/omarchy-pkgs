#!/bin/bash

set -euo pipefail

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
KEY_FINGERPRINT=5983B1CA32CB778F4D74D24ECFF35022CA5B5959
CHANNEL_TAG_PREFIX=asahi-quattro-channel
REPOSITORY=${ASAHI_QUATTRO_REPOSITORY:-maralcbr/omarchy-pkgs}

usage() {
  cat <<'USAGE'
Usage: bin/release-asahi-quattro BUNDLE_DIR UPGRADER [--output DIR] [--publish]

Prepare a signed immutable six-package stable Asahi Quattro release and signed
latest channel pointer. --publish creates/uploads the GitHub releases.
USAGE
}

bundle_dir="${1:-}"
upgrader="${2:-}"
[[ -n $bundle_dir && -d $bundle_dir && -n $upgrader && -f $upgrader ]] || {
  usage >&2
  exit 1
}
shift 2

output_dir=""
publish=0
while (($#)); do
  case "$1" in
    --output)
      (($# > 1)) || { echo "--output requires a directory" >&2; exit 1; }
      output_dir="$2"
      shift 2
      ;;
    --publish)
      publish=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

[[ -n ${ASAHI_QUATTRO_SEQUENCE:-} && $ASAHI_QUATTRO_SEQUENCE =~ ^[1-9][0-9]*$ ]] || {
  echo "ASAHI_QUATTRO_SEQUENCE must be a positive integer" >&2
  exit 1
}

for command_name in gpg sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 || { echo "Missing command: $command_name" >&2; exit 1; }
done
(( publish == 0 )) || command -v gh >/dev/null 2>&1 || { echo "Missing command: gh" >&2; exit 1; }

bundle_dir=$(realpath "$bundle_dir")
upgrader=$(realpath "$upgrader")
bundle_updater="$(dirname "$upgrader")/omarchy-update-asahi-bundle"
[[ -f $bundle_updater ]] || { echo "Missing bundle updater beside upgrader: $bundle_updater" >&2; exit 1; }
fresh_installer="$(dirname "$upgrader")/omarchy-install-asahi-fresh"
[[ -f $fresh_installer ]] || { echo "Missing fresh installer beside upgrader: $fresh_installer" >&2; exit 1; }
candidate_manifest=${ASAHI_RUNTIME_CANDIDATE_MANIFEST:-}
candidate_manifest_signature=${ASAHI_RUNTIME_CANDIDATE_MANIFEST_SIGNATURE:-}
candidate_key=${ASAHI_RUNTIME_CANDIDATE_KEY:-}
candidate_mode=0
candidate_keyring_dir=""
if [[ -n $candidate_manifest || -n $candidate_manifest_signature || -n $candidate_key ]]; then
  candidate_mode=1
  [[ -f $candidate_manifest && -f $candidate_manifest_signature && -f $candidate_key ]] || {
    echo "Candidate manifest, signature, and key must be supplied together" >&2
    exit 1
  }
  candidate_keyring_dir=$(mktemp -d)
  trap 'rm -rf "$candidate_keyring_dir"' EXIT
  candidate_keyring="$candidate_keyring_dir/repository-signing.gpg"
  gpg --batch --dearmor --output "$candidate_keyring" "$candidate_key"
fi

manifest=$("$BUILD_ROOT/bin/asahi-bundle-manifest" "$bundle_dir")
if (( candidate_mode )); then
  cmp --silent "$candidate_manifest" "$manifest" || {
    echo "Candidate runtime manifest does not exactly match the supplied archives" >&2
    exit 1
  }
  gpgv --keyring "$candidate_keyring" "$candidate_manifest_signature" "$candidate_manifest" >/dev/null 2>&1 || {
    echo "Candidate runtime manifest signature verification failed" >&2
    exit 1
  }
fi
source_commit=$(sed -n 's/^source_commit=//p' "$manifest")
[[ $source_commit =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid manifest source commit" >&2; exit 1; }
package_source_commit=${ASAHI_PACKAGE_SOURCE_COMMIT:-$(git -C "$BUILD_ROOT" rev-parse HEAD)}
[[ $package_source_commit =~ ^[0-9a-f]{40}$ ]] || { echo "Invalid package source commit" >&2; exit 1; }
git -C "$BUILD_ROOT" diff --quiet && git -C "$BUILD_ROOT" diff --cached --quiet || {
  echo "Package source must be committed before creating a signed release" >&2
  exit 1
}
release_tag="asahi-quattro-${source_commit:0:8}"
channel_tag="$CHANNEL_TAG_PREFIX-$ASAHI_QUATTRO_SEQUENCE"
output_dir=${output_dir:-"$bundle_dir/release-$release_tag"}
mkdir -p "$output_dir"
output_dir=$(realpath "$output_dir")

if (( candidate_mode )); then
  cp "$candidate_manifest" "$output_dir/asahi-quattro-bundle.manifest"
  cp "$candidate_manifest_signature" "$output_dir/asahi-quattro-bundle.manifest.sig"
else
  cp "$manifest" "$output_dir/asahi-quattro-bundle.manifest"
fi
cp "$upgrader" "$output_dir/omarchy-upgrade-to-quattro"
cp "$bundle_updater" "$output_dir/omarchy-update-asahi-bundle"
cp "$fresh_installer" "$output_dir/omarchy-install-asahi-fresh"
cp "$BUILD_ROOT/bin/install-asahi-quattro" "$output_dir/install-asahi-quattro"
shopt -s nullglob
archives=("$bundle_dir"/*.pkg.tar*)
for archive in "${archives[@]}"; do
  [[ $archive == *.sig ]] && continue
  cp "$archive" "$output_dir/"
  if (( candidate_mode )); then
    [[ -f $archive.sig ]] || { echo "Missing candidate signature for ${archive##*/}" >&2; exit 1; }
    gpgv --keyring "$candidate_keyring" "$archive.sig" "$archive" >/dev/null 2>&1 || {
      echo "Candidate package signature verification failed for ${archive##*/}" >&2
      exit 1
    }
    cp "$archive.sig" "$output_dir/"
  fi
done
shopt -u nullglob

manifest_sha256=$(sha256sum "$output_dir/asahi-quattro-bundle.manifest")
upgrader_sha256=$(sha256sum "$output_dir/omarchy-upgrade-to-quattro")
bundle_updater_sha256=$(sha256sum "$output_dir/omarchy-update-asahi-bundle")
fresh_installer_sha256=$(sha256sum "$output_dir/omarchy-install-asahi-fresh")
release="$output_dir/asahi-quattro-release"
{
  printf 'format=1\n'
  printf 'bundle=asahi-quattro\n'
  printf 'sequence=%s\n' "$ASAHI_QUATTRO_SEQUENCE"
  printf 'release_tag=%s\n' "$release_tag"
  printf 'source_commit=%s\n' "$source_commit"
  printf 'package_source_commit=%s\n' "$package_source_commit"
  printf 'manifest_sha256=%s\n' "${manifest_sha256%%  *}"
  printf 'upgrader_sha256=%s\n' "${upgrader_sha256%%  *}"
  printf 'bundle_updater_sha256=%s\n' "${bundle_updater_sha256%%  *}"
  printf 'fresh_installer_sha256=%s\n' "${fresh_installer_sha256%%  *}"
} >"$release"

channel="$output_dir/asahi-quattro-channel"
release_sha256=$(sha256sum "$release")
{
  printf 'format=1\n'
  printf 'channel=asahi-quattro\n'
  printf 'sequence=%s\n' "$ASAHI_QUATTRO_SEQUENCE"
  printf 'release_tag=%s\n' "$release_tag"
  printf 'source_commit=%s\n' "$source_commit"
  printf 'manifest=asahi-quattro-bundle.manifest\n'
  printf 'manifest_sha256=%s\n' "${manifest_sha256%%  *}"
  printf 'release_sha256=%s\n' "${release_sha256%%  *}"
} >"$channel"

signing_fingerprint=$(gpg --batch --list-secret-keys --with-colons "$KEY_FINGERPRINT" 2>/dev/null | sed -n 's/^fpr:::::::::\([^:]*\):$/\1/p' | head -1)
[[ $signing_fingerprint == "$KEY_FINGERPRINT" ]] || {
  echo "Omarchy secret signing key $KEY_FINGERPRINT is unavailable" >&2
  exit 1
}
sign_args=(--batch --yes --detach-sign --local-user "$KEY_FINGERPRINT")
if [[ -n ${GPG_PASSPHRASE:-} ]]; then
  sign_args+=(--pinentry-mode loopback --passphrase "$GPG_PASSPHRASE")
fi
signed_files=(
  "$release"
  "$channel"
  "$output_dir/install-asahi-quattro"
  "$output_dir/omarchy-update-asahi-bundle"
  "$output_dir/omarchy-install-asahi-fresh"
)
if (( candidate_mode == 0 )); then
  signed_files=("$output_dir"/*.pkg.tar* "$output_dir/asahi-quattro-bundle.manifest" "${signed_files[@]}")
fi
for signed_file in "${signed_files[@]}"; do
  [[ $signed_file == *.sig ]] && continue
  gpg "${sign_args[@]}" "$signed_file"
done

(
  cd "$output_dir"
  sha256sum -- * | grep -vE '  (SHA256SUMS|asahi-quattro-channel|asahi-quattro-channel.sig)$' >SHA256SUMS
)

if (( publish )); then
  immutable_assets=(
    "$output_dir"/*.pkg.tar*
    "$output_dir/asahi-quattro-bundle.manifest"
    "$output_dir/asahi-quattro-bundle.manifest.sig"
    "$output_dir/asahi-quattro-release"
    "$output_dir/asahi-quattro-release.sig"
    "$output_dir/install-asahi-quattro"
    "$output_dir/install-asahi-quattro.sig"
    "$output_dir/omarchy-upgrade-to-quattro"
    "$output_dir/omarchy-update-asahi-bundle"
    "$output_dir/omarchy-update-asahi-bundle.sig"
    "$output_dir/omarchy-install-asahi-fresh"
    "$output_dir/omarchy-install-asahi-fresh.sig"
    "$output_dir/SHA256SUMS"
  )
  channel_assets=(
    "$channel.sig"
    "$output_dir/install-asahi-quattro.sig"
    "$channel"
    "$output_dir/install-asahi-quattro"
  )
  if gh release view "$release_tag" --repo "$REPOSITORY" >/dev/null 2>&1; then
    existing_release_dir=$(mktemp -d)
    gh release download "$release_tag" --repo "$REPOSITORY" --dir "$existing_release_dir"
    mapfile -t existing_assets < <(find "$existing_release_dir" -maxdepth 1 -type f | sort)
    if (( ${#existing_assets[@]} != ${#immutable_assets[@]} )); then
      echo "Existing immutable release $release_tag has an unexpected asset count" >&2
      exit 1
    fi
    generated_signatures=(
      asahi-quattro-release.sig
      install-asahi-quattro.sig
      omarchy-update-asahi-bundle.sig
      omarchy-install-asahi-fresh.sig
    )
    for immutable_asset in "${immutable_assets[@]}"; do
      existing_asset="$existing_release_dir/${immutable_asset##*/}"
      [[ -f $existing_asset ]] || {
        echo "Existing immutable release $release_tag is missing ${immutable_asset##*/}" >&2
        exit 1
      }
      [[ ${immutable_asset##*/} == "SHA256SUMS" ]] && continue
      [[ " ${generated_signatures[*]} " == *" ${immutable_asset##*/} "* ]] && continue
      cmp --silent "$immutable_asset" "$existing_asset" || {
        echo "Existing immutable release $release_tag differs at ${immutable_asset##*/}" >&2
        exit 1
      }
    done
    (
      cd "$existing_release_dir"
      sha256sum --check --strict SHA256SUMS
    )
    cmp --silent \
      <(sed -n 's/^[0-9a-f]\{64\}  //p' "$output_dir/SHA256SUMS" | sort) \
      <(sed -n 's/^[0-9a-f]\{64\}  //p' "$existing_release_dir/SHA256SUMS" | sort) || {
      echo "Existing immutable release $release_tag has an unexpected checksum inventory" >&2
      exit 1
    }
    for signature in "${generated_signatures[@]}"; do
      signed_asset=${signature%.sig}
      gpg --batch --verify "$existing_release_dir/$signature" "$existing_release_dir/$signed_asset" >/dev/null 2>&1 || {
        echo "Existing immutable release $release_tag has an invalid $signature" >&2
        exit 1
      }
      cp "$existing_release_dir/$signature" "$output_dir/$signature"
    done
    cp "$existing_release_dir/SHA256SUMS" "$output_dir/SHA256SUMS"
    rm -rf "$existing_release_dir"
  else
    gh release create "$release_tag" "${immutable_assets[@]}" --repo "$REPOSITORY" --latest --title "$release_tag"
  fi
  if gh release view "$channel_tag" --repo "$REPOSITORY" >/dev/null 2>&1; then
    existing_channel_dir=$(mktemp -d)
    gh release download "$channel_tag" --repo "$REPOSITORY" --dir "$existing_channel_dir"
    mapfile -t existing_channel_assets < <(find "$existing_channel_dir" -maxdepth 1 -type f | sort)
    (( ${#existing_channel_assets[@]} == ${#channel_assets[@]} )) || {
      echo "Existing immutable channel $channel_tag has an unexpected asset count" >&2
      exit 1
    }
    for channel_asset in "$channel" "$output_dir/install-asahi-quattro"; do
      cmp --silent "$channel_asset" "$existing_channel_dir/${channel_asset##*/}" || {
        echo "Existing immutable channel $channel_tag differs at ${channel_asset##*/}" >&2
        exit 1
      }
    done
    for signature in asahi-quattro-channel.sig install-asahi-quattro.sig; do
      signed_asset=${signature%.sig}
      gpg --batch --verify "$existing_channel_dir/$signature" "$existing_channel_dir/$signed_asset" >/dev/null 2>&1 || {
        echo "Existing immutable channel $channel_tag has an invalid $signature" >&2
        exit 1
      }
    done
    rm -rf "$existing_channel_dir"
    gh release edit "$channel_tag" --repo "$REPOSITORY" --latest
  else
    gh release create "$channel_tag" "${channel_assets[@]}" --repo "$REPOSITORY" --latest --title "Asahi Quattro stable channel sequence $ASAHI_QUATTRO_SEQUENCE"
  fi
fi

printf 'Prepared %s in %s\n' "$release_tag" "$output_dir"
