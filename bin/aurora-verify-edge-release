#!/bin/bash

set -euo pipefail
export LC_ALL=C

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
REPOSITORY=${ASAHI_QUATTRO_REPOSITORY:-maralcbr/omarchy-pkgs}
QUALIFIED_REPOSITORY=maralcbr/omarchy-mx-mac
QUALIFIED_FILE=default/aurora-qualified-release
EDGE_TAG_PREFIX=aurora-edge
EDGE_RECIPE=pkgbuilds/linux-aurora-edge
MAX_DESCRIPTOR_BYTES=65536
DATABASE_ASSETS=(omarchy-aurora.db omarchy-aurora.db.sig omarchy-aurora.files omarchy-aurora.files.sig)
KERNEL_PACKAGES=(linux-aurora linux-aurora-headers)

usage() {
  cat <<'USAGE'
Usage: bin/aurora-verify-edge-release edge SEQUENCE [--complete] [OPTIONS]
       bin/aurora-verify-edge-release rc [--m1n1-dir DIR] [OPTIONS]
       bin/aurora-verify-edge-release next DESCRIPTOR [OPTIONS]
       bin/aurora-verify-edge-release packages SOURCE_COMMIT [--complete] [OPTIONS]
       bin/aurora-verify-edge-release gate edge INPUT_DIGEST [--force] [OPTIONS]
       bin/aurora-verify-edge-release gate rc SOURCE_COMMIT [INPUT_DIGEST] [--force] [OPTIONS]

Read-only checks for the Aurora edge lane, shared by release-aurora-edge.yml
and bin/publish-asahi-channel-pointer --kind aurora-edge. Each mode prints the
verified fields as key=value lines.

  edge  aurora-edge-SEQUENCE is published (not a draft or prerelease) and
        immutable, and its AURORA is signed by the signing subkey and is the
        canonical descriptor of exactly that release: channel=aurora-edge,
        sequence=SEQUENCE, and kernel versions ending in .SEQUENCE-1.
        --complete also downloads every asset and checks each package,
        signature, repository database, the recipe (PKGBUILD) and its
        metadata (SRCINFO), the input record (INPUTS) when AURORA records an
        input digest, and SHA256SUMS against AURORA.
  rc    the aurora-packages release named by default/aurora-qualified-release
        on omarchy-mx-mac main carries the pinned AURORA digest, signed by the
        signing subkey. --m1n1-dir also downloads its m1n1-aurora package and
        signature into DIR after checking both against that AURORA.
  next  DESCRIPTOR and DESCRIPTOR.sig, with PKGBUILD, SRCINFO and INPUTS
        beside them, describe the edge release about to be published: its
        PKGBUILD is this checkout's pkgbuilds/linux-aurora-edge pinned to its
        source and its SRCINFO lists that recipe's sources and checksums; it
        records an input digest, and INPUTS is this checkout's input record
        for its source, builder, dependencies and m1n1-aurora; its tag
        exists nowhere yet (no release, draft or git tag); its sequence is
        above every edge release already published; its kernel versions are
        newer (vercmp) than every one of those and than the rc pin's; and its
        m1n1-aurora is the rc pin's exact package.
  packages
        aurora-packages-SOURCE_COMMIT is published (not a draft) and
        immutable, and its AURORA is signed by the signing subkey and is the
        canonical rc descriptor of that release. --complete checks every
        asset as edge --complete does.
  gate  Whether a kernel lane builds (build=true) or has nothing new
        (build=false). Anything that cannot be proven equal builds.
        edge: build=false only when the highest published edge release
        verifies and records INPUT_DIGEST. --force always builds, as a new
        sequence.
        rc: when aurora-packages-SOURCE_COMMIT exists it is never rebuilt,
        forced or not: it is verified completely (published=true) and the
        gate fails if it does not verify. The gate also fails when the
        releases cannot be listed or the tag looked up. Otherwise, without INPUT_DIGEST
        it builds; with one, build=false when another published
        aurora-packages release verifies and records INPUT_DIGEST, unless
        --force.

Options:
  --signing-key FILE     Armored ARM repository key
                         (default keys/asahi-repository-signing.asc)
  --signing-subkey FPR   Subkey that must sign AURORA, packages and databases
                         (default CAB18E175BFB9ACCE185234474DE0C737AC186E4)

Environment: an authenticated gh (GH_TOKEN). next needs vercmp.
USAGE
}

fail() {
  echo "aurora-verify-edge-release: $*" >&2
  exit 1
}

usage_error() {
  echo "aurora-verify-edge-release: $*" >&2
  usage >&2
  exit 64
}

absolute_path() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

mode=${1:-}
if (($#)); then
  shift
fi
case $mode in
  edge|rc|next|packages|gate) ;;
  -h|--help) usage; exit 0 ;;
  *) usage_error "mode must be edge, rc, next, packages or gate" ;;
esac

positionals=()
complete=0
force=0
m1n1_dir=""
repository_key=$ROOT/keys/asahi-repository-signing.asc
signing_subkey=CAB18E175BFB9ACCE185234474DE0C737AC186E4
while (($#)); do
  case $1 in
    --complete)
      complete=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    --m1n1-dir|--signing-key|--signing-subkey)
      (($# > 1)) && [[ -n $2 ]] || usage_error "$1 requires a value"
      case $1 in
        --m1n1-dir) m1n1_dir=$2 ;;
        --signing-key) repository_key=$2 ;;
        --signing-subkey) signing_subkey=${2^^} ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      usage_error "unknown option: $1"
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

sequence_pattern='^[1-9][0-9]{0,8}$'
case $mode in
  edge)
    ((${#positionals[@]} == 1)) || usage_error "edge takes one SEQUENCE"
    [[ ${positionals[0]} =~ $sequence_pattern ]] || usage_error "invalid sequence: ${positionals[0]}"
    ;;
  rc)
    ((${#positionals[@]} == 0)) || usage_error "rc takes no arguments"
    ;;
  next)
    ((${#positionals[@]} == 1)) || usage_error "next takes one DESCRIPTOR"
    ;;
  packages)
    ((${#positionals[@]} == 1)) || usage_error "packages takes one SOURCE_COMMIT"
    [[ ${positionals[0]} =~ ^[0-9a-f]{40}$ ]] || usage_error "invalid source commit: ${positionals[0]}"
    ;;
  gate)
    case ${positionals[0]:-} in
      edge)
        ((${#positionals[@]} == 2)) || usage_error "gate edge takes one INPUT_DIGEST"
        [[ ${positionals[1]} =~ ^[0-9a-f]{64}$ ]] || usage_error "invalid input digest: ${positionals[1]}"
        ;;
      rc)
        ((${#positionals[@]} == 2 || ${#positionals[@]} == 3)) || usage_error "gate rc takes SOURCE_COMMIT [INPUT_DIGEST]"
        [[ ${positionals[1]} =~ ^[0-9a-f]{40}$ ]] || usage_error "invalid source commit: ${positionals[1]}"
        [[ ${#positionals[@]} == 2 || ${positionals[2]} =~ ^[0-9a-f]{64}$ ]] || usage_error "invalid input digest: ${positionals[2]}"
        ;;
      *) usage_error "gate takes edge or rc" ;;
    esac
    ;;
esac
((complete == 0)) || [[ $mode == edge || $mode == packages ]] || usage_error "--complete only applies to edge and packages"
((force == 0)) || [[ $mode == gate ]] || usage_error "--force only applies to gate"
[[ -z $m1n1_dir || $mode == rc ]] || usage_error "--m1n1-dir only applies to rc"
[[ $signing_subkey =~ ^[A-F0-9]{40}$ ]] || usage_error "--signing-subkey must be a full fingerprint"

required_tools=(cmp gh gpg jq sha256sum sort)
[[ $mode != next ]] || required_tools+=(vercmp)
for tool in "${required_tools[@]}"; do
  command -v "$tool" >/dev/null 2>&1 || fail "missing command: $tool"
done

repository_key=$(absolute_path "$repository_key")
[[ -f $repository_key ]] || fail "repository signing key not found: $repository_key"
if [[ -n $m1n1_dir ]]; then
  m1n1_dir=$(absolute_path "$m1n1_dir")
  [[ -d $m1n1_dir ]] || fail "not a directory: $m1n1_dir"
fi
mapfile -t manifest <"$ROOT/pkgbuilds/aurora-repository-packages"
((${#manifest[@]} > 0)) || fail "no Aurora packages listed in pkgbuilds/aurora-repository-packages"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
home=$work/gnupg
mkdir -m 0700 "$home"
gpg --batch --homedir "$home" --import "$repository_key" >/dev/null 2>&1 ||
  fail "could not read repository signing key: $repository_key"
subkey_kind=$(gpg --batch --homedir "$home" --with-colons --list-keys 2>/dev/null |
  awk -F: -v wanted="$signing_subkey" '
    $1 == "pub" || $1 == "sub" { kind=$1; next }
    $1 == "fpr" && $10 == wanted { print kind; exit }
  ')
[[ $subkey_kind == sub ]] || fail "$repository_key does not hold the signing subkey $signing_subkey"

sha256_of() {
  sha256sum "$1" | cut -d' ' -f1
}

# A good signature from another key in the same certificate is not enough.
verify_signed_by() {
  local file=$1 where=$2 status
  [[ -s $file && -s $file.sig ]] || fail "$where is missing ${file##*/} or its signature"
  status=$(gpg --batch --homedir "$home" --status-fd 1 --verify "$file.sig" "$file" 2>/dev/null) ||
    fail "signature verification failed for ${file##*/} in $where"
  awk -v key="$signing_subkey" '$1 == "[GNUPG:]" && $2 == "VALIDSIG" && $3 == key { valid=1 } END { exit !valid }' \
    <<<"$status" || fail "${file##*/} in $where is not signed by $signing_subkey"
}

# Prints the value of a key that must appear exactly once.
field() {
  local count
  count=$(grep -c "^$2=" "$1" || true)
  [[ $count == 1 ]] || return 1
  sed -n "s/^$2=//p" "$1"
}

# prerelease: false (published channel release), any (only not a draft) or
# immutable (not a draft and immutable, like every aurora-packages release).
require_release() {
  local tag=$1 prerelease=$2 json
  json=$(gh api "repos/$REPOSITORY/releases/tags/$tag" 2>/dev/null) || fail "release $tag is not published on $REPOSITORY"
  if [[ $prerelease == any ]]; then
    jq -e --arg tag "$tag" '.tag_name == $tag and .draft == false' <<<"$json" >/dev/null 2>&1 ||
      fail "release $tag is not published"
  elif [[ $prerelease == immutable ]]; then
    jq -e --arg tag "$tag" '.tag_name == $tag and .draft == false and .immutable == true' <<<"$json" >/dev/null 2>&1 ||
      fail "release $tag must be published (not a draft) and immutable"
  else
    jq -e --arg tag "$tag" '.tag_name == $tag and .draft == false and .prerelease == false and .immutable == true' \
      <<<"$json" >/dev/null 2>&1 || fail "release $tag must be published (not a draft or prerelease) and immutable"
  fi
}

download_assets() {
  local tag=$1 dir=$2 name patterns=()
  shift 2
  for name; do
    patterns+=(--pattern "$name")
  done
  mkdir -p "$dir"
  gh release download "$tag" --repo "$REPOSITORY" --dir "$dir" "${patterns[@]}" >/dev/null 2>&1 ||
    fail "could not download ${*:-the assets} from $tag"
  for name; do
    [[ -f $dir/$name ]] || fail "$tag has no $name"
  done
}

in_manifest() {
  local name
  for name in "${manifest[@]}"; do
    [[ $name == "$1" ]] && return 0
  done
  return 1
}

# Checks a signed AURORA against the canonical rendering of the descriptor it
# claims to be and sets d_* and the package/asset maps from it.
#   channel aurora:      tag aurora-packages-<source_commit>, no edge keys
#   channel aurora-edge: tag aurora-edge-N with sequence=N and the edge keys
declare -A package_version=() package_record=() asset_sha256=()
parse_descriptor() {
  local file=$1 where=$2 channel=$3 tag=$4 sequence=${5:-} size index=0 line number name version arch filename
  local checksum signature signature_checksum extra asset value
  size=$(wc -c <"$file" | tr -d ' ')
  ((size <= MAX_DESCRIPTOR_BYTES)) || fail "AURORA in $where is $size bytes, over the $MAX_DESCRIPTOR_BYTES-byte limit"
  verify_signed_by "$file" "$where"
  package_version=() package_record=() asset_sha256=()
  d_source_commit=$(field "$file" source_commit) && [[ $d_source_commit =~ ^[0-9a-f]{40}$ ]] ||
    fail "AURORA in $where has an invalid source_commit"
  d_workflow_run=$(field "$file" workflow_run) && [[ $d_workflow_run =~ ^[0-9]+$ ]] ||
    fail "AURORA in $where has an invalid workflow_run"
  # Releases from before input digests carry none; they are never reused.
  d_input_digest=""
  if grep -q '^input_digest=' "$file"; then
    d_input_digest=$(field "$file" input_digest) && [[ $d_input_digest =~ ^[0-9a-f]{64}$ ]] ||
      fail "AURORA in $where has an invalid input_digest"
  fi
  d_aurora_commit="" d_source_sha256="" d_recipe_sha256="" d_srcinfo_sha256=""
  if [[ $channel == aurora-edge ]]; then
    d_aurora_commit=$(field "$file" aurora_commit) && [[ $d_aurora_commit =~ ^[0-9a-f]{40}$ ]] ||
      fail "AURORA in $where has an invalid aurora_commit"
    d_source_sha256=$(field "$file" source_sha256) && [[ $d_source_sha256 =~ ^[0-9a-f]{64}$ ]] ||
      fail "AURORA in $where has an invalid source_sha256"
    d_recipe_sha256=$(field "$file" recipe_sha256) && [[ $d_recipe_sha256 =~ ^[0-9a-f]{64}$ ]] ||
      fail "AURORA in $where has an invalid recipe_sha256"
    d_srcinfo_sha256=$(field "$file" srcinfo_sha256) && [[ $d_srcinfo_sha256 =~ ^[0-9a-f]{64}$ ]] ||
      fail "AURORA in $where has an invalid srcinfo_sha256"
  else
    [[ $tag == "aurora-packages-$d_source_commit" ]] || fail "AURORA in $where names source $d_source_commit, not $tag"
  fi
  while IFS= read -r line; do
    [[ $line == package=* ]] || continue
    index=$((index + 1))
    IFS='|' read -r number name version arch filename checksum signature signature_checksum extra <<<"${line#package=}"
    [[ $number == "$index" && -z $extra ]] || fail "AURORA in $where has an invalid package entry $index"
    in_manifest "$name" && [[ -z ${package_version[$name]:-} ]] ||
      fail "AURORA in $where lists an unexpected or repeated package $name"
    [[ $version =~ ^([1-9][0-9]*:)?[A-Za-z0-9._+~]+-[0-9]+(\.[0-9]+)?$ && ($arch == aarch64 || $arch == any) ]] ||
      fail "AURORA in $where has an invalid version or architecture for $name"
    [[ $filename =~ ^[A-Za-z0-9._+@-]+$ && $filename == "$name-$version-$arch.pkg.tar."* &&
      $checksum =~ ^[0-9a-f]{64}$ && $signature == "$filename.sig" && $signature_checksum =~ ^[0-9a-f]{64}$ ]] ||
      fail "AURORA in $where has an invalid file or checksum for $name"
    package_version[$name]=$version
    package_record[$name]="$name|$version|$arch|$filename|$checksum|$signature|$signature_checksum"
  done <"$file"
  ((index == ${#manifest[@]})) || fail "AURORA in $where lists $index packages, not ${#manifest[@]}"
  for asset in "${DATABASE_ASSETS[@]}"; do
    value=$(grep -c "^asset=$asset|" "$file" || true)
    [[ $value == 1 ]] || fail "AURORA in $where does not list $asset exactly once"
    asset_sha256[$asset]=$(sed -n "s/^asset=$asset|//p" "$file")
    [[ ${asset_sha256[$asset]} =~ ^[0-9a-f]{64}$ ]] || fail "AURORA in $where has an invalid checksum for $asset"
  done
  if [[ $channel == aurora-edge ]]; then
    for name in "${KERNEL_PACKAGES[@]}"; do
      [[ ${package_version[$name]} =~ ^([1-9][0-9]*:)?[0-9]+\.[0-9]+\.[0-9]+\.aurora[0-9]+\.$sequence-1$ ]] ||
        fail "AURORA in $where carries $name ${package_version[$name]}, not a version built as edge $sequence"
    done
  fi
  # Byte equality with the canonical rendering rejects extra, missing, duplicate
  # or reordered keys, CR and a missing newline.
  {
    printf 'format=1\nchannel=%s\nrelease_tag=%s\n' "$channel" "$tag"
    [[ $channel != aurora-edge ]] || printf 'sequence=%s\n' "$sequence"
    printf 'source_commit=%s\n' "$d_source_commit"
    [[ $channel != aurora-edge ]] || printf 'aurora_commit=%s\nsource_sha256=%s\nrecipe_sha256=%s\nsrcinfo_sha256=%s\n' \
      "$d_aurora_commit" "$d_source_sha256" "$d_recipe_sha256" "$d_srcinfo_sha256"
    [[ -z $d_input_digest ]] || printf 'input_digest=%s\n' "$d_input_digest"
    printf 'workflow_run=%s\nrunner_arch=aarch64\nsigning_fingerprint=%s\npackage_count=%s\n' \
      "$d_workflow_run" "$signing_subkey" "${#manifest[@]}"
    printf '%s\n' "${package_record[@]}" | sort | awk '{ printf "package=%d|%s\n", NR, $0 }'
    for asset in "${DATABASE_ASSETS[@]}"; do
      printf 'asset=%s|%s\n' "$asset" "${asset_sha256[$asset]}"
    done
  } >"$work/canonical"
  cmp -s "$work/canonical" "$file" || fail "AURORA in $where is not the canonical $channel descriptor of $tag"
  d_descriptor_sha256=$(sha256_of "$file")
}

# DIR/PKGBUILD and DIR/SRCINFO are the ones AURORA names, and both are pinned to
# its source: the aurora-silicon/linux commit, archive checksum and sequence.
verify_recipe() {
  local dir=$1 where=$2 sequence=$3 name
  for name in PKGBUILD SRCINFO; do
    [[ -f $dir/$name ]] || fail "$where has no $name"
  done
  [[ $(sha256_of "$dir/PKGBUILD") == "$d_recipe_sha256" ]] || fail "PKGBUILD in $where does not match AURORA"
  [[ $(sha256_of "$dir/SRCINFO") == "$d_srcinfo_sha256" ]] || fail "SRCINFO in $where does not match AURORA"
  [[ $(grep -c '^_commit=' "$dir/PKGBUILD") == 1 && $(grep -c '^_edge_sequence=' "$dir/PKGBUILD") == 1 &&
    $(grep -c '^sha256sums=(' "$dir/PKGBUILD") == 1 ]] &&
    grep -Fxq "_commit=$d_aurora_commit" "$dir/PKGBUILD" && grep -Fxq "_edge_sequence=$sequence" "$dir/PKGBUILD" &&
    grep -Fxq "sha256sums=('$d_source_sha256'" "$dir/PKGBUILD" ||
    fail "PKGBUILD in $where is not pinned to $d_aurora_commit, its archive and edge $sequence"
  [[ $(head -1 "$dir/SRCINFO") == 'pkgbase = linux-aurora' &&
    $(sed -n 's/^pkgname = //p' "$dir/SRCINFO" | paste -sd' ') == "${KERNEL_PACKAGES[*]}" &&
    $(sed -n 's/^\tsource = //p' "$dir/SRCINFO" | head -1) == "https://github.com/aurora-silicon/linux/archive/$d_aurora_commit.tar.gz" &&
    $(sed -n 's/^\tsha256sums = //p' "$dir/SRCINFO" | head -1) == "$d_source_sha256" ]] ||
    fail "SRCINFO in $where does not describe linux-aurora built from $d_aurora_commit and its archive"
}

# The PKGBUILD must be this checkout's recipe pinned exactly as the workflow
# pins it, and the SRCINFO must list that recipe's sources and checksums.
verify_recipe_source() {
  local dir=$1 where=$2 sequence=$3 copy=$work/recipe
  [[ -f $ROOT/$EDGE_RECIPE/PKGBUILD ]] || fail "this checkout has no $EDGE_RECIPE"
  cp -R "$ROOT/$EDGE_RECIPE" "$copy"
  "$BASH" "$ROOT/bin/aurora-edge-pin-recipe" "$copy" "$d_aurora_commit" "$d_source_sha256" "$sequence" >/dev/null ||
    fail "could not pin $EDGE_RECIPE to the source in AURORA"
  cmp -s "$copy/PKGBUILD" "$dir/PKGBUILD" ||
    fail "PKGBUILD in $where is not this checkout's $EDGE_RECIPE pinned to its source"
  (cd "$copy" && startdir=$PWD bash -c '
    source ./PKGBUILD >/dev/null 2>&1 || exit 1
    printf "\tsource = %s\n" "${source[@]}"
    printf "\tsha256sums = %s\n" "${sha256sums[@]}"
  ') >"$work/recipe-sources" || fail "could not read $EDGE_RECIPE"
  grep -E $'^\t(source|sha256sums) = ' "$dir/SRCINFO" | cmp -s "$work/recipe-sources" - ||
    fail "SRCINFO in $where does not list the sources and checksums of its PKGBUILD"
}

# The sha256 of an edge PKGBUILD pinned as sequence 0, as the input record has it.
normalized_recipe_sha256() {
  sed -E 's/^_edge_sequence=(0|[1-9][0-9]{0,8})$/_edge_sequence=0/' "$1" | sha256sum | cut -d' ' -f1
}

# DIR/INPUTS is the input record AURORA's input_digest names, of the lane the
# release belongs to, and for edge names the source, recipe and m1n1-aurora of
# the release itself.
verify_inputs() {
  local dir=$1 where=$2 channel=$3 lane=rc filename checksum
  [[ $channel == aurora ]] || lane=edge
  [[ -f $dir/INPUTS ]] || fail "$where has no INPUTS"
  [[ $(sha256_of "$dir/INPUTS") == "$d_input_digest" ]] || fail "INPUTS in $where does not match AURORA"
  [[ $(head -2 "$dir/INPUTS") == "format=1"$'\n'"lane=$lane" ]] || fail "INPUTS in $where is not an input record of the $lane lane"
  [[ $channel == aurora-edge ]] || return 0
  IFS='|' read -r _ _ _ filename checksum _ <<<"${package_record[m1n1-aurora]}"
  grep -Fxq "source=linux-aurora|https://github.com/aurora-silicon/linux/archive/$d_aurora_commit.tar.gz|$d_source_sha256" \
    "$dir/INPUTS" && grep -Fxq "carried=m1n1-aurora|$filename|$checksum" "$dir/INPUTS" &&
    grep -Fxq "file=$EDGE_RECIPE/PKGBUILD|$(normalized_recipe_sha256 "$dir/PKGBUILD")" "$dir/INPUTS" ||
    fail "INPUTS in $where does not name the source, recipe and m1n1-aurora of its release"
}

# DIR/INPUTS is the record bin/aurora-kernel-input-digest gives for this
# checkout and the pinned recipe copy at $work/recipe, with the builder,
# dependencies and m1n1-aurora the record itself names.
verify_inputs_source() {
  local dir=$1 where=$2 image carried m1n1_file m1n1_sha256
  image=$(field "$dir/INPUTS" builder_image) && carried=$(field "$dir/INPUTS" carried) ||
    fail "INPUTS in $where does not name one builder image and one carried m1n1-aurora"
  IFS='|' read -r _ m1n1_file m1n1_sha256 <<<"$carried"
  sed -n 's/^dependency=//p' "$dir/INPUTS" | tr '|' ' ' >"$work/dependencies"
  "$BASH" "$ROOT/bin/aurora-kernel-input-digest" edge "$work/inputs" --recipe "$work/recipe" \
    --aurora-commit "$d_aurora_commit" --source-sha256 "$d_source_sha256" --m1n1-file "$m1n1_file" \
    --m1n1-sha256 "$m1n1_sha256" --builder-image "$image" --dependencies "$work/dependencies" >/dev/null ||
    fail "could not rebuild the input record of $where from this checkout"
  cmp -s "$work/inputs" "$dir/INPUTS" || fail "INPUTS in $where is not this checkout's input record for its release"
}

# Every asset the workflow of CHANNEL publishes, and nothing else.
verify_complete() {
  local dir=$1 tag=$2 channel=$3 name filename signature checksum signature_checksum
  {
    for name in "${manifest[@]}"; do
      IFS='|' read -r _ _ _ filename checksum signature signature_checksum <<<"${package_record[$name]}"
      printf '%s\n%s\n' "$filename" "$signature"
    done
    printf '%s\n' "${DATABASE_ASSETS[@]}" AURORA AURORA.sig asahi-repository-signing.asc
    [[ $channel != aurora-edge ]] || printf '%s\n' PKGBUILD SRCINFO
    [[ -z $d_input_digest ]] || echo INPUTS
  } | sort >"$work/expected-assets"
  (cd "$dir" && find . -mindepth 1 -maxdepth 1 -printf '%f\n' | grep -vx SHA256SUMS | sort) >"$work/actual-assets"
  [[ -f $dir/SHA256SUMS ]] || fail "$tag has no SHA256SUMS"
  cmp -s "$work/expected-assets" "$work/actual-assets" || fail "$tag does not carry exactly the assets AURORA describes"
  awk '{ print $2 }' "$dir/SHA256SUMS" | sort | cmp -s "$work/expected-assets" - ||
    fail "SHA256SUMS in $tag does not list exactly its other assets"
  (cd "$dir" && sha256sum --check --strict --quiet SHA256SUMS >/dev/null 2>&1) || fail "SHA256SUMS in $tag does not verify"
  for name in "${manifest[@]}"; do
    IFS='|' read -r _ _ _ filename checksum signature signature_checksum <<<"${package_record[$name]}"
    [[ $(sha256_of "$dir/$filename") == "$checksum" && $(sha256_of "$dir/$signature") == "$signature_checksum" ]] ||
      fail "$filename in $tag does not match AURORA"
    verify_signed_by "$dir/$filename" "$tag"
  done
  for name in "${DATABASE_ASSETS[@]}"; do
    [[ $(sha256_of "$dir/$name") == "${asset_sha256[$name]}" ]] || fail "$name in $tag does not match AURORA"
  done
  verify_signed_by "$dir/omarchy-aurora.db" "$tag"
  verify_signed_by "$dir/omarchy-aurora.files" "$tag"
  [[ $channel != aurora-edge ]] || verify_recipe "$dir" "$tag" "$4"
  [[ -z $d_input_digest ]] || verify_inputs "$dir" "$tag" "$channel"
}

verify_edge() {
  local sequence=$1 prerelease=$2 full=$3 tag=$EDGE_TAG_PREFIX-$1 dir=$work/edge-$1
  require_release "$tag" "$prerelease"
  if ((full)); then
    download_assets "$tag" "$dir"
  else
    download_assets "$tag" "$dir" AURORA AURORA.sig
  fi
  parse_descriptor "$dir/AURORA" "$tag" aurora-edge "$tag" "$sequence"
  ((full == 0)) || verify_complete "$dir" "$tag" aurora-edge "$sequence"
}

verify_packages() {
  local commit=$1 full=$2 tag=aurora-packages-$1 dir=$work/packages-$1
  require_release "$tag" immutable
  if ((full)); then
    download_assets "$tag" "$dir"
  else
    download_assets "$tag" "$dir" AURORA AURORA.sig
  fi
  parse_descriptor "$dir/AURORA" "$tag" aurora "$tag"
  ((full == 0)) || verify_complete "$dir" "$tag" aurora
}

verify_rc() {
  local pin=$work/qualified dir=$work/rc filename signature checksum signature_checksum
  gh api -H 'Accept: application/vnd.github.raw+json' \
    "repos/$QUALIFIED_REPOSITORY/contents/$QUALIFIED_FILE?ref=main" >"$pin" 2>/dev/null ||
    fail "could not read $QUALIFIED_FILE from $QUALIFIED_REPOSITORY main"
  rc_tag=$(field "$pin" tag) && [[ $rc_tag =~ ^aurora-packages-[0-9a-f]{40}$ ]] ||
    fail "$QUALIFIED_FILE on $QUALIFIED_REPOSITORY main does not name one aurora-packages release"
  rc_digest=$(field "$pin" descriptor_sha256) && [[ $rc_digest =~ ^[0-9a-f]{64}$ ]] ||
    fail "$QUALIFIED_FILE on $QUALIFIED_REPOSITORY main does not carry one descriptor_sha256"
  download_assets "$rc_tag" "$dir" AURORA AURORA.sig
  [[ $(sha256_of "$dir/AURORA") == "$rc_digest" ]] || fail "AURORA in $rc_tag does not match the qualified digest"
  parse_descriptor "$dir/AURORA" "$rc_tag" aurora "$rc_tag"
  in_manifest m1n1-aurora || fail "the Aurora package list has no m1n1-aurora"
  rc_m1n1_record=${package_record[m1n1-aurora]}
  declare -gA rc_version=()
  for name in "${KERNEL_PACKAGES[@]}"; do
    rc_version[$name]=${package_version[$name]}
  done
  [[ -n $m1n1_dir ]] || return 0
  IFS='|' read -r _ _ _ filename checksum signature signature_checksum <<<"$rc_m1n1_record"
  download_assets "$rc_tag" "$work/rc-m1n1" "$filename" "$signature"
  [[ $(sha256_of "$work/rc-m1n1/$filename") == "$checksum" &&
    $(sha256_of "$work/rc-m1n1/$signature") == "$signature_checksum" ]] || fail "$filename in $rc_tag does not match AURORA"
  verify_signed_by "$work/rc-m1n1/$filename" "$rc_tag"
  cp -- "$work/rc-m1n1/$filename" "$work/rc-m1n1/$signature" "$m1n1_dir/"
}

newer() {
  [[ $(vercmp "$1" "$2") == 1 ]]
}

verify_next() {
  local descriptor=$1 sequence tag listing other name previous=0
  [[ -f $descriptor ]] || fail "descriptor not found: $descriptor"
  sequence=$(field "$descriptor" sequence) && [[ $sequence =~ $sequence_pattern ]] ||
    fail "${descriptor##*/} does not carry one valid sequence"
  tag=$EDGE_TAG_PREFIX-$sequence
  parse_descriptor "$descriptor" "${descriptor##*/}" aurora-edge "$tag" "$sequence"
  verify_recipe "${descriptor%/*}" "${descriptor##*/}" "$sequence"
  verify_recipe_source "${descriptor%/*}" "${descriptor##*/}" "$sequence"
  [[ -n $d_input_digest ]] || fail "${descriptor##*/} records no input digest"
  verify_inputs "${descriptor%/*}" "${descriptor##*/}" aurora-edge
  verify_inputs_source "${descriptor%/*}" "${descriptor##*/}"
  local -A new_version=()
  for name in "${KERNEL_PACKAGES[@]}"; do
    new_version[$name]=${package_version[$name]}
  done
  local new_m1n1=${package_record[m1n1-aurora]}
  local new_digest=$d_descriptor_sha256

  # The edge publisher is not idempotent: an existing tag, release or draft stops it.
  listing=$(gh api --paginate "repos/$REPOSITORY/releases?per_page=100" --jq '.[] | "\(.draft) \(.tag_name)"') ||
    fail "could not list releases on $REPOSITORY"
  ! grep -Eq "^(true|false) $tag\$" <<<"$listing" || fail "release $tag already exists; an edge sequence is published once"
  gh api "repos/$REPOSITORY/git/matching-refs/tags/$tag" --jq '.[].ref' >"$work/refs" 2>/dev/null ||
    fail "could not read the tags of $REPOSITORY"
  ! grep -Fxq "refs/tags/$tag" "$work/refs" || fail "tag $tag already exists; an edge sequence is published once"

  while IFS=' ' read -r _ other; do
    [[ $other =~ ^$EDGE_TAG_PREFIX-[1-9][0-9]*$ ]] || continue
    other=${other#"$EDGE_TAG_PREFIX"-}
    if ((${#other} > 9)) || ((other >= sequence)); then
      fail "$EDGE_TAG_PREFIX-$other is already published; edge $sequence must be above every published sequence"
    fi
    verify_edge "$other" any 0
    for name in "${KERNEL_PACKAGES[@]}"; do
      newer "${new_version[$name]}" "${package_version[$name]}" ||
        fail "$name ${new_version[$name]} is not newer than ${package_version[$name]} in $EDGE_TAG_PREFIX-$other"
    done
    ((other < previous)) || previous=$other
  done < <(grep '^false ' <<<"$listing" || true)

  verify_rc
  for name in "${KERNEL_PACKAGES[@]}"; do
    newer "${new_version[$name]}" "${rc_version[$name]}" ||
      fail "$name ${new_version[$name]} is not newer than ${rc_version[$name]} in the rc pin $rc_tag"
  done
  [[ $new_m1n1 == "$rc_m1n1_record" ]] ||
    fail "m1n1-aurora in ${descriptor##*/} is not the exact package of the rc pin $rc_tag"

  printf 'sequence=%s\nrelease_tag=%s\ndescriptor_sha256=%s\nlinux_aurora_version=%s\nprevious_sequence=%s\nrc_tag=%s\n' \
    "$sequence" "$tag" "$new_digest" "${new_version[linux-aurora]}" "$previous" "$rc_tag"
}

gate_result() {
  printf 'build=%s\nreason=%s\n' "$1" "$2"
}

# The input digest a release records, or a failure when it does not verify.
recorded_digest() {
  (
    "$@"
    printf '%s\n' "$d_input_digest"
  ) 2>"$work/gate-error" || { sed 's/^aurora-verify-edge-release: //' "$work/gate-error" | tail -1 >&2; return 1; }
}

gate_edge() {
  local digest=$1 listing other latest=0 previous
  if ((force)); then
    gate_result true "forced: builds a new edge sequence whatever the latest edge release was built from"
    return 0
  fi
  listing=$(gh api --paginate "repos/$REPOSITORY/releases?per_page=100" --jq '.[] | "\(.draft) \(.tag_name)"' 2>/dev/null) ||
    { gate_result true "the releases on $REPOSITORY could not be listed"; return 0; }
  while IFS=' ' read -r _ other; do
    [[ $other =~ ^$EDGE_TAG_PREFIX-([1-9][0-9]{0,8})$ ]] || continue
    ((BASH_REMATCH[1] <= latest)) || latest=${BASH_REMATCH[1]}
  done < <(grep '^false ' <<<"$listing" || true)
  ((latest)) || { gate_result true "no edge release is published yet"; return 0; }
  printf 'previous_release=%s-%s\n' "$EDGE_TAG_PREFIX" "$latest"
  previous=$(recorded_digest verify_edge "$latest" false 0 2>"$work/gate-reason") ||
    { gate_result true "$EDGE_TAG_PREFIX-$latest does not verify ($(cat "$work/gate-reason"))"; return 0; }
  printf 'previous_input_digest=%s\n' "$previous"
  if [[ -z $previous ]]; then
    gate_result true "$EDGE_TAG_PREFIX-$latest records no input digest"
  elif [[ $previous != "$digest" ]]; then
    gate_result true "the inputs changed since $EDGE_TAG_PREFIX-$latest"
  else
    gate_result false "nothing new: $EDGE_TAG_PREFIX-$latest was built from the same inputs"
  fi
}

gate_rc() {
  local commit=$1 digest=${2:-} tag=aurora-packages-$1 listing other recorded
  # Only a complete listing and tag lookup that both lack the tag prove it
  # does not exist; any error stops the gate rather than risk a rebuild.
  listing=$(gh api --paginate "repos/$REPOSITORY/releases?per_page=100" --jq '.[] | "\(.draft) \(.tag_name)"' 2>/dev/null) ||
    fail "could not list the releases on $REPOSITORY, so whether $tag exists is unknown"
  gh api "repos/$REPOSITORY/git/matching-refs/tags/$tag" --jq '.[].ref' >"$work/refs" 2>/dev/null ||
    fail "could not look up tag $tag on $REPOSITORY"
  # An immutable release is never rebuilt, forced or not; it can only be verified.
  if grep -Eq "^(true|false) $tag\$" <<<"$listing" || grep -Fxq "refs/tags/$tag" "$work/refs"; then
    verify_packages "$commit" 1
    printf 'published=true\nrelease_tag=%s\npublished_input_digest=%s\n' "$tag" "$d_input_digest"
    gate_result false "$tag is already published and verifies; it is never rebuilt, and a rebuild needs a new commit"
    return 0
  fi
  printf 'published=false\n'
  if [[ -z $digest ]]; then
    gate_result true "$tag is not published yet"
    return 0
  fi
  if ((force)); then
    gate_result true "forced: builds $tag whatever earlier releases were built from"
    return 0
  fi
  while IFS=' ' read -r _ other; do
    [[ $other =~ ^aurora-packages-([0-9a-f]{40})$ ]] || continue
    recorded=$(recorded_digest verify_packages "${BASH_REMATCH[1]}" 0 2>/dev/null) || continue
    if [[ $recorded == "$digest" ]]; then
      printf 'release_tag=%s\n' "$other"
      gate_result false "nothing new: $other was built from the same inputs; qualify it, or force a build of $tag"
      return 0
    fi
  done < <(grep '^false ' <<<"$listing" || true)
  gate_result true "no published aurora-packages release was built from these inputs"
}

case $mode in
  edge)
    verify_edge "${positionals[0]}" false "$complete"
    printf 'sequence=%s\nrelease_tag=%s\ndescriptor_sha256=%s\naurora_commit=%s\nsource_sha256=%s\nlinux_aurora_version=%s\n' \
      "${positionals[0]}" "$EDGE_TAG_PREFIX-${positionals[0]}" "$d_descriptor_sha256" "$d_aurora_commit" \
      "$d_source_sha256" "${package_version[linux-aurora]}"
    ;;
  rc)
    verify_rc
    IFS='|' read -r _ _ _ m1n1_file m1n1_sha256 _ <<<"$rc_m1n1_record"
    printf 'release_tag=%s\ndescriptor_sha256=%s\nlinux_aurora_version=%s\nm1n1_aurora_file=%s\nm1n1_aurora_sha256=%s\n' \
      "$rc_tag" "$rc_digest" "${rc_version[linux-aurora]}" "$m1n1_file" "$m1n1_sha256"
    ;;
  packages)
    verify_packages "${positionals[0]}" "$complete"
    printf 'release_tag=aurora-packages-%s\ndescriptor_sha256=%s\ninput_digest=%s\nlinux_aurora_version=%s\n' \
      "${positionals[0]}" "$d_descriptor_sha256" "$d_input_digest" "${package_version[linux-aurora]}"
    ;;
  gate)
    if [[ ${positionals[0]} == edge ]]; then
      gate_edge "${positionals[1]}"
    else
      gate_rc "${positionals[1]}" "${positionals[2]:-}"
    fi
    ;;
  next)
    verify_next "$(absolute_path "${positionals[0]}")"
    ;;
esac
