#!/bin/bash

set -euo pipefail

REPOSITORY=maralcbr/omarchy-pkgs
CHANNEL_TAG_PREFIX=asahi-quattro-channel
RELEASE_KEY_FINGERPRINT=5983B1CA32CB778F4D74D24ECFF35022CA5B5959
PACKAGE_KEY_FINGERPRINT=C81AC3E2A99556F9B21D5FEA3DD49BC9F8360BDC
DOWNLOAD_BASE_URL="${ASAHI_QUATTRO_DOWNLOAD_BASE_URL:-https://github.com/$REPOSITORY/releases/download}"
KEY_URL="${ASAHI_QUATTRO_KEY_URL:-https://raw.githubusercontent.com/maralcbr/omarchy-mx-mac/main/default/omarchy-release.gpg}"

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: install-asahi-quattro [--fresh] [--user USER | --deferred-user] [--yes] [--reboot] [--verify-only] [--release-tag TAG]

Install or update final Omarchy Quattro on Apple Silicon. Use --fresh as root
on a prepared Asahi Arch Minimal system, or run normally as an Omarchy user.

Options:
  --fresh           Install directly onto a fresh Asahi Arch Minimal system
  --user USER       Username to create during a fresh installation
  --deferred-user   Install without an account; first-boot owner setup creates it
  --yes             Do not prompt before upgrading
  --reboot          Reboot automatically after a successful upgrade
  --verify-only     Download and verify the release without changing the system
  --release-tag TAG Use a specific signed immutable release instead of latest
  -h, --help        Show this help
USAGE
}

verify_only=0
yes=0
auto_reboot=0
release_tag="${ASAHI_QUATTRO_RELEASE_TAG:-}"
fresh=0
deferred_user=0
target_user=""
upgrade_args=()
while (($#)); do
  case "$1" in
    --fresh)
      fresh=1
      ;;
    --user)
      (($# > 1)) || fail "--user requires a username."
      target_user="$2"
      shift
      ;;
    --deferred-user)
      deferred_user=1
      ;;
    --yes)
      yes=1
      upgrade_args+=("$1")
      ;;
    --reboot)
      auto_reboot=1
      upgrade_args+=("$1")
      ;;
    --verify-only)
      verify_only=1
      ;;
    --release-tag)
      (($# > 1)) || fail "--release-tag requires a tag."
      release_tag="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option '$1'."
      ;;
  esac
  shift
done

[[ -z $release_tag || $release_tag =~ ^asahi-quattro-[0-9a-f]{8}$ ]] || fail "Invalid release tag."
if (( deferred_user )); then
  (( fresh )) || fail "--deferred-user is only for a fresh installation."
  [[ -z $target_user ]] || fail "--deferred-user and --user cannot be combined."
fi

# The bootstrap that verified this installer hands over the selection it made
# and the release its verification run accepted, so the installation run cannot
# drift onto a release nothing verified. The file is data, never authority: the
# signature, sequence and descriptor checks below all still run.
identity_file="${ASAHI_QUATTRO_IDENTITY_FILE:-}"
identity_format=""
identity_release_tag=""
if [[ -n $identity_file ]]; then
  identity_selector=""
  identity_value=""
  if [[ -e $identity_file ]]; then
    [[ -f $identity_file ]] || fail "The release identity file is not a regular file."
    while IFS= read -r line || [[ -n $line ]]; do
      case "$line" in
        format=*) [[ -z $identity_format ]] || fail "The release identity file is malformed."; identity_format=${line#format=} ;;
        selector=*) [[ -z $identity_selector ]] || fail "The release identity file is malformed."; identity_selector=${line#selector=} ;;
        value=*) [[ -z $identity_value ]] || fail "The release identity file is malformed."; identity_value=${line#value=} ;;
        release_tag=*) [[ -z $identity_release_tag ]] || fail "The release identity file is malformed."; identity_release_tag=${line#release_tag=} ;;
        "") ;;
        *) fail "The release identity file is malformed." ;;
      esac
    done <"$identity_file"
  fi
  if [[ -s $identity_file ]]; then
    [[ $identity_format == "1" ]] || fail "Unsupported release identity file format."
  fi
  if [[ -n $identity_selector || -n $identity_value ]]; then
    case "$identity_selector" in
      release) [[ $identity_value =~ ^asahi-quattro-[0-9a-f]{8}$ ]] ;;
      channel) [[ $identity_value =~ ^asahi-quattro-channel-[1-9][0-9]*$ ]] ;;
      base-url) [[ $identity_value =~ ^https://[^[:space:]]+$ ]] ;;
      *) false ;;
    esac || fail "The release identity file has an invalid selection."
  fi
  if [[ -n $identity_release_tag ]]; then
    [[ $identity_release_tag =~ ^asahi-quattro-[0-9a-f]{8}$ ]] || fail "The release identity file names an invalid release."
    [[ $identity_selector != "release" || $identity_value == "$identity_release_tag" ]] || \
      fail "The release identity file names two different releases."
    # A recorded release is exactly the --release-tag path: no channel lookup.
    [[ -n $release_tag ]] || release_tag=$identity_release_tag
  fi
fi

if (( fresh )); then
  (( EUID == 0 )) || fail "Run a fresh installation as root."
else
  (( EUID != 0 )) || fail "Run an update as your regular Omarchy user, not root. For a new installation, pass --fresh."
fi
[[ $(uname -m) == "aarch64" ]] || fail "This release requires aarch64 Apple Silicon."
# The bundle updater reads the same file through the same prefix, which only
# relocates the read. An image build runs in a chroot with no device tree; the
# fresh installer carries the generic target identity for it instead.
if [[ ${OMARCHY_MAC_IMAGE_BUILD:-} != 1 ]]; then
  device_tree_compatible="${OMARCHY_ASAHI_ROOT:-}/proc/device-tree/compatible"
  [[ -r $device_tree_compatible ]] || fail "Apple device-tree information is unavailable."
  grep -aq 'apple,' "$device_tree_compatible" || fail "Apple Silicon device tree not found."
fi

for command_name in bsdtar curl gpg pacman pacman-conf sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 || fail "Required command '$command_name' is unavailable."
done
(( fresh )) || command -v omarchy >/dev/null 2>&1 || fail "An existing working Omarchy installation is required."

# The kernel the image's marker names, as the fresh installer reads it, else the
# one installed. linux-aurora provides linux-asahi, so only exact names count.
installed_packages=$(pacman -Qq 2>/dev/null) || fail "Could not list the installed packages."
kernel_marker="${OMARCHY_ASAHI_ROOT:-}/usr/share/omarchy/apple-silicon-kernel"
kernel_package=linux-asahi
if [[ -e $kernel_marker || -L $kernel_marker ]]; then
  [[ -f $kernel_marker && ! -L $kernel_marker ]] || fail "The kernel marker is not a regular file."
  read -r kernel_package <"$kernel_marker" || true
  [[ $kernel_package == linux-asahi || $kernel_package == linux-aurora ]] ||
    fail "The kernel marker names neither linux-asahi nor linux-aurora."
elif grep -Fxq linux-aurora <<<"$installed_packages" && ! grep -Fxq linux-asahi <<<"$installed_packages"; then
  kernel_package=linux-aurora
fi
grep -Fxq "$kernel_package" <<<"$installed_packages" || fail "Required Asahi package '$kernel_package' is not installed."
required_packages=(networkmanager iwd)
(( fresh == 0 )) || required_packages+=(grub)
for package_name in "${required_packages[@]}"; do
  pacman -Q "$package_name" >/dev/null 2>&1 || fail "Required Asahi package '$package_name' is not installed."
done
# One listing, read once: `pacman-conf --repo-list | grep -q` leaves the
# writer with a broken pipe when grep exits at the match, which under
# pipefail fails the check for a repository that is configured.
configured_repositories=$(pacman-conf --repo-list)
for repository in asahi-alarm core extra alarm aur; do
  grep -Fxq "$repository" <<<"$configured_repositories" || fail "Required repository '$repository' is not configured."
done
if (( fresh == 0 )); then
  NetworkManager --print-config 2>/dev/null | grep -Fxq 'wifi.backend=iwd' || \
    fail "NetworkManager must use the iwd Wi-Fi backend before upgrading."
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/asahi-quattro.XXXXXXXX")
trap 'rm -rf "$work_dir"' EXIT
bundle_dir="$work_dir/bundle"
release_gnupg_dir="$work_dir/release-gnupg"
package_gnupg_dir="$work_dir/package-gnupg"
mkdir -m 0700 "$release_gnupg_dir" "$package_gnupg_dir"
mkdir -p "$bundle_dir"

download_url() {
  local url="$1"
  local destination="$2"
  printf 'Downloading %s\n' "${url##*/}"
  curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --output "$destination" "$url"
}

download_release_asset() {
  download_url "$DOWNLOAD_BASE_URL/$1/$2" "$3"
}

key_file="$work_dir/omarchy-release.gpg"
download_url "$KEY_URL" "$key_file"
actual_fingerprint=$(gpg --batch --show-keys --with-colons "$key_file" | sed -n 's/^fpr:::::::::\([^:]*\):$/\1/p' | head -1)
[[ $actual_fingerprint == "$RELEASE_KEY_FINGERPRINT" ]] || fail "Omarchy release signing key fingerprint verification failed."
gpg --batch --homedir "$release_gnupg_dir" --import "$key_file" >/dev/null 2>&1 || fail "Could not import the Omarchy release signing key."

verify_release_signature() {
  # The isolated keyring contains only the public key whose primary fingerprint
  # was pinned above; signatures may be made by its signing subkey.
  gpg --batch --homedir "$release_gnupg_dir" --verify "$2" "$1" >/dev/null 2>&1 || \
    fail "Release signature verification failed for '${1##*/}'."
}

verify_package_signature() {
  gpg --batch --homedir "$package_gnupg_dir" --verify "$2" "$1" >/dev/null 2>&1 || \
    fail "Package signature verification failed for '${1##*/}'."
}

# Compare raw bytes with the canonical body so newline stripping cannot hide
# trailing junk, CRs or NULs. The pointer is unsigned and only picks which
# signed channel to fetch; every check below still applies to what it names.
read_pointer_tag() {
  local file="$1" body="" size sequence canonical
  local pattern=$'^format=1\nsequence=([1-9][0-9]{0,8})\n'
  [[ -f $file ]] && size=$(wc -c <"$file") || return 1
  (( size <= 256 )) || return 1
  IFS= read -r -d '' body <"$file" || true
  [[ $body =~ $pattern ]] || return 1
  sequence=${BASH_REMATCH[1]}
  printf -v canonical 'format=1\nsequence=%s\ntag=%s-%s\n' "$sequence" "$CHANNEL_TAG_PREFIX" "$sequence"
  [[ $body == "$canonical" ]] && (( size == ${#canonical} )) || return 1
  printf '%s-%s\n' "$CHANNEL_TAG_PREFIX" "$sequence"
}

if [[ -z $release_tag ]]; then
  channel_tag="${ASAHI_QUATTRO_CHANNEL_TAG:-}"
  if [[ -n $channel_tag ]]; then
    # A locator only, handed over by the bootstrap that verified this installer:
    # the signed channel it names still decides which release is installed.
    [[ $channel_tag =~ ^asahi-quattro-channel-[1-9][0-9]*$ ]] || fail "Invalid release channel tag."
  else
    pointer_url="${OMARCHY_ASAHI_CHANNEL_POINTER_URL:-https://downloads.aicodelabs.com.au/pointers/asahi-quattro-channel}"
    pointer="$work_dir/asahi-quattro-channel-pointer"
    pointer_status=0
    echo "Reading the release channel pointer"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --max-time 20 --max-filesize 256 \
      --output "$pointer" "$pointer_url" || pointer_status=$?
    if (( pointer_status == 0 )); then
      channel_tag=$(read_pointer_tag "$pointer") || channel_tag=""
    fi
  fi
  if [[ -z $channel_tag ]]; then
    echo "The release channel pointer is unavailable or malformed; using the GitHub release listing." >&2
    releases_api_url="${ASAHI_QUATTRO_RELEASES_API_URL:-https://api.github.com/repos/$REPOSITORY/releases?per_page=100}"
    releases="$work_dir/releases.json"
    download_url "$releases_api_url" "$releases" || fail "Could not discover the signed Apple Silicon release channel."
    # Asahi Arch Minimal ships without jq, so the newest numbered channel is
    # selected with grep and sort. Drafts are invisible to unauthenticated API
    # calls and channel releases are never published as prereleases; the signed
    # channel pointer downloaded below is verified before it is trusted.
    channel_tag=$(grep -oE '"tag_name": *"asahi-quattro-channel-[1-9][0-9]*"' "$releases" |
      grep -oE 'asahi-quattro-channel-[0-9]+' | sort -u -t- -k4,4n | tail -1) || channel_tag=""
    [[ $channel_tag =~ ^asahi-quattro-channel-[1-9][0-9]*$ ]] || fail "Could not discover the signed Apple Silicon release channel."
  fi
  channel="$work_dir/asahi-quattro-channel"
  download_release_asset "$channel_tag" asahi-quattro-channel "$channel"
  download_release_asset "$channel_tag" asahi-quattro-channel.sig "$channel.sig"
  verify_release_signature "$channel" "$channel.sig"
  grep -Fxq 'format=1' "$channel" || fail "Unsupported channel pointer format."
  grep -Fxq 'channel=asahi-quattro' "$channel" || fail "Invalid channel pointer."
  channel_sequence=$(sed -n 's/^sequence=//p' "$channel")
  release_tag=$(sed -n 's/^release_tag=//p' "$channel")
  expected_release_sha256=$(sed -n 's/^release_sha256=//p' "$channel")
  [[ $release_tag =~ ^asahi-quattro-[0-9a-f]{8}$ ]] || fail "The channel contains an invalid release tag."
  [[ $channel_sequence =~ ^[1-9][0-9]*$ ]] || fail "The channel contains an invalid release sequence."
  [[ $expected_release_sha256 =~ ^[0-9a-f]{64}$ ]] || fail "The channel contains an invalid release checksum."
  # Whatever named the tag, the signed channel inside it must be the one that
  # tag promises, so a stale or swapped asset cannot install an older release.
  [[ $channel_sequence == "${channel_tag#"$CHANNEL_TAG_PREFIX"-}" ]] || \
    fail "The signed channel in '$channel_tag' carries sequence $channel_sequence."
fi

release="$work_dir/asahi-quattro-release"
download_release_asset "$release_tag" asahi-quattro-release "$release"
download_release_asset "$release_tag" asahi-quattro-release.sig "$release.sig"
if [[ -n ${expected_release_sha256:-} ]]; then
  printf '%s  %s\n' "$expected_release_sha256" "$release" | sha256sum --check --status - || \
    fail "Release descriptor checksum verification failed."
fi
verify_release_signature "$release" "$release.sig"
grep -Fxq 'format=1' "$release" || fail "Unsupported release descriptor format."
grep -Fxq 'bundle=asahi-quattro' "$release" || fail "Invalid release descriptor."
release_sequence=$(sed -n 's/^sequence=//p' "$release")
[[ $release_sequence =~ ^[1-9][0-9]*$ ]] || fail "Invalid release sequence."
[[ -z ${channel_sequence:-} || $release_sequence == "$channel_sequence" ]] || fail "Release sequence does not match the signed channel."
grep -Fxq "release_tag=$release_tag" "$release" || fail "Release descriptor tag mismatch."
source_commit=$(sed -n 's/^source_commit=//p' "$release")
package_source_commit=$(sed -n 's/^package_source_commit=//p' "$release")
manifest_sha256=$(sed -n 's/^manifest_sha256=//p' "$release")
upgrader_sha256=$(sed -n 's/^upgrader_sha256=//p' "$release")
bundle_updater_sha256=$(sed -n 's/^bundle_updater_sha256=//p' "$release")
fresh_installer_sha256=$(sed -n 's/^fresh_installer_sha256=//p' "$release")
[[ $source_commit =~ ^[0-9a-f]{40}$ && $release_tag == "asahi-quattro-${source_commit:0:8}" ]] || fail "Invalid release bundle identity."
[[ $package_source_commit =~ ^[0-9a-f]{40}$ ]] || fail "This release has no verified package source."
[[ $manifest_sha256 =~ ^[0-9a-f]{64}$ && $upgrader_sha256 =~ ^[0-9a-f]{64}$ && $bundle_updater_sha256 =~ ^[0-9a-f]{64}$ ]] || fail "Invalid release asset checksums."
if (( fresh )); then
  [[ $fresh_installer_sha256 =~ ^[0-9a-f]{64}$ ]] || fail "This release does not support fresh installation."
elif [[ -n $fresh_installer_sha256 && ! $fresh_installer_sha256 =~ ^[0-9a-f]{64}$ ]]; then
  fail "Invalid fresh installer checksum."
fi

if [[ -n $identity_file ]]; then
  if [[ -n $identity_release_tag ]]; then
    [[ $release_tag == "$identity_release_tag" ]] || \
      fail "This run resolved a different release than the verification run; rerun."
  else
    # Recorded once the signed channel and the release descriptor have verified,
    # so the installation run installs exactly what was verified here.
    {
      [[ $identity_format == "1" ]] || printf 'format=1\n'
      printf 'release_tag=%s\n' "$release_tag"
    } >>"$identity_file" || fail "Could not record the verified release."
  fi
fi

package_key_file="$work_dir/asahi-repository-signing.asc"
package_key_url="${ASAHI_QUATTRO_PACKAGE_KEY_URL:-https://raw.githubusercontent.com/$REPOSITORY/$package_source_commit/keys/asahi-repository-signing.asc}"
download_url "$package_key_url" "$package_key_file"
actual_fingerprint=$(gpg --batch --show-keys --with-colons "$package_key_file" | sed -n 's/^fpr:::::::::\([^:]*\):$/\1/p' | head -1)
[[ $actual_fingerprint == "$PACKAGE_KEY_FINGERPRINT" ]] || fail "Omarchy package signing key fingerprint verification failed."
gpg --batch --homedir "$package_gnupg_dir" --import "$package_key_file" >/dev/null 2>&1 || fail "Could not import the Omarchy package signing key."

manifest="$bundle_dir/asahi-quattro-bundle.manifest"
download_release_asset "$release_tag" asahi-quattro-bundle.manifest "$manifest"
download_release_asset "$release_tag" asahi-quattro-bundle.manifest.sig "$manifest.sig"
printf '%s  %s\n' "$manifest_sha256" "$manifest" | sha256sum --check --status - || fail "Release manifest checksum verification failed."
verify_package_signature "$manifest" "$manifest.sig"
grep -Fxq 'format=2' "$manifest" || fail "Unsupported bundle manifest format."
grep -Fxq 'bundle=asahi-quattro' "$manifest" || fail "Invalid bundle manifest."
grep -Fxq "source_commit=$source_commit" "$manifest" || fail "Bundle source identity mismatch."
grep -Fxq 'package_count=6' "$manifest" || fail "The release does not contain the complete six-package bundle."

expected_packages=(omarchy-keyring omarchy-settings-dev omarchy-dev omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic)
expected_arches=(any aarch64 aarch64 any aarch64 any)
package_count=0
archives=()
while IFS='|' read -r prefix package_name package_version package_arch package_file checksum extra; do
  [[ $prefix == package=* ]] || continue
  sequence=${prefix#package=}
  (( package_count < ${#expected_packages[@]} )) || fail "The manifest contains too many packages."
  [[ $sequence == "$((package_count + 1))" && $package_name == "${expected_packages[$package_count]}" ]] || fail "The manifest package sequence is invalid."
  [[ -n $package_version && $package_version != *'|'* ]] || fail "The manifest contains an invalid package version."
  [[ $package_arch == "${expected_arches[$package_count]}" ]] || fail "The manifest contains an invalid package architecture."
  [[ $package_file == "$(basename "$package_file")" && $package_file == "$package_name"-*.pkg.tar.* ]] || fail "The manifest contains an invalid package filename."
  [[ $checksum =~ ^[0-9a-f]{64}$ && -z $extra ]] || fail "The manifest contains an invalid package checksum."
  download_release_asset "$release_tag" "$package_file" "$bundle_dir/$package_file"
  download_release_asset "$release_tag" "$package_file.sig" "$bundle_dir/$package_file.sig"
  printf '%s  %s\n' "$checksum" "$bundle_dir/$package_file" | sha256sum --check --status - || fail "Checksum verification failed for '$package_file'."
  verify_package_signature "$bundle_dir/$package_file" "$bundle_dir/$package_file.sig"
  rm -f "$bundle_dir/$package_file.sig"
  metadata=$(bsdtar -xOf "$bundle_dir/$package_file" .PKGINFO 2>/dev/null) || fail "'$package_file' is not a package archive."
  grep -Fxq "pkgname = $package_name" <<<"$metadata" || fail "'$package_file' has the wrong package name."
  grep -Fxq "pkgver = $package_version" <<<"$metadata" || fail "'$package_file' has the wrong package version."
  grep -Fxq "arch = $package_arch" <<<"$metadata" || fail "'$package_file' has the wrong package architecture."
  archives+=("$bundle_dir/$package_file")
  ((package_count += 1))
done <"$manifest"
(( package_count == ${#expected_packages[@]} )) || fail "The release does not contain the complete six-package bundle."
settings_source=$(bsdtar -xOf "${archives[1]}" .PKGINFO | sed -n 's/^provides = omarchy-quattro-bundle=//p')
runtime_source=$(bsdtar -xOf "${archives[2]}" .PKGINFO | sed -n 's/^provides = omarchy-quattro-bundle=//p')
[[ $settings_source == "$source_commit" && $runtime_source == "$source_commit" ]] || fail "Paired packages do not match the source commit."

upgrader="$work_dir/omarchy-upgrade-to-quattro"
download_release_asset "$release_tag" omarchy-upgrade-to-quattro "$upgrader"
printf '%s  %s\n' "$upgrader_sha256" "$upgrader" | sha256sum --check --status - || fail "Upgrade script checksum verification failed."

bundle_updater="$work_dir/omarchy-update-asahi-bundle"
download_release_asset "$release_tag" omarchy-update-asahi-bundle "$bundle_updater"
download_release_asset "$release_tag" omarchy-update-asahi-bundle.sig "$bundle_updater.sig"
printf '%s  %s\n' "$bundle_updater_sha256" "$bundle_updater" | sha256sum --check --status - || fail "Bundle updater checksum verification failed."
verify_release_signature "$bundle_updater" "$bundle_updater.sig"

fresh_installer=""
if [[ -n $fresh_installer_sha256 ]]; then
  fresh_installer="$work_dir/omarchy-install-asahi-fresh"
  download_release_asset "$release_tag" omarchy-install-asahi-fresh "$fresh_installer"
  download_release_asset "$release_tag" omarchy-install-asahi-fresh.sig "$fresh_installer.sig"
  printf '%s  %s\n' "$fresh_installer_sha256" "$fresh_installer" | sha256sum --check --status - || fail "Fresh installer checksum verification failed."
  verify_release_signature "$fresh_installer" "$fresh_installer.sig"
fi

if (( verify_only )); then
  echo "Verified $release_tag ($source_commit) for Apple Silicon."
  exit 0
fi

if (( fresh )); then
  fresh_args=(--asahi-packages "$bundle_dir")
  [[ -z $target_user ]] || fresh_args+=(--user "$target_user")
  (( ! deferred_user )) || fresh_args+=(--deferred-user)
  exec env \
    OMARCHY_ASAHI_RELEASE_SEQUENCE="$release_sequence" \
    OMARCHY_ASAHI_RELEASE_TAG="$release_tag" \
    OMARCHY_ASAHI_RELEASE_SOURCE="$source_commit" \
    OMARCHY_ASAHI_PACKAGE_SOURCE="$package_source_commit" \
    bash "$fresh_installer" "${fresh_args[@]}"
fi

channel_tag=${channel_tag:-"$CHANNEL_TAG_PREFIX-$release_sequence"}
if pacman -Q omarchy-dev omarchy-settings-dev >/dev/null 2>&1 && [[ $(readlink -f ~/.local/share/omarchy) == "/usr/share/omarchy" ]]; then
  bundle_args=()
  (( yes )) && bundle_args+=(--yes)
  env \
    OMARCHY_ASAHI_KEY_FILE="$key_file" \
    OMARCHY_ASAHI_PACKAGE_KEY_FILE="$package_key_file" \
    OMARCHY_ASAHI_CHANNEL_URL="$DOWNLOAD_BASE_URL/$channel_tag/asahi-quattro-channel" \
    OMARCHY_ASAHI_CHANNEL_SIGNATURE_URL="$DOWNLOAD_BASE_URL/$channel_tag/asahi-quattro-channel.sig" \
    OMARCHY_ASAHI_RELEASE_BASE_URL="$DOWNLOAD_BASE_URL/$release_tag" \
    bash "$bundle_updater" "${bundle_args[@]}"
  omarchy-migrate
  omarchy-hook post-update
  sudo mv /var/lib/omarchy/asahi-quattro-release.pending /var/lib/omarchy/asahi-quattro-release
  if (( auto_reboot )); then
    sudo systemctl reboot
  fi
  exit 0
fi

exec env \
  OMARCHY_ASAHI_RELEASE_SEQUENCE="$release_sequence" \
  OMARCHY_ASAHI_RELEASE_TAG="$release_tag" \
  OMARCHY_ASAHI_RELEASE_SOURCE="$source_commit" \
  bash "$upgrader" --asahi-packages "$bundle_dir" "${upgrade_args[@]}"
