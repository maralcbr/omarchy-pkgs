#!/bin/bash

set -euo pipefail

RELEASE_TAG=asahi-quattro-bf71823f
RELEASE_BASE_URL="https://github.com/maralcbr/omarchy-pkgs/releases/download/$RELEASE_TAG"
MANIFEST_SHA256=334a9e472ecc32b84ea5c9a785d10ad4f745f51dc2fac94b50269a0fe82541a3
UPGRADER_SHA256=76547b6e511d007ab65cc64ea868f9b75d8cc7deccc0541a6d1726383383f776

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: install-asahi-quattro [--yes] [--reboot] [--verify-only]

Upgrade an existing Omarchy installation on the tested 14-inch 2021
MacBook Pro with M1 Pro (apple,j314s). Fresh installs and other Apple
Silicon models are not supported by this preview.

Options:
  --yes          Do not prompt before upgrading
  --reboot       Reboot automatically after a successful upgrade
  --verify-only  Download and verify the release without changing the system
  -h, --help     Show this help
USAGE
}

verify_only=0
upgrade_args=()
while (($#)); do
  case "$1" in
    --yes|--reboot)
      upgrade_args+=("$1")
      ;;
    --verify-only)
      verify_only=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option '$1'."
      ;;
  esac
  shift
done

(( EUID != 0 )) || fail "Run this command as your regular Omarchy user, not root."
[[ $(uname -m) == "aarch64" ]] || fail "This release requires aarch64 Apple Silicon."
[[ -r /proc/device-tree/compatible ]] || fail "Apple device-tree information is unavailable."
tr '\0' '\n' </proc/device-tree/compatible | grep -Fxq 'apple,j314s' || \
  fail "This preview is limited to the tested apple,j314s MacBook Pro."

for command_name in curl pacman pacman-conf sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 || fail "Required command '$command_name' is unavailable."
done
command -v omarchy >/dev/null 2>&1 || fail "An existing working Omarchy installation is required."

for package_name in linux-asahi networkmanager iwd; do
  pacman -Q "$package_name" >/dev/null 2>&1 || fail "Required Asahi package '$package_name' is not installed."
done
for repository in asahi-alarm core extra alarm aur; do
  pacman-conf --repo-list | grep -Fxq "$repository" || fail "Required repository '$repository' is not configured."
done
NetworkManager --print-config 2>/dev/null | grep -Fxq 'wifi.backend=iwd' || \
  fail "NetworkManager must use the iwd Wi-Fi backend before upgrading."

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/asahi-quattro.XXXXXXXX")
trap 'rm -rf "$work_dir"' EXIT
bundle_dir="$work_dir/bundle"
mkdir -p "$bundle_dir"

download() {
  local asset="$1"
  local destination="$2"
  printf 'Downloading %s\n' "$asset"
  curl --proto '=https' --tlsv1.2 --fail --location --retry 3 \
    --output "$destination" "$RELEASE_BASE_URL/$asset"
}

manifest="$bundle_dir/asahi-quattro-bundle.manifest"
download asahi-quattro-bundle.manifest "$manifest"
printf '%s  %s\n' "$MANIFEST_SHA256" "$manifest" | sha256sum --check --status - || \
  fail "Release manifest checksum verification failed."

expected_packages=(
  omarchy-keyring
  omarchy-settings-dev
  omarchy-dev
  omarchy-nvim
  quickshell-git
  ttf-jetbrains-mono-nerd-basic
)
declare -A downloaded_packages=()
package_count=0

while IFS= read -r manifest_line; do
  [[ $manifest_line == sha256=* ]] || continue
  checksum_entry=${manifest_line#sha256=}
  checksum=${checksum_entry%%  *}
  package_file=${checksum_entry#*  }
  [[ $checksum =~ ^[0-9a-f]{64}$ ]] || fail "The release manifest contains an invalid checksum."
  [[ $package_file == "$(basename "$package_file")" && $package_file == *.pkg.tar.* ]] || \
    fail "The release manifest contains an invalid package filename."

  matched_package=""
  for package_name in "${expected_packages[@]}"; do
    if [[ $package_file == "$package_name"-*.pkg.tar.* ]]; then
      matched_package="$package_name"
      break
    fi
  done
  [[ -n $matched_package ]] || fail "Unexpected package '$package_file' in the release manifest."
  [[ -z ${downloaded_packages[$matched_package]:-} ]] || fail "Duplicate package '$matched_package' in the release manifest."

  download "$package_file" "$bundle_dir/$package_file"
  printf '%s  %s\n' "$checksum" "$bundle_dir/$package_file" | sha256sum --check --status - || \
    fail "Checksum verification failed for '$package_file'."
  downloaded_packages[$matched_package]=1
  ((package_count += 1))
done <"$manifest"

(( package_count == ${#expected_packages[@]} )) || fail "The release does not contain the complete six-package bundle."
for package_name in "${expected_packages[@]}"; do
  [[ ${downloaded_packages[$package_name]:-} == "1" ]] || fail "The release is missing '$package_name'."
done

upgrader="$work_dir/omarchy-upgrade-to-quattro"
download omarchy-upgrade-to-quattro "$upgrader"
printf '%s  %s\n' "$UPGRADER_SHA256" "$upgrader" | sha256sum --check --status - || \
  fail "Upgrade script checksum verification failed."

if (( verify_only )); then
  echo "Verified $RELEASE_TAG for the tested apple,j314s MacBook Pro."
  exit 0
fi

exec bash "$upgrader" --asahi-packages "$bundle_dir" "${upgrade_args[@]}"
