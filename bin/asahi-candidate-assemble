#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: asahi-candidate-assemble PLAN PREDECESSOR REBUILT_REPOSITORY REBUILT_RUNTIME OUTPUT" >&2
  exit 64
}

(( $# == 5 )) || usage
plan=$1
predecessor=$(realpath "$2")
rebuilt_repository=$(realpath "$3")
rebuilt_runtime=$(realpath "$4")
output=$5
[[ -s $plan && -d $predecessor && -d $rebuilt_repository && -d $rebuilt_runtime ]] || usage
[[ ! -e $output ]] || { echo "Refusing to assemble into existing output: $output" >&2; exit 1; }
mkdir -p "$output"
tmp=$(mktemp -d "${output%/*}/.assemble.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# Reading a package name means decompressing .PKGINFO, so each directory is
# indexed once and every later lookup is a hash hit. Scanning per package
# instead cost one decompression per package per archive, which on a 58-package
# candidate of multi-megabyte archives took half an hour.
declare -A package_archive=()
declare -A directory_indexed=()

read_package_name() {
  # .PKGINFO is the first member of a package archive, so --fast-read stops
  # there instead of streaming the remaining (compressed) hundreds of MiB.
  bsdtar -xOqf "$1" .PKGINFO 2>/dev/null | sed -n 's/^pkgname = //p'
}

index_directory() {
  local directory=$1 archive package
  [[ -z ${directory_indexed[$directory]:-} ]] || return 0
  shopt -s nullglob
  for archive in "$directory"/*.pkg.tar.*; do
    [[ $archive == *.sig ]] && continue
    package=$(read_package_name "$archive") || continue
    [[ -n $package ]] || continue
    if [[ -n ${package_archive["$directory/$package"]:-} ]]; then
      # Ambiguity must fail the lookup, exactly as two matches did before.
      package_archive["$directory/$package"]=$'\n'
    else
      package_archive["$directory/$package"]=$archive
    fi
  done
  shopt -u nullglob
  directory_indexed[$directory]=1
}

find_package() {
  local directory=$1 package=$2 archive
  index_directory "$directory"
  archive=${package_archive["$directory/$package"]:-}
  [[ -n $archive && $archive != $'\n' ]] || { echo "Expected exactly one $package archive in $directory" >&2; return 1; }
  printf '%s\n' "$archive"
}

: >"$tmp/REUSE-MANIFEST"
while read -r package; do
  [[ -n $package ]] || continue
  archive=$(find_package "$predecessor" "$package")
  [[ -s $archive.sig ]] || { echo "Missing predecessor signature: ${archive##*/}.sig" >&2; exit 1; }
  cp --preserve=mode,timestamps "$archive" "$archive.sig" "$tmp/"
  printf '%s|%s|%s|%s\n' "$package" "${archive##*/}" "$(sha256sum "$archive" | cut -d' ' -f1)" "$(sha256sum "$archive.sig" | cut -d' ' -f1)" >>"$tmp/REUSE-MANIFEST"
done < <(jq -r '.reused_packages[]' "$plan")

while read -r package; do
  [[ -n $package ]] || continue
  if grep -Fxq "$package" <(printf '%s\n' omarchy-settings-dev omarchy-dev omarchy-keyring omarchy-nvim quickshell-git ttf-jetbrains-mono-nerd-basic); then
    source_dir=$rebuilt_runtime
  else
    source_dir=$rebuilt_repository
  fi
  archive=$(find_package "$source_dir" "$package")
  [[ ! -e $archive.sig ]] || { echo "Rebuilt archive unexpectedly has a signature: ${archive##*/}" >&2; exit 1; }
  cp "$archive" "$tmp/"
done < <(jq -r '.rebuilt_packages[]' "$plan")

actual=$(find "$tmp" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0 | while IFS= read -r -d '' archive; do read_package_name "$archive"; done | sort)
expected=$(jq -r '.rebuilt_packages[],.reused_packages[]' "$plan" | sort)
[[ $actual == "$expected" ]] || { echo "Assembled package inventory mismatch" >&2; exit 1; }
cp -a "$tmp/." "$output/"
printf '%s\n' "$output"
