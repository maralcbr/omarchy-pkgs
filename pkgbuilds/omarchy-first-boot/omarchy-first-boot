#!/bin/bash

# First boot of an Apple Silicon bootstrap image, on tty1: keyboard, network,
# clock and space, then the signed curl-path installer in --deferred-user mode,
# then the factory snapshot and the hand-off to owner provisioning. The releases
# are chosen once and kept in the selection file, so a retry after any failure
# or power loss installs exactly what the first attempt verified.
#
# omarchy-first-boot            run (omarchy-first-boot.service)
# omarchy-first-boot arm ROOT   arm an image root the builder made

set -euo pipefail

root=${OMARCHY_FIRST_BOOT_ROOT:-}
state_dir=$root/var/lib/omarchy/first-boot
pending=$state_dir/pending
selection_file=$state_dir/selection
handover_file=$state_dir/channel-identity
installed_file=$state_dir/installed
keyboard_file=$state_dir/keyboard
error_file=$state_dir/last-error
log_file=$root/var/log/omarchy-first-boot.log
kernel_marker=$root/usr/share/omarchy/apple-silicon-kernel
channel_record=$root/var/lib/omarchy/apple-silicon-channel
provisioning_dir=$root/var/lib/omarchy/provisioning
runtime_dir=$root/run/omarchy-first-boot
# Per boot: a power loss reboots into whatever kernel the install left.
boot_fingerprint_file=$runtime_dir/boot-fingerprint

package_repo=maralcbr/omarchy-pkgs
download_base_url=${OMARCHY_FIRST_BOOT_DOWNLOAD_BASE_URL:-https://github.com/$package_repo/releases/download}
runtime_pointer_url=${OMARCHY_ASAHI_CHANNEL_POINTER_URL:-https://downloads.aicodelabs.com.au/pointers/asahi-quattro-channel}
packages_pointer_url=${OMARCHY_ASAHI_PACKAGES_POINTER_URL:-https://downloads.aicodelabs.com.au/pointers/asahi-packages-channel}
release_key_url=${OMARCHY_RELEASE_KEY_URL:-https://raw.githubusercontent.com/maralcbr/omarchy-mx-mac/main/default/omarchy-release.gpg}
wrapper_base_url=${OMARCHY_FIRST_BOOT_WRAPPER_URL:-https://github.com/maralcbr/omarchy-mx-mac/releases/latest/download}
release_key_fingerprint=5983B1CA32CB778F4D74D24ECFF35022CA5B5959
minimum_free_bytes=$((10 * 1024 * 1024 * 1024))
time_sync_timeout=${OMARCHY_FIRST_BOOT_TIME_SYNC_TIMEOUT:-120}

# Shipped beside this script: the Node.js build owner provisioning unpacks offline.
node_pin_file=${BASH_SOURCE[0]%/*}/node.pin

# The provisioning form's layouts (omarchy-mx-mac install/provisioning/setup-form.sh).
keyboard_layouts=$'English (US)|us
English (UK)|uk
English (US, Dvorak)|dvorak
English (US, Colemak)|colemak
Azerbaijani|azerty
Belarusian|by
Belgian|be-latin1
Bulgarian|bg-cp1251
Croatian|croat
Czech|cz
Danish|dk-latin1
Dutch|nl
Estonian|et
Finnish|fi
French|fr
French (Canada)|cf
French (Switzerland)|fr_CH
Georgian|ge
German|de
German (Switzerland)|de_CH-latin1
Greek|gr
Hebrew|il
Hungarian|hu
Icelandic|is-latin1
Irish|ie
Italian|it
Japanese|jp106
Kazakh|kazakh
Kyrgyz|kyrgyz
Lao|la-latin1
Latvian|lv
Lithuanian|lt
Macedonian|mk-utf
Norwegian|no-latin1
Polish|pl
Portuguese|pt-latin1
Portuguese (Brazil)|br-abnt2
Romanian|ro
