# Maintainer: Zesko
_pkgname="limine-entry-tool"
pkgname="limine-mkinitcpio-hook"
_pkgver=1.36.0
_extver=""
_gradle_version=9.7.0
pkgver="${_pkgver}${_extver}"
pkgrel=4
pkgdesc="Install kernels for the Limine bootloader."
arch=('x86_64' 'aarch64')
url="https://gitlab.com/Zesko/limine-entry-tool"
source=(
	"${_pkgname}::git+${url}.git#tag=${pkgver}"
	"0001-allow-aarch64-uki-and-efi-entries.patch"
	"gradle-${_gradle_version}-bin.zip::https://services.gradle.org/distributions/gradle-${_gradle_version}-bin.zip")
source_x86_64=("https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-25.0.2/graalvm-community-jdk-25.0.2_linux-x64_bin.tar.gz")
source_aarch64=(
	"https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-25.0.2/graalvm-community-jdk-25.0.2_linux-aarch64_bin.tar.gz"
	"limine-apple-gate")
license=("GPL3")
provides=('limine-entry-tool')
options=(!debug !strip)
_graalvm_version=graalvm_ce_jdk25
depends=(
	'bash'
	'grep'
	'tar'
	'limine'
	'mkinitcpio'
	'efibootmgr')
optdepends=(
	'kernel-modules-hook: Safely keeps kernel on upgrade failure'
	'sbctl: Signs UEFI boot files for Secure Boot when enabled'
	'journalctl-desktop-notification: Sends desktop notifications when errors occur'
)
makedepends=('git')
backup=(etc/limine-entry-tool.conf)
conflicts=('limine-entry-tool')
sha256sums=(
	'e389e36765acc9185499f764c6105ca02b11531d8665a67487816a24b518fecb'
	'8f6c1af2f9a7cf96d72e60bd2a80f4cce5dbafe2b9830a04ab822a76600905ed'
	'84fbba45c7f4c64abc77460e1c00f541e9f960e3c7ed2538f1ede19eacd873ae')
sha256sums_x86_64=('e0be791c8fda4d03b6b0a0cb824fef3149736170057b3a515252b44419606af0')
sha256sums_aarch64=(
	'b4580d9f223d0a4b3a1757e58b18ff4c1db950e67e105fc5cb741457d2384a71'
	'b5eff7b81a135895037db6b6fc6e6d1e65314ee471f74bebbdc2f977a483db77')

prepare() {
	# Apple Silicon Macs boot Limine under U-Boot's UEFI; the tool only
	# refused UKI and EFI entries there by architecture name.
	patch -d "$srcdir/${_pkgname}" -p1 <"$srcdir/0001-allow-aarch64-uki-and-efi-entries.patch"
	[[ -d "${_graalvm_version}" ]] && rm -rf "${_graalvm_version}"
	mv graalvm-community-openjdk-*/ "${_graalvm_version}"
	if ! command -v "${_graalvm_version}"/bin/javac >/dev/null 2>&1; then
		echo "Error: ${_graalvm_version}/bin/javac not found." >&2
		return 1
	fi
}

build() {
	cd "$srcdir/${_pkgname}"
	export GRAALVM_HOME="$srcdir/${_graalvm_version}"
	export JAVA_HOME="${GRAALVM_HOME}"
	export NATIVE_IMAGE_OPTIONS="-march=compatibility"
	"$srcdir/gradle-${_gradle_version}/bin/gradle" --no-daemon clean nativeCompile \
		-Dorg.gradle.java.home="${JAVA_HOME}"
}

package() {
	cd "$srcdir/${_pkgname}"
	local src="install/arch-linux"

	# directories
	install -dm 755 \
		"$pkgdir/usr/share/doc/limine-entry-tool" \
		"$pkgdir/etc/boot/hooks/pre.d" \
		"$pkgdir/etc/boot/hooks/post.d" \
		"$pkgdir/usr/lib/limine"

	# docs
	install -Dm 644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/limine-entry-tool/"

	# files
	cp -a "$src/limine-entry-tool/etc" "$src/limine-entry-tool/usr" "$pkgdir/"
	cp -a "$src/limine-mkinitcpio-hook/etc" "$src/limine-mkinitcpio-hook/usr" "$pkgdir/"
	install -Dm 755 "build/native/nativeCompile/limine-entry-tool" "$pkgdir/usr/lib/limine/"

	# limine hook symlinks
	ln -sf /usr/bin/limine-reset-enroll "$pkgdir/etc/boot/hooks/pre.d/10-limine-reset-enroll"
	ln -sf /usr/bin/limine-enroll-config "$pkgdir/etc/boot/hooks/post.d/90-limine-enroll-config"

	# No /usr/local/bin/mkinitcpio wrapper: it asks a question after every
	# mkinitcpio -P and runs limine-mkinitcpio on the default answer, which
	# breaks unattended installs and the omarchy-mac-boot hook on Macs.
	# Omarchy's flows call limine-update themselves.
	rm -f "$pkgdir/usr/local/bin/mkinitcpio"
	rmdir -p "$pkgdir/usr/local/bin" 2>/dev/null || true

	# Apple Silicon Macs boot GRUB until Omarchy activates Limine, and every
	# Mac keeps the kernel and initramfs mkinitcpio installs under /boot
	# (GRUB, the boot check and the snapshot tools read them). The kernel
	# hook therefore does not take over mkinitcpio's own 90-mkinitcpio-install
	# hook from /etc/pacman.d/hooks, as it does on x86: it runs after it.
	# It, the kernel removal hooks and the deploy hook (limine-install, which
	# deploys nothing on aarch64) run through limine-apple-gate, which passes
	# over Limine quietly until Limine is active.
	if [[ $CARCH == aarch64 ]]; then
		local hooks="$pkgdir/usr/share/libalpm/hooks" scripts=/usr/share/libalpm/scripts
		install -Dm755 "$srcdir/limine-apple-gate" "$pkgdir$scripts/limine-apple-gate"
		sed -e "s|^Description = .*|Description = Updating the Limine UKI (Apple Silicon)...|" \
			-e "s|^Exec = $scripts/limine-mkinitcpio-install\$|Exec = $scripts/limine-apple-gate $scripts/limine-mkinitcpio-install|" \
			"$pkgdir/etc/pacman.d/hooks/90-mkinitcpio-install.hook" >"$hooks/91-limine-mkinitcpio-install.hook"
		rm "$pkgdir/etc/pacman.d/hooks/90-mkinitcpio-install.hook"
		rmdir -p "$pkgdir/etc/pacman.d/hooks" 2>/dev/null || true
		sed -i -e "s|^Exec = $scripts/limine-mkinitcpio-remove |Exec = $scripts/limine-apple-gate $scripts/limine-mkinitcpio-remove |" \
			-e "s|^Exec = /usr/bin/limine-install\$|Exec = $scripts/limine-apple-gate /usr/bin/limine-install|" \
			"$hooks/60-limine-mkinitcpio-remove-pre.hook" "$hooks/90-limine-mkinitcpio-remove-post.hook" "$hooks/80-limine-efi-deploy.hook"
		local hook
		for hook in 91-limine-mkinitcpio-install 60-limine-mkinitcpio-remove-pre 90-limine-mkinitcpio-remove-post 80-limine-efi-deploy; do
			grep -Eq "^Exec = $scripts/limine-apple-gate ($scripts/limine-mkinitcpio-|/usr/bin/limine-install$)" "$hooks/$hook.hook" || {
				echo "$hook.hook does not run through limine-apple-gate" >&2
				return 1
			}
		done
	fi
}
