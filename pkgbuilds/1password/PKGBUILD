pkgname=1password

_tarver=8.12.36
pkgver=${_tarver//-/_}
pkgrel=42
conflicts=('1password-beta' '1password-beta-bin')
pkgdesc="Password manager and secure wallet"
arch=('x86_64' 'aarch64')
url='https://1password.com'
license=('LicenseRef-1Password-Proprietary')
options=(!strip)
install="1password.install"
source_x86_64=("https://downloads.1password.com/linux/tar/stable/x86_64/1password-${_tarver}.x64.tar.gz"{,.sig})
source_aarch64=("https://downloads.1password.com/linux/tar/stable/aarch64/1password-${_tarver}.arm64.tar.gz")
sha256sums_x86_64=('393c93c8025fee5dda76a4d0f1e478e98526cc946e58a22efe26f540ea2b5729'
                   '251177694bfdc63c431021e2bd2ed64f241b8a0247d5dd1c46d4d2dadffe7b97')
sha256sums_aarch64=('4b58851b3bf52a7bbc79243fc6b9cba9591cabe8b7eb2d0e271593bad2192af9')
validpgpkeys=('3FEF9748469ADBE15DA7CA80AC2D62742012EA22')

package() {
    depends=('hicolor-icon-theme' 'libgtk-3.so=0' 'nss' 'xdg-utils')

    if [[ $CARCH == aarch64 ]]; then
        _tardir="1password-${_tarver}.arm64"
    else
        _tardir="1password-${_tarver}.x64"
    fi

    cd "$_tardir"

    resolutions=(32x32 64x64 256x256 512x512)
    for resolution in "${resolutions[@]}"; do
        install -Dm0644 "resources/icons/hicolor/${resolution}/apps/1password.png" \
            "${pkgdir}/usr/share/icons/hicolor/${resolution}/apps/1password.png"
    done
    install -Dm0644 resources/com.onepassword.OnePassword.desktop -t "${pkgdir}"/usr/share/applications/

    if [[ $CARCH == aarch64 ]]; then
        # Do not interpolate the build-host passwd into the polkit policy.
        sed '/org.freedesktop.policykit.owner/d' \
            com.1password.1Password.policy.tpl \
            > "${srcdir}/com.1password.1Password.policy"
    else
        export POLICY_OWNERS
        POLICY_OWNERS="$(cut -d: -f1,3 /etc/passwd | grep -E ':[0-9]{4}$' | cut -d: -f1 | head -n 10 | sed 's/^/unix-user:/' | tr '\n' ' ')"
        eval "cat <<EOF
$(cat ./com.1password.1Password.policy.tpl)
EOF" > "${srcdir}/com.1password.1Password.policy"
    fi
    install -Dm0644 "${srcdir}/com.1password.1Password.policy" -t "${pkgdir}"/usr/share/polkit-1/actions/

    install -Dm0644 resources/custom_allowed_browsers -t "${pkgdir}"/usr/share/doc/1password/examples/

    cd "${srcdir}"
    install -dm0755 "${pkgdir}"/opt
    mv "$_tardir" "${pkgdir}/opt/1Password"

    rm "${pkgdir}"/opt/1Password/com.1password.1Password.policy \
        "${pkgdir}"/opt/1Password/com.1password.1Password.policy.tpl \
        "${pkgdir}"/opt/1Password/install_biometrics_policy.sh
    rm -r "${pkgdir}"/opt/1Password/resources/icons/
    rm "${pkgdir}"/opt/1Password/resources/com.onepassword.OnePassword.desktop \
        "${pkgdir}"/opt/1Password/resources/custom_allowed_browsers

    install -dm0755 "${pkgdir}"/usr/bin
    ln -s /opt/1Password/1password "${pkgdir}"/usr/bin/1password

    chmod 4755 "${pkgdir}"/opt/1Password/chrome-sandbox
}
