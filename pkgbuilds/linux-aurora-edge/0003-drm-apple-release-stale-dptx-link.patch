From 24a2482ac95e4a5fefcdf6e9721ac65de1f6c208 Mon Sep 17 00:00:00 2001
From: Marcelo Alcantara <maralc@gmail.com>
Date: Wed, 16 Sep 2026 08:06:37 +1000
Subject: [PATCH] drm/apple: release a stale DPTX link before borrowing a
 Type-C route

DCP's DP2HDMI HPD handler leaves disconnects to the firmware, so after the
HDMI display on a hybrid pipeline is unplugged dptxport[0].connected stays
true. When the fabric then borrows that pipeline for a Type-C port,
dcp_dptx_connect() sees the stale flag, returns early and never trains the
link, leaving the Type-C display dark. Release the leftover link when a
route is activated; route availability already excludes a pipeline whose
fixed output is live.
---
 drivers/gpu/drm/apple/dcp.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 0815639..6f44634 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -117,6 +117,7 @@ static bool dcp_typec_route_available(struct apple_dcp_typec_route *route)
 
 static int dcp_typec_route_activate(struct apple_dcp_typec_route *route);
 static int dcp_typec_route_deactivate(struct apple_dcp_typec_route *route);
+static int dcp_dptx_disconnect(struct apple_dcp *dcp, u32 port);
 
 /*
  * Pipelines are ranked by CRTC index so the fabric's choice is a pure function
@@ -139,6 +140,13 @@ static int dcp_typec_route_activate(struct apple_dcp_typec_route *route)
 	struct apple_dcp *dcp = route->dcp;
 	int ret;
 
+	/*
+	 * The fixed output's HPD handler leaves disconnects to DCP, so the port
+	 * can still be marked connected to a display that is gone. Release it
+	 * (a no-op otherwise), or connecting the borrowed route returns early.
+	 */
+	dcp_dptx_disconnect(dcp, 0);
+
 	if (dcp->fixed_route_selected) {
 		ret = mux_control_deselect(dcp->xbar);
 		if (ret)
