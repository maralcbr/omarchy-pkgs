[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = etc/mkinitcpio.conf.d/90-omarchy-mac.conf
Target = etc/mkinitcpio.conf.d/92-omarchy-mac-hid.conf
Target = etc/initcpio/install/*
Target = usr/lib/initcpio/install/*

[Action]
Description = Updating linux initcpios for Omarchy Mac boot...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/mkinitcpio install
NeedsTargets
