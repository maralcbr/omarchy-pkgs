#!/bin/bash

# First boot of an Omarchy Mac image, on tty1: consume the app's install.conf,
# run hardware steps the image build deferred, then hand off to owner
# provisioning. Encryption, if chosen, already happened in the initramfs of
# this same boot. The image already contains the runtime.
#
# omarchy-mac-first-boot            run (omarchy-mac-first-boot.service)
# omarchy-mac-first-boot arm ROOT   arm an image root the builder made

set -euo pipefail

root=${OMARCHY_MAC_FIRST_BOOT_ROOT:-}
state_dir=$root/var/lib/omarchy/mac-first-boot
pending=$state_dir/pending
consumed_conf=$state_dir/install.conf
error_file=$state_dir/last-error
log_file=$root/var/log/omarchy-mac-first-boot.log
provisioning_dir=$root/var/lib/omarchy/provisioning
esp_conf=$root/boot/efi/omarchy/install.conf

say() { printf '%s\n' "$*"; }

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$log_file" 2>/dev/null || true; }

fail() {
  mkdir -p "$state_dir"
  printf '%s\n' "$*" >"$error_file"
  log "failed: $*"
  printf 'First boot stopped: %s\n' "$*" >&2
  exit 1
}

pause() { sleep "$1"; }

# Writes bytes to a root-owned file in one rename, so a power loss leaves the old
# file or the new one.
write_atomically() {
  local target=$1 mode=$2 staging
  staging=$(mktemp "$target.XXXXXX")
  printf '%s' "$3" >"$staging"
  chmod "$mode" "$staging"
  sync "$staging" 2>/dev/null || true
  mv -f "$staging" "$target"
}

parse_install_conf() {
  local line key value format="" encrypt=""
  [[ -f $1 && ! -L $1 ]] || fail "$1 is not a regular file"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -n $line && $line != \#* ]] || continue
    [[ $line == *=* ]] || fail "$1 is malformed"
    key=${line%%=*}
    value=${line#*=}
    case $key in
      format) format=$value ;;
      encrypt) encrypt=$value ;;
      lane) ;;
    esac
  done <"$1"
  [[ $format == 1 ]] || fail "install.conf is not format=1"
  [[ $encrypt == 0 || $encrypt == 1 ]] || fail "install.conf does not set encrypt=0 or encrypt=1"
}

# The encrypt hook already read the ESP copy in this boot's initramfs and left
# it in place. First boot keeps it on the root so later tooling (and a retry
# after power loss) does not depend on the ESP file. Missing on both sides is
# encryption on, matching INTERFACES §4.
consume_install_conf() {
  local body=""
  install -d -m 0755 "$state_dir"
  if [[ -e $esp_conf || -L $esp_conf ]]; then
    [[ -f $esp_conf && ! -L $esp_conf ]] || fail "$esp_conf is not a regular file"
    IFS= read -r -d '' body <"$esp_conf" || true
    write_atomically "$consumed_conf" 0644 "$body"
    rm -f "$esp_conf"
    sync
  elif [[ ! -e $consumed_conf ]]; then
    write_atomically "$consumed_conf" 0644 $'format=1\nencrypt=1\n'
  fi
  parse_install_conf "$consumed_conf"
}

run_deferred_steps() {
  local cmd=""
  if [[ -x $root/usr/bin/omarchy-mac-run-deferred-steps ]]; then
    cmd=$root/usr/bin/omarchy-mac-run-deferred-steps
  elif command -v omarchy-mac-run-deferred-steps >/dev/null 2>&1; then
    cmd=$(command -v omarchy-mac-run-deferred-steps)
  else
    log "omarchy-mac-run-deferred-steps is not present; skipping"
    return 0
  fi
  "$cmd" >>"$log_file" 2>&1 || fail "the deferred hardware steps failed"
}

# What a deferred-user image carries for owner provisioning, plus the services
# it enables. Node.js and the runtime itself are already in the image.
# Provision-owner finds $PROVISIONING_DIR/luks-key when the initramfs hook
# encrypted the root; this service never touches keys.
stage_provisioning() {
  local unit=$root/usr/share/omarchy/install/provisioning/omarchy-provision-owner.service
  [[ -f $unit && -x $root/usr/bin/omarchy-provision-owner ]] ||
    fail "the installed runtime does not ship owner provisioning"
  install -d -m 0755 "$provisioning_dir"
  chmod 0755 "$provisioning_dir"
  : >"$provisioning_dir/pending"
  install -d -m 0755 "$root/etc/systemd/system/multi-user.target.wants"
  cp -p "$unit" "$root/etc/systemd/system/omarchy-provision-owner.service"
  ln -sfn /etc/systemd/system/omarchy-provision-owner.service \
    "$root/etc/systemd/system/multi-user.target.wants/omarchy-provision-owner.service"
  systemctl enable speakersafetyd.service sddm.service >>"$log_file" 2>&1 ||
    fail "could not enable speakersafetyd and the display manager"
  systemctl daemon-reload >>"$log_file" 2>&1 || true
}

# The single commit point: from here on provisioning and the display manager may run.
commit() {
  rm -f "$pending"
  sync
  log "committed"
  systemctl start --no-block omarchy-provision-owner.service
  systemctl start --no-block display-manager.service
}

attempt() {
  rm -f "$error_file"
  consume_install_conf
  run_deferred_steps
  stage_provisioning
  say "Ready for account setup."
  commit
}

failure_screen() {
  local choice
  say ""
  say "Omarchy could not finish first boot:"
  say "  $(cat "$error_file" 2>/dev/null || echo "an unexpected error (details in ${log_file#"$root"})")"
  say "Nothing is lost: retrying continues from where this attempt stopped."
  while true; do
    choice=$(gum choose --header "What next?" "Retry" "Shell") || { pause 5; choice=Retry; }
    [[ $choice == Shell ]] || return 0
    say "Type exit to come back to this screen."
    bash -l {lock_fd}>&- || true
  done
}

main() {
  if [[ ${1:-} == arm ]]; then
    local image=${2:?Usage: omarchy-mac-first-boot arm ROOT}
    install -d -m 0755 "$image/var/lib/omarchy/mac-first-boot"
    : >"$image/var/lib/omarchy/mac-first-boot/pending"
    chmod 0644 "$image/var/lib/omarchy/mac-first-boot/pending"
    return 0
  fi
  (($# == 0)) || { echo "Usage: omarchy-mac-first-boot [arm ROOT]" >&2; return 64; }
  [[ -n $root || $EUID == 0 ]] || { echo "omarchy-mac-first-boot must run as root" >&2; return 1; }
  [[ -f $pending ]] || return 0
  install -d -m 0755 "$state_dir"
  mkdir -p "${log_file%/*}"
  touch "$log_file"
  chmod 0600 "$log_file"

  exec {lock_fd}>"$state_dir/lock"
  flock -n "$lock_fd" || { echo "Another first boot is already running" >&2; return 1; }

  local status
  while true; do
    set +e
    (
      set -e
      attempt
    )
    status=$?
    set -e
    ((status != 0)) || return 0
    failure_screen
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
