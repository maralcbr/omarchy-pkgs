#!/bin/bash
# SPDX-License-Identifier: MIT

build() {
    add_module dm-crypt
    add_module ext4
    add_module vfat
    add_all_modules '/crypto/'

    add_binary cryptsetup
    add_binary dmsetup
    add_binary btrfs
    add_binary blockdev
    add_binary blkid
    add_binary lsblk
    add_binary awk
    add_binary findmnt
    add_binary mount
    add_binary umount
    add_binary bash
    add_binary dd
    add_binary install
    add_binary sed
    add_binary udevadm
    add_binary systemctl

    add_file /usr/lib/omarchy/initcpio/omarchy-mac-encrypt
    add_file /usr/lib/omarchy/initcpio/omarchy-mac-encrypt.service \
        /usr/lib/systemd/system/omarchy-mac-encrypt.service 644
    add_symlink /usr/lib/systemd/system/initrd-root-device.target.requires/omarchy-mac-encrypt.service \
        ../omarchy-mac-encrypt.service

    local rule
    for rule in 10-dm.rules 13-dm-disk.rules 95-dm-notify.rules; do
        [[ -f /usr/lib/udev/rules.d/$rule ]] && add_file "/usr/lib/udev/rules.d/$rule"
    done
}

help() {
    cat <<HELPEOF
Systemd initrd unit that encrypts a plain btrfs root in place on first boot
when /boot/efi/omarchy/install.conf is absent or encrypt=1. Journal lives on
the ext4 Boot partition (/boot/omarchy/encrypt.state); throwaway key at
/boot/omarchy/luks-key. No mkinitcpio runtime hook.
HELPEOF
}
