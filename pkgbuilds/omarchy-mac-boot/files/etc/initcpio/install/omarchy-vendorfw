#!/bin/bash
# SPDX-License-Identifier: MIT
# Origin: pkgbuilds/omarchy-apple-boot/omarchy-vendorfw.initcpio-install
# Combined hook: original post-mount omarchy-vendorfw.service plus the
# pre-unlock omarchy-vendorfw-initrd.service predecessor. Do not create
# /vendorfw/apple here — that made the early helper skip ESP extraction.

build() {
    add_binary tr
    add_binary cpio
    add_binary blkid
    add_binary cp
    add_binary sleep
    add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw.sh
    add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh
    add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw.service \
        /usr/lib/systemd/system/omarchy-vendorfw.service 644
    add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.service \
        /usr/lib/systemd/system/omarchy-vendorfw-initrd.service 644
    add_symlink /usr/lib/systemd/system/initrd.target.wants/omarchy-vendorfw.service \
        ../omarchy-vendorfw.service
    add_symlink /usr/lib/systemd/system/cryptsetup-pre.target.wants/omarchy-vendorfw-initrd.service \
        ../omarchy-vendorfw-initrd.service
    add_dir /lib/firmware
    add_symlink /lib/firmware/vendor /vendorfw
}

help() {
    cat <<HELPEOF
Systemd-initrd counterpart of the asahi hook's early/late runscripts: unpacks
the vendor firmware from the ESP before cryptsetup-pre.target so the internal
keyboard and MTP trackpad work at the sd-encrypt passphrase prompt, then the
original omarchy-vendorfw.service copies it onto /lib/firmware/vendor of the
unlocked sysroot after sysroot.mount.
HELPEOF
}
